<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <IsTestProject>true</IsTestProject>
    <IsPackable>false</IsPackable>
    <RuntimeFrameworkVersion>10.0.14</RuntimeFrameworkVersion>
  </PropertyGroup>
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <ProjectReference Include="../../src/ForgeFlow.Web/ForgeFlow.Web.csproj" />
    <ProjectReference Include="../../tools/ForgeFlow.Bootstrap/ForgeFlow.Bootstrap.csproj" />
    <ProjectReference Include="../../tools/ForgeFlow.LocalTestRecovery/ForgeFlow.LocalTestRecovery.csproj" />
    <ProjectReference Include="../../tools/ForgeFlow.LocalTestAccount/ForgeFlow.LocalTestAccount.csproj" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" PrivateAssets="all" />
  </ItemGroup>
  <ItemGroup>
    <Reference Include="Microsoft.CodeAnalysis">
      <HintPath>$(MSBuildSDKsPath)\..\Roslyn\bincore\Microsoft.CodeAnalysis.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="Microsoft.CodeAnalysis.CSharp">
      <HintPath>$(MSBuildSDKsPath)\..\Roslyn\bincore\Microsoft.CodeAnalysis.CSharp.dll</HintPath>
      <Private>true</Private>
    </Reference>
  </ItemGroup>
  <ItemGroup>
    <Content Include="../../src/ForgeFlow.Web/Resources/**/*.resx" Link="Catalogs/%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="../../src/ForgeFlow.Web/Components/**/*.razor" Link="Sources/%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="../../src/ForgeFlow.Web/**/*.cs" Exclude="../../src/ForgeFlow.Web/obj/**/*.cs;../../src/ForgeFlow.Web/bin/**/*.cs"
             Link="ApplicationSources/%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="../../src/ForgeFlow.Web/wwwroot/**/*.mjs"
             Link="ApplicationSources/wwwroot/%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="../../scripts/display-text-exceptions.json" Link="display-text-exceptions.json" CopyToOutputDirectory="PreserveNewest" />
    <None Update="Fixtures/DisplayText/**/*" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
