{
  "AllowedHosts": "*",
  "ForwardedHeaders": {
    "KnownNetworks": [
      "127.0.0.1/8",
      "::1/128"
    ],
    "KnownProxies": [
      "127.0.0.1",
      "::1"
    ]
  },
  "WebAuthn": {
    "RpId": "localhost",
    "Origin": "https://localhost:5001",
    "RpName": "ForgeFlow"
  },
  "RateLimiting": {
    "Enabled": true,
    "Auth": {
      "PermitLimit": 15,
      "WindowSeconds": 60,
      "SegmentsPerWindow": 6,
      "QueueLimit": 0
    },
    "Export": {
      "PermitLimit": 5,
      "WindowSeconds": 60,
      "QueueLimit": 0
    }
  },
  "DataProtection": {
    "KeyRingPath": ""
  },
  "RetentionPolicy": {
    "Enabled": true,
    "CleanupInterval": "01:00:00",
    "InitialDelay": "00:00:30",
    "ErrorLogRetentionDays": 30,
    "FallbackLogRetentionDays": 14,
    "SessionEvictionThresholdDays": 7
  }
}
