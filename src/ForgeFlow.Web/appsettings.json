{
  "RateLimiting": {
    "Enabled": true,
    "Auth": {
      "PermitLimit": 15,
      "WindowSeconds": 60,
      "SegmentsPerWindow": 6,
      "QueueLimit": 0
    },
    "Export": {
      "PermitLimit": 5,
      "WindowSeconds": 60,
      "QueueLimit": 0
    }
  },
  "RetentionPolicy": {
    "Enabled": true,
    "CleanupInterval": "01:00:00",
    "InitialDelay": "00:00:30",
    "ErrorLogRetentionDays": 30,
    "FallbackLogRetentionDays": 14,
    "SessionEvictionThresholdDays": 7
  }
}
