@inherits LayoutComponentBase
@implements IAsyncDisposable
@inject IStringLocalizer<SharedResources> Text
@inject AuthenticationStateProvider AuthProvider
@inject Microsoft.JSInterop.IJSRuntime JS
@inject ForgeFlow.Web.Organizations.ReadScopes ReadScopes
@inject CulturePolicy Culture

<AuthorizeView Context="shellAuth">
<Authorized>
<div class="app-shell">
    <BitNavPanel TItem="BitNavItem"
                 Items="@NavigationItems"
                 HeaderText="@Text["AppTitle"]"
                 IconNavUrl="/"
                 AriaLabel="@Text["Navigation"]"
                 DrawerBreakpoint="BitNavPanelBreakpoint.Lg"
                 NavMode="BitNavMode.Automatic"
                 NavMatch="BitNavMatch.Exact"
                 NoSearchBox="true"
                 NoCollapse="true"
                 ShowCloseButton="true"
                 IsOpen="@drawerOpen"
                 IsOpenChanged="@((bool isOpen) => drawerOpen = isOpen)"
                 ToggleAriaLabel="@Text["CollapseNavigation"]"
                 CloseAriaLabel="@Text["CloseNavigation"]"
                 id="primary-navigation"
                 Class="app-nav-panel" />
    <main id="main-content">
        <div id="auth-ui-notice" class="auth-ui-notice" role="status" hidden></div>
        <header class="app-header">
            <div class="app-header-start">
                <BitButton Class="nav-drawer-toggle" Variant="BitVariant.Outline" Size="BitSize.Small"
                           Icon="@MenuIcon" IconOnly="true"
                           aria-label="@Text["OpenNavigation"]" title="@Text["OpenNavigation"]"
                           aria-expanded="@drawerOpen.ToString().ToLowerInvariant()"
                           aria-controls="primary-navigation" OnClick="ToggleDrawer" />
                @{
                    var targetCulture = Culture.Language == CulturePolicy.Persian ? CulturePolicy.English : CulturePolicy.Persian;
                    var targetLabel = Culture.Language == CulturePolicy.Persian ? Text["LanguageEnglish"] : Text["LanguagePersian"];
                }
                <button type="button" class="header-lang-btn" data-auth-culture="@targetCulture"
                        aria-label="@Text["SwitchLanguageTo", targetLabel]">
                    <span class="ff-icon ff-icon--globe" aria-hidden="true"></span>
                    <span>@targetLabel</span>
                </button>
            </div>
            <UserMenu />
        </header>
        @Body
    </main>
</div>

</Authorized>
<NotAuthorized>
    <AnonymousRedirect />
</NotAuthorized>
</AuthorizeView>

@code {
    private bool drawerOpen;
    private bool wasAuthenticated;
    private Microsoft.JSInterop.IJSObjectReference? authUi;

    protected override void OnInitialized() => AuthProvider.AuthenticationStateChanged += AuthenticationStateChanged;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        authUi = await JS.InvokeAsync<Microsoft.JSInterop.IJSObjectReference>("import", "./auth-ui.mjs");
        var state = await AuthProvider.GetAuthenticationStateAsync();
        wasAuthenticated = state.User.Identity?.IsAuthenticated == true;
        try
        {
            orgScopes = await ReadScopes.LoadOrganizationScopesAsync();
            readScopes = await ReadScopes.Load();
            userScopes = await ReadScopes.LoadUserScopesAsync();
            roleScopes = await ReadScopes.LoadRoleScopesAsync();
            auditScopes = await ReadScopes.LoadAuditScopesAsync();
            unitScopes = await ReadScopes.LoadUnitScopesAsync();
            itemScopes = await ReadScopes.LoadItemScopesAsync();
            bomScopes = await ReadScopes.LoadBomScopesAsync();
            productionOrderScopes = await ReadScopes.LoadProductionOrderScopesAsync();
        }
        catch
        {
            orgScopes = [];
            readScopes = [];
            userScopes = [];
            roleScopes = [];
            auditScopes = [];
            unitScopes = [];
            itemScopes = [];
            bomScopes = [];
            productionOrderScopes = [];
        }
        StateHasChanged();
    }

    private async void AuthenticationStateChanged(Task<AuthenticationState> stateTask)
    {
        try
        {
            var state = await stateTask;
            var isAuthenticated = state.User.Identity?.IsAuthenticated == true;
            if (wasAuthenticated && !isAuthenticated && authUi is not null)
                await authUi.InvokeVoidAsync("clearDrafts");
            wasAuthenticated = isAuthenticated;
        }
        catch (Microsoft.JSInterop.JSDisconnectedException) { }
        catch (Microsoft.JSInterop.JSException) { }
    }

    public async ValueTask DisposeAsync()
    {
        AuthProvider.AuthenticationStateChanged -= AuthenticationStateChanged;
        if (authUi is not null)
        {
            try { await authUi.DisposeAsync(); }
            catch (Microsoft.JSInterop.JSDisconnectedException) { }
        }
    }

    private IReadOnlyList<ForgeFlow.Application.Organizations.OrganizationScope> orgScopes = [];
    private IReadOnlyList<ForgeFlow.Application.Organizations.OrganizationScope> readScopes = [];
    private IReadOnlyList<ForgeFlow.Application.Organizations.OrganizationScope> userScopes = [];
    private IReadOnlyList<ForgeFlow.Application.Organizations.OrganizationScope> roleScopes = [];
    private IReadOnlyList<ForgeFlow.Application.Organizations.OrganizationScope> auditScopes = [];
    private IReadOnlyList<ForgeFlow.Application.Organizations.OrganizationScope> unitScopes = [];
    private IReadOnlyList<ForgeFlow.Application.Organizations.OrganizationScope> itemScopes = [];
    private IReadOnlyList<ForgeFlow.Application.Organizations.OrganizationScope> bomScopes = [];
    private IReadOnlyList<ForgeFlow.Application.Organizations.OrganizationScope> productionOrderScopes = [];

    // The framework stylesheet ships only a few glyphs, so the shell uses its own CSS-mask icons (app.css, .ff-icon--*).
    private static BitIconInfo Icon(string name) => BitIconInfo.Css("ff-icon ff-icon--" + name);
    private static readonly BitIconInfo MenuIcon = Icon("menu");

    private IList<BitNavItem> NavigationItems
    {
        get
        {
            var items = new List<BitNavItem>
            {
                new() { Text = Text["Home"], AriaLabel = Text["Home"], Icon = Icon("home"), Url = "/", Match = BitNavMatch.Exact }
            };
            var production = ProductionItems;
            if (production.Count > 0)
            {
                items.Add(new() { Text = Text["ProductionNavGroup"], Icon = Icon("production"), IsExpanded = true, ChildItems = production });
            }
            var masterData = MasterDataItems;
            if (masterData.Count > 0)
            {
                items.Add(new() { Text = Text["MasterDataNavGroup"], Icon = Icon("catalog"), IsExpanded = true, ChildItems = masterData });
            }
            var settings = SettingsItems;
            if (settings.Count > 0)
            {
                items.Add(new() { Text = Text["Settings"], Icon = Icon("settings"), IsExpanded = true, ChildItems = settings });
            }
            return items;
        }
    }

    private List<BitNavItem> ProductionItems
    {
        get
        {
            var items = new List<BitNavItem>();
            if (productionOrderScopes.Count > 0)
                items.Add(new() { Text = Text["ProductionOrders"], Icon = Icon("production"), Url = "/production-orders", Match = BitNavMatch.Exact });
            return items;
        }
    }

    private List<BitNavItem> MasterDataItems
    {
        get
        {
            var items = new List<BitNavItem>();
            if (unitScopes.Count > 0)
                items.Add(new() { Text = Text["Units"], Icon = Icon("units"), Url = "/units", Match = BitNavMatch.Exact });
            if (itemScopes.Count > 0)
                items.Add(new() { Text = Text["Items"], Icon = Icon("items"), Url = "/items", Match = BitNavMatch.Exact });
            if (bomScopes.Count > 0)
                items.Add(new() { Text = Text["Boms"], Icon = Icon("boms"), Url = "/boms", Match = BitNavMatch.Exact });
            return items;
        }
    }

    private List<BitNavItem> SettingsItems
    {
        get
        {
            var items = new List<BitNavItem>();
            if (orgScopes.Count > 0)
                items.Add(new() { Text = Text["Organizations"], Icon = Icon("org"), Url = "/organizations", Match = BitNavMatch.Exact });
            if (readScopes.Count > 0)
                items.Add(new() { Text = Text["Sites"], Icon = Icon("site"), Url = "/sites", Match = BitNavMatch.Exact });
            if (userScopes.Count > 0)
                items.Add(new() { Text = Text["Users"], Icon = Icon("user"), Url = "/users", Match = BitNavMatch.Exact });
            if (roleScopes.Count > 0)
                items.Add(new() { Text = Text["Roles"], Icon = Icon("role"), Url = "/roles", Match = BitNavMatch.Exact });
            if (auditScopes.Count > 0)
                items.Add(new() { Text = Text["Audit"], Icon = Icon("audit"), Url = "/audit", Match = BitNavMatch.Exact });
            return items;
        }
    }

    private void ToggleDrawer() => drawerOpen = !drawerOpen;
}
