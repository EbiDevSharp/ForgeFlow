@inherits LayoutComponentBase
@implements IAsyncDisposable
@inject IStringLocalizer<SharedResources> Text
@inject AuthenticationStateProvider AuthProvider
@inject Microsoft.JSInterop.IJSRuntime JS
@inject ForgeFlow.Web.Organizations.ReadScopes ReadScopes
@inject CulturePolicy Culture

<AuthorizeView Context="shellAuth">
<Authorized>
<div class="app-shell">
    <BitNavPanel TItem="BitNavItem"
                 Items="@NavigationItems"
                 HeaderText="@Text["AppTitle"]"
                 IconNavUrl="/"
                 AriaLabel="@Text["Navigation"]"
                 DrawerBreakpoint="BitNavPanelBreakpoint.Lg"
                 NavMode="BitNavMode.Automatic"
                 NavMatch="BitNavMatch.Exact"
                 NoSearchBox="true"
                 NoCollapse="true"
                 ShowCloseButton="true"
                 IsOpen="@drawerOpen"
                 IsOpenChanged="@((bool isOpen) => drawerOpen = isOpen)"
                 ToggleAriaLabel="@Text["CollapseNavigation"]"
                 CloseAriaLabel="@Text["CloseNavigation"]"
                 id="primary-navigation"
                 Class="app-nav-panel" />
    <main id="main-content">
        <div id="auth-ui-notice" class="auth-ui-notice" role="status" hidden></div>
        <header class="app-header">
            <div class="app-header-start">
                <button class="nav-drawer-toggle" type="button" aria-expanded="@drawerOpen.ToString().ToLowerInvariant()"
                        aria-controls="primary-navigation" @onclick="ToggleDrawer">
                    @Text["OpenNavigation"]
                </button>
                @{
                    var targetCulture = Culture.Language == CulturePolicy.Persian ? CulturePolicy.English : CulturePolicy.Persian;
                    var targetLabel = Culture.Language == CulturePolicy.Persian ? Text["LanguageEnglish"] : Text["LanguagePersian"];
                }
                <button type="button" class="header-lang-btn" data-auth-culture="@targetCulture"
                        aria-label="@Text["SwitchLanguageTo", targetLabel]">
                    <span class="ff-icon ff-icon--globe" aria-hidden="true"></span>
                    <span>@targetLabel</span>
                </button>
            </div>
            <UserMenu />
        </header>
        @Body
    </main>
</div>

</Authorized>
<NotAuthorized>
    <AnonymousRedirect />
</NotAuthorized>
</AuthorizeView>

@code {
    private bool drawerOpen;
    private bool wasAuthenticated;
    private Microsoft.JSInterop.IJSObjectReference? authUi;

    protected override void OnInitialized() => AuthProvider.AuthenticationStateChanged += AuthenticationStateChanged;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        authUi = await JS.InvokeAsync<Microsoft.JSInterop.IJSObjectReference>("import", "./auth-ui.mjs");
        var state = await AuthProvider.GetAuthenticationStateAsync();
        wasAuthenticated = state.User.Identity?.IsAuthenticated == true;
        try { readScopes = await ReadScopes.Load(); } catch { readScopes = []; }
        StateHasChanged();
    }

    private async void AuthenticationStateChanged(Task<AuthenticationState> stateTask)
    {
        try
        {
            var state = await stateTask;
            var isAuthenticated = state.User.Identity?.IsAuthenticated == true;
            if (wasAuthenticated && !isAuthenticated && authUi is not null)
                await authUi.InvokeVoidAsync("clearDrafts");
            wasAuthenticated = isAuthenticated;
        }
        catch (Microsoft.JSInterop.JSDisconnectedException) { }
        catch (Microsoft.JSInterop.JSException) { }
    }

    public async ValueTask DisposeAsync()
    {
        AuthProvider.AuthenticationStateChanged -= AuthenticationStateChanged;
        if (authUi is not null)
        {
            try { await authUi.DisposeAsync(); }
            catch (Microsoft.JSInterop.JSDisconnectedException) { }
        }
    }

    private IReadOnlyList<ForgeFlow.Application.Organizations.OrganizationScope> readScopes = [];

    // The framework stylesheet ships only a few glyphs, so the shell uses its own CSS-mask icons (app.css, .ff-icon--*).
    private static BitIconInfo Icon(string name) => BitIconInfo.Css("ff-icon ff-icon--" + name);

    private IList<BitNavItem> NavigationItems =>
    [
        new() { Text = Text["Home"], AriaLabel = Text["Home"], Icon = Icon("home"), Url = "/", Match = BitNavMatch.Exact },
        new() { Text = Text["Settings"], Icon = Icon("settings"), IsExpanded = true, IsDisabled = readScopes.Count == 0, ChildItems = SettingsItems }
    ];

    private List<BitNavItem> SettingsItems => readScopes.Count == 0 ? [] :
        readScopes.Any(x => x is ForgeFlow.Application.Organizations.OrganizationScope.Organization)
        ? [new() { Text = Text["Organizations"], Icon = Icon("org"), Url = "/organizations", Match = BitNavMatch.Exact }, new() { Text = Text["Sites"], Icon = Icon("site"), Url = "/sites", Match = BitNavMatch.Exact }]
        : [new() { Text = Text["Sites"], Icon = Icon("site"), Url = "/sites", Match = BitNavMatch.Exact }];

    private void ToggleDrawer() => drawerOpen = !drawerOpen;
}
