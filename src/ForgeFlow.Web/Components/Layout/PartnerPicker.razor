@using ForgeFlow.Application.BusinessPartners
@using ForgeFlow.Application.Organizations
@using ForgeFlow.Domain.BusinessPartners
@inject BusinessPartnerUseCases BpService
@inject IStringLocalizer<SharedResources> Text
@inject NavigationManager Navigation

<div class="partner-picker">
    @if (!string.IsNullOrWhiteSpace(Label))
    {
        <label class="proc-field-label">
            @Label
            @if (Required)
            {
                <span class="proc-req-star" aria-hidden="true">*</span>
            }
        </label>
    }

    <button type="button" class="partner-picker-trigger" disabled="@Disabled" @onclick="OpenModal">
        @if (selectedItem is not null)
        {
            <div class="partner-picker-selected">
                <span class="partner-picker-avatar @GetAvatarClass(selectedItem.Name)">@GetInitial(selectedItem.Name)</span>
                <span class="partner-picker-name">@selectedItem.Name</span>
                @if (!string.IsNullOrWhiteSpace(selectedItem.Code))
                {
                    <span class="partner-picker-code"><bdi dir="ltr">@selectedItem.Code</bdi></span>
                }
            </div>
            <div class="partner-picker-actions">
                <span class="partner-picker-change-btn">@Text["PartnerPickerChange"]</span>
                @if (AllowClear && !Disabled)
                {
                    <span role="button" class="partner-picker-clear-btn" title="@Text["PartnerPickerClear"]" aria-label="@Text["PartnerPickerClear"]" @onclick:stopPropagation="true" @onclick="ClearAsync">
                        ✕
                    </span>
                }
            </div>
        }
        else
        {
            <div class="partner-picker-placeholder">
                <svg class="partner-picker-placeholder-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <circle cx="11" cy="11" r="8"></circle>
                    <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
                </svg>
                <span>@(string.IsNullOrWhiteSpace(Placeholder) ? DefaultPlaceholder : Placeholder)</span>
            </div>
        }
    </button>
</div>

<BitDialog Width="520px" MaxWidth="calc(100vw - 24px)" Classes="@ModalClasses" @bind-IsOpen="isOpen"
           Title="@ModalTitle" CloseButtonTitle="@Text["ReadClose"]" ShowOkButton="false" ShowCancelButton="false"
           ShowCloseButton="false" AutoFocus="false" TrapFocus="true" RestoreFocus="true" CloseOnEscape="true">
    <Body>
        <div class="partner-picker-modal-head">
            <h3>@ModalTitle</h3>
            <button type="button" class="bp-close-btn" aria-label="@Text["ReadClose"]" @onclick="() => isOpen = false">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <line x1="18" y1="6" x2="6" y2="18"></line>
                    <line x1="6" y1="6" x2="18" y2="18"></line>
                </svg>
            </button>
        </div>

        <div class="partner-picker-search-container">
            <div class="partner-picker-search-wrapper">
                <svg class="partner-picker-search-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <circle cx="11" cy="11" r="8"></circle>
                    <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
                </svg>
                <input type="search" class="partner-picker-search-input" value="@search"
                       placeholder="@Text["PartnerPickerSearchPlaceholder"]"
                       @oninput="OnSearchInputAsync" autofocus />
                @if (!string.IsNullOrEmpty(search))
                {
                    <button type="button" class="partner-picker-search-clear" aria-label="@Text["PartnerPickerClear"]" @onclick="ClearSearchAsync">
                        ✕
                    </button>
                }
            </div>
        </div>

        <div class="partner-picker-list">
            @if (loading)
            {
                <div class="partner-picker-loading">
                    <p>@Text["ReadLoading"]</p>
                </div>
            }
            else if (items.Count == 0)
            {
                <div class="partner-picker-empty">
                    <p>@Text["PartnerPickerEmpty"]</p>
                </div>
            }
            else
            {
                @for (var i = 0; i < items.Count; i++)
                {
                    var item = items[i];
                    var isSelected = selectedItem is not null && selectedItem.TargetId == item.TargetId;
                    <div class="partner-picker-item @(isSelected ? "is-selected" : "")" @onclick="() => SelectItemAsync(item)">
                        <div class="partner-picker-item-avatar @GetAvatarClass(item.Name, i)">
                            @GetInitial(item.Name)
                        </div>
                        <div class="partner-picker-item-content">
                            <span class="partner-picker-item-name">@item.Name</span>
                            <span class="partner-picker-item-sub">
                                <bdi dir="ltr">@item.Code</bdi>
                                @if (!string.IsNullOrWhiteSpace(item.City))
                                {
                                    <span class="partner-picker-item-sub-sep">•</span>
                                    <span>@item.City</span>
                                }
                                @if (!string.IsNullOrWhiteSpace(item.Mobile))
                                {
                                    <span class="partner-picker-item-sub-sep">•</span>
                                    <bdi dir="ltr">@item.Mobile</bdi>
                                }
                                else if (!string.IsNullOrWhiteSpace(item.Phone))
                                {
                                    <span class="partner-picker-item-sub-sep">•</span>
                                    <bdi dir="ltr">@item.Phone</bdi>
                                }
                            </span>
                        </div>
                        @if (isSelected)
                        {
                            <svg class="partner-picker-item-check" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round">
                                <polyline points="20 6 9 17 4 12"></polyline>
                            </svg>
                        }
                    </div>
                }
            }
        </div>

        <div class="partner-picker-modal-foot">
            <button type="button" class="partner-picker-create-link" @onclick="NavigateToCreatePartner">
                @CreateNewPartnerLabel
            </button>
            <div class="partner-picker-foot-meta">
                <span>@TotalCountLabel</span>
                @if (totalPages > 1)
                {
                    <div class="partner-picker-pagination">
                        <button type="button" class="partner-picker-page-btn" disabled="@(currentPage <= 1 || loading)" @onclick="() => GoToPageAsync(currentPage - 1)">
                            @Text["PartnerPickerPrev"]
                        </button>
                        <span>@string.Format(Text["PartnerPickerPage"], currentPage, totalPages)</span>
                        <button type="button" class="partner-picker-page-btn" disabled="@(currentPage >= totalPages || loading)" @onclick="() => GoToPageAsync(currentPage + 1)">
                            @Text["PartnerPickerNext"]
                        </button>
                    </div>
                }
            </div>
        </div>
    </Body>
</BitDialog>

@code {
    [Parameter] public long Value { get; set; }
    [Parameter] public EventCallback<long> ValueChanged { get; set; }
    [Parameter] public PartnerLookupRole Role { get; set; } = PartnerLookupRole.All;
    [Parameter] public OrganizationScope? Scope { get; set; }
    [Parameter] public long OrganizationId { get; set; }
    [Parameter] public string? Label { get; set; }
    [Parameter] public string? Placeholder { get; set; }
    [Parameter] public bool Required { get; set; }
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public bool AllowClear { get; set; } = true;
    [Parameter] public string? InitialName { get; set; }
    [Parameter] public string? InitialCode { get; set; }

    private bool isOpen;
    private string search = string.Empty;
    private bool loading;
    private int currentPage = 1;
    private const int PageSize = 10;
    private int totalCount;
    private int totalPages = 1;
    private List<PartnerLookupItem> items = [];
    private PartnerLookupItem? selectedItem;
    private CancellationTokenSource? searchCts;

    private static readonly BitDialogClassStyles ModalClasses = new()
    {
        Root = "partner-picker-dialog",
        Container = "partner-picker-shell",
        Header = "partner-picker-dialog-hidden-hdr"
    };

    private string DefaultPlaceholder => Role switch
    {
        PartnerLookupRole.Supplier => Text["PartnerPickerSelectSupplier"],
        PartnerLookupRole.Customer => Text["PartnerPickerSelectCustomer"],
        _ => Text["PartnerPickerSelectPartner"]
    };

    private string ModalTitle => Role switch
    {
        PartnerLookupRole.Supplier => Text["PartnerPickerTitleSupplier"],
        PartnerLookupRole.Customer => Text["PartnerPickerTitleCustomer"],
        _ => Text["PartnerPickerTitlePartner"]
    };

    private string CreateNewPartnerLabel => Role switch
    {
        PartnerLookupRole.Supplier => Text["PartnerPickerCreateNewSupplier"],
        PartnerLookupRole.Customer => Text["PartnerPickerCreateNewCustomer"],
        _ => Text["PartnerPickerCreateNewPartner"]
    };

    private string TotalCountLabel => Role switch
    {
        PartnerLookupRole.Supplier => string.Format(Text["PartnerPickerTotalSuppliers"], totalCount),
        PartnerLookupRole.Customer => string.Format(Text["PartnerPickerTotalCustomers"], totalCount),
        _ => string.Format(Text["PartnerPickerTotalPartners"], totalCount)
    };

    protected override async Task OnParametersSetAsync()
    {
        if (Value > 0)
        {
            if (selectedItem is null || selectedItem.TargetId != Value)
            {
                if (!string.IsNullOrWhiteSpace(InitialName) && selectedItem is null)
                {
                    selectedItem = new PartnerLookupItem(0, Value, InitialCode ?? string.Empty, InitialName, PersonType.Legal, null, null, null, null, null, null, null, []);
                }
                else if (Scope is not null && OrganizationId > 0)
                {
                    var res = await BpService.GetLookupItem(Scope, OrganizationId, Role, Value);
                    if (res.Succeeded && res.Value is not null)
                    {
                        selectedItem = res.Value;
                    }
                }
            }
        }
        else
        {
            selectedItem = null;
        }
    }

    private async Task OpenModal()
    {
        if (Disabled) return;
        isOpen = true;
        search = string.Empty;
        currentPage = 1;
        await LoadPageAsync(1);
    }

    private async Task OnSearchInputAsync(ChangeEventArgs e)
    {
        search = e.Value?.ToString() ?? string.Empty;
        searchCts?.Cancel();
        searchCts = new CancellationTokenSource();
        var token = searchCts.Token;

        try
        {
            await Task.Delay(250, token);
            if (!token.IsCancellationRequested)
            {
                await LoadPageAsync(1);
            }
        }
        catch (TaskCanceledException) { }
    }

    private async Task ClearSearchAsync()
    {
        search = string.Empty;
        await LoadPageAsync(1);
    }

    private async Task GoToPageAsync(int page)
    {
        if (page < 1 || page > totalPages) return;
        await LoadPageAsync(page);
    }

    private async Task LoadPageAsync(int page)
    {
        if (Scope is null || OrganizationId <= 0) return;
        loading = true;
        currentPage = page;
        StateHasChanged();

        try
        {
            var res = await BpService.SearchLookup(Scope, OrganizationId, new PartnerLookupQuery(search, Role, page, PageSize));
            if (res.Succeeded && res.Value is not null)
            {
                items = res.Value.Items.ToList();
                totalCount = res.Value.Total;
                totalPages = Math.Max(1, (int)Math.Ceiling((double)totalCount / PageSize));
            }
            else
            {
                items = [];
                totalCount = 0;
                totalPages = 1;
            }
        }
        finally
        {
            loading = false;
            StateHasChanged();
        }
    }

    private async Task SelectItemAsync(PartnerLookupItem item)
    {
        selectedItem = item;
        isOpen = false;
        await ValueChanged.InvokeAsync(item.TargetId);
    }

    private async Task ClearAsync()
    {
        selectedItem = null;
        await ValueChanged.InvokeAsync(0);
    }

    private void NavigateToCreatePartner()
    {
        isOpen = false;
        Navigation.NavigateTo("/business-partners");
    }

    private static string GetInitial(string? name)
    {
        if (string.IsNullOrWhiteSpace(name)) return "•";
        var trimmed = name.Trim();
        return trimmed.Length > 0 ? trimmed[..1] : "•";
    }

    private static string GetAvatarClass(string? name, int index = 0)
    {
        if (string.IsNullOrWhiteSpace(name)) return "alt-0";
        var hash = Math.Abs(name.GetHashCode());
        return "alt-" + ((hash + index) % 5);
    }
}
