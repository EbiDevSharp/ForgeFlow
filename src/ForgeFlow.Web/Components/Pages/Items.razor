<BitDialog Width="580px" MaxWidth="calc(100vw - 24px)" Classes="@DialogClasses" @bind-IsOpen="clsModalOpen"
           Title="@Text[clsEditMode ? "ReadEdit" : "ReadDetails"]"
           AriaLabel="@Text[clsEditMode ? "ReadEdit" : "ReadDetails"]"
           CloseButtonTitle="@Text["ReadClose"]" ShowOkButton="false" ShowCancelButton="false" ShowCloseButton="true"
           AutoFocus="true" TrapFocus="true" RestoreFocus="true" CloseOnEscape="true">
    <Body>
        @if (selectedClassification is not null)
        {
            <div class="audit-modal-body">
                @if (!clsEditMode)
                {
                    <div class="audit-modal-title-row">
                        <strong class="audit-modal-code" dir="ltr">@selectedClassification.Code</strong>
                        <span class="read-badge @(selectedClassification.IsActive ? "active" : "inactive")">
                            @Text[selectedClassification.IsActive ? "ReadActive" : "ReadInactiveStatus"]
                        </span>
                    </div>
                    <div class="audit-meta-card">
                        <div class="audit-meta-row"><span class="audit-meta-label">@Text["ClassificationSetLabel"]</span><span class="audit-meta-val">@selectedClassification.ClassificationSetName</span></div>
                        <div class="audit-meta-row"><span class="audit-meta-label">@Text["ReadName"]</span><span class="audit-meta-val">@selectedClassification.Name</span></div>
                        <div class="audit-meta-row"><span class="audit-meta-label">@Text["ClassificationParentLabel"]</span><span class="audit-meta-val">@(selectedClassification.ParentClassificationName ?? "—")</span></div>
                    </div>
                }
                else
                {
                    <form class="write-panel" @onsubmit:preventDefault>
                        <div class="read-field">
                            <label for="edit-cls-name">@Text["ReadName"]</label>
                            <input id="edit-cls-name" @bind="editClsName" maxlength="200" disabled="@(!selectedClassification.IsActive || clsSaving)" />
                        </div>
                        <div class="read-field">
                            <label for="edit-cls-parent">@Text["ClassificationParentLabel"]</label>
                            <select id="edit-cls-parent" @bind="editClsParentIdText" disabled="@(!selectedClassification.IsActive || clsSaving)">
                                <option value="">—</option>
                                @foreach (var p in activeClassifications.Where(x => x.ClassificationSetId == selectedClassification.ClassificationSetId && x.Id != selectedClassification.Id))
                                {
                                    <option value="@p.Id">@p.Code — @p.Name</option>
                                }
                            </select>
                        </div>
                        <div class="write-actions">
                            @if (selectedClassification.IsActive)
                            {
                                <BitButton Size="BitSize.Small" IsEnabled="@(!clsSaving)" OnClick="SubmitUpdateClassificationAsync">@Text["WriteSave"]</BitButton>
                                <BitButton Variant="BitVariant.Outline" Size="BitSize.Small" IsEnabled="@(!clsSaving)" OnClick="() => ToggleClassificationActiveAsync(false)">@Text["WriteDeactivate"]</BitButton>
                            }
                            else
                            {
                                <BitButton Variant="BitVariant.Outline" Size="BitSize.Small" IsEnabled="@(!clsSaving)" OnClick="() => ToggleClassificationActiveAsync(true)">@Text["WriteActivate"]</BitButton>
                            }
                        </div>
                        @if (clsSaved) { <p role="status" class="write-saved">@Text["WriteSaved"]</p> }
                        @if (clsError is not null) { <p role="alert" class="write-error">@Text[clsError]</p> }
                    </form>
                }
            </div>
        }
    </Body>
</BitDialog>

