@page "/items"
@page "/organizations/{OrganizationId:long}/items"
@using System.Globalization
@using ForgeFlow.Application.Items
@using ForgeFlow.Application.Organizations
@using ForgeFlow.Application.Units
@using ForgeFlow.Domain.Items
@using ForgeFlow.Web.Roles
@inject ItemUseCases ItemService
@inject UnitUseCases UnitService
@inject ForgeFlow.Web.Organizations.ReadScopes Scopes
@inject ITrustedActorAccessor Actors
@inject IOrganizationPermissionEvaluator Permissions
@inject IStringLocalizer<SharedResources> Text

<PageTitle>@Text["Items"] - @Text["AppTitle"]</PageTitle>

<section class="organization-reader" aria-labelledby="items-title">
    <div class="read-page-head">
        <div>
            <h1 id="items-title">@Text["Items"]</h1>
            <p class="write-hint">@Text["ItemsCaption"]</p>
        </div>
        @if (!initialLoading && pageError is null && available.Count > 0 && scopeCanManage)
        {
            <div class="read-head-actions">
                @if (activeTab == TabItems)
                {
                    <BitButton Size="BitSize.Small" IconName="Add" Class="read-create-btn" OnClick="OpenCreateItem">
                        @Text["ItemCreateButton"]
                    </BitButton>
                }
                else if (activeTab == TabClassifications)
                {
                    <BitButton Variant="BitVariant.Outline" Size="BitSize.Small" Class="read-create-btn" OnClick="OpenCreateSet">
                        @Text["ClassificationSetCreateButton"]
                    </BitButton>
                    <BitButton Size="BitSize.Small" IconName="Add" Class="read-create-btn"
                               IsEnabled="@(classificationSets.Count > 0)" OnClick="OpenCreateClassification">
                        @Text["ClassificationCreateButton"]
                    </BitButton>
                }
                else
                {
                    <BitButton Size="BitSize.Small" IconName="Add" Class="read-create-btn" OnClick="OpenCreateAttribute">
                        @Text["AttributeCreateButton"]
                    </BitButton>
                }
            </div>
        }
    </div>

    @if (pageNotice is not null)
    {
        <p role="status" class="read-page-notice write-saved">@pageNotice</p>
    }

    @if (initialLoading)
    {
        <p role="status" aria-live="polite">@Text["ReadLoading"]</p>
    }
    else if (pageError is not null)
    {
        <div class="read-state" role="alert">
            <p>@Text[pageError]</p>
            <BitButton Variant="BitVariant.Outline" Size="BitSize.Small" OnClick="ReloadScopeAsync">@Text["WriteReload"]</BitButton>
        </div>
    }
    else
    {
        <div class="read-tab-bar" role="tablist" aria-label="@Text["Items"]">
            <button type="button" role="tab" aria-selected="@(activeTab == TabItems)"
                    class="read-tab-btn @(activeTab == TabItems ? "active" : string.Empty)"
                    @onclick="() => SwitchTabAsync(TabItems)">@Text["ItemsTab"]</button>
            <button type="button" role="tab" aria-selected="@(activeTab == TabClassifications)"
                    class="read-tab-btn @(activeTab == TabClassifications ? "active" : string.Empty)"
                    @onclick="() => SwitchTabAsync(TabClassifications)">@Text["ItemsClassificationsTab"]</button>
            <button type="button" role="tab" aria-selected="@(activeTab == TabAttributes)"
                    class="read-tab-btn @(activeTab == TabAttributes ? "active" : string.Empty)"
                    @onclick="() => SwitchTabAsync(TabAttributes)">@Text["ItemsAttributesTab"]</button>
        </div>

        <div class="read-toolbar-card">
            @if (available.Count > 1)
            {
                <div class="read-field">
                    <label for="items-scope">@Text["ReadScope"]</label>
                    <select id="items-scope" aria-label="@Text["ReadScope"]" value="@scopeIndex" @onchange="ChangeScopeAsync">
                        @for (var i = 0; i < available.Count; i++)
                        {
                            <option value="@i">@ScopeLabel(available[i])</option>
                        }
                    </select>
                </div>
            }

            @if (activeTab == TabItems)
            {
                <div class="read-field">
                    <label for="items-cls-filter">@Text["ItemsClassificationsTab"]</label>
                    <select id="items-cls-filter" value="@itemClassificationFilter" @onchange="ChangeItemClassificationFilterAsync">
                        <option value="">@Text["ClassificationFilterAll"]</option>
                        @foreach (var cls in activeClassifications)
                        {
                            <option value="@cls.Id">@cls.ClassificationSetName — @cls.Name</option>
                        }
                    </select>
                </div>
                <div class="read-field">
                    <label for="items-cap-filter">@Text["ItemCapabilitiesLabel"]</label>
                    <select id="items-cap-filter" value="@itemCapabilityFilter" @onchange="ChangeItemCapabilityFilterAsync">
                        <option value="">@Text["ItemCapFilterAll"]</option>
                        <option value="purchase">@Text["ItemCapPurchase"]</option>
                        <option value="manufacture">@Text["ItemCapManufacture"]</option>
                        <option value="sell">@Text["ItemCapSell"]</option>
                        <option value="consume">@Text["ItemCapConsume"]</option>
                    </select>
                </div>
            }
            else if (activeTab == TabClassifications)
            {
                <div class="read-field">
                    <label for="cls-set-filter">@Text["ClassificationSetLabel"]</label>
                    <select id="cls-set-filter" value="@classificationSetFilter" @onchange="ChangeSetFilterAsync">
                        <option value="">@Text["ClassificationSetAll"]</option>
                        @foreach (var s in classificationSets)
                        {
                            <option value="@s.Id">@s.Code — @s.Name</option>
                        }
                    </select>
                </div>
            }
            else
            {
                <div class="read-field">
                    <label for="attr-type-filter">@Text["AttributeDataTypeLabel"]</label>
                    <select id="attr-type-filter" value="@attributeTypeFilter" @onchange="ChangeAttrTypeFilterAsync">
                        <option value="">@Text["AttributeDataTypeAll"]</option>
                        @foreach (var dt in AllDataTypes)
                        {
                            <option value="@((byte)dt)">@Text[DataTypeResourceKey(dt)]</option>
                        }
                    </select>
                </div>
            }

            <div class="read-field">
                <label for="items-search">@Text["ReadSearch"]</label>
                <input id="items-search" type="search" @bind="search" @bind:after="ApplySearchAsync"
                       maxlength="100" placeholder="@Text["ItemSearchPlaceholder"]" />
            </div>

            <label class="read-inactive">
                <input type="checkbox" @bind="includeInactive" @bind:after="ApplySearchAsync" /> @Text["ReadInactive"]
            </label>
        </div>

        @if (activeTab == TabItems)
        {
            <div class="read-grid-card">
                <div class="read-grid">
                    <BitDataGrid @ref="itemsGrid" TItem="ItemSummary" OnRead="ReadItemsGridAsync" Pageable="true" PageSize="25"
                                 PageSizeOptions="@PageSizeOptions" Strings="@GridStrings" SelectionMode="BitSelectionMode.Single"
                                 AriaLabelledBy="items-title" WrapCellText="true">
                        <EmptyTemplate><p role="status" class="read-empty">@Text["ReadEmpty"]</p></EmptyTemplate>
                        <Columns>
                            <BitDataGridColumn TItem="ItemSummary" Title="@Text["ReadCode"]">
                                <Template Context="row"><bdi dir="ltr">@row.Code</bdi></Template>
                            </BitDataGridColumn>
                            <BitDataGridColumn TItem="ItemSummary" Title="@Text["ReadName"]">
                                <Template Context="row">@row.Name</Template>
                            </BitDataGridColumn>
                            <BitDataGridColumn TItem="ItemSummary" Title="@Text["ItemBaseUnitLabel"]">
                                <Template Context="row">@row.BaseUnitName (<bdi dir="ltr">@row.BaseUnitSymbol</bdi>)</Template>
                            </BitDataGridColumn>
                            <BitDataGridColumn TItem="ItemSummary" Title="@Text["ItemCapabilitiesLabel"]">
                                <Template Context="row">
                                    <div class="cap-badge-row">
                                        @if (row.CanBePurchased) { <span class="cap-badge">@Text["ItemCapPurchase"]</span> }
                                        @if (row.CanBeManufactured) { <span class="cap-badge">@Text["ItemCapManufacture"]</span> }
                                        @if (row.CanBeSold) { <span class="cap-badge">@Text["ItemCapSell"]</span> }
                                        @if (row.CanBeConsumed) { <span class="cap-badge">@Text["ItemCapConsume"]</span> }
                                        @if (row.RequiresLotTracking) { <span class="cap-badge">@Text["ItemLotTrackedBadge"]</span> }
                                        @if (row.QualityControlMode != QualityControlMode.None) { <span class="cap-badge">@Text["ItemQcRequiredBadge"]</span> }
                                    </div>
                                </Template>
                            </BitDataGridColumn>
                            <BitDataGridColumn TItem="ItemSummary" Title="@Text["ReadStatus"]">
                                <Template Context="row">
                                    <span class="read-badge @(row.IsActive ? "active" : "inactive")">
                                        @Text[row.IsActive ? "ReadActive" : "ReadInactiveStatus"]
                                    </span>
                                </Template>
                            </BitDataGridColumn>
                            <BitDataGridColumn TItem="ItemSummary" Title="@Text["ReadActions"]">
                                <Template Context="row">
                                    <div class="read-row-actions">
                                        <BitTooltip Text="@Text["ReadDetails"]" ShowOnFocus="true">
                                            <BitButton Variant="BitVariant.Outline" Size="BitSize.Small" Class="read-detail-action"
                                                       IconName="View" IconOnly="true" aria-label="@Text["ReadDetails"]"
                                                       OnClick="() => OpenItemModal(row.Id, edit: false)" />
                                        </BitTooltip>
                                        @if (scopeCanManage)
                                        {
                                            <BitTooltip Text="@Text["ReadEdit"]" ShowOnFocus="true">
                                                <BitButton Variant="BitVariant.Outline" Size="BitSize.Small" Class="read-detail-action"
                                                           Icon="@EditIcon" IconOnly="true" aria-label="@Text["ReadEdit"]"
                                                           OnClick="() => OpenItemModal(row.Id, edit: true)" />
                                            </BitTooltip>
                                        }
                                    </div>
                                </Template>
                            </BitDataGridColumn>
                        </Columns>
                    </BitDataGrid>
                </div>
            </div>
        }
        else if (activeTab == TabClassifications)
        {
            <div class="read-grid-card">
                <div class="read-grid">
                    <BitDataGrid @ref="classificationsGrid" TItem="ClassificationSummary" OnRead="ReadClassificationsGridAsync" Pageable="true" PageSize="25"
                                 PageSizeOptions="@PageSizeOptions" Strings="@GridStrings" SelectionMode="BitSelectionMode.Single"
                                 AriaLabelledBy="items-title" WrapCellText="true">
                        <EmptyTemplate><p role="status" class="read-empty">@Text["ReadEmpty"]</p></EmptyTemplate>
                        <Columns>
                            <BitDataGridColumn TItem="ClassificationSummary" Title="@Text["ClassificationSetLabel"]">
                                <Template Context="row">@row.ClassificationSetName</Template>
                            </BitDataGridColumn>
                            <BitDataGridColumn TItem="ClassificationSummary" Title="@Text["ReadCode"]">
                                <Template Context="row"><bdi dir="ltr">@row.Code</bdi></Template>
                            </BitDataGridColumn>
                            <BitDataGridColumn TItem="ClassificationSummary" Title="@Text["ReadName"]">
                                <Template Context="row">@row.Name</Template>
                            </BitDataGridColumn>
                            <BitDataGridColumn TItem="ClassificationSummary" Title="@Text["ClassificationParentLabel"]">
                                <Template Context="row">@(row.ParentClassificationName ?? "—")</Template>
                            </BitDataGridColumn>
                            <BitDataGridColumn TItem="ClassificationSummary" Title="@Text["ReadStatus"]">
                                <Template Context="row">
                                    <span class="read-badge @(row.IsActive ? "active" : "inactive")">
                                        @Text[row.IsActive ? "ReadActive" : "ReadInactiveStatus"]
                                    </span>
                                </Template>
                            </BitDataGridColumn>
                            <BitDataGridColumn TItem="ClassificationSummary" Title="@Text["ReadActions"]">
                                <Template Context="row">
                                    <div class="read-row-actions">
                                        <BitTooltip Text="@Text["ReadDetails"]" ShowOnFocus="true">
                                            <BitButton Variant="BitVariant.Outline" Size="BitSize.Small" Class="read-detail-action"
                                                       IconName="View" IconOnly="true" aria-label="@Text["ReadDetails"]"
                                                       OnClick="() => OpenClassificationModal(row.Id, edit: false)" />
                                        </BitTooltip>
                                        @if (scopeCanManage)
                                        {
                                            <BitTooltip Text="@Text["ReadEdit"]" ShowOnFocus="true">
                                                <BitButton Variant="BitVariant.Outline" Size="BitSize.Small" Class="read-detail-action"
                                                           Icon="@EditIcon" IconOnly="true" aria-label="@Text["ReadEdit"]"
                                                           OnClick="() => OpenClassificationModal(row.Id, edit: true)" />
                                            </BitTooltip>
                                        }
                                    </div>
                                </Template>
                            </BitDataGridColumn>
                        </Columns>
                    </BitDataGrid>
                </div>
            </div>
        }
        else
        {
            <div class="read-grid-card">
                <div class="read-grid">
                    <BitDataGrid @ref="attributesGrid" TItem="AttributeDefinitionSummary" OnRead="ReadAttributesGridAsync" Pageable="true" PageSize="25"
                                 PageSizeOptions="@PageSizeOptions" Strings="@GridStrings" SelectionMode="BitSelectionMode.Single"
                                 AriaLabelledBy="items-title" WrapCellText="true">
                        <EmptyTemplate><p role="status" class="read-empty">@Text["ReadEmpty"]</p></EmptyTemplate>
                        <Columns>
                            <BitDataGridColumn TItem="AttributeDefinitionSummary" Title="@Text["ReadCode"]">
                                <Template Context="row"><bdi dir="ltr">@row.Code</bdi></Template>
                            </BitDataGridColumn>
                            <BitDataGridColumn TItem="AttributeDefinitionSummary" Title="@Text["ReadName"]">
                                <Template Context="row">@row.Name</Template>
                            </BitDataGridColumn>
                            <BitDataGridColumn TItem="AttributeDefinitionSummary" Title="@Text["AttributeDataTypeLabel"]">
                                <Template Context="row">
                                    <span class="read-badge role">@Text[DataTypeResourceKey(row.DataType)]</span>
                                </Template>
                            </BitDataGridColumn>
                            <BitDataGridColumn TItem="AttributeDefinitionSummary" Title="@Text["UnitsTab"]">
                                <Template Context="row"><bdi dir="ltr">@(row.UnitSymbol ?? "—")</bdi></Template>
                            </BitDataGridColumn>
                            <BitDataGridColumn TItem="AttributeDefinitionSummary" Title="@Text["AttributeRequiredLabel"]">
                                <Template Context="row">
                                    <span class="read-badge @(row.IsRequired ? "system" : "inactive")">
                                        @Text[row.IsRequired ? "AttributeRequiredYes" : "AttributeRequiredNo"]
                                    </span>
                                </Template>
                            </BitDataGridColumn>
                            <BitDataGridColumn TItem="AttributeDefinitionSummary" Title="@Text["ReadStatus"]">
                                <Template Context="row">
                                    <span class="read-badge @(row.IsActive ? "active" : "inactive")">
                                        @Text[row.IsActive ? "ReadActive" : "ReadInactiveStatus"]
                                    </span>
                                </Template>
                            </BitDataGridColumn>
                            <BitDataGridColumn TItem="AttributeDefinitionSummary" Title="@Text["ReadActions"]">
                                <Template Context="row">
                                    <div class="read-row-actions">
                                        <BitTooltip Text="@Text["ReadDetails"]" ShowOnFocus="true">
                                            <BitButton Variant="BitVariant.Outline" Size="BitSize.Small" Class="read-detail-action"
                                                       IconName="View" IconOnly="true" aria-label="@Text["ReadDetails"]"
                                                       OnClick="() => OpenAttributeModal(row.Id, edit: false)" />
                                        </BitTooltip>
                                        @if (scopeCanManage)
                                        {
                                            <BitTooltip Text="@Text["ReadEdit"]" ShowOnFocus="true">
                                                <BitButton Variant="BitVariant.Outline" Size="BitSize.Small" Class="read-detail-action"
                                                           Icon="@EditIcon" IconOnly="true" aria-label="@Text["ReadEdit"]"
                                                           OnClick="() => OpenAttributeModal(row.Id, edit: true)" />
                                            </BitTooltip>
                                        }
                                    </div>
                                </Template>
                            </BitDataGridColumn>
                        </Columns>
                    </BitDataGrid>
                </div>
            </div>
        }
    }
</section>

<BitDialog Width="580px" MaxWidth="calc(100vw - 24px)" Classes="@DialogClasses" @bind-IsOpen="createItemOpen"
           OnDismissing="OnCreateItemDismissing"
           Title="@Text["ItemCreateTitle"]" AriaLabel="@Text["ItemCreateTitle"]"
           CloseButtonTitle="@Text["ReadClose"]" ShowOkButton="false" ShowCancelButton="false" ShowCloseButton="true"
           AutoFocus="true" TrapFocus="true" RestoreFocus="true" CloseOnEscape="true">
    <Body>
        <div class="audit-modal-body">
            <form class="write-panel" @onsubmit:preventDefault>
                <div class="read-field">
                    <label for="create-item-code">@Text["ReadCode"]</label>
                    <input id="create-item-code" @bind="createItemCode" @bind:event="oninput" maxlength="32"
                           disabled="@itemSaving" aria-describedby="create-item-code-hint" />
                    <span id="create-item-code-hint" class="write-hint">@Text["CreateCodeHint"]</span>
                </div>
                <div class="read-field">
                    <label for="create-item-name">@Text["ReadName"]</label>
                    <input id="create-item-name" @bind="createItemName" @bind:event="oninput" maxlength="200" disabled="@itemSaving" />
                </div>
                <div class="read-field">
                    <label for="create-item-desc">@Text["ItemDescriptionLabel"]</label>
                    <input id="create-item-desc" @bind="createItemDescription" @bind:event="oninput" maxlength="500" disabled="@itemSaving" />
                </div>
                <div class="read-field">
                    <label for="create-item-unit">@Text["ItemBaseUnitLabel"]</label>
                    <select id="create-item-unit" @bind="createItemBaseUnitId" disabled="@itemSaving">
                        @foreach (var u in activeUnits)
                        {
                            <option value="@u.Id">@u.Code — @u.Name (@u.Symbol)</option>
                        }
                    </select>
                </div>
                <div class="perm-group">
                    <div class="perm-group-header">
                        <span>@Text["ItemCapabilitiesLabel"]</span>
                    </div>
                    <div class="perm-grid">
                        <label class="perm-check"><input type="checkbox" @bind="createCapPurchase" disabled="@itemSaving" /><span>@Text["ItemCapPurchase"]</span></label>
                        <label class="perm-check"><input type="checkbox" @bind="createCapManufacture" disabled="@itemSaving" /><span>@Text["ItemCapManufacture"]</span></label>
                        <label class="perm-check"><input type="checkbox" @bind="createCapSell" disabled="@itemSaving" /><span>@Text["ItemCapSell"]</span></label>
                        <label class="perm-check"><input type="checkbox" @bind="createCapConsume" disabled="@itemSaving" /><span>@Text["ItemCapConsume"]</span></label>
                    </div>
                </div>
                <label class="perm-check">
                    <input type="checkbox" @bind="createRequiresLotTracking" disabled="@itemSaving" />
                    <span>@Text["ItemRequiresLotTrackingLabel"]</span>
                </label>
                <div class="read-field">
                    <label for="create-item-qc">@Text["ItemQcModeLabel"]</label>
                    <select id="create-item-qc" @bind="createQualityControlMode" disabled="@itemSaving">
                        <option value="@QualityControlMode.None">@Text["ItemQcModeNone"]</option>
                        <option value="@QualityControlMode.IncomingReceipts">@Text["ItemQcModeIncoming"]</option>
                        <option value="@QualityControlMode.ProductionReceipts">@Text["ItemQcModeProduction"]</option>
                        <option value="@QualityControlMode.AllReceipts">@Text["ItemQcModeAll"]</option>
                    </select>
                </div>

                @if (createItemDiscardConfirm)
                {
                    <div class="write-confirm" role="alertdialog" aria-labelledby="create-item-discard-text">
                        <p id="create-item-discard-text">@Text["WriteDiscardConfirm"]</p>
                        <div class="write-actions">
                            <BitButton Size="BitSize.Small" OnClick="ConfirmCreateItemDiscard">@Text["WriteDiscard"]</BitButton>
                            <BitButton Variant="BitVariant.Outline" Size="BitSize.Small" OnClick="() => createItemDiscardConfirm = false">@Text["WriteKeepEditing"]</BitButton>
                        </div>
                    </div>
                }
                else
                {
                    <div class="write-actions">
                        <BitButton Size="BitSize.Small"
                                   IsEnabled="@(!itemSaving && !string.IsNullOrWhiteSpace(createItemCode) && !string.IsNullOrWhiteSpace(createItemName) && createItemBaseUnitId > 0)"
                                   OnClick="SubmitCreateItemAsync">@Text["CreateSubmit"]</BitButton>
                    </div>
                }

                @if (itemSaving) { <p role="status">@Text["WriteSaving"]</p> }
                @if (itemError is not null) { <p role="alert" class="write-error">@Text[itemError]</p> }
            </form>
        </div>
    </Body>
</BitDialog>

<BitDialog Width="640px" MaxWidth="calc(100vw - 24px)" Classes="@DialogClasses" @bind-IsOpen="itemModalOpen"
           Title="@Text[itemEditMode ? "ItemEditTitle" : "ItemDetailTitle"]"
           AriaLabel="@Text[itemEditMode ? "ItemEditTitle" : "ItemDetailTitle"]"
           CloseButtonTitle="@Text["ReadClose"]" ShowOkButton="false" ShowCancelButton="false" ShowCloseButton="true"
           AutoFocus="true" TrapFocus="true" RestoreFocus="true" CloseOnEscape="true">
    <Body>
        @if (selectedItem is not null)
        {
            <div class="audit-modal-body">
                <div class="audit-modal-title-row">
                    <strong class="audit-modal-code" dir="ltr">@selectedItem.Summary.Code — @selectedItem.Summary.Name</strong>
                    <span class="read-badge @(selectedItem.Summary.IsActive ? "active" : "inactive")">
                        @Text[selectedItem.Summary.IsActive ? "ReadActive" : "ReadInactiveStatus"]
                    </span>
                </div>

                <div class="read-tab-bar" role="tablist">
                    <button type="button" role="tab" aria-selected="@(itemModalTab == 0)"
                            class="read-tab-btn @(itemModalTab == 0 ? "active" : string.Empty)"
                            @onclick="() => itemModalTab = 0">@Text["ItemSectionGeneral"]</button>
                    <button type="button" role="tab" aria-selected="@(itemModalTab == 1)"
                            class="read-tab-btn @(itemModalTab == 1 ? "active" : string.Empty)"
                            @onclick="() => itemModalTab = 1">@Text["ItemSectionClassifications"]</button>
                    <button type="button" role="tab" aria-selected="@(itemModalTab == 2)"
                            class="read-tab-btn @(itemModalTab == 2 ? "active" : string.Empty)"
                            @onclick="() => itemModalTab = 2">@Text["ItemSectionConversions"]</button>
                    <button type="button" role="tab" aria-selected="@(itemModalTab == 3)"
                            class="read-tab-btn @(itemModalTab == 3 ? "active" : string.Empty)"
                            @onclick="() => itemModalTab = 3">@Text["ItemSectionAttributes"]</button>
                </div>

                @if (itemModalTab == 0)
                {
                    @if (!itemEditMode)
                    {
                        <div class="audit-meta-card">
                            <div class="audit-meta-row">
                                <span class="audit-meta-label">@Text["ItemBaseUnitLabel"]</span>
                                <span class="audit-meta-val">@selectedItem.Summary.BaseUnitName (<bdi dir="ltr">@selectedItem.Summary.BaseUnitSymbol</bdi>)</span>
                            </div>
                            <div class="audit-meta-row">
                                <span class="audit-meta-label">@Text["ItemDescriptionLabel"]</span>
                                <span class="audit-meta-val">@(selectedItem.Summary.Description ?? "—")</span>
                            </div>
                            <div class="audit-meta-row">
                                <span class="audit-meta-label">@Text["ItemCapabilitiesLabel"]</span>
                                <div class="cap-badge-row">
                                    @if (selectedItem.Summary.CanBePurchased) { <span class="cap-badge">@Text["ItemCapPurchase"]</span> }
                                    @if (selectedItem.Summary.CanBeManufactured) { <span class="cap-badge">@Text["ItemCapManufacture"]</span> }
                                    @if (selectedItem.Summary.CanBeSold) { <span class="cap-badge">@Text["ItemCapSell"]</span> }
                                    @if (selectedItem.Summary.CanBeConsumed) { <span class="cap-badge">@Text["ItemCapConsume"]</span> }
                                </div>
                            </div>
                            <div class="audit-meta-row">
                                <span class="audit-meta-label">@Text["ItemRequiresLotTrackingLabel"]</span>
                                <span class="audit-meta-val">@Text[selectedItem.Summary.RequiresLotTracking ? "AttributeRequiredYes" : "AttributeRequiredNo"]</span>
                            </div>
                            <div class="audit-meta-row">
                                <span class="audit-meta-label">@Text["ItemQcModeLabel"]</span>
                                <span class="audit-meta-val">@QcModeLabel(selectedItem.Summary.QualityControlMode)</span>
                            </div>
                        </div>
                    }
                    else
                    {
                        <form class="write-panel" @onsubmit:preventDefault>
                            <div class="read-field">
                                <label for="edit-item-name">@Text["ReadName"]</label>
                                <input id="edit-item-name" @bind="editItemName" @bind:event="oninput" maxlength="200"
                                       disabled="@(!selectedItem.Summary.IsActive || itemSaving)" />
                            </div>
                            <div class="read-field">
                                <label for="edit-item-desc">@Text["ItemDescriptionLabel"]</label>
                                <input id="edit-item-desc" @bind="editItemDescription" @bind:event="oninput" maxlength="500"
                                       disabled="@(!selectedItem.Summary.IsActive || itemSaving)" />
                            </div>
                            <div class="read-field">
                                <label for="edit-item-unit">@Text["ItemBaseUnitLabel"]</label>
                                <select id="edit-item-unit" @bind="editItemBaseUnitId" disabled="@(!selectedItem.Summary.IsActive || itemSaving)">
                                    @foreach (var u in activeUnits)
                                    {
                                        <option value="@u.Id">@u.Code — @u.Name (@u.Symbol)</option>
                                    }
                                </select>
                            </div>
                            <div class="perm-group">
                                <div class="perm-group-header"><span>@Text["ItemCapabilitiesLabel"]</span></div>
                                <div class="perm-grid">
                                    <label class="perm-check"><input type="checkbox" @bind="editCapPurchase" disabled="@(!selectedItem.Summary.IsActive || itemSaving)" /><span>@Text["ItemCapPurchase"]</span></label>
                                    <label class="perm-check"><input type="checkbox" @bind="editCapManufacture" disabled="@(!selectedItem.Summary.IsActive || itemSaving)" /><span>@Text["ItemCapManufacture"]</span></label>
                                    <label class="perm-check"><input type="checkbox" @bind="editCapSell" disabled="@(!selectedItem.Summary.IsActive || itemSaving)" /><span>@Text["ItemCapSell"]</span></label>
                                    <label class="perm-check"><input type="checkbox" @bind="editCapConsume" disabled="@(!selectedItem.Summary.IsActive || itemSaving)" /><span>@Text["ItemCapConsume"]</span></label>
                                </div>
                            </div>
                            <label class="perm-check">
                                <input type="checkbox" @bind="editRequiresLotTracking" disabled="@(!selectedItem.Summary.IsActive || itemSaving)" />
                                <span>@Text["ItemRequiresLotTrackingLabel"]</span>
                            </label>
                            <div class="read-field">
                                <label for="edit-item-qc">@Text["ItemQcModeLabel"]</label>
                                <select id="edit-item-qc" @bind="editQualityControlMode" disabled="@(!selectedItem.Summary.IsActive || itemSaving)">
                                    <option value="@QualityControlMode.None">@Text["ItemQcModeNone"]</option>
                                    <option value="@QualityControlMode.IncomingReceipts">@Text["ItemQcModeIncoming"]</option>
                                    <option value="@QualityControlMode.ProductionReceipts">@Text["ItemQcModeProduction"]</option>
                                    <option value="@QualityControlMode.AllReceipts">@Text["ItemQcModeAll"]</option>
                                </select>
                            </div>

                            @if (itemConfirmToggle is null)
                            {
                                <div class="write-actions">
                                    @if (selectedItem.Summary.IsActive)
                                    {
                                        <BitButton Size="BitSize.Small" IsEnabled="@(!itemSaving)" OnClick="SubmitUpdateItemAsync">@Text["WriteSave"]</BitButton>
                                        <BitButton Variant="BitVariant.Outline" Size="BitSize.Small" IsEnabled="@(!itemSaving)" OnClick="() => itemConfirmToggle = false">@Text["WriteDeactivate"]</BitButton>
                                    }
                                    else
                                    {
                                        <BitButton Variant="BitVariant.Outline" Size="BitSize.Small" IsEnabled="@(!itemSaving)" OnClick="() => itemConfirmToggle = true">@Text["WriteActivate"]</BitButton>
                                    }
                                </div>
                            }
                            else
                            {
                                <div class="write-confirm" role="alertdialog" aria-labelledby="item-toggle-text">
                                    <p id="item-toggle-text">@Text[itemConfirmToggle.Value ? "WriteConfirmActivate" : "WriteConfirmDeactivate", selectedItem.Summary.Name]</p>
                                    <div class="write-actions">
                                        <BitButton Size="BitSize.Small" IsEnabled="@(!itemSaving)" OnClick="ExecuteItemToggleAsync">@Text["WriteConfirm"]</BitButton>
                                        <BitButton Variant="BitVariant.Outline" Size="BitSize.Small" IsEnabled="@(!itemSaving)" OnClick="() => itemConfirmToggle = null">@Text["WriteCancel"]</BitButton>
                                    </div>
                                </div>
                            }
                        </form>
                    }
                }
                else if (itemModalTab == 1)
                {
                    @if (!itemEditMode)
                    {
                        @if (selectedItem.Classifications.Count == 0)
                        {
                            <p class="read-empty">@Text["ReadEmpty"]</p>
                        }
                        else
                        {
                            <div class="audit-fields-box">
                                <table class="audit-fields-table">
                                    <thead>
                                        <tr>
                                            <th>@Text["ClassificationSetLabel"]</th>
                                            <th>@Text["ReadCode"]</th>
                                            <th>@Text["ReadName"]</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var cls in selectedItem.Classifications)
                                        {
                                            <tr>
                                                <td>@cls.ClassificationSetName</td>
                                                <td><bdi dir="ltr">@cls.Code</bdi></td>
                                                <td>@cls.Name</td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }
                    }
                    else
                    {
                        <div class="write-panel">
                            @foreach (var setGroup in activeClassifications.GroupBy(c => new { c.ClassificationSetId, c.ClassificationSetName }))
                            {
                                <div class="perm-group">
                                    <div class="perm-group-header"><span>@setGroup.Key.ClassificationSetName</span></div>
                                    <div class="perm-grid">
                                        @foreach (var cls in setGroup)
                                        {
                                            var isChecked = editItemClassIds.Contains(cls.Id);
                                            <label class="perm-check">
                                                <input type="checkbox" checked="@isChecked"
                                                       disabled="@(!selectedItem.Summary.IsActive || itemSaving)"
                                                       @onchange="e => ToggleItemClassification(cls, e.Value is bool b && b)" />
                                                <span>@cls.Name</span>
                                            </label>
                                        }
                                    </div>
                                </div>
                            }
                            <div class="write-actions">
                                <BitButton Size="BitSize.Small" IsEnabled="@(selectedItem.Summary.IsActive && !itemSaving)"
                                           OnClick="SubmitItemClassificationsAsync">@Text["WriteSave"]</BitButton>
                            </div>
                        </div>
                    }
                }
                else if (itemModalTab == 2)
                {
                    <div class="write-panel">
                        @if (selectedItem.Conversions.Count == 0)
                        {
                            <p class="read-empty">@Text["ReadEmpty"]</p>
                        }
                        else
                        {
                            <div class="audit-fields-box">
                                <table class="audit-fields-table">
                                    <thead>
                                        <tr>
                                            <th>@Text["UnitConversionRelationLabel"]</th>
                                            <th>@Text["ReadStatus"]</th>
                                            @if (itemEditMode) { <th>@Text["ReadActions"]</th> }
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var conv in selectedItem.Conversions)
                                        {
                                            <tr>
                                                <td><bdi dir="ltr">1 @conv.FromUnitSymbol = @conv.Factor.ToString("0.######", CultureInfo.InvariantCulture) @conv.ToUnitSymbol</bdi></td>
                                                <td>
                                                    <span class="read-badge @(conv.IsActive ? "active" : "inactive")">
                                                        @Text[conv.IsActive ? "ReadActive" : "ReadInactiveStatus"]
                                                    </span>
                                                </td>
                                                @if (itemEditMode)
                                                {
                                                    <td>
                                                        <BitButton Variant="BitVariant.Outline" Size="BitSize.Small" IsEnabled="@(!itemSaving)"
                                                                   OnClick="() => ToggleItemConversionActiveAsync(conv)">
                                                            @Text[conv.IsActive ? "WriteDeactivate" : "WriteActivate"]
                                                        </BitButton>
                                                    </td>
                                                }
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }

                        @if (itemEditMode && selectedItem.Summary.IsActive)
                        {
                            <div class="item-sub-card">
                                <p class="write-section-title">@Text["UnitConversionCreateTitle"]</p>
                                <div class="read-field">
                                    <label for="item-conv-from">@Text["UnitConversionFromLabel"]</label>
                                    <select id="item-conv-from" @bind="newItemConvFromId" disabled="@itemSaving">
                                        @foreach (var u in activeUnits) { <option value="@u.Id">@u.Code — @u.Name</option> }
                                    </select>
                                </div>
                                <div class="read-field">
                                    <label for="item-conv-to">@Text["UnitConversionToLabel"]</label>
                                    <select id="item-conv-to" @bind="newItemConvToId" disabled="@itemSaving">
                                        @foreach (var u in activeUnits) { <option value="@u.Id">@u.Code — @u.Name</option> }
                                    </select>
                                </div>
                                <div class="read-field">
                                    <label for="item-conv-factor">@Text["UnitConversionFactorLabel"]</label>
                                    <input id="item-conv-factor" type="number" step="0.000001" min="0.000001" @bind="newItemConvFactorText" disabled="@itemSaving" />
                                </div>
                                <div class="write-actions">
                                    <BitButton Size="BitSize.Small" IsEnabled="@(!itemSaving)" OnClick="SubmitCreateItemConversionAsync">@Text["CreateSubmit"]</BitButton>
                                </div>
                            </div>
                        }

                        <div class="item-sub-card">
                            <p class="write-section-title">@Text["UnitConverterTitle"]</p>
                            <div class="read-field">
                                <label for="item-calc-qty">@Text["UnitConverterQuantityLabel"]</label>
                                <input id="item-calc-qty" type="number" step="0.000001" min="0.000001" @bind="itemCalcQtyText" />
                            </div>
                            <div class="read-field">
                                <label for="item-calc-from">@Text["UnitConversionFromLabel"]</label>
                                <select id="item-calc-from" @bind="itemCalcFromId">
                                    @foreach (var u in activeUnits) { <option value="@u.Id">@u.Code — @u.Name</option> }
                                </select>
                            </div>
                            <div class="read-field">
                                <label for="item-calc-to">@Text["UnitConversionToLabel"]</label>
                                <select id="item-calc-to" @bind="itemCalcToId">
                                    @foreach (var u in activeUnits) { <option value="@u.Id">@u.Code — @u.Name</option> }
                                </select>
                            </div>
                            <div class="write-actions">
                                <BitButton Variant="BitVariant.Outline" Size="BitSize.Small" OnClick="CalculateItemConversionAsync">@Text["UnitConverterCalculate"]</BitButton>
                            </div>
                            @if (itemCalcResult is not null)
                            {
                                <div class="converter-result-card" role="status">
                                    <span class="converter-formula">@FormatItemCalcEquation()</span>
                                    <span class="converter-meta">@Text["UnitConverterHops", itemCalcResult.Hops, itemCalcResult.EffectiveFactor.ToString("0.######", CultureInfo.InvariantCulture)]</span>
                                </div>
                            }
                        </div>
                    </div>
                }
                else
                {
                    @if (selectedItem.Attributes.Count == 0)
                    {
                        <p class="read-empty">@Text["ReadEmpty"]</p>
                    }
                    else if (!itemEditMode)
                    {
                        <div class="audit-fields-box">
                            <table class="audit-fields-table">
                                <thead>
                                    <tr>
                                        <th>@Text["ReadName"]</th>
                                        <th>@Text["AuditFieldValueColumn"]</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var attr in selectedItem.Attributes)
                                    {
                                        <tr>
                                            <td>@attr.Name</td>
                                            <td>@FormatAttrDisplay(attr)</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <div class="write-panel">
                            @foreach (var attr in selectedItem.Attributes)
                            {
                                var val = editAttrInputs.TryGetValue(attr.AttributeDefinitionId, out var entry)
                                    ? entry
                                    : new AttrEditModel();
                                <div class="read-field">
                                    <label>@attr.Name @(attr.UnitSymbol is not null ? $"({attr.UnitSymbol})" : "")</label>
                                    @if (attr.DataType == AttributeDataType.Boolean)
                                    {
                                        <select value="@val.BoolText" @onchange="e => val.BoolText = e.Value?.ToString() ?? string.Empty"
                                                disabled="@(!selectedItem.Summary.IsActive || itemSaving)">
                                            <option value="">—</option>
                                            <option value="true">@Text["AttributeBoolTrue"]</option>
                                            <option value="false">@Text["AttributeBoolFalse"]</option>
                                        </select>
                                    }
                                    else if (attr.DataType == AttributeDataType.Decimal)
                                    {
                                        <input type="number" step="0.000001" value="@val.DecimalText"
                                               @onchange="e => val.DecimalText = e.Value?.ToString() ?? string.Empty"
                                               disabled="@(!selectedItem.Summary.IsActive || itemSaving)" />
                                    }
                                    else
                                    {
                                        <input maxlength="400" value="@val.Text"
                                               @oninput="e => val.Text = e.Value?.ToString() ?? string.Empty"
                                               disabled="@(!selectedItem.Summary.IsActive || itemSaving)" />
                                    }
                                </div>
                            }
                            <div class="write-actions">
                                <BitButton Size="BitSize.Small" IsEnabled="@(selectedItem.Summary.IsActive && !itemSaving)"
                                           OnClick="SubmitItemAttributesAsync">@Text["WriteSave"]</BitButton>
                            </div>
                        </div>
                    }
                }

                @if (itemSaving) { <p role="status">@Text["WriteSaving"]</p> }
                @if (itemSaved) { <p role="status" class="write-saved">@Text["WriteSaved"]</p> }
                @if (itemError is not null)
                {
                    <p role="alert" class="write-error">@Text[itemError]</p>
                    @if (itemError is "WriteConflict" or "WriteOutcomeUnknown")
                    {
                        <div class="write-actions">
                            <BitButton Variant="BitVariant.Outline" Size="BitSize.Small" OnClick="ReloadSelectedItemAsync">@Text["WriteReload"]</BitButton>
                        </div>
                    }
                }
            </div>
        }
    </Body>
</BitDialog>

