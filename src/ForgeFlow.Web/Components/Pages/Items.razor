    private long newItemConvFromId, newItemConvToId;
    private string newItemConvFactorText = "1";
    private long itemCalcFromId, itemCalcToId;
    private string itemCalcQtyText = "1";
    private UnitConversionPreviewResult? itemCalcResult;
    private readonly Dictionary<long, AttrEditModel> editAttrInputs = [];

    private bool createSetOpen, createSetAllowMultiple, createClsOpen, clsModalOpen, clsEditMode, clsSaving, clsSaved;
    private string createSetCode = string.Empty, createSetName = string.Empty;
    private long createClsSetId;
    private string createClsParentIdText = string.Empty, createClsCode = string.Empty, createClsName = string.Empty;
    private ClassificationSummary? selectedClassification;
    private string editClsName = string.Empty, editClsParentIdText = string.Empty;
    private string? clsError;

    private bool createAttrOpen, createAttrRequired, attrModalOpen, attrEditMode, attrSaving, attrSaved, editAttrRequired;
    private string createAttrCode = string.Empty, createAttrName = string.Empty, createAttrUnitIdText = string.Empty;
    private AttributeDataType createAttrDataType = AttributeDataType.Text;
    private AttributeDefinitionSummary? selectedAttr;
    private string editAttrName = string.Empty, editAttrUnitIdText = string.Empty;
    private string? attrError;

    private OrganizationScope? CurrentScope => scopeIndex >= 0 && scopeIndex < available.Count ? available[scopeIndex] : null;
    private long CurrentOrgId => CurrentScope switch
    {
        OrganizationScope.Organization o => o.OrganizationId,
        OrganizationScope.Site s => s.OrganizationId,
        _ => 0
    };

    private BitDataGridStrings GridStrings => new()
    {
        GridLabel = Text["Items"],
        EmptyText = Text["ReadEmpty"],
        NoMatchesText = Text["ReadEmpty"],
        LoadingText = Text["ReadLoading"],
        PagerRangeFormat = Text["GridPagerRange"],
        PagerPageFormat = Text["GridPagerPage"],
        PerPageFormat = Text["GridPerPage"],
        RowsPerPageLabel = Text["GridRowsPerPage"],
        FirstPageLabel = Text["GridFirstPage"],
        PreviousPageLabel = Text["GridPreviousPage"],
        NextPageLabel = Text["GridNextPage"],
        LastPageLabel = Text["GridLastPage"],
        AnnouncementPage = Text["GridPagerPage"]
    };

    protected override async Task OnParametersSetAsync() => await LoadAllAsync();

    private async Task LoadAllAsync()
    {
        initialLoading = true;
        pageError = null;
        pageNotice = null;
        try
        {
            available = await Scopes.LoadItemScopesAsync();
            scopeLabels = await Scopes.LoadDisplayInfoAsync(available);
        }
        catch when (OrganizationId is long requestedOrgId)
        {
            available = [new OrganizationScope.Organization(requestedOrgId)];
        }
        catch
        {
            pageError = "ReadError";
            initialLoading = false;
            return;
        }

        if (available.Count == 0)
        {
            if (OrganizationId is long requestedOrgId)
            {
                available = [new OrganizationScope.Organization(requestedOrgId)];
                scopeIndex = 0;
            }
            else
            {
                pageError = "ReadDenied";
                initialLoading = false;
                return;
            }
        }
        else if (OrganizationId is long orgId)
        {
            var idx = -1;
            for (var i = 0; i < available.Count; i++)
            {
                var scopeOrg = available[i] switch
                {
                    OrganizationScope.Organization o => o.OrganizationId,
                    OrganizationScope.Site s => s.OrganizationId,
                    _ => 0
                };
                if (scopeOrg == orgId) { idx = i; break; }
            }
            if (idx >= 0) scopeIndex = idx;
            else
            {
                available = [new OrganizationScope.Organization(orgId)];
                scopeIndex = 0;
            }
        }
        else
        {
            scopeIndex = Math.Clamp(scopeIndex, 0, available.Count - 1);
        }

        await RefreshScopeContextAsync();
        initialLoading = false;
    }

    private async Task RefreshScopeContextAsync()
    {
        scopeCanManage = false;
        activeUnits = [];
        classificationSets = [];
        activeClassifications = [];
        if (CurrentScope is null || CurrentOrgId <= 0) return;

        var actor = await Actors.ResolveAsync(default);
        if (actor is not null && CurrentScope is OrganizationScope.Organization orgScope)
            scopeCanManage = (await Permissions.EvaluateAsync(actor, orgScope, ItemPermissions.ItemsManage, default)).IsAllowed;

        var probe = await ItemService.ListItems(CurrentScope, CurrentOrgId, new ItemListQuery(Page: 1, PageSize: 1));
        if (!probe.Succeeded)
        {
            pageError = RolePermissionLocalization.FailureKey(probe.Error!.Code);
            return;
        }

        var unitRes = await UnitService.ListActiveUnits(CurrentScope, CurrentOrgId);
        if (unitRes.Succeeded && unitRes.Value is not null)
        {
            activeUnits = unitRes.Value.ToList();
            if (createItemBaseUnitId == 0 && activeUnits.Count > 0) createItemBaseUnitId = activeUnits[0].Id;
            if (newItemConvFromId == 0 && activeUnits.Count > 0) newItemConvFromId = activeUnits[0].Id;
            if (newItemConvToId == 0 && activeUnits.Count > 1) newItemConvToId = activeUnits[1].Id;
            if (itemCalcFromId == 0 && activeUnits.Count > 0) itemCalcFromId = activeUnits[0].Id;
            if (itemCalcToId == 0 && activeUnits.Count > 1) itemCalcToId = activeUnits[1].Id;
        }

        var setRes = await ItemService.ListClassificationSets(CurrentScope, CurrentOrgId, includeInactive: false);
        if (setRes.Succeeded && setRes.Value is not null)
        {
            classificationSets = setRes.Value.ToList();
            if (createClsSetId == 0 && classificationSets.Count > 0) createClsSetId = classificationSets[0].Id;
        }

        var clsRes = await ItemService.ListActiveClassifications(CurrentScope, CurrentOrgId);
        if (clsRes.Succeeded && clsRes.Value is not null)
            activeClassifications = clsRes.Value.ToList();
    }

    private Task ReloadScopeAsync() => LoadAllAsync();

    private async Task ChangeScopeAsync(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), NumberStyles.Integer, CultureInfo.InvariantCulture, out var idx) && idx >= 0 && idx < available.Count)
        {
            scopeIndex = idx;
            pageError = null;
            pageNotice = null;
            await RefreshScopeContextAsync();
            await RefreshActiveGridAsync();
        }
    }

    private async Task SwitchTabAsync(byte tab)
    {
        if (activeTab == tab) return;
        activeTab = tab;
        pageNotice = null;
        await RefreshActiveGridAsync();
    }

    private Task ChangeItemClassificationFilterAsync(ChangeEventArgs e)
    {
        itemClassificationFilter = e.Value?.ToString() ?? string.Empty;
        return RefreshActiveGridAsync();
    }

    private Task ChangeItemCapabilityFilterAsync(ChangeEventArgs e)
    {
        itemCapabilityFilter = e.Value?.ToString() ?? string.Empty;
        return RefreshActiveGridAsync();
    }

    private Task ChangeSetFilterAsync(ChangeEventArgs e)
    {
        classificationSetFilter = e.Value?.ToString() ?? string.Empty;
        return RefreshActiveGridAsync();
    }

    private Task ChangeAttrTypeFilterAsync(ChangeEventArgs e)
    {
        attributeTypeFilter = e.Value?.ToString() ?? string.Empty;
        return RefreshActiveGridAsync();
    }

    private Task ApplySearchAsync() => RefreshActiveGridAsync();

    private Task RefreshActiveGridAsync() => activeTab switch
    {
        TabItems => ReloadGrid(itemsGrid),
        TabClassifications => ReloadGrid(classificationsGrid),
        _ => ReloadGrid(attributesGrid)
    };

    private static async Task ReloadGrid<T>(BitDataGrid<T>? grid) where T : class
    {
        if (grid is null) return;
        if (grid.CurrentPage <= 1) await grid.RefreshAsync();
        else await grid.GoToPageAsync(1);
    }

    private async Task<BitDataGridReadResult<ItemSummary>> ReadItemsGridAsync(BitDataGridReadRequest req)
    {
        if (CurrentScope is null || CurrentOrgId <= 0) return new([], 0);
        long? clsId = long.TryParse(itemClassificationFilter, NumberStyles.Integer, CultureInfo.InvariantCulture, out var cid) && cid > 0 ? cid : null;
        var pageSize = Math.Clamp(req.Take ?? 25, 1, 100);
        var page = (req.Skip / pageSize) + 1;
        var query = new ItemListQuery(
            search,
            clsId,
            itemCapabilityFilter == "purchase" ? true : null,
            itemCapabilityFilter == "manufacture" ? true : null,
            itemCapabilityFilter == "sell" ? true : null,
            itemCapabilityFilter == "consume" ? true : null,
            includeInactive,
            page,
            pageSize);

        var res = await ItemService.ListItems(CurrentScope, CurrentOrgId, query, req.CancellationToken);
        return res.Succeeded && res.Value is not null ? new(res.Value.Items.ToList(), res.Value.Total) : new([], 0);
    }

    private async Task<BitDataGridReadResult<ClassificationSummary>> ReadClassificationsGridAsync(BitDataGridReadRequest req)
    {
        if (CurrentScope is null || CurrentOrgId <= 0) return new([], 0);
        long? setId = long.TryParse(classificationSetFilter, NumberStyles.Integer, CultureInfo.InvariantCulture, out var sid) && sid > 0 ? sid : null;
        var pageSize = Math.Clamp(req.Take ?? 25, 1, 100);
        var page = (req.Skip / pageSize) + 1;
        var res = await ItemService.ListClassifications(CurrentScope, CurrentOrgId, new ClassificationListQuery(setId, search, includeInactive, page, pageSize), req.CancellationToken);
        return res.Succeeded && res.Value is not null ? new(res.Value.Items.ToList(), res.Value.Total) : new([], 0);
    }

    private async Task<BitDataGridReadResult<AttributeDefinitionSummary>> ReadAttributesGridAsync(BitDataGridReadRequest req)
    {
        if (CurrentScope is null || CurrentOrgId <= 0) return new([], 0);
        AttributeDataType? dt = byte.TryParse(attributeTypeFilter, NumberStyles.Integer, CultureInfo.InvariantCulture, out var raw)
            && Enum.IsDefined(typeof(AttributeDataType), raw)
            ? (AttributeDataType)raw
            : null;
        var pageSize = Math.Clamp(req.Take ?? 25, 1, 100);
        var page = (req.Skip / pageSize) + 1;
        var res = await ItemService.ListAttributeDefinitions(CurrentScope, CurrentOrgId, new AttributeDefinitionListQuery(search, dt, includeInactive, page, pageSize), req.CancellationToken);
        return res.Succeeded && res.Value is not null ? new(res.Value.Items.ToList(), res.Value.Total) : new([], 0);
    }

    private void OpenCreateItem()
    {
        createItemCode = string.Empty;
        createItemName = string.Empty;
        createItemDescription = string.Empty;
        if (activeUnits.Count > 0 && createItemBaseUnitId == 0) createItemBaseUnitId = activeUnits[0].Id;
        createCapPurchase = true;
        createCapManufacture = createCapSell = createCapConsume = createRequiresLotTracking = false;
        createQualityControlMode = QualityControlMode.None;
        itemError = null;
        createItemDiscardConfirm = false;
        createItemOpen = true;
    }

    private async Task SubmitCreateItemAsync()
    {
        if (CurrentScope is null || CurrentOrgId <= 0 || itemSaving) return;
        itemSaving = true;
        itemError = null;
        try
        {
            var res = await ItemService.CreateItem(CurrentScope, new CreateItemRequest(
                CurrentOrgId, createItemCode, createItemName, createItemDescription, createItemBaseUnitId,
                createCapPurchase, createCapManufacture, createCapSell, createCapConsume,
                createRequiresLotTracking, createQualityControlMode));
            if (!res.Succeeded || res.Value is null)
            {
                itemError = RolePermissionLocalization.FailureKey(res.Error!.Code);
                return;
            }
            createItemOpen = false;
            pageNotice = Text["ItemCreatedSucceeded", res.Value.Summary.Code];
            await RefreshActiveGridAsync();
        }
        finally { itemSaving = false; }
    }

    private async Task OpenItemModal(long id, bool edit)
    {
        if (CurrentScope is null || CurrentOrgId <= 0) return;
        itemSaving = false;
        itemSaved = false;
        itemError = null;
        itemConfirmToggle = null;
        itemCalcResult = null;
        itemModalTab = 0;

        var res = await ItemService.GetItem(CurrentScope, CurrentOrgId, id);
        if (!res.Succeeded || res.Value is null)
        {
            pageError = res.Succeeded ? "ReadNotFound" : RolePermissionLocalization.FailureKey(res.Error!.Code);
            return;
        }

        ApplySelectedItem(res.Value);
        itemEditMode = edit && scopeCanManage;
        itemModalOpen = true;
    }

    private void ApplySelectedItem(ItemDetails details)
    {
        selectedItem = details;
        editItemName = details.Summary.Name;
        editItemDescription = details.Summary.Description ?? string.Empty;
        editItemBaseUnitId = details.Summary.BaseUnitId;
        editCapPurchase = details.Summary.CanBePurchased;
        editCapManufacture = details.Summary.CanBeManufactured;
        editCapSell = details.Summary.CanBeSold;
        editCapConsume = details.Summary.CanBeConsumed;
        editRequiresLotTracking = details.Summary.RequiresLotTracking;
        editQualityControlMode = details.Summary.QualityControlMode;
        editItemClassIds.Clear();
        foreach (var c in details.Classifications) editItemClassIds.Add(c.ClassificationId);

        editAttrInputs.Clear();
        foreach (var a in details.Attributes)
        {
            editAttrInputs[a.AttributeDefinitionId] = new AttrEditModel
            {
                Text = a.TextValue ?? string.Empty,
                DecimalText = a.DecimalValue?.ToString("0.######", CultureInfo.InvariantCulture) ?? string.Empty,
                BoolText = a.BooleanValue switch { true => "true", false => "false", _ => string.Empty }
            };
        }
    }

    private async Task ReloadSelectedItemAsync()
    {
        if (selectedItem is not null) await OpenItemModal(selectedItem.Summary.Id, itemEditMode);
    }

    private async Task SubmitUpdateItemAsync()
    {
        if (CurrentScope is null || selectedItem is null || itemSaving) return;
        itemSaving = true;
        itemSaved = false;
        itemError = null;
        try
        {
            var res = await ItemService.UpdateItem(CurrentScope, new UpdateItemRequest(
                selectedItem.Summary.OrganizationId, selectedItem.Summary.Id, editItemName, editItemDescription, editItemBaseUnitId,
                editCapPurchase, editCapManufacture, editCapSell, editCapConsume, selectedItem.Summary.RowVersion,
                editRequiresLotTracking, editQualityControlMode));
            if (!res.Succeeded || res.Value is null) { itemError = RolePermissionLocalization.FailureKey(res.Error!.Code); return; }
            ApplySelectedItem(res.Value);
            itemSaved = true;
            await RefreshActiveGridAsync();
        }
        finally { itemSaving = false; }
    }

    private async Task ExecuteItemToggleAsync()
    {
        if (CurrentScope is null || selectedItem is null || itemConfirmToggle is not bool target || itemSaving) return;
        itemSaving = true;
        itemSaved = false;
        itemError = null;
        try
        {
            var res = await ItemService.SetItemActive(CurrentScope, new SetItemActiveRequest(
                selectedItem.Summary.OrganizationId, selectedItem.Summary.Id, target, selectedItem.Summary.RowVersion));
            if (!res.Succeeded || res.Value is null) { itemConfirmToggle = null; itemError = RolePermissionLocalization.FailureKey(res.Error!.Code); return; }
            ApplySelectedItem(res.Value);
            itemConfirmToggle = null;
            itemSaved = true;
            await RefreshActiveGridAsync();
        }
        finally { itemSaving = false; }
    }

    private void ToggleItemClassification(ClassificationSummary cls, bool isChecked)
    {
        itemSaved = false;
        if (isChecked)
        {
            var setInfo = classificationSets.FirstOrDefault(s => s.Id == cls.ClassificationSetId);
            if (setInfo is not null && !setInfo.AllowMultiple)
            {
                var sameSetIds = activeClassifications.Where(x => x.ClassificationSetId == cls.ClassificationSetId).Select(x => x.Id).ToArray();
                foreach (var id in sameSetIds) editItemClassIds.Remove(id);
            }
            editItemClassIds.Add(cls.Id);
        }
        else
        {
            editItemClassIds.Remove(cls.Id);
        }
    }

    private async Task SubmitItemClassificationsAsync()
    {
        if (CurrentScope is null || selectedItem is null || itemSaving) return;
        itemSaving = true;
        itemSaved = false;
        itemError = null;
        try
        {
            var res = await ItemService.SaveItemClassifications(CurrentScope, new SaveItemClassificationsRequest(
                selectedItem.Summary.OrganizationId, selectedItem.Summary.Id, editItemClassIds.ToArray(), selectedItem.Summary.RowVersion));
            if (!res.Succeeded || res.Value is null) { itemError = RolePermissionLocalization.FailureKey(res.Error!.Code); return; }
            ApplySelectedItem(res.Value);
            itemSaved = true;
        }
        finally { itemSaving = false; }
    }

    private async Task SubmitCreateItemConversionAsync()
    {
        if (CurrentScope is null || selectedItem is null || itemSaving) return;
        if (!decimal.TryParse(newItemConvFactorText.Trim(), NumberStyles.Number, CultureInfo.InvariantCulture, out var factor) || factor <= 0m)
        {
            itemError = RolePermissionLocalization.FailureKey(ForgeFlow.Domain.Units.UnitErrors.ConversionFactorInvalid);
            return;
        }
        itemSaving = true;
        itemSaved = false;
        itemError = null;
        try
        {
            var res = await ItemService.CreateItemConversion(CurrentScope, new CreateItemUnitConversionRequest(
                selectedItem.Summary.OrganizationId, selectedItem.Summary.Id, newItemConvFromId, newItemConvToId, factor));
            if (!res.Succeeded || res.Value is null) { itemError = RolePermissionLocalization.FailureKey(res.Error!.Code); return; }
            ApplySelectedItem(res.Value);
            itemSaved = true;
        }
        finally { itemSaving = false; }
    }

    private async Task ToggleItemConversionActiveAsync(ItemUnitConversionSummary conv)
    {
        if (CurrentScope is null || selectedItem is null || itemSaving) return;
        itemSaving = true;
        itemSaved = false;
        itemError = null;
        try
        {
            var res = await ItemService.SetItemConversionActive(CurrentScope, new SetItemUnitConversionActiveRequest(
                conv.OrganizationId, conv.ItemId, conv.Id, !conv.IsActive, conv.RowVersion));
            if (!res.Succeeded || res.Value is null) { itemError = RolePermissionLocalization.FailureKey(res.Error!.Code); return; }
            ApplySelectedItem(res.Value);
            itemSaved = true;
        }
        finally { itemSaving = false; }
    }

    private async Task CalculateItemConversionAsync()
    {
        if (CurrentScope is null || selectedItem is null) return;
        itemError = null;
        itemCalcResult = null;
        if (!decimal.TryParse(itemCalcQtyText.Trim(), NumberStyles.Number, CultureInfo.InvariantCulture, out var qty) || qty <= 0m)
        {
            itemError = RolePermissionLocalization.FailureKey(ForgeFlow.Domain.Units.UnitErrors.ConversionQuantityInvalid);
            return;
        }
        var res = await ItemService.PreviewItemConversion(CurrentScope, new ConvertItemQuantityRequest(
            selectedItem.Summary.OrganizationId, selectedItem.Summary.Id, itemCalcFromId, itemCalcToId, qty));
        if (!res.Succeeded || res.Value is null)
        {
            itemError = RolePermissionLocalization.FailureKey(res.Error!.Code);
            return;
        }
        itemCalcResult = res.Value;
    }

    private async Task SubmitItemAttributesAsync()
    {
        if (CurrentScope is null || selectedItem is null || itemSaving) return;
        itemSaving = true;
        itemSaved = false;
        itemError = null;
        try
        {
            var inputs = new List<ItemAttributeValueInput>();
            foreach (var attr in selectedItem.Attributes)
            {
                if (!editAttrInputs.TryGetValue(attr.AttributeDefinitionId, out var model)) continue;
                decimal? decVal = null;
                if (attr.DataType == AttributeDataType.Decimal && !string.IsNullOrWhiteSpace(model.DecimalText))
                {
                    if (!decimal.TryParse(model.DecimalText.Trim(), NumberStyles.Number, CultureInfo.InvariantCulture, out var parsedDec))
                    {
                        itemError = "ItemErrorAttributeValueInvalid";
                        return;
                    }
                    decVal = parsedDec;
                }
                bool? boolVal = attr.DataType == AttributeDataType.Boolean && bool.TryParse(model.BoolText, out var b) ? b : null;
                inputs.Add(new ItemAttributeValueInput(
                    attr.AttributeDefinitionId,
                    attr.DataType == AttributeDataType.Text ? model.Text : null,
                    decVal,
                    boolVal));
            }
            var res = await ItemService.SaveItemAttributeValues(CurrentScope, new SaveItemAttributeValuesRequest(
                selectedItem.Summary.OrganizationId, selectedItem.Summary.Id, inputs, selectedItem.Summary.RowVersion));
            if (!res.Succeeded || res.Value is null) { itemError = RolePermissionLocalization.FailureKey(res.Error!.Code); return; }
            ApplySelectedItem(res.Value);
            itemSaved = true;
        }
        finally { itemSaving = false; }
    }

    private void OpenCreateSet()
    {
        createSetCode = string.Empty;
        createSetName = string.Empty;
        createSetAllowMultiple = false;
        clsError = null;
        createSetOpen = true;
