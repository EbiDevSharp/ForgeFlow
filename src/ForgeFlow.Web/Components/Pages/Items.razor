                            </div>
                        }
                        <label class="perm-check"><input type="checkbox" @bind="editAttrRequired" disabled="@(!selectedAttr.IsActive || attrSaving)" /><span>@Text["AttributeRequiredLabel"]</span></label>
                        <div class="write-actions">
                            @if (selectedAttr.IsActive)
                            {
                                <BitButton Size="BitSize.Small" IsEnabled="@(!attrSaving)" OnClick="SubmitUpdateAttributeAsync">@Text["WriteSave"]</BitButton>
                                <BitButton Variant="BitVariant.Outline" Size="BitSize.Small" IsEnabled="@(!attrSaving)" OnClick="() => ToggleAttributeActiveAsync(false)">@Text["WriteDeactivate"]</BitButton>
                            }
                            else
                            {
                                <BitButton Variant="BitVariant.Outline" Size="BitSize.Small" IsEnabled="@(!attrSaving)" OnClick="() => ToggleAttributeActiveAsync(true)">@Text["WriteActivate"]</BitButton>
                            }
                        </div>
                        @if (attrSaved) { <p role="status" class="write-saved">@Text["WriteSaved"]</p> }
                        @if (attrError is not null) { <p role="alert" class="write-error">@Text[attrError]</p> }
                    </form>
                }
            </div>
        }
    </Body>
</BitDialog>

@code {
