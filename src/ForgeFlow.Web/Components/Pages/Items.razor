    private void OnCreateItemDismissing(BitDialogDismissArgs args)
    {
        if (itemSaving) return;
        if (string.IsNullOrWhiteSpace(createItemCode) && string.IsNullOrWhiteSpace(createItemName) && string.IsNullOrWhiteSpace(createItemDescription))
            return;
        args.Cancel = true;
        createItemDiscardConfirm = true;
    }

    private void ConfirmCreateItemDiscard()
    {
        createItemDiscardConfirm = false;
        createItemOpen = false;
    }

    private string FormatAttrDisplay(ItemAttributeValueSummary attr) => attr.DataType switch
    {
        AttributeDataType.Text => attr.TextValue ?? "—",
        AttributeDataType.Decimal => attr.DecimalValue.HasValue
            ? $"{attr.DecimalValue.Value.ToString("0.######", CultureInfo.InvariantCulture)} {attr.UnitSymbol ?? string.Empty}".Trim()
            : "—",
        AttributeDataType.Boolean => attr.BooleanValue switch
        {
            true => Text["AttributeBoolTrue"],
            false => Text["AttributeBoolFalse"],
            _ => "—"
        },
        _ => "—"
    };

    private string FormatItemCalcEquation()
    {
        if (itemCalcResult is null) return string.Empty;
        var fromSym = activeUnits.FirstOrDefault(u => u.Id == itemCalcResult.FromUnitId)?.Symbol ?? "#";
        var toSym = activeUnits.FirstOrDefault(u => u.Id == itemCalcResult.ToUnitId)?.Symbol ?? "#";
        return $"{itemCalcResult.InputQuantity.ToString("0.######", CultureInfo.InvariantCulture)} {fromSym} = {itemCalcResult.ConvertedQuantity.ToString("0.######", CultureInfo.InvariantCulture)} {toSym}";
    }

    private static string DataTypeResourceKey(AttributeDataType dataType) => dataType switch
    {
        AttributeDataType.Text => "AttributeDataTypeText",
        AttributeDataType.Decimal => "AttributeDataTypeDecimal",
        AttributeDataType.Boolean => "AttributeDataTypeBoolean",
        _ => "AttributeDataTypeText"
    };

    private string QcModeLabel(QualityControlMode mode) => mode switch
    {
        QualityControlMode.IncomingReceipts => Text["ItemQcModeIncoming"],
        QualityControlMode.ProductionReceipts => Text["ItemQcModeProduction"],
        QualityControlMode.AllReceipts => Text["ItemQcModeAll"],
        _ => Text["ItemQcModeNone"]
    };

    private string ScopeLabel(OrganizationScope scope) => scope switch
    {
        OrganizationScope.Organization o when scopeLabels.TryGetValue(scope, out var info) && info.OrgCode is not null
            => $"{info.OrgCode} — {info.OrgName}",
        OrganizationScope.Organization o => Text["ReadOrganizationScope", o.OrganizationId],
        OrganizationScope.Site s when scopeLabels.TryGetValue(scope, out var info) && info.SiteCode is not null
            => $"{info.OrgCode} / {info.SiteCode} — {info.SiteName}",
        OrganizationScope.Site s => Text["ReadSiteScope", s.OrganizationId, s.SiteId],
        _ => string.Empty
    };
}
