            createSetOpen = false;
            await RefreshScopeContextAsync();
            await RefreshActiveGridAsync();
        }
        finally { clsSaving = false; }
    }

    private void OpenCreateClassification()
    {
        createClsCode = string.Empty;
        createClsName = string.Empty;
        createClsParentIdText = string.Empty;
        if (createClsSetId == 0 && classificationSets.Count > 0) createClsSetId = classificationSets[0].Id;
        clsError = null;
        createClsOpen = true;
    }

    private async Task SubmitCreateClassificationAsync()
    {
        if (CurrentScope is null || CurrentOrgId <= 0 || clsSaving) return;
        long? parentId = long.TryParse(createClsParentIdText, NumberStyles.Integer, CultureInfo.InvariantCulture, out var pid) && pid > 0 ? pid : null;
        clsSaving = true;
        clsError = null;
        try
        {
            var res = await ItemService.CreateClassification(CurrentScope, new CreateClassificationRequest(
                CurrentOrgId, createClsSetId, parentId, createClsCode, createClsName));
            if (!res.Succeeded) { clsError = RolePermissionLocalization.FailureKey(res.Error!.Code); return; }
            createClsOpen = false;
            await RefreshScopeContextAsync();
