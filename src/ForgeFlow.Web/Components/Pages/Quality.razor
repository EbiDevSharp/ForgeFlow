@page "/quality"
@page "/organizations/{OrganizationId:long}/quality"
@using ForgeFlow.Application.Inventory
@using ForgeFlow.Application.Items
@using ForgeFlow.Application.Organizations
@using ForgeFlow.Application.ProductionOrders
@using ForgeFlow.Application.Quality
@using ForgeFlow.Application.Units
@using ForgeFlow.Domain.Quality
@using ForgeFlow.Web.Components.Pages.QualitySections
@using ForgeFlow.Web.Roles
@using System.Globalization
@inject QualityUseCases QualityService
@inject QualitySpecUseCases SpecService
@inject InventoryUseCases InvService
@inject ProductionOrderUseCases OrderService
@inject ItemUseCases ItemService
@inject UnitUseCases UnitService
@inject DocumentSequenceUseCases SeqService
@inject ForgeFlow.Web.Organizations.ReadScopes Scopes
@inject ITrustedActorAccessor Actors
@inject IOrganizationPermissionEvaluator Permissions
@inject CulturePolicy Culture
@inject DisplayFormatter Format
@inject IStringLocalizer<SharedResources> Text

<PageTitle>@Text["QualityControl"] - @Text["AppTitle"]</PageTitle>

<section class="organization-reader" aria-labelledby="qc-title">
    <div class="read-page-head">
        <div>
            <h1 id="qc-title">@Text["QualityControl"]</h1>
            <p class="write-hint">@Text["QualityCaption"]</p>
        </div>
        @if (!initialLoading && pageError is null && available.Count > 0 && scopeCanManage)
        {
            <div class="read-head-actions">
                @if (activeTab == TabInspections)
                {
                    <BitButton Size="BitSize.Small" OnClick="OpenHoldModalAsync">@Text["QcCreateHoldBtn"]</BitButton>
                }
                else if (activeTab == TabLots)
                {
                    <BitButton Size="BitSize.Small" OnClick="() => OpenLotModal(null)">@Text["QcLotUpsertBtn"]</BitButton>
                }
                else if (activeTab == TabParameters)
                {
                    <BitButton Size="BitSize.Small" OnClick="() => OpenParameterModal(null)">@Text["QcCreateParameterBtn"]</BitButton>
                }
                else if (activeTab == TabSpecs)
                {
                    <BitButton Size="BitSize.Small" OnClick="() => OpenSpecModalAsync(null)">@Text["QcCreateSpecBtn"]</BitButton>
                }
            </div>
        }
    </div>

    @if (pageNotice is not null)
    {
        <p role="status" class="read-page-notice write-saved">@pageNotice</p>
    }

    @if (initialLoading)
    {
        <p role="status" aria-live="polite">@Text["ReadLoading"]</p>
    }
    else if (pageError is not null)
    {
        <div class="read-state" role="alert">
            <p>@Text[pageError]</p>
            <BitButton Variant="BitVariant.Outline" Size="BitSize.Small" OnClick="ReloadScopeAsync">@Text["WriteReload"]</BitButton>
        </div>
    }
    else if (available.Count == 0)
    {
        <p role="status" class="read-empty">@Text["ReadDenied"]</p>
    }
    else
    {
        <div class="read-tab-bar" role="tablist" aria-label="@Text["QualityControl"]">
            <button type="button" role="tab" aria-selected="@(activeTab == TabInspections)"
                    class="read-tab-btn @(activeTab == TabInspections ? "active" : string.Empty)"
                    @onclick="() => SwitchTabAsync(TabInspections)">@Text["QcTabInspections"]</button>
            <button type="button" role="tab" aria-selected="@(activeTab == TabSpecs)"
                    class="read-tab-btn @(activeTab == TabSpecs ? "active" : string.Empty)"
                    @onclick="() => SwitchTabAsync(TabSpecs)">@Text["QcTabSpecs"]</button>
            <button type="button" role="tab" aria-selected="@(activeTab == TabParameters)"
                    class="read-tab-btn @(activeTab == TabParameters ? "active" : string.Empty)"
                    @onclick="() => SwitchTabAsync(TabParameters)">@Text["QcTabParameters"]</button>
            <button type="button" role="tab" aria-selected="@(activeTab == TabLots)"
                    class="read-tab-btn @(activeTab == TabLots ? "active" : string.Empty)"
                    @onclick="() => SwitchTabAsync(TabLots)">@Text["QcTabLots"]</button>
        </div>

        <div class="read-toolbar-card">
            @if (available.Count > 1)
            {
                <div class="read-field">
                    <label for="qc-scope">@Text["ReadScope"]</label>
                    <select id="qc-scope" aria-label="@Text["ReadScope"]" value="@scopeIndex" @onchange="ChangeScopeAsync">
                        @for (var i = 0; i < available.Count; i++)
                        {
                            <option value="@i">@ScopeLabel(available[i])</option>
                        }
                    </select>
                </div>
            }

            @if (activeTab == TabInspections && CurrentScope is OrganizationScope.Organization && authorizedSites.Count > 1)
            {
                <div class="read-field">
                    <label for="qc-site-filter">@Text["PoSiteColumn"]</label>
                    <select id="qc-site-filter" value="@siteFilter" @onchange="ChangeSiteFilterAsync">
                        <option value="0">@Text["PoAllSitesOption"]</option>
                        @foreach (var s in authorizedSites)
                        {
                            <option value="@s.Id">@s.Code — @s.Name</option>
                        }
                    </select>
                </div>
            }

            @if (activeTab == TabInspections)
            {
                <div class="read-field">
                    <label for="qc-status-filter">@Text["ReadStatus"]</label>
                    <select id="qc-status-filter" value="@statusFilter" @onchange="ChangeStatusFilterAsync">
                        <option value="">@Text["PoAllStatusesOption"]</option>
                        <option value="@((byte)QualityInspectionStatus.Pending)">@StatusLabel(QualityInspectionStatus.Pending)</option>
                        <option value="@((byte)QualityInspectionStatus.InReview)">@StatusLabel(QualityInspectionStatus.InReview)</option>
                        <option value="@((byte)QualityInspectionStatus.Completed)">@StatusLabel(QualityInspectionStatus.Completed)</option>
                        <option value="@((byte)QualityInspectionStatus.Cancelled)">@StatusLabel(QualityInspectionStatus.Cancelled)</option>
                    </select>
                </div>
            }
            else if (activeTab == TabLots)
            {
                <label class="read-inactive">
                    <input type="checkbox" checked="@onlyExpiringLots" @onchange="ToggleExpiringLotsAsync" />
                    <span>@Text["QcOnlyExpiringLabel"]</span>
                </label>
            }
            else if (activeTab == TabParameters)
            {
                <label class="read-inactive">
                    <input type="checkbox" checked="@includeInactiveParams" @onchange="ToggleInactiveParamsAsync" />
                    <span>@Text["ReadInactive"]</span>
                </label>
            }
            else if (activeTab == TabSpecs)
            {
                <div class="read-field">
                    <label for="qc-spec-target-filter">@Text["QcSpecTargetKindLabel"]</label>
                    <select id="qc-spec-target-filter" value="@specTargetFilter" @onchange="ChangeSpecTargetFilterAsync">
                        <option value="">@Text["PoAllStatusesOption"]</option>
                        <option value="@((byte)QualitySpecTargetKind.Item)">@Text["QcTargetItem"]</option>
                        <option value="@((byte)QualitySpecTargetKind.Classification)">@Text["QcTargetClassification"]</option>
                    </select>
                </div>
                <div class="read-field">
                    <label for="qc-spec-ckpt-filter">@Text["QcSpecCheckpointLabel"]</label>
                    <select id="qc-spec-ckpt-filter" value="@specCheckpointFilter" @onchange="ChangeSpecCheckpointFilterAsync">
                        <option value="">@Text["PoAllStatusesOption"]</option>
                        <option value="@((byte)QualitySpecCheckpoint.Incoming)">@Text["QcCheckpointIncoming"]</option>
                        <option value="@((byte)QualitySpecCheckpoint.Production)">@Text["QcCheckpointProduction"]</option>
                        <option value="@((byte)QualitySpecCheckpoint.All)">@Text["QcCheckpointAll"]</option>
                    </select>
                </div>
                <label class="read-inactive">
                    <input type="checkbox" checked="@includeInactiveSpecs" @onchange="ToggleInactiveSpecsAsync" />
                    <span>@Text["ReadInactive"]</span>
                </label>
            }

            <div class="read-field">
                <label for="qc-search">@Text["ReadSearch"]</label>
                <input id="qc-search" type="search" @bind="search" @bind:after="ApplySearchAsync" maxlength="64" placeholder="@Text["ReadSearchPlaceholder"]" />
            </div>
        </div>

        @if (activeTab == TabInspections)
        {
            <InspectionGrid @ref="inspGrid"
                            OnRead="ReadInspectionsAsync"
                            PageSizeOptions="@PageSizeOptions"
                            GridStrings="@GridStrings"
                            SourceLabel="SourceLabel"
                            StatusBadgeClass="StatusBadgeClass"
                            StatusLabel="StatusLabel"
                            OnOpenDetails="OpenInspectionDetailsAsync"
                            OnOpenCoa="args => OpenCoaModal(args.ItemId, args.LotCode)" />
        }
        else if (activeTab == TabLots)
        {
            <div class="read-grid-card">
                <div class="read-grid">
                    <BitDataGrid @ref="lotGrid" TItem="ItemLotSummary" OnRead="ReadLotsAsync" Pageable="true" PageSize="25"
                                 PageSizeOptions="@PageSizeOptions" Strings="@GridStrings" SelectionMode="BitSelectionMode.Single"
                                 AriaLabelledBy="qc-title" WrapCellText="true" Resizable="true">
                        <EmptyTemplate><p role="status" class="read-empty">@Text["ReadEmpty"]</p></EmptyTemplate>
                        <Columns>
                            <BitDataGridColumn TItem="ItemLotSummary" Title="@Text["BomLineItemColumn"]">
                                <Template Context="l"><span dir="ltr">@l.ItemCode</span> — @l.ItemName</Template>
                            </BitDataGridColumn>
                            <BitDataGridColumn TItem="ItemLotSummary" Title="@Text["InvLotCodeLabel"]">
                                <Template Context="l">
                                    <a class="qc-lot-link" href="@($"/traceability?itemId={l.ItemId}&lotCode={Uri.EscapeDataString(l.LotCode)}")" dir="ltr">@l.LotCode</a>
                                </Template>
                            </BitDataGridColumn>
                            <BitDataGridColumn TItem="ItemLotSummary" Title="@Text["QcLotMfgDateLabel"]">
                                <Template Context="l"><bdi dir="ltr">@(l.ManufactureDate?.ToString("yyyy-MM-dd") ?? "—")</bdi></Template>
                            </BitDataGridColumn>
                            <BitDataGridColumn TItem="ItemLotSummary" Title="@Text["QcLotExpDateLabel"]">
                                <Template Context="l">
                                    @if (l.ExpirationDate.HasValue)
                                    {
                                        <span class="read-badge @(l.IsExpired ? "rpt-shortage-badge" : l.IsExpiringSoon ? "qc-status-pending" : "qc-status-completed")">
                                            <bdi dir="ltr">@l.ExpirationDate.Value.ToString("yyyy-MM-dd")</bdi>
                                        </span>
                                    }
                                    else
                                    {
                                        <span>—</span>
                                    }
                                </Template>
                            </BitDataGridColumn>
                            <BitDataGridColumn TItem="ItemLotSummary" Title="@Text["PoNotesLabel"]">
                                <Template Context="l">@(l.Notes ?? "—")</Template>
                            </BitDataGridColumn>
                            <BitDataGridColumn TItem="ItemLotSummary" Title="@Text["ReadActions"]">
                                <Template Context="l">
                                    <div class="read-row-actions">
                                        <BitButton Variant="BitVariant.Outline" Size="BitSize.Small" OnClick="() => OpenCoaModal(l.ItemId, l.LotCode)">
                                            @Text["QcCoaBtn"]
                                        </BitButton>
                                        @if (scopeCanManage)
                                        {
                                            <BitTooltip Text="@Text["ReadEdit"]" ShowOnFocus="true">
                                                <BitButton Variant="BitVariant.Outline" Size="BitSize.Small" Class="read-detail-action"
                                                           Icon="@EditIcon" IconOnly="true" aria-label="@Text["ReadEdit"]"
                                                           OnClick="() => OpenLotModal(l)" />
                                            </BitTooltip>
                                        }
                                    </div>
                                </Template>
                            </BitDataGridColumn>
                        </Columns>
                    </BitDataGrid>
                </div>
            </div>
        }
        else if (activeTab == TabParameters)
        {
            <div class="read-grid-card">
                <div class="read-grid">
                    <BitDataGrid @ref="paramGrid" TItem="QualityParameterSummary" OnRead="ReadParametersAsync" Pageable="true" PageSize="25"
                                 PageSizeOptions="@PageSizeOptions" Strings="@GridStrings" SelectionMode="BitSelectionMode.Single"
                                 AriaLabelledBy="qc-title" WrapCellText="true" Resizable="true">
                        <EmptyTemplate><p role="status" class="read-empty">@Text["ReadEmpty"]</p></EmptyTemplate>
                        <Columns>
                            <BitDataGridColumn TItem="QualityParameterSummary" Title="@Text["ReadCode"]">
                                <Template Context="p"><bdi dir="ltr">@p.Code</bdi></Template>
                            </BitDataGridColumn>
                            <BitDataGridColumn TItem="QualityParameterSummary" Title="@Text["QcParamSymbolLabel"]">
                                <Template Context="p"><span class="qc-symbol-chip" dir="ltr">@p.Symbol</span></Template>
                            </BitDataGridColumn>
                            <BitDataGridColumn TItem="QualityParameterSummary" Title="@Text["ReadName"]">
                                <Template Context="p">@p.Name</Template>
                            </BitDataGridColumn>
                            <BitDataGridColumn TItem="QualityParameterSummary" Title="@Text["QcParamUnitLabel"]">
                                <Template Context="p"><span dir="ltr">@(p.UnitSymbol ?? "—")</span></Template>
                            </BitDataGridColumn>
                            <BitDataGridColumn TItem="QualityParameterSummary" Title="@Text["AttributeDataTypeLabel"]">
                                <Template Context="p">
                                    <span>@ParamDataTypeLabel(p.DataType)</span>
                                    @if (p.DataType == QualityParameterDataType.Numeric)
                                    {
                                        <span class="read-sub-cell" dir="ltr"> (@p.DecimalPlaces)</span>
                                    }
                                </Template>
                            </BitDataGridColumn>
                            <BitDataGridColumn TItem="QualityParameterSummary" Title="@Text["QcParamMethodLabel"]">
                                <Template Context="p"><span dir="ltr">@(p.DefaultTestMethod ?? "—")</span></Template>
                            </BitDataGridColumn>
                            <BitDataGridColumn TItem="QualityParameterSummary" Title="@Text["ReadStatus"]">
                                <Template Context="p">
                                    <span class="read-badge @(p.IsActive ? "active" : "inactive")">
                                        @Text[p.IsActive ? "ReadActive" : "ReadInactiveStatus"]
                                    </span>
                                </Template>
                            </BitDataGridColumn>
                            <BitDataGridColumn TItem="QualityParameterSummary" Title="@Text["ReadActions"]">
                                <Template Context="p">
                                    @if (scopeCanManage)
                                    {
                                        <div class="read-row-actions">
                                            <BitTooltip Text="@Text["ReadEdit"]" ShowOnFocus="true">
                                                <BitButton Variant="BitVariant.Outline" Size="BitSize.Small" Class="read-detail-action"
                                                           Icon="@EditIcon" IconOnly="true" aria-label="@Text["ReadEdit"]"
                                                           OnClick="() => OpenParameterModal(p)" />
                                            </BitTooltip>
                                            @{
                                                var paramToggleLabel = Text[p.IsActive ? "WriteDeactivate" : "WriteActivate"];
                                            }
                                            <BitTooltip Text="@paramToggleLabel" ShowOnFocus="true">
                                                <BitButton Variant="BitVariant.Outline" Size="BitSize.Small" IsEnabled="@(!modalBusy)"
                                                           Class="@($"read-detail-action {(p.IsActive ? "read-action-deactivate" : "read-action-activate")}")"
                                                           Icon="@(p.IsActive ? DeactivateIcon : ActivateIcon)" IconOnly="true"
                                                           aria-label="@paramToggleLabel"
                                                           OnClick="() => ToggleParameterActiveAsync(p)" />
                                            </BitTooltip>
                                        </div>
                                    }
                                </Template>
                            </BitDataGridColumn>
                        </Columns>
                    </BitDataGrid>
                </div>
            </div>
        }
        else if (activeTab == TabSpecs)
        {
            <div class="read-grid-card">
                <div class="read-grid">
                    <BitDataGrid @ref="specGrid" TItem="QualitySpecSummary" OnRead="ReadSpecsAsync" Pageable="true" PageSize="25"
                                 PageSizeOptions="@PageSizeOptions" Strings="@GridStrings" SelectionMode="BitSelectionMode.Single"
                                 AriaLabelledBy="qc-title" WrapCellText="true" Resizable="true">
                        <EmptyTemplate><p role="status" class="read-empty">@Text["ReadEmpty"]</p></EmptyTemplate>
                        <Columns>
                            <BitDataGridColumn TItem="QualitySpecSummary" Title="@Text["ReadCode"]">
                                <Template Context="s">
                                    <div>
                                        <div class="read-primary-cell"><bdi dir="ltr">@s.Code</bdi></div>
                                        <div class="read-sub-cell" dir="ltr">v@(s.Version)</div>
                                    </div>
                                </Template>
                            </BitDataGridColumn>
                            <BitDataGridColumn TItem="QualitySpecSummary" Title="@Text["ReadName"]">
                                <Template Context="s">@s.Name</Template>
                            </BitDataGridColumn>
                            <BitDataGridColumn TItem="QualitySpecSummary" Title="@Text["QcSpecTargetLabel"]">
                                <Template Context="s">
                                    <div>
                                        <div class="read-primary-cell">
                                            @if (s.TargetKind == QualitySpecTargetKind.Item)
                                            {
                                                <span dir="ltr">@s.ItemCode</span> <span>— @s.ItemName</span>
                                            }
                                            else
                                            {
                                                <span dir="ltr">@s.ClassificationCode</span> <span>— @s.ClassificationName</span>
                                            }
                                        </div>
                                        <div class="read-sub-cell">@TargetKindLabel(s.TargetKind)</div>
                                    </div>
                                </Template>
                            </BitDataGridColumn>
                            <BitDataGridColumn TItem="QualitySpecSummary" Title="@Text["QcSpecCheckpointLabel"]">
                                <Template Context="s"><span class="cap-badge">@CheckpointLabel(s.Checkpoint)</span></Template>
                            </BitDataGridColumn>
                            <BitDataGridColumn TItem="QualitySpecSummary" Title="@Text["QcSpecLinesCountCol"]">
                                <Template Context="s"><span dir="ltr">@s.LineCount</span></Template>
                            </BitDataGridColumn>
                            <BitDataGridColumn TItem="QualitySpecSummary" Title="@Text["ReadStatus"]">
                                <Template Context="s">
                                    <span class="read-badge @(s.IsActive ? "active" : "inactive")">
                                        @Text[s.IsActive ? "ReadActive" : "ReadInactiveStatus"]
                                    </span>
                                </Template>
                            </BitDataGridColumn>
                            <BitDataGridColumn TItem="QualitySpecSummary" Title="@Text["ReadActions"]">
                                <Template Context="s">
                                    <div class="read-row-actions">
                                        <BitTooltip Text="@Text[scopeCanManage ? "ReadEdit" : "ReadDetails"]" ShowOnFocus="true">
                                            <BitButton Variant="BitVariant.Outline" Size="BitSize.Small" Class="read-detail-action"
                                                       Icon="@(scopeCanManage ? EditIcon : BitIconInfo.Css("ff-icon ff-icon--eye"))" IconOnly="true"
                                                       aria-label="@Text[scopeCanManage ? "ReadEdit" : "ReadDetails"]"
                                                       OnClick="() => OpenSpecModalAsync(s.Id)" />
                                        </BitTooltip>
                                        @if (scopeCanManage)
                                        {
                                            var specToggleLabel = Text[s.IsActive ? "WriteDeactivate" : "WriteActivate"];
                                            <BitTooltip Text="@specToggleLabel" ShowOnFocus="true">
                                                <BitButton Variant="BitVariant.Outline" Size="BitSize.Small" IsEnabled="@(!modalBusy)"
                                                           Class="@($"read-detail-action {(s.IsActive ? "read-action-deactivate" : "read-action-activate")}")"
                                                           Icon="@(s.IsActive ? DeactivateIcon : ActivateIcon)" IconOnly="true"
                                                           aria-label="@specToggleLabel"
                                                           OnClick="() => ToggleSpecActiveAsync(s)" />
                                            </BitTooltip>
                                        }
                                    </div>
                                </Template>
                            </BitDataGridColumn>
                        </Columns>
                    </BitDataGrid>
                </div>
            </div>
        }
    }

    <QualityHoldModal @ref="holdModal"
                      @bind-IsOpen="holdModalOpen"
                      DialogClasses="@DialogClasses"
                      CurrentScope="@CurrentScope"
                      CurrentOrgId="@(ScopeOrganizationId(CurrentScope))"
                      ActiveWarehouses="@activeWarehouses"
                      ActiveItems="@activeItems"
                      ActiveUnits="@activeUnits"
                      OnHoldCreated="OnHoldCreatedAsync" />

    <QualityInspectionDetailsModal @ref="detailsModal"
                                  @bind-IsOpen="detailsOpen"
                                  DialogClasses="@DialogClasses"
                                  CurrentScope="@CurrentScope"
                                  CurrentOrgId="@(ScopeOrganizationId(CurrentScope))"
                                  ActiveParameters="@activeParameters"
                                  CanManage="@scopeCanManage"
                                  StatusBadgeClass="StatusBadgeClass"
                                  StatusLabel="StatusLabel"
                                  OnInspectionChanged="OnInspectionChangedAsync"
                                  OnOpenCoa="OpenCoaModalFromTuple" />

    <QualityLotModal @ref="lotModal"
                     @bind-IsOpen="lotModalOpen"
                     DialogClasses="@DialogClasses"
                     CurrentScope="@CurrentScope"
                     CurrentOrgId="@(ScopeOrganizationId(CurrentScope))"
                     ActiveItems="@activeItems"
                     OnSaved="OnLotSavedAsync" />

    <ForgeFormDialog IsOpen="@paramModalOpen" IsOpenChanged="v => paramModalOpen = v" Width="640px"
                     Title="@Text[editingParam is null ? "QcCreateParameterTitle" : "QcEditParameterTitle"]"
                     Subtitle="@Text["QcParamModalSubtitle"]" CloseTitle="@Text["ReadClose"]">
        <ChildContent>
            @if (paramError is not null)
            {
                <p role="alert" class="write-error">@Text[paramError]</p>
            }
            <div class="po-form-grid">
                <div class="write-field">
                    <label for="qc-param-code">@Text["ReadCode"]</label>
                    <input id="qc-param-code" type="text" maxlength="32" @bind="paramCode" disabled="@(editingParam is not null || modalBusy)" placeholder="MFI" />
                </div>
                <div class="write-field">
                    <label for="qc-param-symbol">@Text["QcParamSymbolLabel"]</label>
                    <input id="qc-param-symbol" type="text" maxlength="24" @bind="paramSymbol" disabled="@modalBusy" placeholder="MFI" />
                </div>
                <div class="write-field po-field-full">
                    <label for="qc-param-name">@Text["ReadName"]</label>
                    <input id="qc-param-name" type="text" maxlength="120" @bind="paramName" disabled="@modalBusy" placeholder="Melt Flow Index" />
                </div>
                <div class="write-field">
                    <label for="qc-param-unit">@Text["QcParamUnitLabel"]</label>
                    <input id="qc-param-unit" type="text" maxlength="24" @bind="paramUnitSymbol" disabled="@modalBusy" placeholder="g/10min" />
                </div>
                <div class="write-field">
                    <label for="qc-param-type">@Text["AttributeDataTypeLabel"]</label>
                    <select id="qc-param-type" @bind="paramDataType" disabled="@(editingParam is not null || modalBusy)">
                        <option value="@QualityParameterDataType.Numeric">@ParamDataTypeLabel(QualityParameterDataType.Numeric)</option>
                        <option value="@QualityParameterDataType.Text">@ParamDataTypeLabel(QualityParameterDataType.Text)</option>
                        <option value="@QualityParameterDataType.Boolean">@ParamDataTypeLabel(QualityParameterDataType.Boolean)</option>
                    </select>
                </div>
                @if (paramDataType == QualityParameterDataType.Numeric)
                {
                    <div class="write-field">
                        <label for="qc-param-dec">@Text["QcParamDecimalLabel"]</label>
                        <input id="qc-param-dec" type="number" min="0" max="6" @bind="paramDecimalPlaces" disabled="@modalBusy" />
                    </div>
                }
                <div class="write-field @(paramDataType == QualityParameterDataType.Numeric ? string.Empty : "po-field-full")">
                    <label for="qc-param-method">@Text["QcParamMethodLabel"]</label>
                    <input id="qc-param-method" type="text" maxlength="64" @bind="paramTestMethod" disabled="@modalBusy" placeholder="ASTM D1238" />
                </div>
            </div>
        </ChildContent>
        <FooterActions>
            <BitButton IsEnabled="@(!modalBusy && !string.IsNullOrWhiteSpace(paramCode) && !string.IsNullOrWhiteSpace(paramName) && !string.IsNullOrWhiteSpace(paramSymbol))"
                       OnClick="SubmitParameterAsync">@Text["WriteSave"]</BitButton>
            <BitButton Variant="BitVariant.Outline" OnClick="() => paramModalOpen = false">@Text["WriteCancel"]</BitButton>
        </FooterActions>
    </ForgeFormDialog>

    <ForgeFormDialog IsOpen="@specModalOpen" IsOpenChanged="v => specModalOpen = v" Width="920px"
                     Title="@Text[editingSpec is null ? "QcCreateSpecTitle" : "QcEditSpecTitle"]"
                     Subtitle="@Text["QcSpecModalSubtitle"]" CloseTitle="@Text["ReadClose"]">
        <ChildContent>
            @if (specError is not null)
            {
                <p role="alert" class="write-error">@Text[specError]</p>
            }
            <div class="po-form-grid">
                <div class="write-field">
                    <label for="qc-spec-code">@Text["ReadCode"]</label>
                    <input id="qc-spec-code" type="text" maxlength="32" @bind="specCode" disabled="@(editingSpec is not null || !scopeCanManage || modalBusy)" placeholder="SPEC-STYRENE-IN" />
                </div>
                <div class="write-field">
                    <label for="qc-spec-ver">@Text["QcSpecVersionLabel"]</label>
                    <input id="qc-spec-ver" type="number" min="1" @bind="specVersion" disabled="@(editingSpec is not null || !scopeCanManage || modalBusy)" />
                </div>
                <div class="write-field po-field-full">
                    <label for="qc-spec-name">@Text["ReadName"]</label>
                    <input id="qc-spec-name" type="text" maxlength="120" @bind="specName" disabled="@(!scopeCanManage || modalBusy)" />
                </div>
                <div class="write-field">
                    <label for="qc-spec-tkind">@Text["QcSpecTargetKindLabel"]</label>
                    <select id="qc-spec-tkind" @bind="specTargetKind" disabled="@(editingSpec is not null || !scopeCanManage || modalBusy)">
                        <option value="@QualitySpecTargetKind.Item">@Text["QcTargetItem"]</option>
                        <option value="@QualitySpecTargetKind.Classification">@Text["QcTargetClassification"]</option>
                    </select>
                </div>
                @if (specTargetKind == QualitySpecTargetKind.Item)
                {
                    <div class="write-field">
                        <label for="qc-spec-item">@Text["BomLineItemColumn"]</label>
                        <select id="qc-spec-item" @bind="specTargetItemId" disabled="@(editingSpec is not null || !scopeCanManage || modalBusy)">
                            <option value="0">@Text["InvSelectItemOption"]</option>
                            @foreach (var it in activeItems)
                            {
                                <option value="@it.Id">@it.Code — @it.Name</option>
                            }
                        </select>
                    </div>
                }
                else
                {
                    <div class="write-field">
                        <label for="qc-spec-cls">@Text["QcTargetClassification"]</label>
                        <select id="qc-spec-cls" @bind="specTargetClassId" disabled="@(editingSpec is not null || !scopeCanManage || modalBusy)">
                            <option value="0">—</option>
                            @foreach (var cls in activeClassifications)
                            {
                                <option value="@cls.Id">@cls.ClassificationSetName: @cls.Code — @cls.Name</option>
                            }
                        </select>
                    </div>
                }
                <div class="write-field">
                    <label for="qc-spec-ckpt">@Text["QcSpecCheckpointLabel"]</label>
                    <select id="qc-spec-ckpt" @bind="specCheckpoint" disabled="@(!scopeCanManage || modalBusy)">
                        <option value="@QualitySpecCheckpoint.Incoming">@Text["QcCheckpointIncoming"]</option>
                        <option value="@QualitySpecCheckpoint.Production">@Text["QcCheckpointProduction"]</option>
                        <option value="@QualitySpecCheckpoint.All">@Text["QcCheckpointAll"]</option>
                    </select>
                </div>
                <div class="write-field">
                    <label for="qc-spec-notes">@Text["PoNotesLabel"]</label>
                    <input id="qc-spec-notes" type="text" maxlength="1000" @bind="specNotes" disabled="@(!scopeCanManage || modalBusy)" />
                </div>
            </div>

            <div class="po-context-card qc-spec-lines-box">
                <div class="po-context-head">
                    <strong>@Text["QcSpecLinesHeading"]</strong>
                    @if (scopeCanManage)
                    {
                        <BitButton Variant="BitVariant.Outline" Size="BitSize.Small" Icon="@PlusIcon" OnClick="AddSpecLine">
                            @Text["QcAddSpecLineBtn"]
                        </BitButton>
                    }
                </div>
                @foreach (var sl in specLines)
                {
                    var selectedP = activeParameters.FirstOrDefault(p => p.Id == sl.QualityParameterId);
                    <div class="qc-spec-line-row">
                        <select value="@sl.QualityParameterId" @onchange="e => OnSpecLineParamChanged(sl, e)" disabled="@(!scopeCanManage || modalBusy)">
                            <option value="0">—</option>
                            @foreach (var p in activeParameters)
                            {
                                <option value="@p.Id">@p.Code — @p.Name (@p.Symbol@(string.IsNullOrWhiteSpace(p.UnitSymbol) ? string.Empty : $", {p.UnitSymbol}"))</option>
                            }
                        </select>
                        @if (selectedP is null || selectedP.DataType == QualityParameterDataType.Numeric)
                        {
                            <input type="number" step="any" @bind="sl.MinValue" placeholder="@Text["QcSpecMinLabel"]" disabled="@(!scopeCanManage || modalBusy)" />
                            <input type="number" step="any" @bind="sl.MaxValue" placeholder="@Text["QcSpecMaxLabel"]" disabled="@(!scopeCanManage || modalBusy)" />
                            <input type="number" step="any" @bind="sl.TargetValue" placeholder="@Text["QcSpecTargetValLabel"]" disabled="@(!scopeCanManage || modalBusy)" />
                        }
                        else
                        {
                            <input type="text" maxlength="100" @bind="sl.ExpectedTextSpec" placeholder="@Text["QcExpectedSpecPlaceholder"]" disabled="@(!scopeCanManage || modalBusy)" />
                        }
                        <label class="perm-check">
                            <input type="checkbox" @bind="sl.IsMandatory" disabled="@(!scopeCanManage || modalBusy)" />
                            <span>@Text["QcMandatoryLabel"]</span>
                        </label>
                        @if (scopeCanManage)
                        {
                            <BitButton Variant="BitVariant.Outline" Size="BitSize.Small" OnClick="() => specLines.Remove(sl)">@Text["BomRemoveRowBtn"]</BitButton>
                        }
                    </div>
                }
            </div>
        </ChildContent>
        <FooterActions>
            @if (scopeCanManage)
            {
                <BitButton IsEnabled="@(!modalBusy && !string.IsNullOrWhiteSpace(specCode) && !string.IsNullOrWhiteSpace(specName) && specLines.Count > 0)"
                           OnClick="SubmitSpecAsync">@Text["WriteSave"]</BitButton>
            }
            <BitButton Variant="BitVariant.Outline" OnClick="() => specModalOpen = false">@Text[scopeCanManage ? "WriteCancel" : "ReadClose"]</BitButton>
        </FooterActions>
    </ForgeFormDialog>

    @if (CurrentScope is not null)
    {
        <LotCertificateDialog @bind-IsOpen="coaOpen" Scope="@CurrentScope" OrganizationId="@ScopeOrganizationId(CurrentScope)"
                              ItemId="@coaItemId" LotCode="@coaLotCode" />
    }
</section>

@code {
    [Parameter] public long? OrganizationId { get; set; }
    [SupplyParameterFromQuery(Name = "tab")] public string? TabQuery { get; set; }

    private const int TabInspections = 0;
    private const int TabSpecs = 1;
    private const int TabParameters = 2;
    private const int TabLots = 3;
    private static readonly int[] PageSizeOptions = [10, 25, 50, 100];
    private static readonly BitDialogClassStyles DialogClasses = new()
    {
        Container = "read-dialog",
        Header = "read-dialog-header",
        Body = "read-dialog-body",
        CloseButton = "read-dialog-close",
        Overlay = "read-dialog-overlay"
    };
    private static readonly BitIconInfo EditIcon = BitIconInfo.Css("ff-icon ff-icon--edit");
    private static readonly BitIconInfo DeactivateIcon = BitIconInfo.Css("ff-icon ff-icon--deactivate");
    private static readonly BitIconInfo ActivateIcon = BitIconInfo.Css("ff-icon ff-icon--activate");
    private static readonly BitIconInfo PlusIcon = BitIconInfo.Css("ff-icon ff-icon--plus");
    private static readonly BitIconInfo CalendarIcon = BitIconInfo.Css("ff-icon ff-icon--calendar");
    private static readonly BitIconInfo TodayIcon = BitIconInfo.Css("ff-icon ff-icon--today");
    private static readonly BitIconInfo NextNavIcon = BitIconInfo.Css("ff-icon ff-icon--chevron-next");
    private static readonly BitIconInfo PrevNavIcon = BitIconInfo.Css("ff-icon ff-icon--chevron-prev");
    private static readonly BitIconInfo NextYearIcon = BitIconInfo.Css("ff-icon ff-icon--chevrons-next");
    private static readonly BitIconInfo PrevYearIcon = BitIconInfo.Css("ff-icon ff-icon--chevrons-prev");
    private static readonly BitIconInfo CloseIcon = BitIconInfo.Css("ff-icon ff-icon--close");
    private string PickerDateFormat => Culture.Language == CulturePolicy.Persian ? "yyyy/MM/dd" : "yyyy-MM-dd";

    private InspectionGrid? inspGrid;
    private BitDataGrid<ItemLotSummary>? lotGrid;
    private BitDataGrid<QualityParameterSummary>? paramGrid;
    private BitDataGrid<QualitySpecSummary>? specGrid;

    private int activeTab = TabInspections;
    private bool initialLoading = true;
    private string? pageError;
    private string? pageNotice;
    private List<OrganizationScope> available = [];
    private IReadOnlyDictionary<OrganizationScope, ForgeFlow.Web.Organizations.ScopeDisplayInfo> scopeLabels =
        new Dictionary<OrganizationScope, ForgeFlow.Web.Organizations.ScopeDisplayInfo>();
    private int scopeIndex;
    private bool scopeCanManage;

    private IReadOnlyList<ProductionOrderSiteInfo> authorizedSites = [];
    private IReadOnlyList<WarehouseSummary> activeWarehouses = [];
    private IReadOnlyList<ItemSummary> activeItems = [];
    private IReadOnlyList<UnitSummary> activeUnits = [];
    private IReadOnlyList<ClassificationSummary> activeClassifications = [];
    private IReadOnlyList<QualityParameterSummary> activeParameters = [];

    private long siteFilter;
    private string statusFilter = string.Empty;
    private bool onlyExpiringLots;
    private bool includeInactiveParams;
    private bool includeInactiveSpecs;
    private string specTargetFilter = string.Empty;
    private string specCheckpointFilter = string.Empty;
    private string? search;
    private string? appliedSearch;
    private bool modalBusy;

    private QualityHoldModal? holdModal;
    private bool holdModalOpen;

    private QualityInspectionDetailsModal? detailsModal;
    private bool detailsOpen;

    private QualityLotModal? lotModal;
    private bool lotModalOpen;

    private bool coaOpen;
    private long coaItemId;
    private string coaLotCode = string.Empty;

    private bool paramModalOpen;
    private QualityParameterSummary? editingParam;
    private string? paramError;
    private string paramCode = string.Empty;
    private string paramName = string.Empty;
    private string paramSymbol = string.Empty;
    private string? paramUnitSymbol;
    private QualityParameterDataType paramDataType = QualityParameterDataType.Numeric;
    private byte paramDecimalPlaces = 2;
    private string? paramTestMethod;

    private bool specModalOpen;
    private QualitySpecSummary? editingSpec;
    private string? specError;
    private string specCode = string.Empty;
    private string specName = string.Empty;
    private int specVersion = 1;
    private QualitySpecTargetKind specTargetKind = QualitySpecTargetKind.Classification;
    private long specTargetItemId;
    private long specTargetClassId;
    private QualitySpecCheckpoint specCheckpoint = QualitySpecCheckpoint.Incoming;
    private string? specNotes;
    private readonly List<SpecLineEditRow> specLines = [];


    private sealed class SpecLineEditRow
    {
        public long QualityParameterId { get; set; }
        public decimal? MinValue { get; set; }
        public decimal? MaxValue { get; set; }
        public decimal? TargetValue { get; set; }
        public string? ExpectedTextSpec { get; set; }
        public bool IsMandatory { get; set; } = true;
        public string? Notes { get; set; }
    }

    private OrganizationScope? CurrentScope => scopeIndex >= 0 && scopeIndex < available.Count ? available[scopeIndex] : null;
    private static long ScopeOrganizationId(OrganizationScope? scope) => scope switch
    {
        OrganizationScope.Organization o => o.OrganizationId,
        OrganizationScope.Site s => s.OrganizationId,
        _ => 0
    };

    private BitDataGridStrings GridStrings => new()
    {
        GridLabel = Text["QualityControl"],
        EmptyText = Text["ReadEmpty"],
        NoMatchesText = Text["ReadEmpty"],
        LoadingText = Text["ReadLoading"],
        PagerRangeFormat = Text["GridPagerRange"],
        PagerPageFormat = Text["GridPagerPage"],
        PerPageFormat = Text["GridPerPage"],
        RowsPerPageLabel = Text["GridRowsPerPage"],
        FirstPageLabel = Text["GridFirstPage"],
        PreviousPageLabel = Text["GridPreviousPage"],
        NextPageLabel = Text["GridNextPage"],
        LastPageLabel = Text["GridLastPage"],
        AnnouncementPage = Text["GridPagerPage"]
    };

    protected override async Task OnParametersSetAsync()
    {
        if (!string.IsNullOrWhiteSpace(TabQuery))
        {
            var target = TabQuery.ToLowerInvariant() switch
            {
                "specs" or "spec" => TabSpecs,
                "parameters" or "params" => TabParameters,
                "lots" or "lot" => TabLots,
                _ => TabInspections
            };
            activeTab = target;
        }
        await ReloadScopeAsync();
    }

    private async Task ReloadScopeAsync()
    {
        initialLoading = true;
        pageError = null;
        pageNotice = null;
        try
        {
            var loaded = await Scopes.LoadQualityScopesAsync();
            available = OrganizationId is long orgId
                ? loaded.Where(s => ScopeOrganizationId(s) == orgId).ToList()
                : loaded.ToList();
            scopeLabels = await Scopes.LoadDisplayInfoAsync(available);
            if (available.Count == 0 && OrganizationId is long fallbackOrgId)
                available = [new OrganizationScope.Organization(fallbackOrgId)];
            scopeIndex = 0;
            await RefreshScopeStateAsync();
        }
        catch { pageError = "ReadError"; }
        finally { initialLoading = false; }
    }

    private async Task RefreshScopeStateAsync()
    {
        scopeCanManage = false;
        authorizedSites = [];
        activeWarehouses = [];
        activeItems = [];
        activeUnits = [];
        activeClassifications = [];
        activeParameters = [];
        var scope = CurrentScope;
        if (scope is null) return;

        var actor = await Actors.ResolveAsync(default);
        if (actor is not null)
            scopeCanManage = (await Permissions.EvaluateAsync(actor, scope, QualityPermissions.QualityManage, default)).IsAllowed;

        var orgId = ScopeOrganizationId(scope);
        var sitesRes = await OrderService.ListAuthorizedSites(scope, orgId);
        if (sitesRes.Succeeded) authorizedSites = sitesRes.Value!;
        var whRes = await InvService.ListWarehouses(scope, orgId, new WarehouseListQuery(IncludeInactive: false, PageSize: 100));
        if (whRes.Succeeded) activeWarehouses = whRes.Value!.Items;
        var itemsRes = await ItemService.ListActiveItems(scope, orgId);
        if (itemsRes.Succeeded) activeItems = itemsRes.Value!;
        var unitsRes = await UnitService.ListActiveUnits(scope, orgId);
        if (unitsRes.Succeeded) activeUnits = unitsRes.Value!;
        var clsRes = await ItemService.ListActiveClassifications(scope, orgId);
        if (clsRes.Succeeded) activeClassifications = clsRes.Value!;
        var paramRes = await SpecService.ListParameters(scope, orgId, new QualityParameterListQuery(IncludeInactive: false, PageSize: 100));
        if (paramRes.Succeeded) activeParameters = paramRes.Value!.Items;
    }

    private async Task SwitchTabAsync(int tab)
    {
        if (activeTab == tab) return;
        activeTab = tab;
        await ReloadActiveGridAsync(true);
    }

    private async Task ChangeScopeAsync(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out var idx) && idx >= 0 && idx < available.Count)
        {
            scopeIndex = idx;
            siteFilter = 0;
            await RefreshScopeStateAsync();
            await ReloadActiveGridAsync(true);
        }
    }

    private async Task ChangeSiteFilterAsync(ChangeEventArgs e)
    {
        siteFilter = long.TryParse(e.Value?.ToString(), out var id) ? id : 0;
        await ReloadActiveGridAsync(true);
    }

    private async Task ChangeStatusFilterAsync(ChangeEventArgs e)
    {
        statusFilter = e.Value?.ToString() ?? string.Empty;
        await ReloadActiveGridAsync(true);
    }

    private async Task ToggleExpiringLotsAsync(ChangeEventArgs e)
    {
        onlyExpiringLots = e.Value is bool b && b;
        await ReloadActiveGridAsync(true);
    }

    private async Task ToggleInactiveParamsAsync(ChangeEventArgs e)
    {
        includeInactiveParams = e.Value is bool b && b;
        await ReloadActiveGridAsync(true);
    }

    private async Task ToggleInactiveSpecsAsync(ChangeEventArgs e)
    {
        includeInactiveSpecs = e.Value is bool b && b;
        await ReloadActiveGridAsync(true);
    }

    private async Task ChangeSpecTargetFilterAsync(ChangeEventArgs e)
    {
        specTargetFilter = e.Value?.ToString() ?? string.Empty;
        await ReloadActiveGridAsync(true);
    }

    private async Task ChangeSpecCheckpointFilterAsync(ChangeEventArgs e)
    {
        specCheckpointFilter = e.Value?.ToString() ?? string.Empty;
        await ReloadActiveGridAsync(true);
    }

    private async Task ApplySearchAsync()
    {
        appliedSearch = string.IsNullOrWhiteSpace(search) ? null : search.Trim();
        await ReloadActiveGridAsync(true);
    }

    private async Task ReloadActiveGridAsync(bool fromFirstPage)
    {
        if (activeTab == TabInspections && inspGrid is not null)
            await inspGrid.RefreshAsync(fromFirstPage);
        else if (activeTab == TabLots && lotGrid is not null)
        {
            if (fromFirstPage && lotGrid.CurrentPage > 1) await lotGrid.GoToPageAsync(1);
            else await lotGrid.RefreshAsync();
        }
        else if (activeTab == TabParameters && paramGrid is not null)
        {
            if (fromFirstPage && paramGrid.CurrentPage > 1) await paramGrid.GoToPageAsync(1);
            else await paramGrid.RefreshAsync();
        }
        else if (activeTab == TabSpecs && specGrid is not null)
        {
            if (fromFirstPage && specGrid.CurrentPage > 1) await specGrid.GoToPageAsync(1);
            else await specGrid.RefreshAsync();
        }
    }

    private async Task<BitDataGridReadResult<QualityInspectionSummary>> ReadInspectionsAsync(BitDataGridReadRequest req)
    {
        var scope = CurrentScope;
        if (scope is null) return new([], 0);
        var size = Math.Clamp(req.Take ?? 25, 1, 100);
        var page = (req.Skip / size) + 1;
        QualityInspectionStatus? st = byte.TryParse(statusFilter, out var s) && Enum.IsDefined((QualityInspectionStatus)s)
            ? (QualityInspectionStatus)s
            : null;
        var res = await QualityService.ListInspections(scope, ScopeOrganizationId(scope),
            new QualityInspectionListQuery(siteFilter > 0 ? siteFilter : null, null, null, st, appliedSearch, page, size), req.CancellationToken);
        if (!res.Succeeded) { pageError = RolePermissionLocalization.FailureKey(res.Error!.Code); StateHasChanged(); return new([], 0); }
        return new(res.Value!.Items.ToList(), res.Value.Total);
    }

    private async Task<BitDataGridReadResult<ItemLotSummary>> ReadLotsAsync(BitDataGridReadRequest req)
    {
        var scope = CurrentScope;
        if (scope is null) return new([], 0);
        var size = Math.Clamp(req.Take ?? 25, 1, 100);
        var page = (req.Skip / size) + 1;
        var res = await QualityService.ListItemLots(scope, ScopeOrganizationId(scope),
            new ItemLotListQuery(null, appliedSearch, onlyExpiringLots, page, size), req.CancellationToken);
        if (!res.Succeeded) { pageError = RolePermissionLocalization.FailureKey(res.Error!.Code); StateHasChanged(); return new([], 0); }
        return new(res.Value!.Items.ToList(), res.Value.Total);
    }

    private async Task<BitDataGridReadResult<QualityParameterSummary>> ReadParametersAsync(BitDataGridReadRequest req)
    {
        var scope = CurrentScope;
        if (scope is null) return new([], 0);
        var size = Math.Clamp(req.Take ?? 25, 1, 100);
        var page = (req.Skip / size) + 1;
        var res = await SpecService.ListParameters(scope, ScopeOrganizationId(scope),
            new QualityParameterListQuery(includeInactiveParams, appliedSearch, page, size), req.CancellationToken);
        if (!res.Succeeded) { pageError = RolePermissionLocalization.FailureKey(res.Error!.Code); StateHasChanged(); return new([], 0); }
        return new(res.Value!.Items.ToList(), res.Value.Total);
    }

    private async Task<BitDataGridReadResult<QualitySpecSummary>> ReadSpecsAsync(BitDataGridReadRequest req)
    {
        var scope = CurrentScope;
        if (scope is null) return new([], 0);
        var size = Math.Clamp(req.Take ?? 25, 1, 100);
        var page = (req.Skip / size) + 1;
        QualitySpecTargetKind? targetKind = byte.TryParse(specTargetFilter, out var tk) && Enum.IsDefined((QualitySpecTargetKind)tk)
            ? (QualitySpecTargetKind)tk : null;
        QualitySpecCheckpoint? checkpoint = byte.TryParse(specCheckpointFilter, out var ck) && Enum.IsDefined((QualitySpecCheckpoint)ck)
            ? (QualitySpecCheckpoint)ck : null;
        var res = await SpecService.ListSpecs(scope, ScopeOrganizationId(scope),
            new QualitySpecListQuery(targetKind, checkpoint, includeInactiveSpecs, appliedSearch, page, size), req.CancellationToken);
        if (!res.Succeeded) { pageError = RolePermissionLocalization.FailureKey(res.Error!.Code); StateHasChanged(); return new([], 0); }
        return new(res.Value!.Items.ToList(), res.Value.Total);
    }

    private Task OpenHoldModalAsync()
    {
        holdModal?.Open();
        return Task.CompletedTask;
    }

    private async Task OnHoldCreatedAsync()
    {
        pageNotice = Text["QcHoldCreatedNotice"];
        await ReloadActiveGridAsync(true);
    }

    private async Task OpenInspectionDetailsAsync(long id)
    {
        if (detailsModal is not null)
        {
            await detailsModal.OpenAsync(id);
        }
    }

    private async Task OnInspectionChangedAsync(string? notice)
    {
        pageNotice = notice;
        await ReloadActiveGridAsync(false);
    }

    private void OpenCoaModalFromTuple((long ItemId, string LotCode) args)
    {
        OpenCoaModal(args.ItemId, args.LotCode);
    }

    private void OpenCoaModal(long itemId, string lotCode)
    {
        coaItemId = itemId;
        coaLotCode = lotCode;
        coaOpen = true;
    }

    private void OpenParameterModal(QualityParameterSummary? param)
    {
        paramError = null;
        editingParam = param;
        paramCode = param?.Code ?? string.Empty;
        paramName = param?.Name ?? string.Empty;
        paramSymbol = param?.Symbol ?? string.Empty;
        paramUnitSymbol = param?.UnitSymbol;
        paramDataType = param?.DataType ?? QualityParameterDataType.Numeric;
        paramDecimalPlaces = param?.DecimalPlaces ?? (byte)2;
        paramTestMethod = param?.DefaultTestMethod;
        paramModalOpen = true;
    }

    private async Task SubmitParameterAsync()
    {
        var scope = CurrentScope;
        if (scope is null) return;
        modalBusy = true;
        paramError = null;
        try
        {
            var orgId = ScopeOrganizationId(scope);
            OrganizationResult<QualityParameterSummary> res = editingParam is null
                ? await SpecService.CreateParameter(scope, new CreateQualityParameterRequest(
                    orgId, paramCode, paramName, paramSymbol, paramUnitSymbol, paramDataType, paramDecimalPlaces, paramTestMethod))
                : await SpecService.UpdateParameter(scope, new UpdateQualityParameterRequest(
                    orgId, editingParam.Id, paramName, paramSymbol, paramUnitSymbol, paramDecimalPlaces, paramTestMethod, editingParam.RowVersion));
            if (!res.Succeeded) { paramError = RolePermissionLocalization.FailureKey(res.Error!.Code); return; }
            paramModalOpen = false;
            pageNotice = Text["WriteSaved"];
            await RefreshScopeStateAsync();
            await ReloadActiveGridAsync(editingParam is null);
        }
        finally { modalBusy = false; }
    }

    private async Task ToggleParameterActiveAsync(QualityParameterSummary p)
    {
        var scope = CurrentScope;
        if (scope is null) return;
        modalBusy = true;
        try
        {
            var res = await SpecService.SetParameterActive(scope, new SetQualityParameterActiveRequest(
                p.OrganizationId, p.Id, !p.IsActive, p.RowVersion));
            if (!res.Succeeded) { pageError = RolePermissionLocalization.FailureKey(res.Error!.Code); return; }
            pageNotice = Text["WriteSaved"];
            await RefreshScopeStateAsync();
            await ReloadActiveGridAsync(false);
        }
        finally { modalBusy = false; }
    }

    private async Task OpenSpecModalAsync(long? specId)
    {
        var scope = CurrentScope;
        if (scope is null) return;
        specError = null;
        specLines.Clear();
        if (specId is null)
        {
            editingSpec = null;
            specCode = string.Empty;
            specName = string.Empty;
            specVersion = 1;
            specTargetKind = QualitySpecTargetKind.Classification;
            specTargetItemId = activeItems.FirstOrDefault()?.Id ?? 0;
            specTargetClassId = activeClassifications.FirstOrDefault()?.Id ?? 0;
            specCheckpoint = QualitySpecCheckpoint.Incoming;
            specNotes = null;
            AddSpecLine();
            specModalOpen = true;
            return;
        }

        var res = await SpecService.GetSpec(scope, ScopeOrganizationId(scope), specId.Value);
        if (!res.Succeeded || res.Value is null)
        {
            pageError = res.Succeeded ? "ReadNotFound" : RolePermissionLocalization.FailureKey(res.Error!.Code);
            return;
        }
        var d = res.Value;
        editingSpec = d.Summary;
        specCode = d.Summary.Code;
        specName = d.Summary.Name;
        specVersion = d.Summary.Version;
        specTargetKind = d.Summary.TargetKind;
        specTargetItemId = d.Summary.ItemId ?? 0;
        specTargetClassId = d.Summary.ClassificationId ?? 0;
        specCheckpoint = d.Summary.Checkpoint;
        specNotes = d.Summary.Notes;
        foreach (var l in d.Lines)
        {
            specLines.Add(new SpecLineEditRow
            {
                QualityParameterId = l.QualityParameterId,
                MinValue = l.MinValue,
                MaxValue = l.MaxValue,
                TargetValue = l.TargetValue,
                ExpectedTextSpec = l.ExpectedTextSpec,
                IsMandatory = l.IsMandatory,
                Notes = l.Notes
            });
        }
        specModalOpen = true;
    }

    private void AddSpecLine() => specLines.Add(new SpecLineEditRow
    {
        QualityParameterId = activeParameters.FirstOrDefault()?.Id ?? 0,
        IsMandatory = true
    });

    private void OnSpecLineParamChanged(SpecLineEditRow row, ChangeEventArgs e)
    {
        if (long.TryParse(e.Value?.ToString(), NumberStyles.Integer, CultureInfo.InvariantCulture, out var pid))
            row.QualityParameterId = pid;
    }

    private async Task SubmitSpecAsync()
    {
        var scope = CurrentScope;
        if (scope is null) return;
        modalBusy = true;
        specError = null;
        try
        {
            var orgId = ScopeOrganizationId(scope);
            var inputs = specLines.Select(l => new QualitySpecLineInput(
                l.QualityParameterId, l.MinValue, l.MaxValue, l.TargetValue, l.ExpectedTextSpec, l.IsMandatory, l.Notes)).ToArray();

            OrganizationResult<QualitySpecDetails> res = editingSpec is null
                ? await SpecService.CreateSpec(scope, new CreateQualitySpecRequest(
                    orgId, specCode, specName, specTargetKind,
                    specTargetKind == QualitySpecTargetKind.Item ? specTargetItemId : null,
                    specTargetKind == QualitySpecTargetKind.Classification ? specTargetClassId : null,
                    specCheckpoint, specVersion, specNotes, inputs))
                : await SpecService.UpdateSpec(scope, new UpdateQualitySpecRequest(
                    orgId, editingSpec.Id, specName, specCheckpoint, specNotes, inputs, editingSpec.RowVersion));
            if (!res.Succeeded) { specError = RolePermissionLocalization.FailureKey(res.Error!.Code); return; }
            specModalOpen = false;
            pageNotice = Text["WriteSaved"];
            await ReloadActiveGridAsync(editingSpec is null);
        }
        finally { modalBusy = false; }
    }

    private async Task ToggleSpecActiveAsync(QualitySpecSummary s)
    {
        var scope = CurrentScope;
        if (scope is null) return;
        modalBusy = true;
        try
        {
            var res = await SpecService.SetSpecActive(scope, new SetQualitySpecActiveRequest(
                s.OrganizationId, s.Id, !s.IsActive, s.RowVersion));
            if (!res.Succeeded) { pageError = RolePermissionLocalization.FailureKey(res.Error!.Code); return; }
            pageNotice = Text["WriteSaved"];
            await ReloadActiveGridAsync(false);
        }
        finally { modalBusy = false; }
    }

    private string ParamDataTypeLabel(QualityParameterDataType dt) => dt switch
    {
        QualityParameterDataType.Numeric => Text["AttributeDataTypeDecimal"],
        QualityParameterDataType.Boolean => Text["AttributeDataTypeBoolean"],
        _ => Text["AttributeDataTypeText"]
    };

    private string TargetKindLabel(QualitySpecTargetKind kind) => kind == QualitySpecTargetKind.Item
        ? Text["QcTargetItem"] : Text["QcTargetClassification"];

    private string CheckpointLabel(QualitySpecCheckpoint ckpt) => ckpt switch
    {
        QualitySpecCheckpoint.Incoming => Text["QcCheckpointIncoming"],
        QualitySpecCheckpoint.Production => Text["QcCheckpointProduction"],
        _ => Text["QcCheckpointAll"]
    };

    private void OpenLotModal(ItemLotSummary? lot)
    {
        lotModal?.Open(lot);
    }

    private async Task OnLotSavedAsync()
    {
        pageNotice = Text["WriteSaved"];
        await ReloadActiveGridAsync(false);
    }

    private string StatusLabel(QualityInspectionStatus status) => status switch
    {
        QualityInspectionStatus.Pending => Text["QcStatusPending"],
        QualityInspectionStatus.InReview => Text["QcStatusInReview"],
        QualityInspectionStatus.Completed => Text["QcStatusCompleted"],
        QualityInspectionStatus.Cancelled => Text["QcStatusCancelled"],
        _ => status.ToString()
    };

    private static string StatusBadgeClass(QualityInspectionStatus status) => status switch
    {
        QualityInspectionStatus.Pending => "qc-status-pending",
        QualityInspectionStatus.InReview => "qc-status-review",
        QualityInspectionStatus.Completed => "qc-status-completed",
        QualityInspectionStatus.Cancelled => "qc-status-cancelled",
        _ => "qc-status-pending"
    };

    private string SourceLabel(QualityInspectionSourceType source) => source switch
    {
        QualityInspectionSourceType.Receipt => Text["QcSourceReceipt"],
        QualityInspectionSourceType.ProductionReceipt => Text["QcSourceProdReceipt"],
        QualityInspectionSourceType.ManualHold => Text["QcSourceManualHold"],
        _ => source.ToString()
    };

    private string ScopeLabel(OrganizationScope scope) => scope switch
    {
        OrganizationScope.Organization o when scopeLabels.TryGetValue(scope, out var info) && info.OrgCode is not null
            => $"{info.OrgCode} — {info.OrgName}",
        OrganizationScope.Organization o => Text["ReadOrganizationScope", o.OrganizationId],
        OrganizationScope.Site s when scopeLabels.TryGetValue(scope, out var info) && info.SiteCode is not null
            => $"{info.OrgCode} / {info.SiteCode} — {info.SiteName}",
        OrganizationScope.Site s => Text["ReadSiteScope", s.OrganizationId, s.SiteId],
        _ => string.Empty
    };
}
