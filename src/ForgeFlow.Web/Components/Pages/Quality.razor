@page "/quality"
@page "/organizations/{OrganizationId:long}/quality"
@using ForgeFlow.Application.Inventory
@using ForgeFlow.Application.Items
@using ForgeFlow.Application.Organizations
@using ForgeFlow.Application.ProductionOrders
@using ForgeFlow.Application.Quality
@using ForgeFlow.Application.Units
@using ForgeFlow.Domain.Quality
@using ForgeFlow.Web.Roles
@using System.Globalization
@inject QualityUseCases QualityService
@inject QualitySpecUseCases SpecService
@inject InventoryUseCases InvService
@inject ProductionOrderUseCases OrderService
@inject ItemUseCases ItemService
@inject UnitUseCases UnitService
@inject DocumentSequenceUseCases SeqService
@inject ForgeFlow.Web.Organizations.ReadScopes Scopes
@inject ITrustedActorAccessor Actors
@inject IOrganizationPermissionEvaluator Permissions
@inject CulturePolicy Culture
@inject DisplayFormatter Format
@inject IStringLocalizer<SharedResources> Text

<PageTitle>@Text["QualityControl"] - @Text["AppTitle"]</PageTitle>

<section class="organization-reader" aria-labelledby="qc-title">
    <div class="read-page-head">
        <div>
            <h1 id="qc-title">@Text["QualityControl"]</h1>
            <p class="write-hint">@Text["QualityCaption"]</p>
        </div>
        @if (!initialLoading && pageError is null && available.Count > 0 && scopeCanManage)
        {
            <div class="read-head-actions">
                @if (activeTab == TabInspections)
                {
                    <BitButton Size="BitSize.Small" OnClick="OpenHoldModalAsync">@Text["QcCreateHoldBtn"]</BitButton>
                }
                else if (activeTab == TabLots)
                {
                    <BitButton Size="BitSize.Small" OnClick="() => OpenLotModal(null)">@Text["QcLotUpsertBtn"]</BitButton>
                }
                else if (activeTab == TabParameters)
                {
                    <BitButton Size="BitSize.Small" OnClick="() => OpenParameterModal(null)">@Text["QcCreateParameterBtn"]</BitButton>
                }
                else if (activeTab == TabSpecs)
                {
                    <BitButton Size="BitSize.Small" OnClick="() => OpenSpecModalAsync(null)">@Text["QcCreateSpecBtn"]</BitButton>
                }
            </div>
        }
    </div>

    @if (pageNotice is not null)
    {
        <p role="status" class="read-page-notice write-saved">@pageNotice</p>
    }

    @if (initialLoading)
    {
        <p role="status" aria-live="polite">@Text["ReadLoading"]</p>
    }
    else if (pageError is not null)
    {
        <div class="read-state" role="alert">
            <p>@Text[pageError]</p>
            <BitButton Variant="BitVariant.Outline" Size="BitSize.Small" OnClick="ReloadScopeAsync">@Text["WriteReload"]</BitButton>
        </div>
    }
    else if (available.Count == 0)
    {
        <p role="status" class="read-empty">@Text["ReadDenied"]</p>
    }
    else
    {
        <div class="read-tab-bar" role="tablist" aria-label="@Text["QualityControl"]">
            <button type="button" role="tab" aria-selected="@(activeTab == TabInspections)"
                    class="read-tab-btn @(activeTab == TabInspections ? "active" : string.Empty)"
                    @onclick="() => SwitchTabAsync(TabInspections)">@Text["QcTabInspections"]</button>
            <button type="button" role="tab" aria-selected="@(activeTab == TabLots)"
                    class="read-tab-btn @(activeTab == TabLots ? "active" : string.Empty)"
                    @onclick="() => SwitchTabAsync(TabLots)">@Text["QcTabLots"]</button>
            <button type="button" role="tab" aria-selected="@(activeTab == TabParameters)"
                    class="read-tab-btn @(activeTab == TabParameters ? "active" : string.Empty)"
                    @onclick="() => SwitchTabAsync(TabParameters)">@Text["QcTabParameters"]</button>
            <button type="button" role="tab" aria-selected="@(activeTab == TabSpecs)"
                    class="read-tab-btn @(activeTab == TabSpecs ? "active" : string.Empty)"
                    @onclick="() => SwitchTabAsync(TabSpecs)">@Text["QcTabSpecs"]</button>
        </div>

        <div class="read-toolbar-card">
            @if (available.Count > 1)
            {
                <div class="read-field">
                    <label for="qc-scope">@Text["ReadScope"]</label>
                    <select id="qc-scope" aria-label="@Text["ReadScope"]" value="@scopeIndex" @onchange="ChangeScopeAsync">
                        @for (var i = 0; i < available.Count; i++)
                        {
                            <option value="@i">@ScopeLabel(available[i])</option>
                        }
                    </select>
                </div>
            }

            @if (activeTab == TabInspections && CurrentScope is OrganizationScope.Organization && authorizedSites.Count > 1)
            {
                <div class="read-field">
                    <label for="qc-site-filter">@Text["PoSiteColumn"]</label>
                    <select id="qc-site-filter" value="@siteFilter" @onchange="ChangeSiteFilterAsync">
                        <option value="0">@Text["PoAllSitesOption"]</option>
                        @foreach (var s in authorizedSites)
                        {
                            <option value="@s.Id">@s.Code — @s.Name</option>
                        }
                    </select>
                </div>
            }

            @if (activeTab == TabInspections)
            {
                <div class="read-field">
                    <label for="qc-status-filter">@Text["ReadStatus"]</label>
                    <select id="qc-status-filter" value="@statusFilter" @onchange="ChangeStatusFilterAsync">
                        <option value="">@Text["PoAllStatusesOption"]</option>
                        <option value="@((byte)QualityInspectionStatus.Pending)">@StatusLabel(QualityInspectionStatus.Pending)</option>
                        <option value="@((byte)QualityInspectionStatus.InReview)">@StatusLabel(QualityInspectionStatus.InReview)</option>
                        <option value="@((byte)QualityInspectionStatus.Completed)">@StatusLabel(QualityInspectionStatus.Completed)</option>
                        <option value="@((byte)QualityInspectionStatus.Cancelled)">@StatusLabel(QualityInspectionStatus.Cancelled)</option>
                    </select>
                </div>
            }
            else if (activeTab == TabLots)
            {
                <label class="read-inactive">
                    <input type="checkbox" checked="@onlyExpiringLots" @onchange="ToggleExpiringLotsAsync" />
                    <span>@Text["QcOnlyExpiringLabel"]</span>
                </label>
            }
            else if (activeTab == TabParameters)
            {
                <label class="read-inactive">
                    <input type="checkbox" checked="@includeInactiveParams" @onchange="ToggleInactiveParamsAsync" />
                    <span>@Text["ReadInactive"]</span>
                </label>
            }
            else if (activeTab == TabSpecs)
            {
                <div class="read-field">
                    <label for="qc-spec-target-filter">@Text["QcSpecTargetKindLabel"]</label>
                    <select id="qc-spec-target-filter" value="@specTargetFilter" @onchange="ChangeSpecTargetFilterAsync">
                        <option value="">@Text["PoAllStatusesOption"]</option>
                        <option value="@((byte)QualitySpecTargetKind.Item)">@Text["QcTargetItem"]</option>
                        <option value="@((byte)QualitySpecTargetKind.Classification)">@Text["QcTargetClassification"]</option>
                    </select>
                </div>
                <div class="read-field">
                    <label for="qc-spec-ckpt-filter">@Text["QcSpecCheckpointLabel"]</label>
                    <select id="qc-spec-ckpt-filter" value="@specCheckpointFilter" @onchange="ChangeSpecCheckpointFilterAsync">
                        <option value="">@Text["PoAllStatusesOption"]</option>
                        <option value="@((byte)QualitySpecCheckpoint.Incoming)">@Text["QcCheckpointIncoming"]</option>
                        <option value="@((byte)QualitySpecCheckpoint.Production)">@Text["QcCheckpointProduction"]</option>
                        <option value="@((byte)QualitySpecCheckpoint.All)">@Text["QcCheckpointAll"]</option>
                    </select>
                </div>
                <label class="read-inactive">
                    <input type="checkbox" checked="@includeInactiveSpecs" @onchange="ToggleInactiveSpecsAsync" />
                    <span>@Text["ReadInactive"]</span>
                </label>
            }

            <div class="read-field">
                <label for="qc-search">@Text["ReadSearch"]</label>
                <input id="qc-search" type="search" @bind="search" @bind:after="ApplySearchAsync" maxlength="64" placeholder="@Text["ReadSearchPlaceholder"]" />
            </div>
        </div>

        @if (activeTab == TabInspections)
        {
            <div class="read-grid-card">
                <div class="read-grid">
                    <BitDataGrid @ref="inspGrid" TItem="QualityInspectionSummary" OnRead="ReadInspectionsAsync" Pageable="true" PageSize="25"
                                 PageSizeOptions="@PageSizeOptions" Strings="@GridStrings" SelectionMode="BitSelectionMode.Single"
                                 AriaLabelledBy="qc-title" WrapCellText="true" Resizable="true">
                        <EmptyTemplate><p role="status" class="read-empty">@Text["ReadEmpty"]</p></EmptyTemplate>
                        <Columns>
                            <BitDataGridColumn TItem="QualityInspectionSummary" Title="@Text["QcNumberColumn"]">
                                <Template Context="q">
                                    <div>
                                        <div class="read-primary-cell"><bdi dir="ltr">@q.InspectionNumber</bdi></div>
                                        <div class="read-sub-cell"><span dir="ltr">@q.SiteCode / @q.WarehouseCode</span></div>
                                        @if (!string.IsNullOrWhiteSpace(q.CertificateNumber))
                                        {
                                            <div class="read-sub-cell" dir="ltr">@Text["QcCertNumberShort"]: @q.CertificateNumber</div>
                                        }
                                    </div>
                                </Template>
                            </BitDataGridColumn>
                            <BitDataGridColumn TItem="QualityInspectionSummary" Title="@Text["BomLineItemColumn"]">
                                <Template Context="q">
                                    <div>
                                        <div class="read-primary-cell"><span dir="ltr">@q.ItemCode</span> — @q.ItemName</div>
                                        @if (!string.IsNullOrEmpty(q.LotCode))
                                        {
                                            <div class="read-sub-cell">
                                                <a class="qc-lot-link" href="@($"/traceability?itemId={q.ItemId}&lotCode={Uri.EscapeDataString(q.LotCode)}")" dir="ltr">@q.LotCode</a>
                                            </div>
                                        }
                                    </div>
                                </Template>
                            </BitDataGridColumn>
                            <BitDataGridColumn TItem="QualityInspectionSummary" Title="@Text["QcSourceColumn"]">
                                <Template Context="q">
                                    <div>
                                        <div class="read-primary-cell">@SourceLabel(q.SourceType)</div>
                                        @if (!string.IsNullOrEmpty(q.SourceDocumentNumber))
                                        {
                                            <div class="read-sub-cell" dir="ltr">@q.SourceDocumentNumber</div>
                                        }
                                    </div>
                                </Template>
                            </BitDataGridColumn>
                            <BitDataGridColumn TItem="QualityInspectionSummary" Title="@Text["QcQuantitiesColumn"]">
                                <Template Context="q">
                                    <div>
                                        <div class="read-primary-cell" dir="ltr">@Format.Number(q.InspectedBaseQuantity) @q.BaseUnitSymbol</div>
                                        <div class="read-sub-cell" dir="ltr">
                                            @Text["QcQtyBreakdown", Format.Number(q.AcceptedBaseQuantity), Format.Number(q.RejectedBaseQuantity), Format.Number(q.RemainingBlockedBaseQuantity)]
                                        </div>
                                    </div>
                                </Template>
                            </BitDataGridColumn>
                            <BitDataGridColumn TItem="QualityInspectionSummary" Title="@Text["ReadStatus"]">
                                <Template Context="q">
                                    <span class="read-badge @StatusBadgeClass(q.Status)">@StatusLabel(q.Status)</span>
                                </Template>
                            </BitDataGridColumn>
                            <BitDataGridColumn TItem="QualityInspectionSummary" Title="@Text["ReadActions"]">
                                <Template Context="q">
                                    <div class="read-row-actions">
                                        <BitTooltip Text="@Text["ReadDetails"]" ShowOnFocus="true">
                                            <BitButton Variant="BitVariant.Outline" Size="BitSize.Small" Class="read-detail-action"
                                                       IconName="View" IconOnly="true" aria-label="@Text["ReadDetails"]"
                                                       OnClick="() => OpenInspectionDetailsAsync(q.Id)" />
                                        </BitTooltip>
                                        @if (!string.IsNullOrWhiteSpace(q.LotCode))
                                        {
                                            <BitButton Variant="BitVariant.Outline" Size="BitSize.Small" OnClick="() => OpenCoaModal(q.ItemId, q.LotCode)">
                                                @Text["QcCoaBtn"]
                                            </BitButton>
                                        }
                                    </div>
                                </Template>
                            </BitDataGridColumn>
                        </Columns>
                    </BitDataGrid>
                </div>
            </div>
        }
        else if (activeTab == TabLots)
        {
            <div class="read-grid-card">
                <div class="read-grid">
                    <BitDataGrid @ref="lotGrid" TItem="ItemLotSummary" OnRead="ReadLotsAsync" Pageable="true" PageSize="25"
                                 PageSizeOptions="@PageSizeOptions" Strings="@GridStrings" SelectionMode="BitSelectionMode.Single"
                                 AriaLabelledBy="qc-title" WrapCellText="true" Resizable="true">
                        <EmptyTemplate><p role="status" class="read-empty">@Text["ReadEmpty"]</p></EmptyTemplate>
                        <Columns>
                            <BitDataGridColumn TItem="ItemLotSummary" Title="@Text["BomLineItemColumn"]">
                                <Template Context="l"><span dir="ltr">@l.ItemCode</span> — @l.ItemName</Template>
                            </BitDataGridColumn>
                            <BitDataGridColumn TItem="ItemLotSummary" Title="@Text["InvLotCodeLabel"]">
                                <Template Context="l">
                                    <a class="qc-lot-link" href="@($"/traceability?itemId={l.ItemId}&lotCode={Uri.EscapeDataString(l.LotCode)}")" dir="ltr">@l.LotCode</a>
                                </Template>
                            </BitDataGridColumn>
                            <BitDataGridColumn TItem="ItemLotSummary" Title="@Text["QcLotMfgDateLabel"]">
                                <Template Context="l"><bdi dir="ltr">@(l.ManufactureDate?.ToString("yyyy-MM-dd") ?? "—")</bdi></Template>
                            </BitDataGridColumn>
                            <BitDataGridColumn TItem="ItemLotSummary" Title="@Text["QcLotExpDateLabel"]">
                                <Template Context="l">
                                    @if (l.ExpirationDate.HasValue)
                                    {
                                        <span class="read-badge @(l.IsExpired ? "rpt-shortage-badge" : l.IsExpiringSoon ? "qc-status-pending" : "qc-status-completed")">
                                            <bdi dir="ltr">@l.ExpirationDate.Value.ToString("yyyy-MM-dd")</bdi>
                                        </span>
                                    }
                                    else
                                    {
                                        <span>—</span>
                                    }
                                </Template>
                            </BitDataGridColumn>
                            <BitDataGridColumn TItem="ItemLotSummary" Title="@Text["PoNotesLabel"]">
                                <Template Context="l">@(l.Notes ?? "—")</Template>
                            </BitDataGridColumn>
                            <BitDataGridColumn TItem="ItemLotSummary" Title="@Text["ReadActions"]">
                                <Template Context="l">
                                    <div class="read-row-actions">
                                        <BitButton Variant="BitVariant.Outline" Size="BitSize.Small" OnClick="() => OpenCoaModal(l.ItemId, l.LotCode)">
                                            @Text["QcCoaBtn"]
                                        </BitButton>
                                        @if (scopeCanManage)
                                        {
                                            <BitTooltip Text="@Text["ReadEdit"]" ShowOnFocus="true">
                                                <BitButton Variant="BitVariant.Outline" Size="BitSize.Small" Class="read-detail-action"
                                                           Icon="@EditIcon" IconOnly="true" aria-label="@Text["ReadEdit"]"
                                                           OnClick="() => OpenLotModal(l)" />
                                            </BitTooltip>
                                        }
                                    </div>
                                </Template>
                            </BitDataGridColumn>
                        </Columns>
                    </BitDataGrid>
                </div>
            </div>
        }
        else if (activeTab == TabParameters)
        {
            <div class="read-grid-card">
                <div class="read-grid">
                    <BitDataGrid @ref="paramGrid" TItem="QualityParameterSummary" OnRead="ReadParametersAsync" Pageable="true" PageSize="25"
                                 PageSizeOptions="@PageSizeOptions" Strings="@GridStrings" SelectionMode="BitSelectionMode.Single"
                                 AriaLabelledBy="qc-title" WrapCellText="true" Resizable="true">
                        <EmptyTemplate><p role="status" class="read-empty">@Text["ReadEmpty"]</p></EmptyTemplate>
                        <Columns>
                            <BitDataGridColumn TItem="QualityParameterSummary" Title="@Text["ReadCode"]">
                                <Template Context="p"><bdi dir="ltr">@p.Code</bdi></Template>
                            </BitDataGridColumn>
                            <BitDataGridColumn TItem="QualityParameterSummary" Title="@Text["QcParamSymbolLabel"]">
                                <Template Context="p"><span class="qc-symbol-chip" dir="ltr">@p.Symbol</span></Template>
                            </BitDataGridColumn>
                            <BitDataGridColumn TItem="QualityParameterSummary" Title="@Text["ReadName"]">
                                <Template Context="p">@p.Name</Template>
                            </BitDataGridColumn>
                            <BitDataGridColumn TItem="QualityParameterSummary" Title="@Text["QcParamUnitLabel"]">
                                <Template Context="p"><span dir="ltr">@(p.UnitSymbol ?? "—")</span></Template>
                            </BitDataGridColumn>
                            <BitDataGridColumn TItem="QualityParameterSummary" Title="@Text["AttributeDataTypeLabel"]">
                                <Template Context="p">
                                    <span>@ParamDataTypeLabel(p.DataType)</span>
                                    @if (p.DataType == QualityParameterDataType.Numeric)
                                    {
                                        <span class="read-sub-cell" dir="ltr"> (@p.DecimalPlaces)</span>
                                    }
                                </Template>
                            </BitDataGridColumn>
                            <BitDataGridColumn TItem="QualityParameterSummary" Title="@Text["QcParamMethodLabel"]">
                                <Template Context="p"><span dir="ltr">@(p.DefaultTestMethod ?? "—")</span></Template>
                            </BitDataGridColumn>
                            <BitDataGridColumn TItem="QualityParameterSummary" Title="@Text["ReadStatus"]">
                                <Template Context="p">
                                    <span class="read-badge @(p.IsActive ? "active" : "inactive")">
                                        @Text[p.IsActive ? "ReadActive" : "ReadInactiveStatus"]
                                    </span>
                                </Template>
                            </BitDataGridColumn>
                            <BitDataGridColumn TItem="QualityParameterSummary" Title="@Text["ReadActions"]">
                                <Template Context="p">
                                    @if (scopeCanManage)
                                    {
                                        <div class="read-row-actions">
                                            <BitTooltip Text="@Text["ReadEdit"]" ShowOnFocus="true">
                                                <BitButton Variant="BitVariant.Outline" Size="BitSize.Small" Class="read-detail-action"
                                                           Icon="@EditIcon" IconOnly="true" aria-label="@Text["ReadEdit"]"
                                                           OnClick="() => OpenParameterModal(p)" />
                                            </BitTooltip>
                                            @{
                                                var paramToggleLabel = Text[p.IsActive ? "WriteDeactivate" : "WriteActivate"];
                                            }
                                            <BitTooltip Text="@paramToggleLabel" ShowOnFocus="true">
                                                <BitButton Variant="BitVariant.Outline" Size="BitSize.Small" IsEnabled="@(!modalBusy)"
                                                           Class="@($"read-detail-action {(p.IsActive ? "read-action-deactivate" : "read-action-activate")}")"
                                                           Icon="@(p.IsActive ? DeactivateIcon : ActivateIcon)" IconOnly="true"
                                                           aria-label="@paramToggleLabel"
                                                           OnClick="() => ToggleParameterActiveAsync(p)" />
                                            </BitTooltip>
                                        </div>
                                    }
                                </Template>
                            </BitDataGridColumn>
                        </Columns>
                    </BitDataGrid>
                </div>
            </div>
        }
        else if (activeTab == TabSpecs)
        {
            <div class="read-grid-card">
                <div class="read-grid">
                    <BitDataGrid @ref="specGrid" TItem="QualitySpecSummary" OnRead="ReadSpecsAsync" Pageable="true" PageSize="25"
                                 PageSizeOptions="@PageSizeOptions" Strings="@GridStrings" SelectionMode="BitSelectionMode.Single"
                                 AriaLabelledBy="qc-title" WrapCellText="true" Resizable="true">
                        <EmptyTemplate><p role="status" class="read-empty">@Text["ReadEmpty"]</p></EmptyTemplate>
                        <Columns>
                            <BitDataGridColumn TItem="QualitySpecSummary" Title="@Text["ReadCode"]">
                                <Template Context="s">
                                    <div>
                                        <div class="read-primary-cell"><bdi dir="ltr">@s.Code</bdi></div>
                                        <div class="read-sub-cell" dir="ltr">v@(s.Version)</div>
                                    </div>
                                </Template>
                            </BitDataGridColumn>
                            <BitDataGridColumn TItem="QualitySpecSummary" Title="@Text["ReadName"]">
                                <Template Context="s">@s.Name</Template>
                            </BitDataGridColumn>
                            <BitDataGridColumn TItem="QualitySpecSummary" Title="@Text["QcSpecTargetLabel"]">
                                <Template Context="s">
                                    <div>
                                        <div class="read-primary-cell">
                                            @if (s.TargetKind == QualitySpecTargetKind.Item)
                                            {
                                                <span dir="ltr">@s.ItemCode</span> <span>— @s.ItemName</span>
                                            }
                                            else
                                            {
                                                <span dir="ltr">@s.ClassificationCode</span> <span>— @s.ClassificationName</span>
                                            }
                                        </div>
                                        <div class="read-sub-cell">@TargetKindLabel(s.TargetKind)</div>
                                    </div>
                                </Template>
                            </BitDataGridColumn>
                            <BitDataGridColumn TItem="QualitySpecSummary" Title="@Text["QcSpecCheckpointLabel"]">
                                <Template Context="s"><span class="cap-badge">@CheckpointLabel(s.Checkpoint)</span></Template>
                            </BitDataGridColumn>
                            <BitDataGridColumn TItem="QualitySpecSummary" Title="@Text["QcSpecLinesCountCol"]">
                                <Template Context="s"><span dir="ltr">@s.LineCount</span></Template>
                            </BitDataGridColumn>
                            <BitDataGridColumn TItem="QualitySpecSummary" Title="@Text["ReadStatus"]">
                                <Template Context="s">
                                    <span class="read-badge @(s.IsActive ? "active" : "inactive")">
                                        @Text[s.IsActive ? "ReadActive" : "ReadInactiveStatus"]
                                    </span>
                                </Template>
                            </BitDataGridColumn>
                            <BitDataGridColumn TItem="QualitySpecSummary" Title="@Text["ReadActions"]">
                                <Template Context="s">
                                    <div class="read-row-actions">
                                        <BitTooltip Text="@Text[scopeCanManage ? "ReadEdit" : "ReadDetails"]" ShowOnFocus="true">
                                            <BitButton Variant="BitVariant.Outline" Size="BitSize.Small" Class="read-detail-action"
                                                       Icon="@(scopeCanManage ? EditIcon : BitIconInfo.Css("ff-icon ff-icon--eye"))" IconOnly="true"
                                                       aria-label="@Text[scopeCanManage ? "ReadEdit" : "ReadDetails"]"
                                                       OnClick="() => OpenSpecModalAsync(s.Id)" />
                                        </BitTooltip>
                                        @if (scopeCanManage)
                                        {
                                            var specToggleLabel = Text[s.IsActive ? "WriteDeactivate" : "WriteActivate"];
                                            <BitTooltip Text="@specToggleLabel" ShowOnFocus="true">
                                                <BitButton Variant="BitVariant.Outline" Size="BitSize.Small" IsEnabled="@(!modalBusy)"
                                                           Class="@($"read-detail-action {(s.IsActive ? "read-action-deactivate" : "read-action-activate")}")"
                                                           Icon="@(s.IsActive ? DeactivateIcon : ActivateIcon)" IconOnly="true"
                                                           aria-label="@specToggleLabel"
                                                           OnClick="() => ToggleSpecActiveAsync(s)" />
                                            </BitTooltip>
                                        }
                                    </div>
                                </Template>
                            </BitDataGridColumn>
                        </Columns>
                    </BitDataGrid>
                </div>
            </div>
        }
    }

    <BitDialog Width="640px" MaxWidth="calc(100vw - 24px)" Classes="@DialogClasses" @bind-IsOpen="holdModalOpen"
               Title="@Text["QcCreateHoldTitle"]" AriaLabel="@Text["QcCreateHoldTitle"]"
               CloseButtonTitle="@Text["ReadClose"]" ShowOkButton="false" ShowCancelButton="false" ShowCloseButton="true"
               AutoFocus="true" TrapFocus="true" RestoreFocus="true" CloseOnEscape="true">
        <Body>
            <div class="audit-modal-body">
                @if (holdError is not null)
                {
                    <p role="alert" class="write-error">@Text[holdError]</p>
                }
                <div class="po-form-grid">
                    <div class="write-field">
                        <label for="qc-hold-num">@Text["QcNumberColumn"]</label>
                        <input id="qc-hold-num" type="text" maxlength="32" @bind="holdNumber" placeholder="QC-HOLD-001" />
                    </div>
                    <div class="write-field">
                        <label for="qc-hold-wh">@Text["InvWarehouseLabel"]</label>
                        <select id="qc-hold-wh" @bind="holdWarehouseId">
                            <option value="0">@Text["InvSelectWarehouseOption"]</option>
                            @foreach (var w in activeWarehouses)
                            {
                                <option value="@w.Id">@w.Code — @w.Name</option>
                            }
                        </select>
                    </div>
                    <div class="write-field">
                        <label for="qc-hold-item">@Text["BomLineItemColumn"]</label>
                        <select id="qc-hold-item" value="@holdItemId" @onchange="OnHoldItemChanged">
                            <option value="0">@Text["InvSelectItemOption"]</option>
                            @foreach (var it in activeItems)
                            {
                                <option value="@it.Id">@it.Code — @it.Name</option>
                            }
                        </select>
                    </div>
                    <div class="write-field">
                        <label for="qc-hold-lot">@Text["InvLotCodeLabel"]</label>
                        <input id="qc-hold-lot" type="text" maxlength="32" @bind="holdLotCode" />
                    </div>
                    <div class="write-field">
                        <label for="qc-hold-qty">@Text["BomQuantityColumn"]</label>
                        <input id="qc-hold-qty" type="number" step="0.000001" min="0.000001" @bind="holdQuantity" />
                    </div>
                    <div class="write-field">
                        <label for="qc-hold-unit">@Text["BomLineUnitColumn"]</label>
                        <select id="qc-hold-unit" @bind="holdUnitId">
                            @foreach (var u in activeUnits)
                            {
                                <option value="@u.Id">@u.Code (@u.Symbol)</option>
                            }
                        </select>
                    </div>
                    <div class="write-field">
                        <label for="qc-hold-defect">@Text["QcDefectCodeLabel"]</label>
                        <input id="qc-hold-defect" type="text" maxlength="64" @bind="holdDefectCode" />
                    </div>
                    <div class="write-field po-field-full">
                        <label for="qc-hold-notes">@Text["PoNotesLabel"]</label>
                        <textarea id="qc-hold-notes" rows="2" maxlength="1000" @bind="holdNotes"></textarea>
                    </div>
                </div>
                <div class="po-dialog-footer">
                    <BitButton IsEnabled="@(!modalBusy && holdWarehouseId > 0 && holdItemId > 0 && !string.IsNullOrWhiteSpace(holdNumber))" OnClick="SubmitManualHoldAsync">
                        @Text["QcCreateHoldBtn"]
                    </BitButton>
                    <BitButton Variant="BitVariant.Outline" OnClick="() => holdModalOpen = false">@Text["WriteCancel"]</BitButton>
                </div>
            </div>
        </Body>
    </BitDialog>

    <BitDialog Width="780px" MaxWidth="calc(100vw - 24px)" Classes="@DialogClasses" @bind-IsOpen="detailsOpen"
               Title="@Text["QcDetailsTitle"]" AriaLabel="@Text["QcDetailsTitle"]"
               CloseButtonTitle="@Text["ReadClose"]" ShowOkButton="false" ShowCancelButton="false" ShowCloseButton="true"
               AutoFocus="true" TrapFocus="true" RestoreFocus="true" CloseOnEscape="true">
        <Body>
            @if (selectedInspection is not null)
            {
                var q = selectedInspection.Summary;
                <div class="audit-modal-body audit-modal-body--wide">
                    <div class="audit-modal-title-row">
                        <span class="audit-modal-code" dir="ltr">@q.InspectionNumber</span>
                        <span class="read-badge @StatusBadgeClass(q.Status)">@StatusLabel(q.Status)</span>
                    </div>
                    @if (detailsError is not null)
                    {
                        <p role="alert" class="write-error">@Text[detailsError]</p>
                    }
                    <div class="audit-meta-card">
                        <div class="audit-meta-row">
                            <span class="audit-meta-label">@Text["InvWarehouseLabel"]</span>
                            <span class="audit-meta-val" dir="ltr">@q.SiteCode / @q.WarehouseCode — @q.WarehouseName</span>
                        </div>
                        <div class="audit-meta-row">
                            <span class="audit-meta-label">@Text["BomLineItemColumn"]</span>
                            <span class="audit-meta-val"><span dir="ltr">@q.ItemCode</span> — @q.ItemName</span>
                        </div>
                        @if (!string.IsNullOrEmpty(q.LotCode))
                        {
                            <div class="audit-meta-row">
                                <span class="audit-meta-label">@Text["InvLotCodeLabel"]</span>
                                <span class="audit-meta-val" dir="ltr">
                                    <a class="qc-lot-link" href="@($"/traceability?itemId={q.ItemId}&lotCode={Uri.EscapeDataString(q.LotCode)}")">@q.LotCode</a>
                                    <BitButton Variant="BitVariant.Outline" Size="BitSize.Small" Class="qc-inline-coa-btn" OnClick="() => OpenCoaModal(q.ItemId, q.LotCode)">
                                        @Text["QcCoaBtn"]
                                    </BitButton>
                                </span>
                            </div>
                        }
                        @if (!string.IsNullOrWhiteSpace(q.CertificateNumber))
                        {
                            <div class="audit-meta-row">
                                <span class="audit-meta-label">@Text["QcCertNumberLabel"]</span>
                                <span class="audit-meta-val" dir="ltr">@q.CertificateNumber</span>
                            </div>
                        }
                        <div class="audit-meta-row">
                            <span class="audit-meta-label">@Text["QcQuantitiesColumn"]</span>
                            <span class="audit-meta-val" dir="ltr">
                                @Format.Number(q.InspectedBaseQuantity) @q.BaseUnitSymbol ·
                                @Text["QcQtyBreakdown", Format.Number(q.AcceptedBaseQuantity), Format.Number(q.RejectedBaseQuantity), Format.Number(q.RemainingBlockedBaseQuantity)]
                            </span>
                        </div>
                        @if (q.InspectedAtUtc.HasValue)
                        {
                            <div class="audit-meta-row">
                                <span class="audit-meta-label">@Text["AuditTimeColumn"]</span>
                                <span class="audit-meta-val"><bdi dir="ltr">@Format.Timestamp(q.InspectedAtUtc.Value)</bdi> @(q.InspectedByActorName is not null ? $"({q.InspectedByActorName})" : string.Empty)</span>
                            </div>
                        }
                    </div>

                    @if (scopeCanManage && q.Status is QualityInspectionStatus.Pending or QualityInspectionStatus.InReview)
                    {
                        <div class="po-context-card">
                            <div class="po-context-head">
                                <strong>@Text["QcMeasurementsSection"]</strong>
                                <div class="read-row-actions">
                                    <BitButton Variant="BitVariant.Outline" Size="BitSize.Small" IsEnabled="@(!modalBusy)" OnClick="ApplySpecToInspectionAsync">
                                        @Text["QcLoadTemplateBtn"]
                                    </BitButton>
                                    <BitButton Variant="BitVariant.Outline" Size="BitSize.Small" Class="po-add-cond-btn" Icon="@PlusIcon" OnClick="AddMeasurementLine">
                                        @Text["QcAddLineBtn"]
                                    </BitButton>
                                </div>
                            </div>
                            <div class="po-form-grid">
                                <div class="write-field">
                                    <label for="qc-det-cert">@Text["QcCertNumberLabel"]</label>
                                    <input id="qc-det-cert" type="text" maxlength="64" @bind="editCertificateNumber" placeholder="COA-2026-001" />
                                </div>
                                <div class="write-field">
                                    <label for="qc-det-defect">@Text["QcDefectCodeLabel"]</label>
                                    <input id="qc-det-defect" type="text" maxlength="64" @bind="editDefectCode" />
                                </div>
                                <div class="write-field po-field-full">
                                    <label for="qc-det-notes">@Text["PoNotesLabel"]</label>
                                    <input id="qc-det-notes" type="text" maxlength="1000" @bind="editNotes" />
                                </div>
                            </div>
                            @foreach (var line in editLines)
                            {
                                <div class="qc-spec-meas-card">
                                    <div class="qc-spec-meas-head">
                                        <select class="qc-param-select" value="@(line.QualityParameterId?.ToString(CultureInfo.InvariantCulture) ?? string.Empty)"
                                                @onchange="e => OnMeasurementParamChanged(line, e)">
                                            <option value="">@Text["QcCustomParamOption"]</option>
                                            @foreach (var p in activeParameters)
                                            {
                                                <option value="@p.Id">@p.Code — @p.Name (@p.Symbol@(string.IsNullOrWhiteSpace(p.UnitSymbol) ? string.Empty : $", {p.UnitSymbol}"))</option>
                                            }
                                        </select>
                                        @if (!string.IsNullOrWhiteSpace(line.Symbol))
                                        {
                                            <span class="qc-symbol-chip" dir="ltr">@line.Symbol</span>
                                        }
                                        @if (!string.IsNullOrWhiteSpace(line.UnitSymbol))
                                        {
                                            <span class="cap-badge" dir="ltr">@line.UnitSymbol</span>
                                        }
                                        @if (line.IsMandatory)
                                        {
                                            <span class="read-badge qc-status-pending">@Text["QcMandatoryLabel"]</span>
                                        }
                                        @if (!string.IsNullOrWhiteSpace(line.TestMethod))
                                        {
                                            <span class="read-sub-cell" dir="ltr">@line.TestMethod</span>
                                        }
                                        <BitButton Variant="BitVariant.Outline" Size="BitSize.Small" OnClick="() => editLines.Remove(line)">@Text["BomRemoveRowBtn"]</BitButton>
                                    </div>
                                    <div class="qc-line-row">
                                        <input type="text" maxlength="100" @bind="line.ParameterName" placeholder="@Text["QcParamNamePlaceholder"]" disabled="@line.QualityParameterId.HasValue" />
                                        <input type="text" maxlength="100" @bind="line.ExpectedSpec" placeholder="@Text["QcExpectedSpecPlaceholder"]" />
                                        @if (line.DataType == QualityParameterDataType.Numeric)
                                        {
                                            <input type="number" step="any" dir="ltr" value="@(line.MeasuredNumericValue?.ToString("0.######", CultureInfo.InvariantCulture))" @onchange="e => OnNumericMeasuredChanged(line, e)"
                                                   placeholder="@Text["QcMeasuredValPlaceholder"]" />
                                        }
                                        else
                                        {
                                            <input type="text" maxlength="100" @bind="line.MeasuredValue" placeholder="@Text["QcMeasuredValPlaceholder"]" />
                                        }
                                        <label class="perm-check">
                                            <input type="checkbox" @bind="line.IsPassed" disabled="@(line.DataType == QualityParameterDataType.Numeric && (line.MinValue.HasValue || line.MaxValue.HasValue) && line.MeasuredNumericValue.HasValue)" />
                                            <span>@Text["QcPassedCheck"]</span>
                                        </label>
                                    </div>
                                </div>
                            }
                            <div class="write-actions">
                                <BitButton Variant="BitVariant.Outline" Size="BitSize.Small" IsEnabled="@(!modalBusy)" OnClick="SaveMeasurementsAsync">
                                    @Text["QcSaveMeasurementsBtn"]
                                </BitButton>
                            </div>
                        </div>

                        <div class="po-context-card">
                            <strong>@Text["QcDispositionSection"]</strong>
                            @if (HasMandatoryFailure() && dispAcceptQty > 0m && string.IsNullOrWhiteSpace(editDefectCode) && string.IsNullOrWhiteSpace(dispNotes) && string.IsNullOrWhiteSpace(editNotes))
                            {
                                <p role="alert" class="write-error qc-concession-banner">@Text["QcConcessionWarning"]</p>
                            }
                            <div class="po-form-grid">
                                <div class="write-field">
                                    <label for="qc-disp-accept">@Text["QcAcceptQtyLabel"] (@q.BaseUnitSymbol)</label>
                                    <input id="qc-disp-accept" type="number" step="0.000001" min="0" @bind="dispAcceptQty" />
                                </div>
                                <div class="write-field">
                                    <label for="qc-disp-reject">@Text["QcRejectScrapQtyLabel"] (@q.BaseUnitSymbol)</label>
                                    <input id="qc-disp-reject" type="number" step="0.000001" min="0" @bind="dispRejectQty" />
                                </div>
                                <div class="write-field">
                                    <label for="qc-disp-scrapdoc">@Text["QcScrapDocLabel"]</label>
                                    <input id="qc-disp-scrapdoc" type="text" maxlength="32" class="@(qcScrapAllowOverride ? string.Empty : "proc-input-readonly")" @bind="dispScrapDoc" readonly="@(!qcScrapAllowOverride)" dir="ltr" />
                                </div>
                                <div class="write-field">
                                    <label for="qc-disp-notes">@Text["PoNotesLabel"]</label>
                                    <input id="qc-disp-notes" type="text" maxlength="1000" @bind="dispNotes" />
                                </div>
                            </div>
                            <div class="write-actions">
                                <BitButton IsEnabled="@(!modalBusy && (dispAcceptQty + dispRejectQty) > 0m)" OnClick="SubmitDispositionAsync">
                                    @Text["QcRecordDispositionBtn"]
                                </BitButton>
                                @if (q.AcceptedBaseQuantity == 0m && q.RejectedBaseQuantity == 0m)
                                {
                                    <BitButton Variant="BitVariant.Outline" IsEnabled="@(!modalBusy)" OnClick="CancelHoldAsync">
                                        @Text["QcCancelHoldBtn"]
                                    </BitButton>
                                }
                            </div>
                        </div>
                    }
                    else if (selectedInspection.Lines.Count > 0)
                    {
                        <div class="audit-modal-section">
                            <h3 class="audit-section-heading">@Text["QcMeasurementsSection"]</h3>
                            <div class="audit-fields-box">
                                <table class="audit-fields-table">
                                    <thead>
                                        <tr>
                                            <th>#</th>
                                            <th>@Text["QcParamNamePlaceholder"]</th>
                                            <th>@Text["QcExpectedSpecPlaceholder"]</th>
                                            <th>@Text["QcMeasuredValPlaceholder"]</th>
                                            <th>@Text["ReadStatus"]</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var l in selectedInspection.Lines)
                                        {
                                            <tr>
                                                <td>@l.LineNumber</td>
                                                <td>
                                                    @if (!string.IsNullOrWhiteSpace(l.Symbol))
                                                    {
                                                        <strong class="qc-symbol-chip" dir="ltr">@l.Symbol</strong>
                                                    }
                                                    <span>@l.ParameterName</span>
                                                    @if (l.IsMandatory) { <span class="qc-mandatory-star">*</span> }
                                                    @if (!string.IsNullOrWhiteSpace(l.TestMethod))
                                                    {
                                                        <div class="read-sub-cell" dir="ltr">@l.TestMethod</div>
                                                    }
                                                </td>
                                                <td dir="ltr">@(l.ExpectedSpec ?? "—")</td>
                                                <td dir="ltr">
                                                    @(l.MeasuredValue ?? "—")
                                                    @if (!string.IsNullOrWhiteSpace(l.UnitSymbol) && !string.IsNullOrWhiteSpace(l.MeasuredValue))
                                                    {
                                                        <span class="read-sub-cell"> @l.UnitSymbol</span>
                                                    }
                                                </td>
                                                <td>
                                                    <span class="read-badge @(l.IsPassed ? "qc-status-completed" : "rpt-shortage-badge")">
                                                        @Text[l.IsPassed ? "QcPassedCheck" : "QcFailedLabel"]
                                                    </span>
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    }
                </div>
            }
        </Body>
    </BitDialog>

    <BitDialog Width="580px" MaxWidth="calc(100vw - 24px)" Classes="@DialogClasses" @bind-IsOpen="lotModalOpen"
               Title="@Text["QcLotUpsertTitle"]" AriaLabel="@Text["QcLotUpsertTitle"]"
               CloseButtonTitle="@Text["ReadClose"]" ShowOkButton="false" ShowCancelButton="false" ShowCloseButton="true"
               AutoFocus="true" TrapFocus="true" RestoreFocus="true" CloseOnEscape="true">
        <Body>
            <div class="audit-modal-body">
                @if (lotError is not null)
                {
                    <p role="alert" class="write-error">@Text[lotError]</p>
                }
                <div class="po-form-grid">
                    <div class="write-field">
                        <label for="qc-lot-item">@Text["BomLineItemColumn"]</label>
                        <select id="qc-lot-item" @bind="lotEditItemId" disabled="@(editingLot is not null)">
                            <option value="0">@Text["InvSelectItemOption"]</option>
                            @foreach (var it in activeItems)
                            {
                                <option value="@it.Id">@it.Code — @it.Name</option>
                            }
                        </select>
                    </div>
                    <div class="write-field">
                        <label for="qc-lot-code">@Text["InvLotCodeLabel"]</label>
                        <input id="qc-lot-code" type="text" maxlength="32" @bind="lotEditCode" disabled="@(editingLot is not null)" />
                    </div>
                    <div class="write-field">
                        <label>@Text["QcLotMfgDateLabel"]</label>
                        <BitDatePicker @bind-Value="lotMfgDateOffset" Class="bom-dtp" Culture="@Culture.PickerCulture" DateFormat="@PickerDateFormat"
                                       ShowTimePicker="false" AllowTextInput="false" AutoClose="true" ShowClearButton="true" ShowGoToToday="true"
                                       GoToTodayTitle="@Text["BomDateToday"]" GoToTodayIcon="@TodayIcon" Icon="@CalendarIcon"
                                       NextMonthNavIcon="@NextNavIcon" PrevMonthNavIcon="@PrevNavIcon" NextYearNavIcon="@NextYearIcon" PrevYearNavIcon="@PrevYearIcon" ClearButtonIcon="@CloseIcon" />
                    </div>
                    <div class="write-field">
                        <label>@Text["QcLotExpDateLabel"]</label>
                        <BitDatePicker @bind-Value="lotExpDateOffset" Class="bom-dtp" Culture="@Culture.PickerCulture" DateFormat="@PickerDateFormat"
                                       ShowTimePicker="false" AllowTextInput="false" AutoClose="true" ShowClearButton="true" ShowGoToToday="true"
                                       GoToTodayTitle="@Text["BomDateToday"]" GoToTodayIcon="@TodayIcon" Icon="@CalendarIcon"
                                       NextMonthNavIcon="@NextNavIcon" PrevMonthNavIcon="@PrevNavIcon" NextYearNavIcon="@NextYearIcon" PrevYearNavIcon="@PrevYearIcon" ClearButtonIcon="@CloseIcon" />
                    </div>
                    <div class="write-field po-field-full">
                        <label for="qc-lot-notes">@Text["PoNotesLabel"]</label>
                        <textarea id="qc-lot-notes" rows="2" maxlength="500" @bind="lotEditNotes"></textarea>
                    </div>
                </div>
                <div class="po-dialog-footer">
                    <BitButton IsEnabled="@(!modalBusy && lotEditItemId > 0 && !string.IsNullOrWhiteSpace(lotEditCode))" OnClick="SubmitLotMetadataAsync">
                        @Text["WriteSave"]
                    </BitButton>
                    <BitButton Variant="BitVariant.Outline" OnClick="() => lotModalOpen = false">@Text["WriteCancel"]</BitButton>
                </div>
            </div>
        </Body>
    </BitDialog>

    <ForgeFormDialog IsOpen="@paramModalOpen" IsOpenChanged="v => paramModalOpen = v" Width="640px"
                     Title="@Text[editingParam is null ? "QcCreateParameterTitle" : "QcEditParameterTitle"]"
                     Subtitle="@Text["QcParamModalSubtitle"]" CloseTitle="@Text["ReadClose"]">
        <ChildContent>
            @if (paramError is not null)
            {
                <p role="alert" class="write-error">@Text[paramError]</p>
            }
            <div class="po-form-grid">
                <div class="write-field">
                    <label for="qc-param-code">@Text["ReadCode"]</label>
                    <input id="qc-param-code" type="text" maxlength="32" @bind="paramCode" disabled="@(editingParam is not null || modalBusy)" placeholder="MFI" />
                </div>
                <div class="write-field">
                    <label for="qc-param-symbol">@Text["QcParamSymbolLabel"]</label>
                    <input id="qc-param-symbol" type="text" maxlength="24" @bind="paramSymbol" disabled="@modalBusy" placeholder="MFI" />
                </div>
                <div class="write-field po-field-full">
                    <label for="qc-param-name">@Text["ReadName"]</label>
                    <input id="qc-param-name" type="text" maxlength="120" @bind="paramName" disabled="@modalBusy" placeholder="Melt Flow Index" />
                </div>
                <div class="write-field">
                    <label for="qc-param-unit">@Text["QcParamUnitLabel"]</label>
                    <input id="qc-param-unit" type="text" maxlength="24" @bind="paramUnitSymbol" disabled="@modalBusy" placeholder="g/10min" />
                </div>
                <div class="write-field">
                    <label for="qc-param-type">@Text["AttributeDataTypeLabel"]</label>
                    <select id="qc-param-type" @bind="paramDataType" disabled="@(editingParam is not null || modalBusy)">
                        <option value="@QualityParameterDataType.Numeric">@ParamDataTypeLabel(QualityParameterDataType.Numeric)</option>
                        <option value="@QualityParameterDataType.Text">@ParamDataTypeLabel(QualityParameterDataType.Text)</option>
                        <option value="@QualityParameterDataType.Boolean">@ParamDataTypeLabel(QualityParameterDataType.Boolean)</option>
                    </select>
                </div>
                @if (paramDataType == QualityParameterDataType.Numeric)
                {
                    <div class="write-field">
                        <label for="qc-param-dec">@Text["QcParamDecimalLabel"]</label>
                        <input id="qc-param-dec" type="number" min="0" max="6" @bind="paramDecimalPlaces" disabled="@modalBusy" />
                    </div>
                }
                <div class="write-field @(paramDataType == QualityParameterDataType.Numeric ? string.Empty : "po-field-full")">
                    <label for="qc-param-method">@Text["QcParamMethodLabel"]</label>
                    <input id="qc-param-method" type="text" maxlength="64" @bind="paramTestMethod" disabled="@modalBusy" placeholder="ASTM D1238" />
                </div>
            </div>
        </ChildContent>
        <FooterActions>
            <BitButton IsEnabled="@(!modalBusy && !string.IsNullOrWhiteSpace(paramCode) && !string.IsNullOrWhiteSpace(paramName) && !string.IsNullOrWhiteSpace(paramSymbol))"
                       OnClick="SubmitParameterAsync">@Text["WriteSave"]</BitButton>
            <BitButton Variant="BitVariant.Outline" OnClick="() => paramModalOpen = false">@Text["WriteCancel"]</BitButton>
        </FooterActions>
    </ForgeFormDialog>

    <ForgeFormDialog IsOpen="@specModalOpen" IsOpenChanged="v => specModalOpen = v" Width="920px"
                     Title="@Text[editingSpec is null ? "QcCreateSpecTitle" : "QcEditSpecTitle"]"
                     Subtitle="@Text["QcSpecModalSubtitle"]" CloseTitle="@Text["ReadClose"]">
        <ChildContent>
            @if (specError is not null)
            {
                <p role="alert" class="write-error">@Text[specError]</p>
            }
            <div class="po-form-grid">
                <div class="write-field">
                    <label for="qc-spec-code">@Text["ReadCode"]</label>
                    <input id="qc-spec-code" type="text" maxlength="32" @bind="specCode" disabled="@(editingSpec is not null || !scopeCanManage || modalBusy)" placeholder="SPEC-STYRENE-IN" />
                </div>
                <div class="write-field">
                    <label for="qc-spec-ver">@Text["QcSpecVersionLabel"]</label>
                    <input id="qc-spec-ver" type="number" min="1" @bind="specVersion" disabled="@(editingSpec is not null || !scopeCanManage || modalBusy)" />
                </div>
                <div class="write-field po-field-full">
                    <label for="qc-spec-name">@Text["ReadName"]</label>
                    <input id="qc-spec-name" type="text" maxlength="120" @bind="specName" disabled="@(!scopeCanManage || modalBusy)" />
                </div>
                <div class="write-field">
                    <label for="qc-spec-tkind">@Text["QcSpecTargetKindLabel"]</label>
                    <select id="qc-spec-tkind" @bind="specTargetKind" disabled="@(editingSpec is not null || !scopeCanManage || modalBusy)">
                        <option value="@QualitySpecTargetKind.Item">@Text["QcTargetItem"]</option>
                        <option value="@QualitySpecTargetKind.Classification">@Text["QcTargetClassification"]</option>
                    </select>
                </div>
                @if (specTargetKind == QualitySpecTargetKind.Item)
                {
                    <div class="write-field">
                        <label for="qc-spec-item">@Text["BomLineItemColumn"]</label>
                        <select id="qc-spec-item" @bind="specTargetItemId" disabled="@(editingSpec is not null || !scopeCanManage || modalBusy)">
                            <option value="0">@Text["InvSelectItemOption"]</option>
                            @foreach (var it in activeItems)
                            {
                                <option value="@it.Id">@it.Code — @it.Name</option>
                            }
                        </select>
                    </div>
                }
                else
                {
                    <div class="write-field">
                        <label for="qc-spec-cls">@Text["QcTargetClassification"]</label>
                        <select id="qc-spec-cls" @bind="specTargetClassId" disabled="@(editingSpec is not null || !scopeCanManage || modalBusy)">
                            <option value="0">—</option>
                            @foreach (var cls in activeClassifications)
                            {
                                <option value="@cls.Id">@cls.ClassificationSetName: @cls.Code — @cls.Name</option>
                            }
                        </select>
                    </div>
                }
                <div class="write-field">
                    <label for="qc-spec-ckpt">@Text["QcSpecCheckpointLabel"]</label>
                    <select id="qc-spec-ckpt" @bind="specCheckpoint" disabled="@(!scopeCanManage || modalBusy)">
                        <option value="@QualitySpecCheckpoint.Incoming">@Text["QcCheckpointIncoming"]</option>
                        <option value="@QualitySpecCheckpoint.Production">@Text["QcCheckpointProduction"]</option>
                        <option value="@QualitySpecCheckpoint.All">@Text["QcCheckpointAll"]</option>
                    </select>
                </div>
                <div class="write-field">
                    <label for="qc-spec-notes">@Text["PoNotesLabel"]</label>
                    <input id="qc-spec-notes" type="text" maxlength="1000" @bind="specNotes" disabled="@(!scopeCanManage || modalBusy)" />
                </div>
            </div>

            <div class="po-context-card qc-spec-lines-box">
                <div class="po-context-head">
                    <strong>@Text["QcSpecLinesHeading"]</strong>
                    @if (scopeCanManage)
                    {
                        <BitButton Variant="BitVariant.Outline" Size="BitSize.Small" Icon="@PlusIcon" OnClick="AddSpecLine">
                            @Text["QcAddSpecLineBtn"]
                        </BitButton>
                    }
                </div>
                @foreach (var sl in specLines)
                {
                    var selectedP = activeParameters.FirstOrDefault(p => p.Id == sl.QualityParameterId);
                    <div class="qc-spec-line-row">
                        <select value="@sl.QualityParameterId" @onchange="e => OnSpecLineParamChanged(sl, e)" disabled="@(!scopeCanManage || modalBusy)">
                            <option value="0">—</option>
                            @foreach (var p in activeParameters)
                            {
                                <option value="@p.Id">@p.Code — @p.Name (@p.Symbol@(string.IsNullOrWhiteSpace(p.UnitSymbol) ? string.Empty : $", {p.UnitSymbol}"))</option>
                            }
                        </select>
                        @if (selectedP is null || selectedP.DataType == QualityParameterDataType.Numeric)
                        {
                            <input type="number" step="any" @bind="sl.MinValue" placeholder="@Text["QcSpecMinLabel"]" disabled="@(!scopeCanManage || modalBusy)" />
                            <input type="number" step="any" @bind="sl.MaxValue" placeholder="@Text["QcSpecMaxLabel"]" disabled="@(!scopeCanManage || modalBusy)" />
                            <input type="number" step="any" @bind="sl.TargetValue" placeholder="@Text["QcSpecTargetValLabel"]" disabled="@(!scopeCanManage || modalBusy)" />
                        }
                        else
                        {
                            <input type="text" maxlength="100" @bind="sl.ExpectedTextSpec" placeholder="@Text["QcExpectedSpecPlaceholder"]" disabled="@(!scopeCanManage || modalBusy)" />
                        }
                        <label class="perm-check">
                            <input type="checkbox" @bind="sl.IsMandatory" disabled="@(!scopeCanManage || modalBusy)" />
                            <span>@Text["QcMandatoryLabel"]</span>
                        </label>
                        @if (scopeCanManage)
                        {
                            <BitButton Variant="BitVariant.Outline" Size="BitSize.Small" OnClick="() => specLines.Remove(sl)">@Text["BomRemoveRowBtn"]</BitButton>
                        }
                    </div>
                }
            </div>
        </ChildContent>
        <FooterActions>
            @if (scopeCanManage)
            {
                <BitButton IsEnabled="@(!modalBusy && !string.IsNullOrWhiteSpace(specCode) && !string.IsNullOrWhiteSpace(specName) && specLines.Count > 0)"
                           OnClick="SubmitSpecAsync">@Text["WriteSave"]</BitButton>
            }
            <BitButton Variant="BitVariant.Outline" OnClick="() => specModalOpen = false">@Text[scopeCanManage ? "WriteCancel" : "ReadClose"]</BitButton>
        </FooterActions>
    </ForgeFormDialog>

    @if (CurrentScope is not null)
    {
        <LotCertificateDialog @bind-IsOpen="coaOpen" Scope="@CurrentScope" OrganizationId="@ScopeOrganizationId(CurrentScope)"
                              ItemId="@coaItemId" LotCode="@coaLotCode" />
    }
</section>

@code {
    [Parameter] public long? OrganizationId { get; set; }

