    private OrganizationScope? CurrentScope => scopeIndex >= 0 && scopeIndex < available.Count ? available[scopeIndex] : null;
    private static long ScopeOrganizationId(OrganizationScope scope) => scope switch
    {
        OrganizationScope.Organization o => o.OrganizationId,
        OrganizationScope.Site s => s.OrganizationId,
        _ => 0
    };

    private BitDataGridStrings GridStrings => new()
    {
        GridLabel = Text["QualityControl"],
        EmptyText = Text["ReadEmpty"],
        NoMatchesText = Text["ReadEmpty"],
        LoadingText = Text["ReadLoading"],
        PagerRangeFormat = Text["GridPagerRange"],
        PagerPageFormat = Text["GridPagerPage"],
        PerPageFormat = Text["GridPerPage"],
        RowsPerPageLabel = Text["GridRowsPerPage"],
        FirstPageLabel = Text["GridFirstPage"],
        PreviousPageLabel = Text["GridPreviousPage"],
        NextPageLabel = Text["GridNextPage"],
        LastPageLabel = Text["GridLastPage"],
        AnnouncementPage = Text["GridPagerPage"]
    };

    protected override async Task OnParametersSetAsync() => await ReloadScopeAsync();

    private async Task ReloadScopeAsync()
    {
        initialLoading = true;
        pageError = null;
        pageNotice = null;
        try
        {
            var loaded = await Scopes.LoadQualityScopesAsync();
            available = OrganizationId is long orgId
                ? loaded.Where(s => ScopeOrganizationId(s) == orgId).ToList()
                : loaded.ToList();
            scopeLabels = await Scopes.LoadDisplayInfoAsync(available);
            if (available.Count == 0 && OrganizationId is long fallbackOrgId)
                available = [new OrganizationScope.Organization(fallbackOrgId)];
            scopeIndex = 0;
            await RefreshScopeStateAsync();
        }
        catch { pageError = "ReadError"; }
        finally { initialLoading = false; }
    }

    private async Task RefreshScopeStateAsync()
    {
        scopeCanManage = false;
        authorizedSites = [];
        activeWarehouses = [];
        activeItems = [];
        activeUnits = [];
        activeClassifications = [];
        activeParameters = [];
        var scope = CurrentScope;
        if (scope is null) return;

        var actor = await Actors.ResolveAsync(default);
        if (actor is not null)
            scopeCanManage = (await Permissions.EvaluateAsync(actor, scope, QualityPermissions.QualityManage, default)).IsAllowed;

        var orgId = ScopeOrganizationId(scope);
        var sitesRes = await OrderService.ListAuthorizedSites(scope, orgId);
        if (sitesRes.Succeeded) authorizedSites = sitesRes.Value!;
        var whRes = await InvService.ListWarehouses(scope, orgId, new WarehouseListQuery(IncludeInactive: false, PageSize: 100));
        if (whRes.Succeeded) activeWarehouses = whRes.Value!.Items;
        var itemsRes = await ItemService.ListActiveItems(scope, orgId);
        if (itemsRes.Succeeded) activeItems = itemsRes.Value!;
        var unitsRes = await UnitService.ListActiveUnits(scope, orgId);
        if (unitsRes.Succeeded) activeUnits = unitsRes.Value!;
        var clsRes = await ItemService.ListActiveClassifications(scope, orgId);
        if (clsRes.Succeeded) activeClassifications = clsRes.Value!;
        var paramRes = await SpecService.ListParameters(scope, orgId, new QualityParameterListQuery(IncludeInactive: false, PageSize: 100));
        if (paramRes.Succeeded) activeParameters = paramRes.Value!.Items;
    }

    private async Task SwitchTabAsync(int tab)
    {
        if (activeTab == tab) return;
        activeTab = tab;
        await ReloadActiveGridAsync(true);
    }

    private async Task ChangeScopeAsync(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out var idx) && idx >= 0 && idx < available.Count)
        {
            scopeIndex = idx;
            siteFilter = 0;
            await RefreshScopeStateAsync();
            await ReloadActiveGridAsync(true);
        }
    }

    private async Task ChangeSiteFilterAsync(ChangeEventArgs e)
    {
        siteFilter = long.TryParse(e.Value?.ToString(), out var id) ? id : 0;
        await ReloadActiveGridAsync(true);
    }

    private async Task ChangeStatusFilterAsync(ChangeEventArgs e)
    {
        statusFilter = e.Value?.ToString() ?? string.Empty;
        await ReloadActiveGridAsync(true);
    }

    private async Task ToggleExpiringLotsAsync(ChangeEventArgs e)
    {
        onlyExpiringLots = e.Value is bool b && b;
        await ReloadActiveGridAsync(true);
    }

    private async Task ToggleInactiveParamsAsync(ChangeEventArgs e)
    {
        includeInactiveParams = e.Value is bool b && b;
        await ReloadActiveGridAsync(true);
    }

    private async Task ToggleInactiveSpecsAsync(ChangeEventArgs e)
    {
        includeInactiveSpecs = e.Value is bool b && b;
        await ReloadActiveGridAsync(true);
    }

    private async Task ChangeSpecTargetFilterAsync(ChangeEventArgs e)
    {
        specTargetFilter = e.Value?.ToString() ?? string.Empty;
        await ReloadActiveGridAsync(true);
    }

    private async Task ChangeSpecCheckpointFilterAsync(ChangeEventArgs e)
    {
        specCheckpointFilter = e.Value?.ToString() ?? string.Empty;
        await ReloadActiveGridAsync(true);
    }

    private async Task ApplySearchAsync()
    {
        appliedSearch = string.IsNullOrWhiteSpace(search) ? null : search.Trim();
        await ReloadActiveGridAsync(true);
    }

    private async Task ReloadActiveGridAsync(bool fromFirstPage)
    {
        if (activeTab == TabInspections && inspGrid is not null)
        {
            if (fromFirstPage && inspGrid.CurrentPage > 1) await inspGrid.GoToPageAsync(1);
            else await inspGrid.RefreshAsync();
        }
        else if (activeTab == TabLots && lotGrid is not null)
        {
            if (fromFirstPage && lotGrid.CurrentPage > 1) await lotGrid.GoToPageAsync(1);
            else await lotGrid.RefreshAsync();
        }
        else if (activeTab == TabParameters && paramGrid is not null)
        {
            if (fromFirstPage && paramGrid.CurrentPage > 1) await paramGrid.GoToPageAsync(1);
            else await paramGrid.RefreshAsync();
        }
        else if (activeTab == TabSpecs && specGrid is not null)
        {
            if (fromFirstPage && specGrid.CurrentPage > 1) await specGrid.GoToPageAsync(1);
            else await specGrid.RefreshAsync();
        }
    }

    private async Task<BitDataGridReadResult<QualityInspectionSummary>> ReadInspectionsAsync(BitDataGridReadRequest req)
    {
        var scope = CurrentScope;
        if (scope is null) return new([], 0);
        var size = Math.Clamp(req.Take ?? 25, 1, 100);
        var page = (req.Skip / size) + 1;
        QualityInspectionStatus? st = byte.TryParse(statusFilter, out var s) && Enum.IsDefined((QualityInspectionStatus)s)
            ? (QualityInspectionStatus)s
            : null;
        var res = await QualityService.ListInspections(scope, ScopeOrganizationId(scope),
            new QualityInspectionListQuery(siteFilter > 0 ? siteFilter : null, null, null, st, appliedSearch, page, size), req.CancellationToken);
        if (!res.Succeeded) { pageError = RolePermissionLocalization.FailureKey(res.Error!.Code); StateHasChanged(); return new([], 0); }
        return new(res.Value!.Items.ToList(), res.Value.Total);
    }

    private async Task<BitDataGridReadResult<ItemLotSummary>> ReadLotsAsync(BitDataGridReadRequest req)
    {
        var scope = CurrentScope;
        if (scope is null) return new([], 0);
        var size = Math.Clamp(req.Take ?? 25, 1, 100);
        var page = (req.Skip / size) + 1;
        var res = await QualityService.ListItemLots(scope, ScopeOrganizationId(scope),
            new ItemLotListQuery(null, appliedSearch, onlyExpiringLots, page, size), req.CancellationToken);
        if (!res.Succeeded) { pageError = RolePermissionLocalization.FailureKey(res.Error!.Code); StateHasChanged(); return new([], 0); }
        return new(res.Value!.Items.ToList(), res.Value.Total);
    }

    private async Task<BitDataGridReadResult<QualityParameterSummary>> ReadParametersAsync(BitDataGridReadRequest req)
    {
        var scope = CurrentScope;
        if (scope is null) return new([], 0);
        var size = Math.Clamp(req.Take ?? 25, 1, 100);
        var page = (req.Skip / size) + 1;
        var res = await SpecService.ListParameters(scope, ScopeOrganizationId(scope),
            new QualityParameterListQuery(includeInactiveParams, appliedSearch, page, size), req.CancellationToken);
        if (!res.Succeeded) { pageError = RolePermissionLocalization.FailureKey(res.Error!.Code); StateHasChanged(); return new([], 0); }
        return new(res.Value!.Items.ToList(), res.Value.Total);
    }

    private async Task<BitDataGridReadResult<QualitySpecSummary>> ReadSpecsAsync(BitDataGridReadRequest req)
    {
        var scope = CurrentScope;
        if (scope is null) return new([], 0);
        var size = Math.Clamp(req.Take ?? 25, 1, 100);
        var page = (req.Skip / size) + 1;
        QualitySpecTargetKind? targetKind = byte.TryParse(specTargetFilter, out var tk) && Enum.IsDefined((QualitySpecTargetKind)tk)
            ? (QualitySpecTargetKind)tk : null;
        QualitySpecCheckpoint? checkpoint = byte.TryParse(specCheckpointFilter, out var ck) && Enum.IsDefined((QualitySpecCheckpoint)ck)
            ? (QualitySpecCheckpoint)ck : null;
        var res = await SpecService.ListSpecs(scope, ScopeOrganizationId(scope),
            new QualitySpecListQuery(targetKind, checkpoint, includeInactiveSpecs, appliedSearch, page, size), req.CancellationToken);
        if (!res.Succeeded) { pageError = RolePermissionLocalization.FailureKey(res.Error!.Code); StateHasChanged(); return new([], 0); }
        return new(res.Value!.Items.ToList(), res.Value.Total);
    }

    private Task OpenHoldModalAsync()
    {
        holdError = null;
        holdNumber = $"QCH-{DateTime.UtcNow:yyyyMMddHHmm}";
        holdWarehouseId = activeWarehouses.FirstOrDefault()?.Id ?? 0;
        var firstItem = activeItems.FirstOrDefault();
        holdItemId = firstItem?.Id ?? 0;
        holdUnitId = firstItem?.BaseUnitId ?? activeUnits.FirstOrDefault()?.Id ?? 0;
        holdLotCode = string.Empty;
        holdQuantity = 1m;
        holdDefectCode = null;
        holdNotes = null;
        holdModalOpen = true;
        return Task.CompletedTask;
    }

    private void OnHoldItemChanged(ChangeEventArgs e)
    {
        if (long.TryParse(e.Value?.ToString(), out var id))
        {
            holdItemId = id;
            var it = activeItems.FirstOrDefault(x => x.Id == id);
            if (it is not null) holdUnitId = it.BaseUnitId;
        }
    }

    private async Task SubmitManualHoldAsync()
    {
        var scope = CurrentScope;
        if (scope is null) return;
        modalBusy = true;
        holdError = null;
        try
        {
            var res = await QualityService.CreateManualHold(scope, new CreateManualQualityHoldRequest(
                ScopeOrganizationId(scope), holdWarehouseId, holdItemId, holdLotCode, holdNumber,
                holdQuantity, holdUnitId > 0 ? holdUnitId : null, holdDefectCode, holdNotes));
            if (!res.Succeeded) { holdError = RolePermissionLocalization.FailureKey(res.Error!.Code); return; }
            holdModalOpen = false;
            pageNotice = Text["QcHoldCreatedNotice"];
            await ReloadActiveGridAsync(true);
        }
        finally { modalBusy = false; }
    }

    private async Task OpenInspectionDetailsAsync(long id)
    {
        var scope = CurrentScope;
        if (scope is null) return;
        var res = await QualityService.GetInspection(scope, ScopeOrganizationId(scope), id);
        if (!res.Succeeded) { pageError = RolePermissionLocalization.FailureKey(res.Error!.Code); return; }
        var scrapPrev = await SeqService.GetPreview(scope, ScopeOrganizationId(scope), ForgeFlow.Domain.Organizations.DocumentSequenceType.QualityScrap);
        qcScrapAllowOverride = scrapPrev.Succeeded && scrapPrev.Value!.AllowManualOverride;
        qcScrapPreview = scrapPrev.Succeeded ? scrapPrev.Value!.NextPreview : null;
        ApplyInspectionDetails(res.Value!);
        detailsOpen = true;
    }

    private void ApplyInspectionDetails(QualityInspectionDetails details)
    {
        selectedInspection = details;
        detailsError = null;
        editCertificateNumber = details.Summary.CertificateNumber;
        editDefectCode = details.Summary.DefectReasonCode;
        editNotes = details.Summary.Notes;
        editLines.Clear();
        foreach (var l in details.Lines)
        {
            editLines.Add(new MeasurementEditRow
            {
                QualityParameterId = l.QualityParameterId,
                ParameterCode = l.ParameterCode,
                ParameterName = l.ParameterName,
                Symbol = l.Symbol,
                UnitSymbol = l.UnitSymbol,
                TestMethod = l.TestMethod,
                DataType = l.DataType,
                MinValue = l.MinValue,
                MaxValue = l.MaxValue,
                TargetValue = l.TargetValue,
                MeasuredNumericValue = l.MeasuredNumericValue,
                ExpectedSpec = l.ExpectedSpec,
                MeasuredValue = l.MeasuredValue,
                IsPassed = l.IsPassed,
                IsMandatory = l.IsMandatory,
                Notes = l.Notes
            });
        }
        dispAcceptQty = details.Summary.RemainingBlockedBaseQuantity;
        dispRejectQty = 0m;
        dispScrapDoc = qcScrapPreview;
        dispNotes = null;
    }

    private void AddMeasurementLine() => editLines.Add(new MeasurementEditRow());

    private void OnMeasurementParamChanged(MeasurementEditRow row, ChangeEventArgs e)
    {
        if (!long.TryParse(e.Value?.ToString(), NumberStyles.Integer, CultureInfo.InvariantCulture, out var pid) || pid <= 0)
        {
            row.QualityParameterId = null;
            row.ParameterCode = null;
            row.Symbol = null;
            row.UnitSymbol = null;
            row.TestMethod = null;
            row.DataType = QualityParameterDataType.Text;
            return;
        }
        var p = activeParameters.FirstOrDefault(x => x.Id == pid);
        if (p is null) return;
        row.QualityParameterId = p.Id;
        row.ParameterCode = p.Code;
        row.ParameterName = p.Name;
        row.Symbol = p.Symbol;
        row.UnitSymbol = p.UnitSymbol;
        row.TestMethod = p.DefaultTestMethod;
        row.DataType = p.DataType;
    }

    private void OnNumericMeasuredChanged(MeasurementEditRow row, ChangeEventArgs e)
    {
        if (decimal.TryParse(e.Value?.ToString(), NumberStyles.Number, CultureInfo.InvariantCulture, out var val))
        {
            row.MeasuredNumericValue = val;
            row.MeasuredValue = val.ToString("0.######", CultureInfo.InvariantCulture);
            if (row.MinValue.HasValue || row.MaxValue.HasValue)
                row.IsPassed = QualityInspectionLine.EvaluateNumericPass(row.MinValue, row.MaxValue, val);
        }
        else
        {
            row.MeasuredNumericValue = null;
            row.MeasuredValue = null;
            if (row.MinValue.HasValue || row.MaxValue.HasValue)
                row.IsPassed = false;
        }
    }

    private bool HasMandatoryFailure() => editLines.Any(l => l.IsMandatory && !l.IsPassed);

    private async Task ApplySpecToInspectionAsync()
    {
        var scope = CurrentScope;
        if (scope is null || selectedInspection is null) return;
        modalBusy = true;
        detailsError = null;
        try
        {
            var res = await SpecService.ApplySpecToInspection(
                scope,
                selectedInspection.Summary.OrganizationId,
                selectedInspection.Summary.Id,
                selectedInspection.Summary.RowVersion);
            if (!res.Succeeded) { detailsError = RolePermissionLocalization.FailureKey(res.Error!.Code); return; }
            ApplyInspectionDetails(res.Value!);
            pageNotice = Text["QcTemplateLoadedNotice"];
            await ReloadActiveGridAsync(false);
        }
        finally { modalBusy = false; }
    }

    private async Task SaveMeasurementsAsync()
    {
        var scope = CurrentScope;
        if (scope is null || selectedInspection is null) return;
        modalBusy = true;
        detailsError = null;
        try
        {
            var lines = editLines.Select(l => new QualityInspectionLineInput(
                l.ParameterName, l.ExpectedSpec, l.MeasuredValue, l.IsPassed, l.Notes,
                l.QualityParameterId, l.ParameterCode, l.Symbol, l.UnitSymbol, l.TestMethod,
                l.DataType, l.MinValue, l.MaxValue, l.TargetValue, l.MeasuredNumericValue, l.IsMandatory)).ToArray();
            var res = await QualityService.UpdateMeasurements(scope, new UpdateQualityMeasurementsRequest(
                selectedInspection.Summary.OrganizationId, selectedInspection.Summary.Id,
                editDefectCode, editNotes, lines, selectedInspection.Summary.RowVersion, editCertificateNumber));
            if (!res.Succeeded) { detailsError = RolePermissionLocalization.FailureKey(res.Error!.Code); return; }
            ApplyInspectionDetails(res.Value!);
            pageNotice = Text["WriteSaved"];
            await ReloadActiveGridAsync(false);
        }
        finally { modalBusy = false; }
    }

    private void OpenCoaModal(long itemId, string lotCode)
    {
        coaItemId = itemId;
        coaLotCode = lotCode;
        coaOpen = true;
    }

    private void OpenParameterModal(QualityParameterSummary? param)
    {
        paramError = null;
        editingParam = param;
        paramCode = param?.Code ?? string.Empty;
        paramName = param?.Name ?? string.Empty;
        paramSymbol = param?.Symbol ?? string.Empty;
        paramUnitSymbol = param?.UnitSymbol;
        paramDataType = param?.DataType ?? QualityParameterDataType.Numeric;
        paramDecimalPlaces = param?.DecimalPlaces ?? (byte)2;
        paramTestMethod = param?.DefaultTestMethod;
        paramModalOpen = true;
    }

    private async Task SubmitParameterAsync()
    {
        var scope = CurrentScope;
        if (scope is null) return;
        modalBusy = true;
        paramError = null;
        try
        {
            var orgId = ScopeOrganizationId(scope);
            OrganizationResult<QualityParameterSummary> res = editingParam is null
                ? await SpecService.CreateParameter(scope, new CreateQualityParameterRequest(
                    orgId, paramCode, paramName, paramSymbol, paramUnitSymbol, paramDataType, paramDecimalPlaces, paramTestMethod))
                : await SpecService.UpdateParameter(scope, new UpdateQualityParameterRequest(
                    orgId, editingParam.Id, paramName, paramSymbol, paramUnitSymbol, paramDecimalPlaces, paramTestMethod, editingParam.RowVersion));
            if (!res.Succeeded) { paramError = RolePermissionLocalization.FailureKey(res.Error!.Code); return; }
            paramModalOpen = false;
            pageNotice = Text["WriteSaved"];
            await RefreshScopeStateAsync();
            await ReloadActiveGridAsync(editingParam is null);
        }
        finally { modalBusy = false; }
    }

    private async Task ToggleParameterActiveAsync(QualityParameterSummary p)
    {
        var scope = CurrentScope;
        if (scope is null) return;
        modalBusy = true;
        try
        {
            var res = await SpecService.SetParameterActive(scope, new SetQualityParameterActiveRequest(
                p.OrganizationId, p.Id, !p.IsActive, p.RowVersion));
            if (!res.Succeeded) { pageError = RolePermissionLocalization.FailureKey(res.Error!.Code); return; }
            pageNotice = Text["WriteSaved"];
            await RefreshScopeStateAsync();
            await ReloadActiveGridAsync(false);
        }
        finally { modalBusy = false; }
    }

    private async Task OpenSpecModalAsync(long? specId)
    {
        var scope = CurrentScope;
        if (scope is null) return;
        specError = null;
        specLines.Clear();
        if (specId is null)
        {
            editingSpec = null;
            specCode = string.Empty;
            specName = string.Empty;
            specVersion = 1;
            specTargetKind = QualitySpecTargetKind.Classification;
            specTargetItemId = activeItems.FirstOrDefault()?.Id ?? 0;
            specTargetClassId = activeClassifications.FirstOrDefault()?.Id ?? 0;
            specCheckpoint = QualitySpecCheckpoint.Incoming;
            specNotes = null;
            AddSpecLine();
            specModalOpen = true;
            return;
        }

        var res = await SpecService.GetSpec(scope, ScopeOrganizationId(scope), specId.Value);
        if (!res.Succeeded || res.Value is null)
        {
            pageError = res.Succeeded ? "ReadNotFound" : RolePermissionLocalization.FailureKey(res.Error!.Code);
            return;
        }
        var d = res.Value;
        editingSpec = d.Summary;
        specCode = d.Summary.Code;
        specName = d.Summary.Name;
        specVersion = d.Summary.Version;
        specTargetKind = d.Summary.TargetKind;
        specTargetItemId = d.Summary.ItemId ?? 0;
        specTargetClassId = d.Summary.ClassificationId ?? 0;
        specCheckpoint = d.Summary.Checkpoint;
        specNotes = d.Summary.Notes;
        foreach (var l in d.Lines)
        {
            specLines.Add(new SpecLineEditRow
            {
                QualityParameterId = l.QualityParameterId,
                MinValue = l.MinValue,
                MaxValue = l.MaxValue,
                TargetValue = l.TargetValue,
                ExpectedTextSpec = l.ExpectedTextSpec,
                IsMandatory = l.IsMandatory,
                Notes = l.Notes
            });
        }
        specModalOpen = true;
    }

    private void AddSpecLine() => specLines.Add(new SpecLineEditRow
    {
        QualityParameterId = activeParameters.FirstOrDefault()?.Id ?? 0,
        IsMandatory = true
    });

    private void OnSpecLineParamChanged(SpecLineEditRow row, ChangeEventArgs e)
    {
        if (long.TryParse(e.Value?.ToString(), NumberStyles.Integer, CultureInfo.InvariantCulture, out var pid))
            row.QualityParameterId = pid;
    }

    private async Task SubmitSpecAsync()
    {
        var scope = CurrentScope;
        if (scope is null) return;
        modalBusy = true;
        specError = null;
        try
        {
            var orgId = ScopeOrganizationId(scope);
            var inputs = specLines.Select(l => new QualitySpecLineInput(
                l.QualityParameterId, l.MinValue, l.MaxValue, l.TargetValue, l.ExpectedTextSpec, l.IsMandatory, l.Notes)).ToArray();

            OrganizationResult<QualitySpecDetails> res = editingSpec is null
                ? await SpecService.CreateSpec(scope, new CreateQualitySpecRequest(
                    orgId, specCode, specName, specTargetKind,
                    specTargetKind == QualitySpecTargetKind.Item ? specTargetItemId : null,
                    specTargetKind == QualitySpecTargetKind.Classification ? specTargetClassId : null,
                    specCheckpoint, specVersion, specNotes, inputs))
                : await SpecService.UpdateSpec(scope, new UpdateQualitySpecRequest(
                    orgId, editingSpec.Id, specName, specCheckpoint, specNotes, inputs, editingSpec.RowVersion));
            if (!res.Succeeded) { specError = RolePermissionLocalization.FailureKey(res.Error!.Code); return; }
            specModalOpen = false;
            pageNotice = Text["WriteSaved"];
            await ReloadActiveGridAsync(editingSpec is null);
        }
        finally { modalBusy = false; }
    }

    private async Task ToggleSpecActiveAsync(QualitySpecSummary s)
    {
        var scope = CurrentScope;
        if (scope is null) return;
        modalBusy = true;
        try
        {
            var res = await SpecService.SetSpecActive(scope, new SetQualitySpecActiveRequest(
                s.OrganizationId, s.Id, !s.IsActive, s.RowVersion));
            if (!res.Succeeded) { pageError = RolePermissionLocalization.FailureKey(res.Error!.Code); return; }
            pageNotice = Text["WriteSaved"];
            await ReloadActiveGridAsync(false);
        }
        finally { modalBusy = false; }
    }

