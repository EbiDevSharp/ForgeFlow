    private async Task SubmitDirectPermissions()
    {
        if (permSaving || permSnapshot is null || RolesService is null) return;
        var token = revision;
        permSaving = true; permSaved = false; permError = null;
        try
        {
            var targetScope = permSiteId == 0 ? RoleScopeTarget.Organization : RoleScopeTarget.Site;
            long? siteId = permSiteId == 0 ? null : permSiteId;
            var existingByCode = permSnapshot.DirectGrants
                .Where(g => permSiteId == 0
                    ? g.ScopeTarget == RoleScopeTarget.Organization
                    : (g.ScopeTarget == RoleScopeTarget.Site && g.SiteId == permSiteId))
                .ToDictionary(g => g.PermissionCode, StringComparer.Ordinal);

            var changes = new List<OperationGrantChange>();
            foreach (var d in TargetDescriptors)
            {
                var desiredActive = directSelectedPerms.Contains(d.Code);
                if (existingByCode.TryGetValue(d.Code, out var existing))
                {
                    if (existing.IsActive != desiredActive)
                        changes.Add(new OperationGrantChange(d.Code, desiredActive, existing.RowVersion));
                }
                else if (desiredActive)
                {
                    changes.Add(new OperationGrantChange(d.Code, true, null));
                }
            }

            if (changes.Count == 0)
            {
                permSaved = true;
                return;
            }

            var res = await RolesService.SaveUserOperationGrants(
                Scope,
                new SaveUserOperationGrants(
                    Org(Scope),
                    permSnapshot.UserId,
                    targetScope,
                    siteId,
                    changes));
            if (!Current(token)) return;
            if (!res.Succeeded)
            {
                permError = RolePermissionLocalization.FailureKey(res.Error!.Code);
                return;
            }
            permSnapshot = res.Value;
            permSaved = true;
            SyncTargetScopePermissions();
        }
        catch
        {
            if (Current(token)) permError = "WriteUnavailable";
        }
        finally
        {
            if (!disposed) permSaving = false;
        }
    }
