    private void OpenAttach()
    {
        if (!canPlatformAttach || available.Count == 0) return;
        attachUserName = string.Empty;
        attachError = null;
        attachAssignAdmin = false;
        attachAssignSiteOperator = false;
        attachSelectedSiteIds.Clear();
        detailOpen = false;
        createOpen = false;
        attachOpen = true;
    }

    private void ToggleAttachSite(long siteId, bool isChecked)
    {
        if (isChecked) attachSelectedSiteIds.Add(siteId);
        else attachSelectedSiteIds.Remove(siteId);
    }

    private async Task SubmitAttach()
    {
        if (attaching || !canPlatformAttach || available.Count == 0) return;
        var token = revision;
        attaching = true; attachError = null; pageNotice = null;
        try
        {
            var result = await UsersService.AttachExistingUserToOrganization(
                new OrganizationScope.Platform(),
                new AttachExistingUserToOrganization(
                    Org(Scope),
                    attachUserName,
                    attachAssignAdmin,
                    attachSelectedSiteIds.ToArray(),
                    attachAssignSiteOperator));
            if (!Current(token)) return;
            if (!result.Succeeded)
            {
                attachError = FailureKey(result.Error!.Code);
                return;
            }
            attachUserName = string.Empty;
            attachOpen = false;
            pageNotice = Text["UserAttachedSucceeded", result.Value!.UserName];
            attaching = false;
            await ReloadGridFromFirstPage();
        }
        catch
        {
            if (Current(token)) attachError = "WriteUnavailable";
        }
        finally
        {
            if (!disposed) attaching = false;
        }
    }

    private IReadOnlyList<PermissionModule> TargetModules => TargetDescriptors
        .Select(d => d.Module)
        .Distinct()
        .ToList();

    private IReadOnlyList<PermissionDescriptor> TargetDescriptors => permSiteId == 0
        ? RolePermissionLocalization.OrganizationScopePermissions
        : RolePermissionLocalization.SiteScopePermissions;

    private void ChangePermSelectedModule(ChangeEventArgs e)
    {
        if (byte.TryParse(e.Value?.ToString(), out var raw) && Enum.IsDefined((PermissionModule)raw))
        {
            var candidate = (PermissionModule)raw;
            if (TargetModules.Contains(candidate))
                permSelectedModule = candidate;
        }
    }

    private bool IsTargetOrgAdmin => permSnapshot is not null && permSnapshot.AssignedRoles.Any(
        x => x.RoleId == PermissionCatalog.OrganizationAdministratorRoleId && x.IsActive && x.ScopeTarget == RoleScopeTarget.Organization);

    private IReadOnlyList<UserAssignedRoleDetails> ScopedRoleAssignmentsForTarget => permSnapshot is null
        ? []
        : permSnapshot.AssignedRoles
            .Where(x => permSiteId == 0
                ? x.ScopeTarget == RoleScopeTarget.Organization
                : (x.ScopeTarget == RoleScopeTarget.Site && x.SiteId == permSiteId))
            .ToList();

    private IReadOnlyList<RoleDetails> AssignableRolesForTarget
    {
        get
        {
            if (permSnapshot is null) return [];
            var targetScope = permSiteId == 0 ? RoleScopeTarget.Organization : RoleScopeTarget.Site;
            var existingRoleIds = ScopedRoleAssignmentsForTarget.Select(x => x.RoleId).ToHashSet();
            return orgRoleDetails
                .Where(r => r.IsActive && r.ScopeTarget == targetScope && !existingRoleIds.Contains(r.Id))
                .ToList();
        }
    }

    private async Task OpenPermissionsDialog(long userId)
    {
        if (RolesService is null || available.Count == 0) return;
        var token = revision;
        permSaving = false; permSaved = false; permError = null; permSiteId = 0;
        try
        {
            var userRes = await UsersService.GetOrganizationUser(Scope, Org(Scope), userId);
            var snapRes = await RolesService.GetUserPermissions(Scope, Org(Scope), userId);
            if (!Current(token)) return;
            if (!userRes.Succeeded || !snapRes.Succeeded)
            {
                error = RolePermissionLocalization.FailureKey((snapRes.Error ?? userRes.Error)!.Code);
                return;
            }
            permUserSites = userRes.Value!.Sites.Where(s => s.MembershipIsActive && s.SiteIsActive).ToList();
            permSnapshot = snapRes.Value;
            await LoadOrganizationRoleDetailsAsync(token);
            if (!Current(token)) return;
            SyncTargetScopePermissions();
            detailOpen = false;
            createOpen = false;
            attachOpen = false;
            permOpen = true;
        }
        catch
        {
            if (Current(token)) error = "ReadError";
        }
    }

    private async Task ReloadPermissionsDialog()
    {
        if (permSnapshot is null) return;
        await OpenPermissionsDialog(permSnapshot.UserId);
    }

    private async Task LoadOrganizationRoleDetailsAsync(int token)
    {
        var details = new List<RoleDetails>();
        if (RolesService is not null)
        {
            var listRes = await RolesService.ListOrganizationRoles(Scope, Org(Scope), new RoleListQuery(IncludeInactive: false, IncludeSystem: true, Page: 1, PageSize: 100));
            if (listRes.Succeeded && listRes.Value is not null)
            {
                foreach (var item in listRes.Value.Items)
                {
                    var d = await RolesService.GetOrganizationRole(Scope, Org(Scope), item.Id);
                    if (d.Succeeded && d.Value is not null)
                        details.Add(d.Value);
                }
            }
        }
        if (Current(token)) orgRoleDetails = details;
    }

    private void ChangePermTargetScope(ChangeEventArgs e)
    {
        if (long.TryParse(e.Value?.ToString(), out var siteId))
        {
            permSiteId = siteId;
            permError = null;
            permSaved = false;
            SyncTargetScopePermissions();
        }
    }

    private void SyncTargetScopePermissions()
    {
        directSelectedPerms.Clear();
        roleGrantedPerms.Clear();
        if (permSnapshot is null) return;

        foreach (var grant in permSnapshot.DirectGrants)
        {
            if (!grant.IsActive) continue;
            if (permSiteId == 0 && grant.ScopeTarget == RoleScopeTarget.Organization)
                directSelectedPerms.Add(grant.PermissionCode);
            else if (permSiteId > 0 && grant.ScopeTarget == RoleScopeTarget.Site && grant.SiteId == permSiteId)
                directSelectedPerms.Add(grant.PermissionCode);
        }

        var roleMap = orgRoleDetails.ToDictionary(x => x.Id, x => x.Permissions);
        foreach (var ra in permSnapshot.AssignedRoles.Where(x => x.IsActive))
        {
            var applies = ra.ScopeTarget == RoleScopeTarget.Organization
                || (permSiteId > 0 && ra.ScopeTarget == RoleScopeTarget.Site && ra.SiteId == permSiteId);
            if (!applies) continue;

            if (ra.RoleId == PermissionCatalog.OrganizationAdministratorRoleId)
            {
                foreach (var p in TargetDescriptors)
                    roleGrantedPerms.Add(p.Code);
            }
            else if (ra.RoleId == PermissionCatalog.SiteOperatorRoleId && permSiteId > 0)
            {
                roleGrantedPerms.Add("Sites.Read");
                roleGrantedPerms.Add("Sites.Update");
                roleGrantedPerms.Add("Sites.SetActive");
            }
            else if (roleMap.TryGetValue(ra.RoleId, out var codes))
            {
                foreach (var code in codes)
                {
                    if (TargetDescriptors.Any(d => d.Code == code))
                        roleGrantedPerms.Add(code);
                }
            }
        }

        selectedRoleIdToAssign = AssignableRolesForTarget.FirstOrDefault()?.Id ?? 0;
        if (!TargetModules.Contains(permSelectedModule) && TargetModules.Count > 0)
            permSelectedModule = TargetModules[0];
    }

