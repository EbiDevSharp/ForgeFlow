    private async Task ExecuteConfirm()
    {
        if (selected is null || confirmAction is null) return;
        var action = confirmAction.Value;
        confirmAction = null;
        var current = selected;
        switch (action)
        {
            case ConfirmActionKind.DisableAccount:
            case ConfirmActionKind.EnableAccount:
                var accountScope = !current.BelongsToSingleOrganization && canPlatformSetActive
                    ? (OrganizationScope)new OrganizationScope.Platform()
                    : Scope;
                long? accountOrgId = accountScope is OrganizationScope.Organization o ? o.OrganizationId : null;
                await RunMutationAsync(() => UsersService.SetUserActive(
                    accountScope,
                    new SetUserActive(accountOrgId, current.UserId, action == ConfirmActionKind.EnableAccount, current.AccountRowVersion)));
                break;
            case ConfirmActionKind.DisableOrgMembership:
            case ConfirmActionKind.EnableOrgMembership:
                await RunMutationAsync(() => UsersService.SetOrganizationMembershipActive(
                    Scope,
                    new SetOrganizationMembershipActive(Org(Scope), current.UserId, action == ConfirmActionKind.EnableOrgMembership, current.MembershipRowVersion)));
                break;
            case ConfirmActionKind.RevokeOrgAdmin:
                await RunMutationAsync(() => UsersService.SetTenantRoleActive(
                    Scope,
                    new SetTenantRoleActive(Org(Scope), current.UserId, TenantRoleKind.OrganizationAdministrator, null, false, current.OrganizationAdminRoleRowVersion)));
                break;
            case ConfirmActionKind.ResetPassword:
                var pwdScope = !current.BelongsToSingleOrganization && canPlatformResetPassword
                    ? (OrganizationScope)new OrganizationScope.Platform()
                    : Scope;
                long? pwdOrgId = pwdScope is OrganizationScope.Organization org ? org.OrganizationId : null;
                var newPassword = resetPasswordValue;
                resetPasswordValue = string.Empty;
                await RunMutationAsync(() => UsersService.ResetUserPassword(
                    pwdScope,
                    new ResetUserPassword(pwdOrgId, current.UserId, newPassword, current.AccountRowVersion, resetRequirePasswordChange)));
                break;
        }
    }

