    private async Task OpenPermissionsDialog(long userId)
    {
        if (RolesService is null || available.Count == 0) return;
        var token = revision;
        permSaving = false; permSaved = false; permError = null; permSiteId = 0;
        permFilter = "all"; permSearch = null; permAddRoleOpen = false; expandedPermModules.Clear();
        try
        {
            var userRes = await UsersService.GetOrganizationUser(Scope, Org(Scope), userId);
            var snapRes = await RolesService.GetUserPermissions(Scope, Org(Scope), userId);
            if (!Current(token)) return;
            if (!userRes.Succeeded || !snapRes.Succeeded)
            {
                error = RolePermissionLocalization.FailureKey((snapRes.Error ?? userRes.Error)!.Code);
                return;
            }
            permUserSites = userRes.Value!.Sites.Where(s => s.MembershipIsActive && s.SiteIsActive).ToList();
            permSnapshot = snapRes.Value;
            if (permUserSites.Count == 1 && !IsTargetOrgAdmin
                && !permSnapshot!.AssignedRoles.Any(r => r.IsActive && r.ScopeTarget == RoleScopeTarget.Organization)
                && !permSnapshot.DirectGrants.Any(g => g.IsActive && g.ScopeTarget == RoleScopeTarget.Organization))
            {
                permSiteId = permUserSites[0].SiteId;
            }
            await LoadOrganizationRoleDetailsAsync(token);
            if (!Current(token)) return;
            SyncTargetScopePermissions();
            detailOpen = false;
            createOpen = false;
            attachOpen = false;
            permOpen = true;
