    private IReadOnlyList<UserPermissionGroup> ActiveScopeGroups
    {
        get
        {
            var scopeKind = (byte)(permSiteId == 0 ? 1 : 2);
            long? siteId = permSiteId == 0 ? null : permSiteId;
            if (permSnapshot?.Groups is not null)
            {
                var serverGroups = permSnapshot.Groups
                    .Where(g => g.ScopeKind == scopeKind && g.SiteId == siteId)
                    .ToList();
                if (serverGroups.Count > 0)
                    return serverGroups;
            }

            return TargetDescriptors
                .GroupBy(d => d.Module)
                .Select(g => new UserPermissionGroup(
                    scopeKind,
                    siteId,
                    g.Key,
                    g.Select(d => new UserEffectivePermissionCell(
                        scopeKind,
                        siteId,
                        d.Code,
                        roleGrantedPerms.Contains(d.Code),
                        directSelectedPerms.Contains(d.Code),
                        roleGrantingNamesByCode.TryGetValue(d.Code, out var names) ? names : [])).ToList()))
                .ToList();
        }
    }

    private IReadOnlyList<UserPermissionGroup> FilteredAccordionGroups
    {
        get
        {
            var term = permSearch?.Trim();
            var list = new List<UserPermissionGroup>();
            foreach (var grp in ActiveScopeGroups)
            {
                if (!string.IsNullOrEmpty(term))
                {
                    var pageTitle = Text[RolePermissionLocalization.PageTitleKey(grp.Module)].Value;
                    var pageMatches = pageTitle.Contains(term, StringComparison.OrdinalIgnoreCase);
                    var opMatches = grp.Operations.Any(op =>
                        Text[RolePermissionLocalization.OperationLabelKey(op.PermissionCode)].Value.Contains(term, StringComparison.OrdinalIgnoreCase));
                    if (!pageMatches && !opMatches)
                        continue;
                }

                if (permFilter == "granted" && !grp.Operations.Any(op => roleGrantedPerms.Contains(op.PermissionCode) || directSelectedPerms.Contains(op.PermissionCode)))
                    continue;
                if (permFilter == "direct" && !grp.Operations.Any(op => !roleGrantedPerms.Contains(op.PermissionCode) && directSelectedPerms.Contains(op.PermissionCode)))
                    continue;
                if (permFilter == "dirty" && !grp.Operations.Any(op => !roleGrantedPerms.Contains(op.PermissionCode) && (directSelectedPerms.Contains(op.PermissionCode) != initialDirectPerms.Contains(op.PermissionCode))))
                    continue;

                list.Add(grp);
            }
            return list;
        }
    }

