@page "/users"
@page "/organizations/{OrganizationId:long}/users"
@page "/organizations/{OrganizationId:long}/users/{UserId:long}"
@page "/users/{UserId:long}"
@using ForgeFlow.Application.Organizations
@using ForgeFlow.Application.Roles
@using ForgeFlow.Application.Users
@using ForgeFlow.Domain.Organizations
@using ForgeFlow.Domain.Roles
@using ForgeFlow.Domain.Users
@using ForgeFlow.Web.Drafts
@using ForgeFlow.Web.Roles
@implements IDisposable
@inject UserUseCases UsersService
@inject RoleUseCases RolesService
@inject OrganizationUseCases OrganizationQueries
@inject ForgeFlow.Web.Organizations.ReadScopes Scopes
@inject IStringLocalizer<SharedResources> Text
@inject DisplayFormatter Format
@inject ITrustedActorAccessor Actors
@inject IOrganizationPermissionEvaluator Permissions
@inject DraftCoordinator Drafts

<PageTitle>@Text["Users"]</PageTitle>
<section class="organization-reader">
<div class="read-page-head">
    <h1 id="users-title">@Text["Users"]</h1>
    @if (!initialLoading && error is null && available.Count > 0)
    {
        <div class="read-head-actions">
            @if (scopeCanCreate)
            {
                <BitButton Size="BitSize.Small" IconName="Add" Class="read-create-btn" OnClick="OpenCreate">
                    @Text["CreateUserButton"]
                </BitButton>
            }
            @if (canPlatformAttach)
            {
                <BitButton Variant="BitVariant.Outline" Size="BitSize.Small" Class="read-create-btn" OnClick="OpenAttach">
                    @Text["AttachUserButton"]
                </BitButton>
            }
        </div>
    }
</div>

@if (pageNotice is not null)
{
    <p role="status" class="write-saved read-page-notice">@pageNotice</p>
}
@if (initialLoading)
{
    <p role="status">@Text["ReadLoading"]</p>
}
else if (error is not null)
{
    <p role="alert">@Text[error]</p>
    @if (OrganizationId > 0 || UserId > 0)
    {
        <p><a href="/users">@Text["Users"]</a></p>
    }
}
else if (available.Count == 0)
{
    <p role="status" class="read-empty">@Text["ReadDenied"]</p>
}
else
{
    <div class="read-toolbar-card">
        <div class="read-field">
            <label for="users-scope">@Text["ReadScope"]</label>
            <select id="users-scope" value="@scopeIndex" @onchange="ChangeScope">
                @for (var i = 0; i < available.Count; i++)
                {
                    <option value="@i">@ScopeLabel(available[i])</option>
                }
            </select>
        </div>
        <div class="read-field">
            <label for="users-search">@Text["ReadSearch"]</label>
            <input id="users-search" @bind="search" @bind:after="Search" maxlength="100" placeholder="@Text["UserSearchPlaceholder"]" />
        </div>
        <label class="read-inactive">
            <input type="checkbox" @bind="inactive" @bind:after="Search" /> @Text["ReadInactive"]
        </label>
    </div>

    <div class="read-grid-card">
        <div class="read-grid">
            <BitDataGrid @ref="grid" TItem="UserSummary" OnRead="ReadGridAsync" Pageable="true" PageSize="25" PageSizeOptions="@PageSizeOptions"
                         Strings="@GridStrings" SelectionMode="BitSelectionMode.Single" AriaLabelledBy="users-title" WrapCellText="true" Resizable="true">
                <EmptyTemplate><p role="status" class="read-empty">@Text["ReadEmpty"]</p></EmptyTemplate>
                <Columns>
                    <BitDataGridColumn TItem="UserSummary" Field="UserName" Title="@Text["UserUsername"]" />
                    <BitDataGridColumn TItem="UserSummary" Title="@Text["UserAccountStatus"]">
                        <Template Context="row">
                            <span class="read-badge @(row.AccountIsActive ? "active" : "inactive")">@Text[row.AccountIsActive ? "ReadActive" : "UserAccountDisabled"]</span>
                            @if (row.IsLockedOut)
                            {
                                <span class="read-badge locked">@Text["UserLockedBadge"]</span>
                            }
                        </Template>
                    </BitDataGridColumn>
                    <BitDataGridColumn TItem="UserSummary" Title="@Text["UserMembershipStatus"]">
                        <Template Context="row">
                            <span class="read-badge @(row.MembershipIsActive ? "active" : "inactive")">@Text[row.MembershipIsActive ? "UserMembershipActive" : "UserMembershipInactive"]</span>
                        </Template>
                    </BitDataGridColumn>
                    <BitDataGridColumn TItem="UserSummary" Title="@Text["UserRoleColumn"]">
                        <Template Context="row">
                            <span class="read-badge @(row.IsOrganizationAdmin ? "role" : "inactive")">@Text[row.IsOrganizationAdmin ? "UserOrgAdminRole" : "UserStandardRole"]</span>
                        </Template>
                    </BitDataGridColumn>
                    <BitDataGridColumn TItem="UserSummary" Title="@Text["UserSitesColumn"]">
                        <Template Context="row">@Text["UserSitesCount", row.ActiveSiteMembershipCount]</Template>
                    </BitDataGridColumn>
                    <BitDataGridColumn TItem="UserSummary" Title="@Text["ReadActions"]">
                        <Template Context="row">
                            <div class="read-row-actions">
                                <BitTooltip Text="@Text["ReadDetails"]" ShowOnFocus="true">
                                    <BitButton Variant="BitVariant.Outline" Size="BitSize.Small" Class="read-detail-action" IconName="View" IconOnly="true" aria-label="@Text["ReadDetails"]" OnClick="() => Detail(row.UserId)" />
                                </BitTooltip>
                                @if (ScopeCanEdit)
                                {
                                    <BitTooltip Text="@Text["ReadEdit"]" ShowOnFocus="true">
                                        <BitButton Variant="BitVariant.Outline" Size="BitSize.Small" Class="read-detail-action" Icon="@EditIcon" IconOnly="true" aria-label="@Text["ReadEdit"]" OnClick="() => Edit(row.UserId)" />
                                    </BitTooltip>
                                }
                                @if (ScopeCanManagePermissions)
                                {
                                    <BitTooltip Text="@Text["UserPermissionsButton"]" ShowOnFocus="true">
                                        <BitButton Variant="BitVariant.Outline" Size="BitSize.Small" Class="read-detail-action" Icon="@RoleIcon" IconOnly="true" aria-label="@Text["UserPermissionsButton"]" OnClick="() => OpenPermissionsDialog(row.UserId)" />
                                    </BitTooltip>
                                }
                                @if ((scopeCanSetAccountActive || canPlatformSetActive) && row.UserId != currentActorId)
                                {
                                    var actLabel = Text[row.AccountIsActive ? "UserDeactivateAccount" : "UserActivateAccount"].Value;
                                    <BitTooltip Text="@actLabel" ShowOnFocus="true">
                                        <BitButton Variant="BitVariant.Outline" Size="BitSize.Small"
                                                   Class="@(row.AccountIsActive ? "read-detail-action um-btn-danger" : "read-detail-action")"
                                                   Icon="@(row.AccountIsActive ? DeactivateIcon : ActivateIcon)" IconOnly="true"
                                                   aria-label="@actLabel" OnClick="() => PromptRowAccountActive(row)" />
                                    </BitTooltip>
                                }
                                @if (row.IsLockedOut && (scopeCanUnlock || canPlatformUnlock))
                                {
                                    <BitTooltip Text="@Text["UserUnlockButton"]" ShowOnFocus="true">
                                        <BitButton Variant="BitVariant.Outline" Size="BitSize.Small" Class="read-detail-action"
                                                   Icon="@UnlockIcon" IconOnly="true"
                                                   aria-label="@Text["UserUnlockButton"]" OnClick="() => PromptRowUnlock(row)" />
                                    </BitTooltip>
                                }
                            </div>
                        </Template>
                    </BitDataGridColumn>
                </Columns>
            </BitDataGrid>
        </div>
    </div>
}
</section>

<BitDialog Width="540px" MaxWidth="calc(100vw - 24px)" Classes="@DialogClasses" @bind-IsOpen="detailOpen"
           Title="@(editMode ? Text["UserEditModalTitle"] : Text["ReadDetails"])" AriaLabel="@(editMode ? Text["UserEditModalTitle"] : Text["ReadDetails"])"
           CloseButtonTitle="@Text["ReadClose"]" ShowOkButton="false" ShowCancelButton="false" ShowCloseButton="true"
           AutoFocus="true" TrapFocus="true" RestoreFocus="true" CloseOnEscape="true">
<Body>
@if (selected is not null)
{
    @if (!editMode)
    {
        <dl class="read-detail">
            <dt>@Text["UserUsername"]</dt>
            <dd dir="ltr">@selected.UserName</dd>
            <dt>@Text["UserAccountStatus"]</dt>
            <dd>
                <span class="read-badge @(selected.AccountIsActive ? "active" : "inactive")">@Text[selected.AccountIsActive ? "ReadActive" : "UserAccountDisabled"]</span>
                @if (selected.IsLockedOut)
                {
                    <span class="read-badge locked">@Text["UserLockedBadge"]</span>
                }
            </dd>
            <dt>@Text["UserMembershipStatus"]</dt>
            <dd><span class="read-badge @(selected.MembershipIsActive ? "active" : "inactive")">@Text[selected.MembershipIsActive ? "UserMembershipActive" : "UserMembershipInactive"]</span></dd>
            <dt>@Text["UserRoleColumn"]</dt>
            <dd><span class="read-badge @(selected.IsOrganizationAdmin ? "role" : "inactive")">@Text[selected.IsOrganizationAdmin ? "UserOrgAdminRole" : "UserStandardRole"]</span></dd>
            <dt>@Text["UserSitesColumn"]</dt>
            <dd>
                @if (selected.Sites.Count == 0)
                {
                    @Text["UserEmptySites"]
                }
                else
                {
                    <div class="user-site-list">
                        @foreach (var s in selected.Sites)
                        {
                            <div class="user-site-info">
                                <span dir="ltr">@s.SiteCode</span>
                                <span>— @s.SiteName</span>
                                <span class="read-badge @(s.MembershipIsActive ? "active" : "inactive")">@Text[s.MembershipIsActive ? "ReadActive" : "ReadInactiveStatus"]</span>
                                @if (s.IsSiteOperator)
                                {
                                    <span class="read-badge role">@Text["UserSiteOperatorRole"]</span>
                                }
                            </div>
                        }
                    </div>
                }
            </dd>
        </dl>
    }
    else
    {
        <div class="um-modal-panel">
            <div class="um-modal-user-head">
                <span class="um-username-ellipsis" dir="ltr" title="@selected.UserName">@selected.UserName</span>
                <span class="read-badge @(selected.AccountIsActive ? "active" : "inactive")">@Text[selected.AccountIsActive ? "ReadActive" : "UserAccountDisabled"]</span>
                @if (selected.IsLockedOut)
                {
                    <span class="read-badge locked">@Text["UserLockedBadge"]</span>
                }
            </div>

            <div class="um-tabs" role="tablist">
                <button type="button" role="tab" aria-selected="@(editTab == "access" ? "true" : "false")"
                        class="um-tab @(editTab == "access" ? "is-active" : string.Empty)"
                        @onclick='() => editTab = "access"'>
                    @Text["UserTabAccess"]
                </button>
                <button type="button" role="tab" aria-selected="@(editTab == "security" ? "true" : "false")"
                        class="um-tab @(editTab == "security" ? "is-active" : string.Empty)"
                        @onclick='() => editTab = "security"'>
                    @Text["UserTabSecurity"]
                </button>
            </div>

            @if (editTab == "access")
            {
                @if (scopeCanManageMemberships || scopeCanAssignRoles)
                {
                    <div class="um-section">
                        <p class="um-section-title">@Text["UserOrgMembershipCardTitle"]</p>
                        <div class="um-card">
                            <div class="um-card-top">
                                <span class="um-org-name">@ScopeOrgLabel</span>
                                @if (selected.IsOrganizationAdmin)
                                {
                                    <span class="read-badge role">@Text["UserOrgAdminRole"]</span>
                                }
                                else
                                {
                                    <span class="read-badge @(selected.MembershipIsActive ? "active" : "inactive")">@Text[selected.MembershipIsActive ? "UserMembershipActive" : "UserMembershipInactive"]</span>
                                }
                            </div>
                            <div class="write-actions">
                                @if (ScopeCanManagePermissions)
                                {
                                    <BitButton Variant="BitVariant.Outline" Size="BitSize.Small" IsEnabled="@(!saving)"
                                               OnClick="() => OpenPermissionsDialog(selected.UserId)">@Text["UserPermissionsButton"]</BitButton>
                                }
                                @if (scopeCanAssignRoles)
                                {
                                    @if (selected.IsOrganizationAdmin)
                                    {
                                        <BitButton Variant="BitVariant.Outline" Size="BitSize.Small" IsEnabled="@(!saving && selected.UserId != currentActorId)"
                                                   OnClick="@(() => AskConfirm(ConfirmActionKind.RevokeOrgAdmin))">@Text["UserRevokeOrgAdmin"]</BitButton>
                                    }
                                    else
                                    {
                                        <BitButton Variant="BitVariant.Outline" Size="BitSize.Small" IsEnabled="@(!saving && selected.MembershipIsActive)"
                                                   OnClick="GrantOrRestoreOrgAdmin">@Text["UserGrantOrgAdmin"]</BitButton>
                                    }
                                }
                                @if (scopeCanManageMemberships)
                                {
                                    @if (selected.MembershipIsActive)
                                    {
                                        <BitButton Variant="BitVariant.Outline" Size="BitSize.Small" Class="um-btn-danger" IsEnabled="@(!saving && selected.UserId != currentActorId)"
                                                   OnClick="@(() => AskConfirm(ConfirmActionKind.DisableOrgMembership))">@Text["UserDeactivateMembership"]</BitButton>
                                    }
                                    else
                                    {
                                        <BitButton Variant="BitVariant.Outline" Size="BitSize.Small" IsEnabled="@(!saving)"
                                                   OnClick="@(() => AskConfirm(ConfirmActionKind.EnableOrgMembership))">@Text["UserActivateMembership"]</BitButton>
                                    }
                                }
                            </div>
                        </div>
                    </div>
                }

                <div class="um-section">
                    <p class="um-section-title">@Text["UserSitesColumn"]</p>
                    @if (selected.Sites.Count == 0)
                    {
                        <p class="write-hint">@Text["UserEmptySites"]</p>
                    }
                    else
                    {
                        <div class="um-site-list">
                            @foreach (var s in selected.Sites)
                            {
                                <div class="um-site-row">
                                    <div class="user-site-info">
                                        <span class="um-chip" dir="ltr">@s.SiteCode</span>
                                        <span>@s.SiteName</span>
                                        <span class="read-badge @(s.MembershipIsActive ? "active" : "inactive")">@Text[s.MembershipIsActive ? "ReadActive" : "ReadInactiveStatus"]</span>
                                    </div>
                                    <div class="um-site-controls">
                                        @if (scopeCanManageMemberships)
                                        {
                                            <BitButton Variant="BitVariant.Outline" Size="BitSize.Small"
                                                       Class="@(s.MembershipIsActive ? "um-btn-danger" : string.Empty)"
                                                       IsEnabled="@(!saving)"
                                                       OnClick="() => ToggleSiteMembership(s)">
                                                @Text[s.MembershipIsActive ? "WriteDeactivate" : "WriteActivate"]
                                            </BitButton>
                                        }
                                    </div>
                                </div>
                            }
                        </div>
                    }

                    @if (scopeCanManageMemberships && UnassignedSites.Count > 0)
                    {
                        <div class="um-site-add-row">
                            <label class="visually-hidden" for="user-add-site">@Text["UserAddSiteLabel"]</label>
                            <select id="user-add-site" class="um-select" @bind="addSiteId" disabled="@saving">
                                @foreach (var site in UnassignedSites)
                                {
                                    <option value="@site.Id">@($"{site.Code} — {site.Name}")</option>
                                }
                            </select>
                            <BitButton Variant="BitVariant.Fill" Color="BitColor.Primary" Size="BitSize.Small"
                                       IsEnabled="@(!saving && addSiteId > 0)" OnClick="SubmitAddSite">
                                @Text["UserAddSiteButton"]
                            </BitButton>
                        </div>
                    }
                </div>
            }
            else
            {
                @if ((scopeCanUnlock && selected.IsLockedOut) || scopeCanSetAccountActive || canPlatformSetActive || canPlatformUnlock)
                {
                    <div class="um-section">
                        <p class="um-section-title">@Text["UserAccountStatus"]</p>
                        <div class="um-card um-card--row">
                            <div class="um-status-pair">
                                <span class="read-badge @(selected.AccountIsActive ? "active" : "inactive")">@Text[selected.AccountIsActive ? "ReadActive" : "UserAccountDisabled"]</span>
                                <span class="um-meta-text">@Text["UserLockStatusLabel"] <strong>@(selected.IsLockedOut ? Text["UserLockStatusLocked"] : Text["UserLockStatusOpen"])</strong></span>
                            </div>
                            <div class="write-actions">
                                @if (scopeCanUnlock || canPlatformUnlock)
                                {
                                    <BitButton Variant="BitVariant.Outline" Size="BitSize.Small" IsEnabled="@(!saving && selected.IsLockedOut)" OnClick="SubmitUnlock">@Text["UserUnlockButton"]</BitButton>
                                }
                                @if ((selected.BelongsToSingleOrganization && scopeCanSetAccountActive) || canPlatformSetActive)
                                {
                                    @if (selected.AccountIsActive)
                                    {
                                        <BitButton Variant="BitVariant.Outline" Size="BitSize.Small" Class="um-btn-danger" IsEnabled="@(!saving && selected.UserId != currentActorId)"
                                                   OnClick="@(() => AskConfirm(ConfirmActionKind.DisableAccount))">@Text["UserDeactivateAccount"]</BitButton>
                                    }
                                    else
                                    {
                                        <BitButton Variant="BitVariant.Outline" Size="BitSize.Small" IsEnabled="@(!saving)"
                                                   OnClick="@(() => AskConfirm(ConfirmActionKind.EnableAccount))">@Text["UserActivateAccount"]</BitButton>
                                    }
                                }
                            </div>
                        </div>
                    </div>
                }

                @if ((selected.BelongsToSingleOrganization && scopeCanResetPassword) || canPlatformResetPassword)
                {
                    <div class="um-section">
                        <p class="um-section-title">@Text["UserResetPasswordTitle"]</p>
                        <BitTextField @bind-Value="resetPasswordValue" Immediate="true" Type="BitInputType.Password"
                                      Label="@Text["UserNewPasswordLabel"]" Classes="@LoginPasswordFieldClasses"
                                      CanRevealPassword="true" RevealPasswordAriaLabel="@Text["PasswordVisibilityToggle"]"
                                      IsEnabled="@(!saving)" InputHtmlAttributes="@ResetPasswordAttributes" />
                        <span id="reset-password-hint" class="write-hint">@Text["UserPasswordHint"]</span>
                        <label class="um-inline-check">
                            <input type="checkbox" @bind="resetRequirePasswordChange" disabled="@saving" />
                            <span>@Text["UserMustChangePasswordLabel"]</span>
                        </label>
                        <div class="write-actions">
                            <BitButton Variant="BitVariant.Outline" Size="BitSize.Small"
                                       IsEnabled="@(!saving && !string.IsNullOrEmpty(resetPasswordValue))"
                                       OnClick="@(() => AskConfirm(ConfirmActionKind.ResetPassword))">@Text["UserResetPasswordButton"]</BitButton>
                        </div>
                    </div>
                }

                <div class="um-section">
                    <p class="um-section-title">@Text["User2FAStatusTitle"]</p>
                    <div class="um-card">
                        <div class="um-card-top">
                            <span class="read-badge @(selected.TwoFactorEnabled ? "active" : "inactive")">@Text[selected.TwoFactorEnabled ? "SecurityRow2FAOn" : "SecurityRow2FAOff"]</span>
                            @if ((selected.BelongsToSingleOrganization && (scopeCanResetTwoFactor || scopeCanResetPassword)) || canPlatformResetTwoFactor)
                            {
                                <BitButton Variant="BitVariant.Outline" Size="BitSize.Small" Class="um-btn-danger"
                                           IsEnabled="@(!saving && selected.TwoFactorEnabled && selected.UserId != currentActorId)"
                                           OnClick="OpenReset2FADialog">
                                    @Text["User2FAResetBtn"]
                                </BitButton>
                            }
                        </div>
                        @if (selected.TwoFactorEnabled)
                        {
                            <p class="um-meta-text">@Text["User2FAEnabledMeta", selected.TwoFactorEnabledAtUtc.HasValue ? Format.Timestamp(selected.TwoFactorEnabledAtUtc.Value, " - ") : "—", selected.RecoveryCodesRemaining]</p>
                            <p class="write-hint">@Text["User2FAResetHint"]</p>
                        }
                        else
                        {
                            <p class="write-hint">@Text["User2FADisabledHint"]</p>
                        }
                    </div>
                </div>

                <div class="um-section">
                    <p class="um-section-title">@Text["UserSessionsCardTitle"]</p>
                    <div class="um-card um-card--row">
                        <span class="um-meta-text">@Text["UserActiveSessionsCount", selected.ActiveSessionCount]</span>
                        @if ((selected.BelongsToSingleOrganization && scopeCanResetPassword) || canPlatformResetPassword)
                        {
                            <BitButton Variant="BitVariant.Outline" Size="BitSize.Small"
                                       IsEnabled="@(!saving && selected.ActiveSessionCount > 0)"
                                       OnClick="SubmitRevokeSessions">
                                @Text["UserRevokeAllSessionsBtn"]
                            </BitButton>
                        }
                    </div>
                </div>
            }

            @if (saving) { <p role="status">@Text["WriteSaving"]</p> }
            @if (saved) { <p role="status" class="write-saved">@Text["WriteSaved"]</p> }
            @if (pageNotice is not null && detailOpen) { <p role="status" class="write-saved">@pageNotice</p> }
            @if (writeError is not null)
            {
                <p role="alert" class="write-error">@Text[writeError]</p>
                @if (writeError is "WriteConflict" or "WriteOutcomeUnknown")
                {
                    <div class="write-actions">
                        <BitButton Variant="BitVariant.Outline" Size="BitSize.Small" OnClick="ReloadSelected">@Text["WriteReload"]</BitButton>
                    </div>
                }
            }

            <div class="um-modal-footer">
                <BitButton Variant="BitVariant.Outline" Size="BitSize.Small" OnClick="() => detailOpen = false">@Text["ReadClose"]</BitButton>
            </div>
        </div>
    }
}
</Body>
</BitDialog>

<BitDialog Width="440px" MaxWidth="calc(100vw - 24px)" Classes="@DialogClasses" IsOpen="@(confirmAction is not null)" OnDismiss="CancelConfirm"
           Title="@Text["WriteConfirm"]" AriaLabel="@Text["WriteConfirm"]"
           CloseButtonTitle="@Text["ReadClose"]" ShowOkButton="false" ShowCancelButton="false" ShowCloseButton="true"
           AutoFocus="true" TrapFocus="true" RestoreFocus="true" CloseOnEscape="true">
<Body>
@if (confirmAction is not null)
{
    var isDanger = confirmAction is ConfirmActionKind.DisableAccount or ConfirmActionKind.DisableOrgMembership or ConfirmActionKind.RevokeOrgAdmin;
    <div class="write-panel" role="alertdialog" aria-labelledby="user-confirm-text">
        <p id="user-confirm-text">@ConfirmMessage()</p>
        @if (writeError is not null)
        {
            <p role="alert" class="write-error">@Text[writeError]</p>
        }
        <div class="um-modal-footer">
            <span></span>
            <div class="um-footer-actions">
                <BitButton Variant="BitVariant.Outline" Size="BitSize.Small" IsEnabled="@(!saving)" OnClick="CancelConfirm">@Text["WriteCancel"]</BitButton>
                <BitButton Variant="BitVariant.Fill" Color="@(isDanger ? BitColor.Error : BitColor.Primary)" Size="BitSize.Small"
                           IsEnabled="@(!saving)" OnClick="ExecuteConfirm">@Text["WriteConfirm"]</BitButton>
            </div>
        </div>
    </div>
}
</Body>
</BitDialog>

<BitDialog Width="440px" MaxWidth="calc(100vw - 24px)" Classes="@DialogClasses" @bind-IsOpen="reset2FAOpen"
           Title="@Text["User2FAResetDialogTitle"]" AriaLabel="@Text["User2FAResetDialogTitle"]"
           CloseButtonTitle="@Text["ReadClose"]" ShowOkButton="false" ShowCancelButton="false" ShowCloseButton="true"
           AutoFocus="true" TrapFocus="true" RestoreFocus="true" CloseOnEscape="true">
<Body>
    @if (selected is not null)
    {
        <div class="um-modal-panel">
            <div class="sec-warning-box" role="alert">@Text["User2FAResetWarning"]</div>
            <p class="um-meta-text">@Text["User2FAResetBody", selected.UserName]</p>
            <div class="sec-field">
                <label for="reset-2fa-reason">@Text["User2FAResetReasonLabel"]</label>
                <textarea id="reset-2fa-reason"
                          rows="3"
                          maxlength="300"
                          class="sec-text-input"
                          placeholder="@Text["User2FAResetReasonPlaceholder"]"
                          disabled="@saving"
                          @bind="reset2FAReason"
                          @bind:event="oninput"></textarea>
            </div>
            <label class="sec-confirm-check">
                <input type="checkbox" @bind="reset2FAIdentityVerified" disabled="@saving" />
                <span>@Text["User2FAResetIdentityCheck"]</span>
            </label>
            <div class="um-modal-footer um-modal-footer--split">
                <BitButton Variant="BitVariant.Outline" Size="BitSize.Small" IsEnabled="@(!saving)" OnClick="() => reset2FAOpen = false">@Text["TotpCancelBtn"]</BitButton>
                <BitButton Variant="BitVariant.Fill" Size="BitSize.Small" Class="um-btn-danger-fill"
                           IsEnabled="@(!saving && reset2FAIdentityVerified && !string.IsNullOrWhiteSpace(reset2FAReason))"
                           OnClick="SubmitResetTwoFactorAsync">
                    @Text["User2FAResetConfirmBtn"]
                </BitButton>
            </div>
        </div>
    }
</Body>
</BitDialog>

<BitDialog Width="460px" MaxWidth="calc(100vw - 24px)" Classes="@DialogClasses" @bind-IsOpen="createOpen"
           OnDismissing="OnCreateDismissing"
           Title="@Text["CreateUserTitle"]" AriaLabel="@Text["CreateUserTitle"]"
           CloseButtonTitle="@Text["ReadClose"]" ShowOkButton="false" ShowCancelButton="false" ShowCloseButton="true"
           AutoFocus="true" TrapFocus="true" RestoreFocus="true" CloseOnEscape="true">
<Body>
<form id="user-create-form" class="um-modal-panel" @onsubmit:preventDefault>
    <p class="um-create-subtitle">@Text["UserCreateInOrgSubtitle", ScopeOrgLabel]</p>

    <div class="um-field-group">
        <label class="um-field-label" for="create-user-name">@Text["UserUsername"]</label>
        <input id="create-user-name"
               dir="ltr"
               class="um-text-input @(createUserNameTouched && !IsCreateUsernameValid ? "is-invalid" : string.Empty)"
               placeholder="@Text["UserUsernamePlaceholder"]"
               @bind="createUserName"
               @bind:event="oninput"
               @onblur="() => createUserNameTouched = true"
               maxlength="128"
               disabled="@creating"
               aria-describedby="create-username-hint" />
        @if (createUserNameTouched && !IsCreateUsernameValid)
        {
            <span class="um-field-error" role="alert">@Text["UserUsernameInvalidError"]</span>
        }
        else
        {
            <span id="create-username-hint" class="write-hint">@Text["UserUsernameAllowedHint"]</span>
        }
    </div>

    <div class="um-field-group">
        <div class="um-label-row">
            <label class="um-field-label" for="create-user-password">@Text["UserPasswordLabel"]</label>
            <button type="button" class="um-gen-pwd-btn" disabled="@creating" @onclick="GenerateRandomCreatePassword">
                @Text["UserGenerateRandomPassword"]
            </button>
        </div>
        <div class="um-login-pwd-wrap @(createPasswordTouched && !IsCreatePasswordValid ? "is-invalid" : string.Empty)">
            <BitTextField @bind-Value="createPassword"
                          Immediate="true"
                          Type="@(createPasswordRevealed ? BitInputType.Text : BitInputType.Password)"
                          Classes="@LoginPasswordFieldClasses"
                          CanRevealPassword="true"
                          RevealPasswordAriaLabel="@Text["PasswordVisibilityToggle"]"
                          IsEnabled="@(!creating)"
                          OnFocusOut="() => createPasswordTouched = true"
                          InputHtmlAttributes="@CreatePasswordAttributes" />
        </div>
        @if (!string.IsNullOrEmpty(createPassword))
        {
            var strength = CreatePasswordStrength;
            <div class="um-strength-bar" aria-hidden="true">
                @for (var i = 1; i <= 4; i++)
                {
                    <span class="um-strength-seg @(i <= strength ? (strength <= 1 ? "is-weak" : strength <= 2 ? "is-med" : "is-strong") : string.Empty)"></span>
                }
            </div>
        }
        @if (createPasswordTouched && !IsCreatePasswordValid)
        {
            <span class="um-field-error" role="alert">@Text["UserPasswordStrengthMin"]</span>
        }
        else if (!string.IsNullOrEmpty(createPassword) && IsCreatePasswordValid)
        {
            <span class="um-meta-text">@(CreatePasswordStrength >= 3 ? Text["UserPasswordStrengthStrong"] : Text["UserPasswordStrengthMedium"])</span>
        }
        else
        {
            <span id="create-password-hint" class="write-hint">@Text["UserPasswordHint"]</span>
        }
        <label class="um-inline-check">
            <input type="checkbox" @bind="createRequirePasswordChange" disabled="@creating" />
            <span>@Text["UserMustChangePasswordLabel"]</span>
        </label>
    </div>

    @if (scopeCanAssignRoles)
    {
        <div class="um-admin-switch-row">
            <div>
                <div class="um-field-label">@Text["UserOrgAdminRole"]</div>
                <div class="write-hint">@Text["UserOrgAdminSwitchDesc"]</div>
            </div>
            <label class="um-switch">
                <input type="checkbox" @bind="createAssignAdmin" disabled="@creating" />
                <span class="um-switch-track"></span>
            </label>
        </div>
    }

    @if (orgSites.Count > 0)
    {
        <div class="um-section">
            <div class="um-label-row">
                <span class="um-section-title">@Text["UserAssignSitesLabel"]</span>
                <span class="write-hint">@Text["UserSitesSelectedCount", createSelectedSiteIds.Count, orgSites.Count]</span>
            </div>
            <div class="um-site-cards">
                @foreach (var site in orgSites)
                {
                    var checkedSite = createSelectedSiteIds.Contains(site.Id);
                    <label class="um-site-check-card @(checkedSite ? "is-selected" : string.Empty)">
                        <span class="um-site-check-main">
                            <input type="checkbox" checked="@checkedSite" disabled="@creating" @onchange="e => ToggleCreateSite(site.Id, e.Value is bool b && b)" />
                            <span>@site.Name</span>
                        </span>
                        <span class="um-chip" dir="ltr">@site.Code</span>
                    </label>
                }
            </div>
        </div>
    }

    @if (creating) { <p role="status">@Text["WriteSaving"]</p> }
    @if (createError is not null) { <p role="alert" class="write-error">@Text[createError]</p> }
    @if (createDiscardConfirm)
    {
        <div class="write-confirm" role="alertdialog" aria-labelledby="user-create-discard-text">
            <p id="user-create-discard-text">@Text["WriteDiscardConfirm"]</p>
            <div class="write-actions">
                <BitButton Size="BitSize.Small" OnClick="DiscardCreate">@Text["WriteDiscard"]</BitButton>
                <BitButton Variant="BitVariant.Outline" Size="BitSize.Small" OnClick="CancelDiscardCreate">@Text["WriteKeepEditing"]</BitButton>
            </div>
        </div>
    }

    <div class="um-modal-footer um-modal-footer--split">
        <BitButton Variant="BitVariant.Outline" Size="BitSize.Small" IsEnabled="@(!creating)" OnClick="DiscardCreate">@Text["TotpCancelBtn"]</BitButton>
        <BitButton Variant="BitVariant.Fill" Color="BitColor.Primary" Size="BitSize.Small"
                   IsEnabled="@(!creating && IsCreateUsernameValid && IsCreatePasswordValid)"
                   OnClick="SubmitCreate">
            @Text["CreateSubmit"]
        </BitButton>
    </div>
</form>
</Body>
</BitDialog>

<BitDialog Width="420px" MaxWidth="calc(100vw - 24px)" Classes="@DialogClasses" @bind-IsOpen="attachOpen"
           Title="@Text["AttachUserTitle"]" AriaLabel="@Text["AttachUserTitle"]"
           CloseButtonTitle="@Text["ReadClose"]" ShowOkButton="false" ShowCancelButton="false" ShowCloseButton="true"
           AutoFocus="true" TrapFocus="true" RestoreFocus="true" CloseOnEscape="true">
<Body>
<form class="write-panel" @onsubmit:preventDefault>
    <div class="read-field">
        <label for="attach-user-name">@Text["UserUsername"]</label>
        <input id="attach-user-name" dir="ltr" @bind="attachUserName" @bind:event="oninput" maxlength="128" disabled="@attaching" aria-describedby="attach-username-hint" />
        <span id="attach-username-hint" class="write-hint">@Text["UserNameHint"]</span>
    </div>
    <label class="write-check">
        <input type="checkbox" @bind="attachAssignAdmin" disabled="@attaching" />
        <span>@Text["UserAssignOrgAdmin"]</span>
    </label>
    @if (orgSites.Count > 0)
    {
        <div class="write-section">
            <p class="write-section-title">@Text["UserAssignSitesLabel"]</p>
            <div class="user-site-checks">
                @foreach (var site in orgSites)
                {
                    var checkedSite = attachSelectedSiteIds.Contains(site.Id);
                    <label class="write-check">
                        <input type="checkbox" checked="@checkedSite" disabled="@attaching" @onchange="e => ToggleAttachSite(site.Id, e.Value is bool b && b)" />
                        <span>@($"{site.Code} — {site.Name}")</span>
                    </label>
                }
            </div>
        </div>
    }
    <div class="write-actions">
        <BitButton Size="BitSize.Small" IsEnabled="@(!attaching && !string.IsNullOrWhiteSpace(attachUserName))" OnClick="SubmitAttach">
            @Text["AttachUserButton"]
        </BitButton>
    </div>
    @if (attaching) { <p role="status">@Text["WriteSaving"]</p> }
    @if (attachError is not null) { <p role="alert" class="write-error">@Text[attachError]</p> }
</form>
</Body>
</BitDialog>

<BitDialog Width="700px" MaxWidth="calc(100vw - 24px)" Classes="@DialogClasses" @bind-IsOpen="permOpen"
           Title="@(permSnapshot is null ? Text["UserPermissionsButton"] : Text["UserPermissionsTitle", permSnapshot.UserName])"
           AriaLabel="@(permSnapshot is null ? Text["UserPermissionsButton"] : Text["UserPermissionsTitle", permSnapshot.UserName])"
           CloseButtonTitle="@Text["ReadClose"]" ShowOkButton="false" ShowCancelButton="false" ShowCloseButton="true"
           AutoFocus="true" TrapFocus="true" RestoreFocus="true" CloseOnEscape="true">
<Body>
@if (permSnapshot is not null)
{
    var pendingCount = PendingDirectChangesCount;
    var allGroups = ActiveScopeGroups;
    var totalOps = allGroups.Sum(g => g.Operations.Count);
    var viaRoleCount = allGroups.Sum(g => g.Operations.Count(op => roleGrantedPerms.Contains(op.PermissionCode)));
    var isFullViaRole = totalOps > 0 && viaRoleCount == totalOps;

    <PermissionAccordionPanel
        Descriptors="@TargetDescriptors"
        SelectedPerms="@directSelectedPerms"
        RoleGrantedPerms="@roleGrantedPerms"
        InitialPerms="@initialDirectPerms"
        RoleGrantingNames="@roleGrantingNamesByCode"
        CanEdit="@scopeCanAssignPermissions"
        IsSaving="@permSaving"
        OnChanged="@(() => { permSaved = false; StateHasChanged(); })">
        <HeaderContent>
            <div class="pa-roles-bar">
                @if (permUserSites.Count > 0)
                {
                    <div class="pa-scope-wrap">
                        <label class="visually-hidden" for="user-perm-scope">@Text["UserPermScopeLabel"]</label>
                        <select id="user-perm-scope" class="um-select" value="@permSiteId" @onchange="ChangePermTargetScope" disabled="@permSaving">
                            <option value="0">@Text["UserPermScopeOrg"]</option>
                            @foreach (var s in permUserSites)
                            {
                                <option value="@s.SiteId">@Text["UserPermScopeSite", s.SiteCode, s.SiteName]</option>
                            }
                        </select>
                    </div>
                }
                <div class="pa-role-chips">
                    <span class="pm-role-prefix">@Text["PermRolesLabel"]</span>
                    @foreach (var ra in ScopedRoleAssignmentsForTarget.Where(x => x.IsActive))
                    {
                        var roleLabel = RolePermissionLocalization.RoleDisplayName(ra.RoleName, ra.IsSystem, Text);
                        var canRemove = scopeCanAssignRoles && !(ra.RoleId == PermissionCatalog.OrganizationAdministratorRoleId && permSnapshot.UserId == currentActorId);
                        <span class="pa-role-chip">
                            <span>@roleLabel</span>
                            @if (canRemove)
                            {
                                <button type="button" class="pa-role-chip-x"
                                        aria-label="@Text["PermRemoveRoleAria", roleLabel]"
                                        disabled="@permSaving"
                                        @onclick="() => ToggleRoleAssignment(ra)">×</button>
                            }
                        </span>
                    }
                    @if (scopeCanAssignRoles && AssignableRolesForTarget.Count > 0)
                    {
                        @if (!permAddRoleOpen)
                        {
                            <button type="button" class="pa-add-role-btn" disabled="@permSaving" @onclick="() => permAddRoleOpen = true">
                                @Text["PermAddRoleChipBtn"]
                            </button>
                        }
                        else
                        {
                            <span class="pa-add-role-inline">
                                <label class="visually-hidden" for="user-assign-role">@Text["UserAssignRoleLabel"]</label>
                                <select id="user-assign-role" class="um-select pa-role-select" @bind="selectedRoleIdToAssign" disabled="@permSaving">
                                    @foreach (var r in AssignableRolesForTarget)
                                    {
                                        <option value="@r.Id">@RolePermissionLocalization.RoleDisplayName(r.Name, r.IsSystem, Text)</option>
                                    }
                                </select>
                                <BitButton Size="BitSize.Small" IsEnabled="@(!permSaving && selectedRoleIdToAssign > 0)" OnClick="SubmitAssignRole">
                                    @Text["UserAssignRoleButton"]
                                </BitButton>
                                <button type="button" class="pa-role-chip-x" aria-label="@Text["WriteCancel"]" @onclick="() => permAddRoleOpen = false">×</button>
                            </span>
                        }
                    }
                </div>
            </div>
        </HeaderContent>
        <StatusContent>
            @if (permSaving) { <p role="status">@Text["WriteSaving"]</p> }
            @if (permSaved) { <p role="status" class="write-saved">@Text["WriteSaved"]</p> }
            @if (permError is not null)
            {
                <p role="alert" class="write-error">@Text[permError]</p>
                @if (permError is "WriteConflict" or "WriteOutcomeUnknown")
                {
                    <div class="write-actions">
                        <BitButton Variant="BitVariant.Outline" Size="BitSize.Small" OnClick="ReloadPermissionsDialog">@Text["WriteReload"]</BitButton>
                    </div>
                }
            }
        </StatusContent>
        <FooterContent>
            <div class="um-modal-footer pm-footer">
                @if (isFullViaRole || !scopeCanAssignPermissions)
                {
                    <span></span>
                    <BitButton Variant="BitVariant.Outline" Size="BitSize.Small" OnClick="() => permOpen = false">@Text["ReadClose"]</BitButton>
                }
                else
                {
                    <div class="pm-unsaved">
                        @if (pendingCount > 0)
                        {
                            <span>@Text["PermUnsavedChangesCount", pendingCount]</span>
                        }
                    </div>
                    <div class="um-footer-actions">
                        <BitButton Variant="BitVariant.Outline" Size="BitSize.Small" IsEnabled="@(!permSaving)" OnClick="() => permOpen = false">
                            @Text["WriteCancel"]
                        </BitButton>
                        <BitButton Variant="BitVariant.Fill" Color="BitColor.Primary" Size="BitSize.Small"
                                   IsEnabled="@(!permSaving && pendingCount > 0)" OnClick="SubmitDirectPermissions">
                            @Text["UserPermSaveButton"]
                        </BitButton>
                    </div>
                }
            </div>
        </FooterContent>
    </PermissionAccordionPanel>
}
</Body>
</BitDialog>

@code {
    [Parameter] public long OrganizationId { get; set; }
    [Parameter] public long UserId { get; set; }

    private enum ConfirmActionKind { DisableAccount, EnableAccount, DisableOrgMembership, EnableOrgMembership, RevokeOrgAdmin, ResetPassword }

    private BitDataGrid<UserSummary>? grid;
    private int revision;
    private bool disposed;
    private bool Current(int value) => !disposed && value == revision;

    public void Dispose()
    {
        disposed = true;
        revision++;
        selected = null;
        detailOpen = false;
        createOpen = false;
        attachOpen = false;
        createPassword = string.Empty;
        resetPasswordValue = string.Empty;
    }

    private IReadOnlyList<OrganizationScope> available = [];
    private IReadOnlyDictionary<OrganizationScope, ForgeFlow.Web.Organizations.ScopeDisplayInfo> scopeLabels = new Dictionary<OrganizationScope, ForgeFlow.Web.Organizations.ScopeDisplayInfo>();
    private List<SiteDetails> orgSites = [];
    private int scopeIndex;
    private long currentActorId;
    private bool initialLoading = true, inactive, detailOpen, editMode;
    private string editTab = "access";
    private bool scopeCanCreate, scopeCanSetAccountActive, scopeCanUnlock, scopeCanResetPassword, scopeCanResetTwoFactor, scopeCanManageMemberships, scopeCanAssignRoles;
    private bool canPlatformAttach, canPlatformSetActive, canPlatformUnlock, canPlatformResetPassword, canPlatformResetTwoFactor;
    private string? error, pageNotice, search, resetPasswordValue;
    private bool resetRequirePasswordChange = true;
    private bool reset2FAOpen, reset2FAIdentityVerified;
    private string? reset2FAReason;
    private UserDetails? selected;
    private ConfirmActionKind? confirmAction;
    private bool saving, saved;
    private string? writeError;
    private long addSiteId;

    private bool createOpen, creating, createDiscardConfirm, draftInitialized;
    private string? createUserName, createPassword, createError;
    private bool createAssignAdmin, createRequirePasswordChange = true;
    private bool createUserNameTouched, createPasswordTouched, createPasswordRevealed;
    private readonly HashSet<long> createSelectedSiteIds = [];
    private DraftDefinition? pendingDraft;

    private bool attachOpen, attaching, attachAssignAdmin;
    private string? attachUserName, attachError;
    private readonly HashSet<long> attachSelectedSiteIds = [];

    private bool permOpen, permSaving, permSaved, permAddRoleOpen;
    private bool scopeCanReadRoles, scopeCanAssignPermissions;
    private long permSiteId, selectedRoleIdToAssign;
    private string permFilter = "all";
    private string? permSearch;
    private string? permError;
    private UserPermissionMatrix? permSnapshot;
    private List<UserSiteMembershipDetails> permUserSites = [];
    private List<RoleDetails> orgRoleDetails = [];
    private readonly HashSet<PermissionModule> expandedPermModules = [];
    private readonly HashSet<string> directSelectedPerms = new(StringComparer.Ordinal);
    private readonly HashSet<string> initialDirectPerms = new(StringComparer.Ordinal);
    private readonly HashSet<string> roleGrantedPerms = new(StringComparer.Ordinal);
    private readonly Dictionary<string, IReadOnlyList<string>> roleGrantingNamesByCode = new(StringComparer.Ordinal);

    private static readonly int[] PageSizeOptions = [10, 25, 50, 100];
    private static readonly BitIconInfo EditIcon = BitIconInfo.Css("ff-icon ff-icon--edit");
    private static readonly BitIconInfo RoleIcon = BitIconInfo.Css("ff-icon ff-icon--role");
    private static readonly BitIconInfo ActivateIcon = BitIconInfo.Css("ff-icon ff-icon--activate");
    private static readonly BitIconInfo DeactivateIcon = BitIconInfo.Css("ff-icon ff-icon--deactivate");
    private static readonly BitIconInfo UnlockIcon = BitIconInfo.Css("ff-icon ff-icon--unlock");
    private static readonly BitTextFieldClassStyles WriteFieldClasses = new()
    {
        Root = "write-field",
        Label = "write-field-label",
        InputWrapper = "write-field-wrapper",
        FieldGroup = "write-field-group",
        Input = "write-field-input",
        RevealPassword = "write-field-reveal"
    };
    private static readonly BitTextFieldClassStyles LoginPasswordFieldClasses = new()
    {
        Root = "login-field",
        Label = "write-field-label",
        InputWrapper = "login-field-wrapper",
        FieldGroup = "login-field-group",
        Input = "login-field-input",
        RevealPassword = "login-field-reveal"
    };
    private static readonly Dictionary<string, object> CreatePasswordAttributes = new()
    {
        ["id"] = "create-user-password",
        ["autocomplete"] = "new-password",
        ["dir"] = "ltr",
        ["maxlength"] = "128",
        ["aria-describedby"] = "create-password-hint"
    };
    private static readonly Dictionary<string, object> ResetPasswordAttributes = new()
    {
        ["id"] = "reset-user-password",
        ["autocomplete"] = "new-password",
        ["dir"] = "ltr",
        ["maxlength"] = "128",
        ["aria-describedby"] = "reset-password-hint"
    };
    private static readonly BitDialogClassStyles DialogClasses = new()
    {
        Container = "read-dialog", Header = "read-dialog-header", Body = "read-dialog-body",
        CloseButton = "read-dialog-close", Overlay = "read-dialog-overlay"
    };

    private BitDataGridStrings GridStrings => new()
    {
        GridLabel = Text["Users"],
        EmptyText = Text["ReadEmpty"],
        NoMatchesText = Text["ReadEmpty"],
        LoadingText = Text["ReadLoading"],
        PagerRangeFormat = Text["GridPagerRange"],
        PagerPageFormat = Text["GridPagerPage"],
        PerPageFormat = Text["GridPerPage"],
        RowsPerPageLabel = Text["GridRowsPerPage"],
        FirstPageLabel = Text["GridFirstPage"],
        PreviousPageLabel = Text["GridPreviousPage"],
        NextPageLabel = Text["GridNextPage"],
        LastPageLabel = Text["GridLastPage"],
        AnnouncementPage = Text["GridPagerPage"]
    };

    private bool ScopeCanEdit => scopeCanSetAccountActive || scopeCanUnlock || scopeCanResetPassword || scopeCanResetTwoFactor || scopeCanManageMemberships || scopeCanAssignRoles || canPlatformSetActive || canPlatformUnlock || canPlatformResetPassword || canPlatformResetTwoFactor;

    private string ScopeOrgLabel => available.Count > 0 && scopeLabels.TryGetValue(Scope, out var info)
        ? (!string.IsNullOrWhiteSpace(info.OrgName) ? info.OrgName! : info.OrgCode ?? ScopeLabel(Scope))
        : (available.Count > 0 ? ScopeLabel(Scope) : string.Empty);

    private bool IsCreateUsernameValid =>
        !string.IsNullOrEmpty(createUserName)
        && createUserName.Length is >= 1 and <= 128
        && createUserName.All(c => c is >= 'a' and <= 'z' or >= 'A' and <= 'Z' or >= '0' and <= '9' or '.' or '_' or '-' or '@' or '+');

    private bool IsCreatePasswordValid =>
        !string.IsNullOrEmpty(createPassword)
        && createPassword.Length is >= 12 and <= 128
        && !createPassword.Any(char.IsControl);

    private int CreatePasswordStrength
    {
        get
        {
            if (string.IsNullOrEmpty(createPassword) || createPassword.Length < 12 || createPassword.Any(char.IsControl))
                return 1;
            var score = 2;
            if (createPassword.Length >= 16) score++;
            if (createPassword.Any(char.IsUpper) && createPassword.Any(char.IsDigit) && createPassword.Any(c => !char.IsLetterOrDigit(c))) score++;
            return Math.Min(4, score);
        }
    }

    private void GenerateRandomCreatePassword()
    {
        const string upper = "ABCDEFGHJKLMNPQRSTUVWXYZ";
        const string lower = "abcdefghijkmnopqrstuvwxyz";
        const string digits = "23456789";
        const string symbols = "!@#$%&*-_";
        const string all = upper + lower + digits + symbols;
        var chars = new char[16];
        chars[0] = upper[System.Security.Cryptography.RandomNumberGenerator.GetInt32(upper.Length)];
        chars[1] = lower[System.Security.Cryptography.RandomNumberGenerator.GetInt32(lower.Length)];
        chars[2] = digits[System.Security.Cryptography.RandomNumberGenerator.GetInt32(digits.Length)];
        chars[3] = symbols[System.Security.Cryptography.RandomNumberGenerator.GetInt32(symbols.Length)];
        for (var i = 4; i < chars.Length; i++)
            chars[i] = all[System.Security.Cryptography.RandomNumberGenerator.GetInt32(all.Length)];
        for (var i = chars.Length - 1; i > 0; i--)
        {
            var j = System.Security.Cryptography.RandomNumberGenerator.GetInt32(i + 1);
            (chars[i], chars[j]) = (chars[j], chars[i]);
        }
        createPassword = new string(chars);
        createPasswordTouched = true;
        createPasswordRevealed = true;
    }
    private bool ScopeCanManagePermissions => scopeCanReadRoles || scopeCanAssignRoles || scopeCanAssignPermissions;
    private OrganizationScope Scope => available[scopeIndex];
    private static long Org(OrganizationScope scope) => ((OrganizationScope.Organization)scope).OrganizationId;
    private bool CreateDirty => !string.IsNullOrWhiteSpace(createUserName) || !string.IsNullOrEmpty(createPassword);

    private IReadOnlyList<SiteDetails> UnassignedSites => selected is null
        ? []
        : orgSites.Where(s => selected.Sites.All(existing => existing.SiteId != s.Id)).ToList();

    private string ScopeLabel(OrganizationScope scope)
    {
        if (scopeLabels.TryGetValue(scope, out var info) && !string.IsNullOrEmpty(info.OrgCode))
            return $"{info.OrgCode} — {info.OrgName}";
        return Text["ReadOrganizationScope", Org(scope)];
    }

    public static string BuildCreateDraftScope(long actorId, long orgId) => $"actor:{actorId}:org:{orgId}:create-user";

    public static string FailureKey(string code) => code switch
    {
        UserManagementErrors.UserNameInvalid => "UserErrorInvalidName",
        UserManagementErrors.UserNameDuplicate => "UserErrorDuplicate",
        UserManagementErrors.PasswordInvalid => "UserErrorPasswordInvalid",
        UserManagementErrors.SelfDeactivationForbidden => "UserErrorSelfDeactivation",
        UserManagementErrors.LastOrganizationAdminRequired => "UserErrorLastOrgAdmin",
        UserManagementErrors.LastPlatformAdminRequired => "UserErrorLastPlatformAdmin",
        UserManagementErrors.OrganizationMembershipRequired => "UserErrorOrgMembershipRequired",
        UserManagementErrors.SiteMembershipRequired => "UserErrorSiteMembershipRequired",
        UserManagementErrors.ParentOrganizationInactive or OrganizationSiteErrors.OrganizationInactive => "WriteParentInactive",
        UserManagementErrors.ParentSiteInactive => "UserErrorParentSiteInactive",
        UserManagementErrors.RoleScopeInvalid => "UserErrorRoleScopeInvalid",
        UserManagementErrors.ConcurrencyConflict or OrganizationAccessErrors.ConcurrencyConflict => "WriteConflict",
        UserManagementErrors.OutcomeUnknown or OrganizationAccessErrors.OutcomeUnknown => "WriteOutcomeUnknown",
        UserManagementErrors.AccessDenied or UserManagementErrors.ActorRequired or UserManagementErrors.ScopeRequired => "ReadDenied",
        UserManagementErrors.NotFound or OrganizationSiteErrors.OrganizationNotFound or OrganizationSiteErrors.SiteNotFound => "ReadNotFound",
        _ => "WriteUnavailable"
    };

    protected override async Task OnParametersSetAsync()
    {
        var request = ++revision;
        initialLoading = true;
        selected = null; detailOpen = false; createOpen = false; attachOpen = false; editMode = false;
        error = null; pageNotice = null; orgSites = [];
        scopeLabels = new Dictionary<OrganizationScope, ForgeFlow.Web.Organizations.ScopeDisplayInfo>();
        try
        {
            var scopes = await Scopes.LoadUserScopesAsync();
            if (!Current(request)) return;
            available = scopes.Where(s => OrganizationId == 0 || Org(s) == OrganizationId).ToList();
            scopeIndex = 0;

            var platform = new OrganizationScope.Platform();
            canPlatformAttach = await Can(UserPermissions.UsersAttachOrganization, platform);
            canPlatformSetActive = await Can(UserPermissions.UsersSetActive, platform);
            canPlatformUnlock = await Can(UserPermissions.UsersUnlock, platform);
            canPlatformResetPassword = await Can(UserPermissions.UsersResetPassword, platform);
            canPlatformResetTwoFactor = await Can(UserPermissions.UsersResetTwoFactor, platform);
            if (!Current(request)) return;

            if (available.Count == 0)
            {
                error = OrganizationId > 0 || UserId > 0 ? "ReadNotFound" : "ReadDenied";
                return;
            }

            scopeLabels = await Scopes.LoadDisplayInfoAsync(available);
            if (!Current(request)) return;

            await RefreshScopeStateAsync(request);
            if (!Current(request)) return;

            if (UserId > 0)
                await OpenUserDialog(UserId, edit: false);
        }
        catch
        {
            if (Current(request)) error = "ReadError";
        }
        finally
        {
            if (Current(request)) initialLoading = false;
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (disposed || pendingDraft is null || Drafts is null) return;
        var def = pendingDraft;
        pendingDraft = null;
        try
        {
            var result = await Drafts.InitializeAsync(def);
            draftInitialized = true;
            if (!disposed && result.Snapshot is not null && createOpen
                && result.Snapshot.Fields.TryGetValue("UserName", out var u))
            {
                createUserName = u.Raw;
                StateHasChanged();
            }
        }
        catch { draftInitialized = false; }
