    private void SyncTargetScopePermissions()
    {
        directSelectedPerms.Clear();
        initialDirectPerms.Clear();
        roleGrantedPerms.Clear();
        roleGrantingNamesByCode.Clear();
        if (permSnapshot is null) return;

        var targetScopeKind = (byte)(permSiteId == 0 ? 1 : 2);
        long? targetSiteId = permSiteId == 0 ? null : permSiteId;

        if (permSnapshot.EffectiveCells is not null)
        {
            foreach (var cell in permSnapshot.EffectiveCells)
            {
                if (cell.ScopeKind != targetScopeKind || cell.SiteId != targetSiteId) continue;
                if (cell.GrantedDirectly)
                {
                    initialDirectPerms.Add(cell.PermissionCode);
                    directSelectedPerms.Add(cell.PermissionCode);
                }
                if (cell.GrantedByRole)
                {
                    roleGrantedPerms.Add(cell.PermissionCode);
                    roleGrantingNamesByCode[cell.PermissionCode] = cell.GrantingRoleNames;
                }
            }
        }
        else
        {
            foreach (var grant in permSnapshot.DirectGrants)
            {
                if (!grant.IsActive) continue;
                if (permSiteId == 0 && grant.ScopeTarget == RoleScopeTarget.Organization)
                {
                    initialDirectPerms.Add(grant.PermissionCode);
                    directSelectedPerms.Add(grant.PermissionCode);
                }
                else if (permSiteId > 0 && grant.ScopeTarget == RoleScopeTarget.Site && grant.SiteId == permSiteId)
                {
                    initialDirectPerms.Add(grant.PermissionCode);
                    directSelectedPerms.Add(grant.PermissionCode);
                }
            }

            var roleMap = orgRoleDetails.ToDictionary(x => x.Id, x => x.Permissions);
            foreach (var ra in permSnapshot.AssignedRoles.Where(x => x.IsActive))
            {
                var applies = ra.ScopeTarget == RoleScopeTarget.Organization
                    || (permSiteId > 0 && ra.ScopeTarget == RoleScopeTarget.Site && ra.SiteId == permSiteId);
                if (!applies) continue;

                IEnumerable<string> granted = ra.RoleId == PermissionCatalog.OrganizationAdministratorRoleId
                    ? TargetDescriptors.Select(p => p.Code)
                    : ra.RoleId == PermissionCatalog.SiteOperatorRoleId && permSiteId > 0
                        ? ["Sites.Read", "Sites.Update", "Sites.SetActive"]
                        : roleMap.TryGetValue(ra.RoleId, out var codes)
                            ? codes.Where(c => TargetDescriptors.Any(d => d.Code == c))
                            : [];

                foreach (var code in granted)
                {
                    roleGrantedPerms.Add(code);
                    if (!roleGrantingNamesByCode.TryGetValue(code, out var list))
                        roleGrantingNamesByCode[code] = [ra.RoleName];
                    else if (!list.Contains(ra.RoleName, StringComparer.Ordinal))
                        roleGrantingNamesByCode[code] = [.. list, ra.RoleName];
                }
            }
        }

        selectedRoleIdToAssign = AssignableRolesForTarget.FirstOrDefault()?.Id ?? 0;
    }

    private void ToggleDirectOperation(PermissionDescriptor descriptor, bool isChecked)
    {
        permSaved = false;
        RolePermissionLocalization.ToggleOperationWithAutoRead(directSelectedPerms, descriptor, isChecked, TargetDescriptors);
    }

    private async Task SubmitAssignRole()
    {
        if (permSaving || permSnapshot is null || RolesService is null || selectedRoleIdToAssign <= 0) return;
        var token = revision;
        permSaving = true; permSaved = false; permError = null;
        try
        {
            var targetScope = permSiteId == 0 ? RoleScopeTarget.Organization : RoleScopeTarget.Site;
            long? siteId = permSiteId == 0 ? null : permSiteId;
            var existingInactive = ScopedRoleAssignmentsForTarget.FirstOrDefault(x => x.RoleId == selectedRoleIdToAssign && !x.IsActive);
            var res = existingInactive is not null
                ? await RolesService.SetUserRoleAssignmentActive(
                    Scope,
                    new SetUserRoleAssignmentActive(Org(Scope), permSnapshot.UserId, existingInactive.AssignmentId, true, existingInactive.RowVersion))
                : await RolesService.AssignUserRole(
                    Scope,
                    new AssignUserRole(Org(Scope), permSnapshot.UserId, selectedRoleIdToAssign, targetScope, siteId));
            if (!Current(token)) return;
            if (!res.Succeeded)
            {
                permError = RolePermissionLocalization.FailureKey(res.Error!.Code);
                return;
            }
            permSnapshot = res.Value;
            permSaved = true;
            permAddRoleOpen = false;
            SyncTargetScopePermissions();
            await ReloadGridFromFirstPage();
        }
        catch
        {
            if (Current(token)) permError = "WriteUnavailable";
        }
        finally
        {
            if (!disposed) permSaving = false;
        }
    }

