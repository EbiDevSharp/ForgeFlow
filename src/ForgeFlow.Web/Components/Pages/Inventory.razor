    private async Task OpenPostModal(long? prefillPoId)
    {
        postError = null;
        var prevRes = CurrentScope is not null
            ? await SeqService.GetPreview(CurrentScope, ScopeOrganizationId(CurrentScope), ForgeFlow.Domain.Organizations.DocumentSequenceType.InventoryTransaction)
            : null;
        invDocAllowOverride = prevRes is { Succeeded: true } && prevRes.Value!.AllowManualOverride;
        postDocNumber = prevRes is { Succeeded: true } ? prevRes.Value!.NextPreview : string.Empty;
        postDestWarehouseId = 0;
        postReferenceNote = null;
        postLines.Clear();
        postType = prefillPoId.HasValue ? InventoryTransactionType.ProductionIssue : InventoryTransactionType.Receipt;
        postProductionOrderId = prefillPoId ?? 0;
        postWarehouseManual = false;
        postWarehouseId = activeWarehouses.FirstOrDefault(w => w.IsDefaultForSite)?.Id ?? activeWarehouses.FirstOrDefault()?.Id ?? 0;

        if (prefillPoId.HasValue)
            await PrefillFromProductionOrderAsync(prefillPoId.Value);
        else
            AddPostLine();

        postModalOpen = true;
    }

    private Task OnPostTypeChangedAsync(ChangeEventArgs e)
    {
        if (byte.TryParse(e.Value?.ToString(), out var raw) && Enum.IsDefined((InventoryTransactionType)raw))
            postType = (InventoryTransactionType)raw;
        return Task.CompletedTask;
    }

    private async Task OnPostOrderChangedAsync(ChangeEventArgs e)
    {
        postProductionOrderId = long.TryParse(e.Value?.ToString(), NumberStyles.Integer, CultureInfo.InvariantCulture, out var id) ? id : 0;
        if (postProductionOrderId > 0)
            await PrefillFromProductionOrderAsync(postProductionOrderId);
    }

    private async Task PrefillFromProductionOrderAsync(long poId)
    {
        var scope = CurrentScope;
        if (scope is null) return;
        var res = await OrderService.GetOrder(scope, ScopeOrganizationId(scope), poId);
        if (!res.Succeeded) return;
        var details = res.Value!;
        IReadOnlyList<StockReservationSummary> reservations = [];
        if (postType == InventoryTransactionType.ProductionIssue)
        {
            var resList = await ResService.ListReservations(scope, details.Summary.OrganizationId,
                new ReservationListQuery(ProductionOrderId: poId, OpenOnly: true, Page: 1, PageSize: 100));
            if (resList.Succeeded)
                reservations = resList.Value!.Items;
        }

        var hasManualSiteWh = postWarehouseManual && activeWarehouses.Any(w => w.Id == postWarehouseId && w.SiteId == details.Summary.SiteId);
        if (!hasManualSiteWh)
        {
            var reservedWhId = reservations.FirstOrDefault()?.WarehouseId;
            var matchingWh = (reservedWhId.HasValue ? activeWarehouses.FirstOrDefault(w => w.Id == reservedWhId.Value && w.SiteId == details.Summary.SiteId) : null)
                             ?? activeWarehouses.FirstOrDefault(w => w.SiteId == details.Summary.SiteId && w.IsDefaultForSite)
                             ?? activeWarehouses.FirstOrDefault(w => w.SiteId == details.Summary.SiteId);
            if (matchingWh is not null)
                postWarehouseId = matchingWh.Id;
        }

        postLines.Clear();
        if (postType == InventoryTransactionType.ProductionIssue)
        {
            foreach (var inp in details.Inputs.Where(i => !i.IsSubAssembly))
            {
                var lot = reservations.FirstOrDefault(r => r.WarehouseId == postWarehouseId && r.ItemId == inp.ItemId)?.LotCode
                          ?? reservations.FirstOrDefault(r => r.ItemId == inp.ItemId)?.LotCode
                          ?? string.Empty;
                postLines.Add(new PostLineRow { ItemId = inp.ItemId, LotCode = lot, Quantity = inp.GrossQuantity, UnitId = inp.UnitId });
            }
        }
        else if (postType == InventoryTransactionType.ProductionReceipt)
        {
            foreach (var outLine in details.Outputs.Where(o => o.Level == 1))
                postLines.Add(new PostLineRow { ItemId = outLine.ItemId, Quantity = outLine.PlannedQuantity, UnitId = outLine.UnitId });
        }
        if (postLines.Count == 0)
            AddPostLine();
    }

    private void AddPostLine()
    {
        var firstItem = activeItems.FirstOrDefault();
        postLines.Add(new PostLineRow
        {
            ItemId = firstItem?.Id ?? 0,
            Quantity = 1m,
            UnitId = firstItem?.BaseUnitId ?? activeUnits.FirstOrDefault()?.Id ?? 0
        });
    }

    private void OnPostLineItemChanged(PostLineRow row, ChangeEventArgs e)
    {
        if (long.TryParse(e.Value?.ToString(), NumberStyles.Integer, CultureInfo.InvariantCulture, out var id))
        {
            row.ItemId = id;
            var it = activeItems.FirstOrDefault(i => i.Id == id);
            if (it is not null) row.UnitId = it.BaseUnitId;
        }
    }

    private async Task SubmitPostTransactionAsync()
    {
        var scope = CurrentScope;
        if (scope is null) return;
        modalBusy = true;
        postError = null;
        try
        {
            var orgId = ScopeOrganizationId(scope);
            var lines = postLines.Select(l => new InventoryLineInput(
                l.ItemId,
                l.LotCode,
                l.Quantity,
                l.UnitId > 0 ? l.UnitId : null,
                null,
                l.ManufactureDateOffset.HasValue ? DateOnly.FromDateTime(l.ManufactureDateOffset.Value.Date) : null,
                l.ExpirationDateOffset.HasValue ? DateOnly.FromDateTime(l.ExpirationDateOffset.Value.Date) : null)).ToArray();
            var res = await InvService.PostTransaction(scope, new PostInventoryTransactionRequest(
                orgId,
                postWarehouseId,
                postType == InventoryTransactionType.TransferOut ? postDestWarehouseId : null,
                invDocAllowOverride ? postDocNumber : null,
                postType,
                postType is InventoryTransactionType.ProductionIssue or InventoryTransactionType.ProductionReceipt ? postProductionOrderId : null,
                postReferenceNote,
                null,
                lines));
            if (!res.Succeeded) { postError = RolePermissionLocalization.FailureKey(res.Error!.Code); return; }
            postModalOpen = false;
            pageNotice = Text["InvPostedNotice"];
            await ReloadActiveGridAsync(fromFirstPage: true);
        }
        finally { modalBusy = false; }
    }

    private async Task OpenTransactionDetailsAsync(long id)
    {
        var scope = CurrentScope;
        if (scope is null) return;
        var res = await InvService.GetTransaction(scope, ScopeOrganizationId(scope), id);
        if (!res.Succeeded) { pageError = RolePermissionLocalization.FailureKey(res.Error!.Code); return; }
        selectedTxn = res.Value!;
        detailsError = null;
        var revPrev = await SeqService.GetPreview(scope, ScopeOrganizationId(scope), ForgeFlow.Domain.Organizations.DocumentSequenceType.InventoryReversal);
        invRevAllowOverride = revPrev.Succeeded && revPrev.Value!.AllowManualOverride;
        reverseDocNumber = revPrev.Succeeded ? revPrev.Value!.NextPreview : string.Empty;
        reverseNote = null;
        detailsOpen = true;
    }

    private async Task ReverseSelectedTxnAsync()
    {
        var scope = CurrentScope;
        if (scope is null || selectedTxn is null) return;
        modalBusy = true;
        detailsError = null;
        try
        {
            var res = await InvService.ReverseTransaction(scope, new ReverseInventoryTransactionRequest(
                selectedTxn.Summary.OrganizationId,
                selectedTxn.Summary.Id,
                invRevAllowOverride ? reverseDocNumber : null,
                reverseNote));
            if (!res.Succeeded) { detailsError = RolePermissionLocalization.FailureKey(res.Error!.Code); return; }
            detailsOpen = false;
            pageNotice = Text["InvReversedNotice"];
            await ReloadActiveGridAsync(fromFirstPage: true);
        }
        finally { modalBusy = false; }
    }

