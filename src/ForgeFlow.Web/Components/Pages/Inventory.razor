@page "/inventory"
@page "/organizations/{OrganizationId:long}/inventory"
@using ForgeFlow.Application.Inventory
@using ForgeFlow.Application.Items
@using ForgeFlow.Application.Organizations
@using ForgeFlow.Application.ProductionOrders
@using ForgeFlow.Application.Units
@using ForgeFlow.Domain.Inventory
@using ForgeFlow.Domain.ProductionOrders
@using ForgeFlow.Web.Roles
@implements IDisposable
@inject InventoryUseCases InvService
@inject StockReservationUseCases ResService
@inject ProductionOrderUseCases OrderService
@inject ItemUseCases ItemService
@inject UnitUseCases UnitService
@inject DocumentSequenceUseCases SeqService
@inject ForgeFlow.Web.Organizations.ReadScopes Scopes
@inject ITrustedActorAccessor Actors
@inject IOrganizationPermissionEvaluator Permissions
@inject CulturePolicy Culture
@inject DisplayFormatter Format
@inject IStringLocalizer<SharedResources> Text

<PageTitle>@Text["Inventory"] - @Text["AppTitle"]</PageTitle>

<section class="organization-reader" aria-labelledby="inv-title">
    <div class="read-page-head">
        <div>
            <h1 id="inv-title">@Text["Inventory"]</h1>
            <p class="write-hint">@Text["InventoryCaption"]</p>
        </div>
        @if (!initialLoading && pageError is null && available.Count > 0 && scopeCanManage)
        {
            <div class="read-head-actions">
                @if (activeTab == TabWarehouses)
                {
                    <BitButton Size="BitSize.Small" IconName="Add" Class="read-create-btn" OnClick="OpenCreateWarehouse">
                        @Text["InvWarehouseCreateBtn"]
                    </BitButton>
                }
                else
                {
                    <BitButton Size="BitSize.Small" IconName="Add" Class="read-create-btn" IsEnabled="@(activeWarehouses.Count > 0)" OnClick="() => OpenPostModal(null)">
                        @Text["InvPostMovementBtn"]
                    </BitButton>
                }
            </div>
        }
    </div>

    @if (pageNotice is not null)
    {
        <p role="status" class="read-page-notice write-saved">@pageNotice</p>
    }

    @if (initialLoading)
    {
        <p role="status" aria-live="polite">@Text["ReadLoading"]</p>
    }
    else if (pageError is not null)
    {
        <div class="read-state" role="alert">
            <p>@Text[pageError]</p>
            <BitButton Variant="BitVariant.Outline" Size="BitSize.Small" OnClick="ReloadScopeAsync">@Text["WriteReload"]</BitButton>
        </div>
    }
    else if (available.Count == 0)
    {
        <p role="status" class="read-empty">@Text["ReadDenied"]</p>
    }
    else
    {
        <InventoryToolbarSection
            ActiveTab="@activeTab"
            OnSwitchTab="SwitchTabAsync"
            AvailableScopes="@available"
            ScopeIndex="@scopeIndex"
            OnScopeChanged="ChangeScopeAsync"
            ScopeLabel="@ScopeLabel"
            CurrentScope="@CurrentScope"
            AuthorizedSites="@authorizedSites"
            SiteFilter="@siteFilter"
            OnSiteFilterChanged="ChangeSiteFilterAsync"
            ActiveWarehouses="@activeWarehouses"
            WarehouseFilter="@warehouseFilter"
            OnWarehouseFilterChanged="ChangeWarehouseFilterAsync"
            TypeFilter="@typeFilter"
            OnTypeFilterChanged="ChangeTypeFilterAsync"
            TxnTypeLabel="@TxnTypeLabel"
            IncludeZeroBalances="@includeZeroBalances"
            OnToggleZeroBalances="ToggleZeroBalancesAsync"
            IncludeInactiveWarehouses="@includeInactiveWarehouses"
            OnToggleInactiveWarehouses="ToggleInactiveWarehousesAsync"
            OpenReservationsOnly="@openReservationsOnly"
            OnToggleOpenReservations="ToggleOpenReservationsAsync"
            Search="@search"
            OnSearchInput="OnSearchInput" />

        <InventoryGridsSection @ref="gridsSection"
            ActiveTab="@activeTab"
            PageSizeOptions="@PageSizeOptions"
            GridStrings="@GridStrings"
            ScopeCanManage="@scopeCanManage"
            ModalBusy="@modalBusy"
            EditIcon="@EditIcon"
            CurrentScope="@CurrentScope"
            SiteFilter="@siteFilter"
            WarehouseFilter="@warehouseFilter"
            TypeFilter="@typeFilter"
            AppliedSearch="@appliedSearch"
            IncludeZeroBalances="@includeZeroBalances"
            IncludeInactiveWarehouses="@includeInactiveWarehouses"
            OpenReservationsOnly="@openReservationsOnly"
            OnPageError="err => { pageError = err; StateHasChanged(); }"
            TxnBadgeClass="@TxnBadgeClass"
            TxnTypeLabel="@TxnTypeLabel"
            ResBadgeClass="@ResBadgeClass"
            ResStatusLabel="@ResStatusLabel"
            OnOpenCoa="args => OpenCoaModal(args.ItemId, args.LotCode)"
            OnOpenTxnDetails="OpenTransactionDetailsAsync"
            OnEditWarehouse="OpenEditWarehouse"
            OnReleaseReservation="ReleaseReservationAsync" />
    }

@using ForgeFlow.Web.Components.Pages.InventorySections
    <InventoryWarehouseModal
        @bind-IsOpen="whModalOpen"
        @bind-IsOpen:after="OnWhModalOpenChanged"
        DialogClasses="@DialogClasses"
        EditingWarehouse="@editingWarehouse"
        WhError="@whError"
        @bind-WhCode="whCode"
        CurrentScope="@CurrentScope"
        AuthorizedSites="@authorizedSites"
        @bind-WhSiteId="whSiteId"
        @bind-WhName="whName"
        @bind-WhIsDefault="whIsDefault"
        @bind-ModalBusy="modalBusy"
        WhErrorChanged="err => whError = err"
        OnSaved="HandleWarehouseSavedAsync" />

    <InventoryPostModal
        @bind-IsOpen="postModalOpen"
        @bind-IsOpen:after="OnPostOpenChanged"
        DialogClasses="@DialogClasses"
        PostError="@postError"
        InvDocAllowOverride="@invDocAllowOverride"
        @bind-PostDocNumber="postDocNumber"
        PostType="@postType"
        OnPostTypeChanged="OnPostTypeChangedAsync"
        TxnTypeLabel="@TxnTypeLabel"
        @bind-PostWarehouseId="postWarehouseId"
        OnPostWarehouseManual="() => postWarehouseManual = true"
        ActiveWarehouses="@activeWarehouses"
        @bind-PostDestWarehouseId="postDestWarehouseId"
        PostProductionOrderId="@postProductionOrderId"
        OnPostOrderChanged="OnPostOrderChangedAsync"
        ActiveProductionOrders="@activeProductionOrders"
        @bind-PostReferenceNote="postReferenceNote"
        PostLines="@postLines"
        ActiveItems="@activeItems"
        ActiveUnits="@activeUnits"
        OnAddPostLine="AddPostLine"
        OnPostLineItemChanged="args => OnPostLineItemChanged(args.Row, args.Args)"
        @bind-ModalBusy="modalBusy"
        CurrentScope="@CurrentScope"
        PostErrorChanged="err => postError = err"
        OnPosted="HandlePostedAsync"
        PickerDateFormat="@PickerDateFormat"
        PlusIcon="@PlusIcon"
        TodayIcon="@TodayIcon"
        CalendarIcon="@CalendarIcon"
        NextNavIcon="@NextNavIcon"
        PrevNavIcon="@PrevNavIcon"
        NextYearIcon="@NextYearIcon"
        PrevYearIcon="@PrevYearIcon"
        CloseIcon="@CloseIcon" />

    <InventoryDetailsModal
        @bind-IsOpen="detailsOpen"
        @bind-IsOpen:after="OnDetailsOpenChanged"
        DialogClasses="@DialogClasses"
        SelectedTxn="@selectedTxn"
        DetailsError="@detailsError"
        ScopeCanManage="@scopeCanManage"
        InvRevAllowOverride="@invRevAllowOverride"
        @bind-ReverseDocNumber="reverseDocNumber"
        @bind-ReverseNote="reverseNote"
        @bind-ModalBusy="modalBusy"
        CurrentScope="@CurrentScope"
        DetailsErrorChanged="err => detailsError = err"
        OnReversed="HandleTxnReversedAsync"
        TxnBadgeClass="@TxnBadgeClass"
        TxnTypeLabel="@TxnTypeLabel" />

    @if (CurrentScope is not null)
    {
        <LotCertificateDialog @bind-IsOpen="coaOpen" Scope="@CurrentScope" OrganizationId="@ScopeOrganizationId(CurrentScope)"
                              ItemId="@coaItemId" LotCode="@coaLotCode" />
    }
</section>

@code {
    [Parameter] public long? OrganizationId { get; set; }
    [SupplyParameterFromQuery(Name = "poId")] public long? QueryPoId { get; set; }

    private const int TabWarehouses = 0;
    private const int TabBalances = 1;
    private const int TabMovements = 2;
    private const int TabReservations = 3;

    private static readonly int[] PageSizeOptions = [10, 25, 50, 100];
    private static readonly BitDialogClassStyles DialogClasses = new()
    {
        Container = "read-dialog",
        Header = "read-dialog-header",
        Body = "read-dialog-body",
        CloseButton = "read-dialog-close",
        Overlay = "read-dialog-overlay"
    };
    private static readonly BitIconInfo EditIcon = BitIconInfo.Css("ff-icon ff-icon--edit");
    private static readonly BitIconInfo PlusIcon = BitIconInfo.Css("ff-icon ff-icon--plus");
    private static readonly BitIconInfo CalendarIcon = BitIconInfo.Css("ff-icon ff-icon--calendar");
    private static readonly BitIconInfo TodayIcon = BitIconInfo.Css("ff-icon ff-icon--today");
    private static readonly BitIconInfo NextNavIcon = BitIconInfo.Css("ff-icon ff-icon--chevron-next");
    private static readonly BitIconInfo PrevNavIcon = BitIconInfo.Css("ff-icon ff-icon--chevron-prev");
    private static readonly BitIconInfo NextYearIcon = BitIconInfo.Css("ff-icon ff-icon--chevrons-next");
    private static readonly BitIconInfo PrevYearIcon = BitIconInfo.Css("ff-icon ff-icon--chevrons-prev");
    private static readonly BitIconInfo CloseIcon = BitIconInfo.Css("ff-icon ff-icon--close");
    private string PickerDateFormat => Culture.Language == CulturePolicy.Persian ? "yyyy/MM/dd" : "yyyy-MM-dd";

    private InventoryGridsSection? gridsSection;

    private int activeTab = TabWarehouses;
    private bool initialLoading = true;
    private string? pageError;
    private string? pageNotice;
    private List<OrganizationScope> available = [];
    private IReadOnlyDictionary<OrganizationScope, ForgeFlow.Web.Organizations.ScopeDisplayInfo> scopeLabels =
        new Dictionary<OrganizationScope, ForgeFlow.Web.Organizations.ScopeDisplayInfo>();
    private int scopeIndex;
    private bool scopeCanManage;

    private IReadOnlyList<ProductionOrderSiteInfo> authorizedSites = [];
    private IReadOnlyList<WarehouseSummary> activeWarehouses = [];
    private IReadOnlyList<ItemSummary> activeItems = [];
    private IReadOnlyList<UnitSummary> activeUnits = [];
    private IReadOnlyList<ProductionOrderSummary> activeProductionOrders = [];

    private long siteFilter;
    private long warehouseFilter;
    private string typeFilter = string.Empty;
    private bool includeZeroBalances;
    private bool includeInactiveWarehouses;
    private bool openReservationsOnly = true;
    private string? search;
    private string? appliedSearch;
    private readonly DebouncedSearchController _searchController = new(300);

    public void Dispose()
    {
        _searchController.Dispose();
        selectedTxn = null;
        editingWarehouse = null;
        postLines.Clear();
        activeWarehouses = [];
        activeItems = [];
        activeUnits = [];
        activeProductionOrders = [];
        authorizedSites = [];
    }

    private void OnDetailsOpenChanged()
    {
        if (!detailsOpen)
        {
            selectedTxn = null;
            detailsError = null;
            reverseDocNumber = string.Empty;
            reverseNote = string.Empty;
        }
    }

    private void OnPostOpenChanged()
    {
        if (!postModalOpen)
        {
            postLines.Clear();
            postError = null;
            postReferenceNote = string.Empty;
        }
    }

    private void OnWhModalOpenChanged()
    {
        if (!whModalOpen)
        {
            editingWarehouse = null;
            whError = null;
            whCode = string.Empty;
            whName = string.Empty;
        }
    }
    private bool modalBusy;

    private bool coaOpen;
    private long coaItemId;
    private string coaLotCode = string.Empty;

    private void OpenCoaModal(long itemId, string lotCode)
    {
        coaItemId = itemId;
        coaLotCode = lotCode;
        coaOpen = true;
    }

    private bool whModalOpen;
    private WarehouseSummary? editingWarehouse;
    private string? whError;
    private string whCode = string.Empty;
    private long whSiteId;
    private string whName = string.Empty;
    private bool whIsDefault;

    private bool postModalOpen;
    private string? postError;
    private string postDocNumber = string.Empty;
    private bool invDocAllowOverride;
    private InventoryTransactionType postType = InventoryTransactionType.Receipt;
    private long postWarehouseId;
    private bool postWarehouseManual;
    private long postDestWarehouseId;
    private long postProductionOrderId;
    private string? postReferenceNote;
    private readonly List<PostLineRow> postLines = [];

    private bool detailsOpen;
    private InventoryTransactionDetails? selectedTxn;
    private string? detailsError;
    private string reverseDocNumber = string.Empty;
    private bool invRevAllowOverride;
    private string? reverseNote;
    private long? handledQueryPoId;

    public sealed class PostLineRow
    {
        public long ItemId { get; set; }
        public string LotCode { get; set; } = string.Empty;
        public decimal Quantity { get; set; } = 1m;
        public long UnitId { get; set; }
        private DateTimeOffset? _mfgOffset;
        public DateTimeOffset? ManufactureDateOffset
        {
            get => _mfgOffset;
            set
            {
                _mfgOffset = value;
                if (_mfgOffset.HasValue && _expOffset.HasValue && _mfgOffset.Value > _expOffset.Value)
                    _expOffset = _mfgOffset;
            }
        }
        private DateTimeOffset? _expOffset;
        public DateTimeOffset? ExpirationDateOffset
        {
            get => _expOffset;
            set
            {
                _expOffset = value;
                if (_mfgOffset.HasValue && _expOffset.HasValue && _expOffset.Value < _mfgOffset.Value)
                    _mfgOffset = _expOffset;
            }
        }
    }

    private OrganizationScope? CurrentScope =>
        scopeIndex >= 0 && scopeIndex < available.Count ? available[scopeIndex] : null;

    private static long ScopeOrganizationId(OrganizationScope scope) => scope switch
    {
        OrganizationScope.Organization o => o.OrganizationId,
        OrganizationScope.Site s => s.OrganizationId,
        _ => 0
    };

    private BitDataGridStrings GridStrings => new()
    {
        GridLabel = Text["Inventory"],
        EmptyText = Text["ReadEmpty"],
        NoMatchesText = Text["ReadEmpty"],
        LoadingText = Text["ReadLoading"],
        PagerRangeFormat = Text["GridPagerRange"],
        PagerPageFormat = Text["GridPagerPage"],
        PerPageFormat = Text["GridPerPage"],
        RowsPerPageLabel = Text["GridRowsPerPage"],
        FirstPageLabel = Text["GridFirstPage"],
        PreviousPageLabel = Text["GridPreviousPage"],
        NextPageLabel = Text["GridNextPage"],
        LastPageLabel = Text["GridLastPage"],
        AnnouncementPage = Text["GridPagerPage"]
    };

    protected override async Task OnParametersSetAsync() => await ReloadScopeAsync();

    private async Task ReloadScopeAsync()
    {
        initialLoading = true;
        pageError = null;
        pageNotice = null;
        try
        {
            var loaded = await Scopes.LoadInventoryScopesAsync();
            available = OrganizationId is long orgId
                ? loaded.Where(s => ScopeOrganizationId(s) == orgId).ToList()
                : loaded.ToList();
            scopeLabels = await Scopes.LoadDisplayInfoAsync(available);
            if (available.Count == 0 && OrganizationId is long fallbackOrgId)
                available = [new OrganizationScope.Organization(fallbackOrgId)];
            scopeIndex = 0;
            await RefreshScopeStateAsync();
            if (QueryPoId is long poId && handledQueryPoId != poId && scopeCanManage && activeWarehouses.Count > 0)
            {
                handledQueryPoId = poId;
                await OpenPostModal(poId);
            }
        }
        catch
        {
            pageError = "ReadError";
        }
        finally
        {
            initialLoading = false;
        }
    }

    private async Task RefreshScopeStateAsync()
    {
        scopeCanManage = false;
        authorizedSites = [];
        activeWarehouses = [];
        activeItems = [];
        activeUnits = [];
        activeProductionOrders = [];
        siteFilter = 0;
        warehouseFilter = 0;

        var scope = CurrentScope;
        if (scope is null) return;

        var actor = await Actors.ResolveAsync(default);
        var orgId = ScopeOrganizationId(scope);

        Task<PermissionDecision>? manageTask = actor is not null
            ? Permissions.EvaluateAsync(actor, scope, InventoryPermissions.InventoryManage, default).AsTask()
            : null;

        var whTask = InvService.ListWarehouses(scope, orgId, new WarehouseListQuery(IncludeInactive: false, Page: 1, PageSize: 100));
        var sitesTask = OrderService.ListAuthorizedSites(scope, orgId);
        var itemsTask = ItemService.ListItems(scope, orgId, new ItemListQuery(IncludeInactive: false, Page: 1, PageSize: 100));
        var unitsTask = UnitService.ListUnits(scope, orgId, new UnitListQuery(IncludeInactive: false, Page: 1, PageSize: 100));
        var relOrdersTask = OrderService.ListOrders(scope, orgId, new ProductionOrderListQuery(Status: ProductionOrderStatus.Released, Page: 1, PageSize: 50));
        var progOrdersTask = OrderService.ListOrders(scope, orgId, new ProductionOrderListQuery(Status: ProductionOrderStatus.InProgress, Page: 1, PageSize: 50));

        var tasks = new List<Task> { whTask, sitesTask, itemsTask, unitsTask, relOrdersTask, progOrdersTask };
        if (manageTask is not null) tasks.Add(manageTask);

        await Task.WhenAll(tasks);

        if (manageTask is not null)
            scopeCanManage = (await manageTask).IsAllowed;

        var whRes = await whTask;
        if (whRes.Succeeded)
            activeWarehouses = whRes.Value!.Items;

        var sitesRes = await sitesTask;
        if (sitesRes.Succeeded)
            authorizedSites = sitesRes.Value!;
        if (scope is OrganizationScope.Site siteScope)
            siteFilter = siteScope.SiteId;

        var itemsRes = await itemsTask;
        if (itemsRes.Succeeded)
            activeItems = itemsRes.Value!.Items;

        var unitsRes = await unitsTask;
        if (unitsRes.Succeeded)
            activeUnits = unitsRes.Value!.Items;

        var relOrders = await relOrdersTask;
        var progOrders = await progOrdersTask;
        var combined = new List<ProductionOrderSummary>();
        if (relOrders.Succeeded) combined.AddRange(relOrders.Value!.Items);
        if (progOrders.Succeeded) combined.AddRange(progOrders.Value!.Items);
        activeProductionOrders = combined.OrderByDescending(o => o.Id).ToArray();
    }

    private string ScopeLabel(OrganizationScope scope) => scope switch
    {
        OrganizationScope.Organization o when scopeLabels.TryGetValue(scope, out var info) && info.OrgCode is not null
            => $"{info.OrgCode} — {info.OrgName}",
        OrganizationScope.Organization o => Text["ReadOrganizationScope", o.OrganizationId],
        OrganizationScope.Site s when scopeLabels.TryGetValue(scope, out var info) && info.SiteCode is not null
            => $"{info.OrgCode} / {info.SiteCode} — {info.SiteName}",
        OrganizationScope.Site s => Text["ReadSiteScope", s.OrganizationId, s.SiteId],
        _ => string.Empty
    };

    private async Task SwitchTabAsync(int tab)
    {
        activeTab = tab;
        await ReloadActiveGridAsync(fromFirstPage: true);
    }

    private async Task ChangeScopeAsync(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), NumberStyles.Integer, CultureInfo.InvariantCulture, out var idx))
            scopeIndex = idx;
        await RefreshScopeStateAsync();
        await ReloadActiveGridAsync(fromFirstPage: true);
    }

    private async Task OnSearchInput(ChangeEventArgs e)
    {
        await _searchController.OnInputDebouncedAsync(
            e,
            val => search = val,
            async _ =>
            {
                appliedSearch = string.IsNullOrWhiteSpace(search) ? null : search.Trim();
                await ReloadActiveGridAsync(fromFirstPage: true);
                await InvokeAsync(StateHasChanged);
            });
    }

    private Task RunFilterAsync(Action apply) => _searchController.RunImmediateAsync(async _ =>
    {
        apply();
        await ReloadActiveGridAsync(fromFirstPage: true);
        await InvokeAsync(StateHasChanged);
    });

    private Task ChangeSiteFilterAsync(ChangeEventArgs e)
        => RunFilterAsync(() => siteFilter = long.TryParse(e.Value?.ToString(), NumberStyles.Integer, CultureInfo.InvariantCulture, out var id) ? id : 0);

    private Task ChangeWarehouseFilterAsync(ChangeEventArgs e)
        => RunFilterAsync(() => warehouseFilter = long.TryParse(e.Value?.ToString(), NumberStyles.Integer, CultureInfo.InvariantCulture, out var id) ? id : 0);

    private Task ChangeTypeFilterAsync(ChangeEventArgs e)
        => RunFilterAsync(() => typeFilter = e.Value?.ToString() ?? string.Empty);

    private Task ToggleZeroBalancesAsync(ChangeEventArgs e)
        => RunFilterAsync(() => includeZeroBalances = e.Value is bool b && b);

    private Task ToggleInactiveWarehousesAsync(ChangeEventArgs e)
        => RunFilterAsync(() => includeInactiveWarehouses = e.Value is bool b && b);

    private Task ToggleOpenReservationsAsync(ChangeEventArgs e)
        => RunFilterAsync(() => openReservationsOnly = e.Value is bool b && b);

    private Task ApplySearchAsync()
        => RunFilterAsync(() => appliedSearch = string.IsNullOrWhiteSpace(search) ? null : search.Trim());

    private Task ReloadActiveGridAsync(bool fromFirstPage)
        => gridsSection is not null ? gridsSection.ReloadActiveGridAsync(fromFirstPage) : Task.CompletedTask;

    private async Task ReleaseReservationAsync(StockReservationSummary r)
    {
        var scope = CurrentScope;
        if (scope is null) return;
        modalBusy = true;
        pageError = null;
        pageNotice = null;
        try
        {
            var res = await ResService.ReleaseReservation(scope, new ReleaseReservationRequest(r.OrganizationId, r.Id, r.RowVersion));
            if (!res.Succeeded)
            {
                pageError = RolePermissionLocalization.FailureKey(res.Error!.Code);
                return;
            }
            pageNotice = Text["InvResReleasedNotice"];
            await ReloadActiveGridAsync(fromFirstPage: false);
        }
        finally { modalBusy = false; }
    }

    private void OpenCreateWarehouse()
    {
        editingWarehouse = null;
        whError = null;
        whCode = string.Empty;
        whName = string.Empty;
        whSiteId = CurrentScope is OrganizationScope.Site s ? s.SiteId : authorizedSites.FirstOrDefault()?.Id ?? 0;
        whIsDefault = false;
        whModalOpen = true;
    }

    private void OpenEditWarehouse(WarehouseSummary w)
    {
        editingWarehouse = w;
        whError = null;
        whCode = w.Code;
        whName = w.Name;
        whSiteId = w.SiteId;
        whIsDefault = w.IsDefaultForSite;
        whModalOpen = true;
    }

    private async Task HandleWarehouseSavedAsync()
    {
        whModalOpen = false;
        pageNotice = Text["InvSavedNotice"];
        await RefreshScopeStateAsync();
        await ReloadActiveGridAsync(fromFirstPage: false);
    }

    private async Task OpenPostModal(long? prefillPoId)
    {
        postError = null;
        var prevRes = CurrentScope is not null
            ? await SeqService.GetPreview(CurrentScope, ScopeOrganizationId(CurrentScope), ForgeFlow.Domain.Organizations.DocumentSequenceType.InventoryTransaction)
            : null;
        invDocAllowOverride = prevRes is { Succeeded: true } && prevRes.Value!.AllowManualOverride;
        postDocNumber = prevRes is { Succeeded: true } ? prevRes.Value!.NextPreview : string.Empty;
        postDestWarehouseId = 0;
        postReferenceNote = null;
        postLines.Clear();
        postType = prefillPoId.HasValue ? InventoryTransactionType.ProductionIssue : InventoryTransactionType.Receipt;
        postProductionOrderId = prefillPoId ?? 0;
        postWarehouseManual = false;
        postWarehouseId = activeWarehouses.FirstOrDefault(w => w.IsDefaultForSite)?.Id ?? activeWarehouses.FirstOrDefault()?.Id ?? 0;

        if (prefillPoId.HasValue)
            await PrefillFromProductionOrderAsync(prefillPoId.Value);
        else
            AddPostLine();

        postModalOpen = true;
    }

    private Task OnPostTypeChangedAsync(ChangeEventArgs e)
    {
        if (byte.TryParse(e.Value?.ToString(), out var raw) && Enum.IsDefined((InventoryTransactionType)raw))
            postType = (InventoryTransactionType)raw;
        return Task.CompletedTask;
    }

    private async Task OnPostOrderChangedAsync(ChangeEventArgs e)
    {
        postProductionOrderId = long.TryParse(e.Value?.ToString(), NumberStyles.Integer, CultureInfo.InvariantCulture, out var id) ? id : 0;
        if (postProductionOrderId > 0)
            await PrefillFromProductionOrderAsync(postProductionOrderId);
    }

    private async Task PrefillFromProductionOrderAsync(long poId)
    {
        var scope = CurrentScope;
        if (scope is null) return;
        var res = await OrderService.GetOrder(scope, ScopeOrganizationId(scope), poId);
        if (!res.Succeeded) return;
        var details = res.Value!;
        IReadOnlyList<StockReservationSummary> reservations = [];
        if (postType == InventoryTransactionType.ProductionIssue)
        {
            var resList = await ResService.ListReservations(scope, details.Summary.OrganizationId,
                new ReservationListQuery(ProductionOrderId: poId, OpenOnly: true, Page: 1, PageSize: 100));
            if (resList.Succeeded)
                reservations = resList.Value!.Items;
        }

        var hasManualSiteWh = postWarehouseManual && activeWarehouses.Any(w => w.Id == postWarehouseId && w.SiteId == details.Summary.SiteId);
        if (!hasManualSiteWh)
        {
            var reservedWhId = reservations.FirstOrDefault()?.WarehouseId;
            var matchingWh = (reservedWhId.HasValue ? activeWarehouses.FirstOrDefault(w => w.Id == reservedWhId.Value && w.SiteId == details.Summary.SiteId) : null)
                             ?? activeWarehouses.FirstOrDefault(w => w.SiteId == details.Summary.SiteId && w.IsDefaultForSite)
                             ?? activeWarehouses.FirstOrDefault(w => w.SiteId == details.Summary.SiteId);
            if (matchingWh is not null)
                postWarehouseId = matchingWh.Id;
        }

        postLines.Clear();
        if (postType == InventoryTransactionType.ProductionIssue)
        {
            foreach (var inp in details.Inputs.Where(i => !i.IsSubAssembly))
            {
                var lot = reservations.FirstOrDefault(r => r.WarehouseId == postWarehouseId && r.ItemId == inp.ItemId)?.LotCode
                          ?? reservations.FirstOrDefault(r => r.ItemId == inp.ItemId)?.LotCode
                          ?? string.Empty;
                postLines.Add(new PostLineRow { ItemId = inp.ItemId, LotCode = lot, Quantity = inp.GrossQuantity, UnitId = inp.UnitId });
            }
        }
        else if (postType == InventoryTransactionType.ProductionReceipt)
        {
            foreach (var outLine in details.Outputs.Where(o => o.Level == 1))
                postLines.Add(new PostLineRow { ItemId = outLine.ItemId, Quantity = outLine.PlannedQuantity, UnitId = outLine.UnitId });
        }
        if (postLines.Count == 0)
            AddPostLine();
    }

    private void AddPostLine()
    {
        var firstItem = activeItems.FirstOrDefault();
        postLines.Add(new PostLineRow
        {
            ItemId = firstItem?.Id ?? 0,
            Quantity = 1m,
            UnitId = firstItem?.BaseUnitId ?? activeUnits.FirstOrDefault()?.Id ?? 0
        });
    }

    private void OnPostLineItemChanged(PostLineRow row, ChangeEventArgs e)
    {
        if (long.TryParse(e.Value?.ToString(), NumberStyles.Integer, CultureInfo.InvariantCulture, out var id))
        {
            row.ItemId = id;
            var it = activeItems.FirstOrDefault(i => i.Id == id);
            if (it is not null) row.UnitId = it.BaseUnitId;
        }
    }

    private async Task HandlePostedAsync()
    {
        postModalOpen = false;
        pageNotice = Text["InvPostedNotice"];
        await ReloadActiveGridAsync(fromFirstPage: true);
    }

    private async Task OpenTransactionDetailsAsync(long id)
    {
        var scope = CurrentScope;
        if (scope is null) return;
        var res = await InvService.GetTransaction(scope, ScopeOrganizationId(scope), id);
        if (!res.Succeeded) { pageError = RolePermissionLocalization.FailureKey(res.Error!.Code); return; }
        selectedTxn = res.Value!;
        detailsError = null;
        var revPrev = await SeqService.GetPreview(scope, ScopeOrganizationId(scope), ForgeFlow.Domain.Organizations.DocumentSequenceType.InventoryReversal);
        invRevAllowOverride = revPrev.Succeeded && revPrev.Value!.AllowManualOverride;
        reverseDocNumber = revPrev.Succeeded ? revPrev.Value!.NextPreview : string.Empty;
        reverseNote = null;
        detailsOpen = true;
    }

    private async Task HandleTxnReversedAsync()
    {
        detailsOpen = false;
        pageNotice = Text["InvReversedNotice"];
        await ReloadActiveGridAsync(fromFirstPage: true);
    }

    private string TxnTypeLabel(InventoryTransactionType type) => type switch
    {
        InventoryTransactionType.Receipt => Text["InvTypeReceipt"],
        InventoryTransactionType.Issue => Text["InvTypeIssue"],
        InventoryTransactionType.Adjustment => Text["InvTypeAdjustment"],
        InventoryTransactionType.TransferOut => Text["InvTypeTransferOut"],
        InventoryTransactionType.TransferIn => Text["InvTypeTransferIn"],
        InventoryTransactionType.ProductionIssue => Text["InvTypeProdIssue"],
        InventoryTransactionType.ProductionReceipt => Text["InvTypeProdReceipt"],
        InventoryTransactionType.Reversal => Text["InvTypeReversal"],
        InventoryTransactionType.QualityScrap => Text["InvTypeQualityScrap"],
        InventoryTransactionType.SalesDispatch => Text["InvTypeSalesDispatch"],
        _ => type.ToString()
    };

    private static string TxnBadgeClass(InventoryTransactionType type) => type switch
    {
        InventoryTransactionType.Receipt or InventoryTransactionType.ProductionReceipt or InventoryTransactionType.TransferIn => "po-status-completed",
        InventoryTransactionType.Issue or InventoryTransactionType.ProductionIssue or InventoryTransactionType.SalesDispatch => "po-status-inprogress",
        InventoryTransactionType.TransferOut or InventoryTransactionType.Adjustment => "po-status-released",
        InventoryTransactionType.Reversal or InventoryTransactionType.QualityScrap => "po-status-cancelled",
        _ => "po-status-draft"
    };

    private string ResStatusLabel(ReservationStatus status) => status switch
    {
        ReservationStatus.Active => Text["InvResStatusActive"],
        ReservationStatus.PartiallyConsumed => Text["InvResStatusPartial"],
        ReservationStatus.Fulfilled => Text["InvResStatusConsumed"],
        ReservationStatus.Released => Text["InvResStatusReleased"],
        _ => status.ToString()
    };

    private static string ResBadgeClass(ReservationStatus status) => status switch
    {
        ReservationStatus.Active => "po-status-released",
        ReservationStatus.PartiallyConsumed => "qc-status-pending",
        ReservationStatus.Fulfilled => "po-status-completed",
        ReservationStatus.Released => "po-status-draft",
        _ => "po-status-draft"
    };
