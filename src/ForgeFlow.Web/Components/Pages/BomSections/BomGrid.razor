@using ForgeFlow.Application.Boms
@inject IStringLocalizer<SharedResources> Text

<div class="read-grid-card">
    <div class="read-grid">
        <BitDataGrid @ref="grid" TItem="BomSummary" OnRead="OnRead" Pageable="true" PageSize="25"
                     PageSizeOptions="@PageSizeOptions" Strings="@GridStrings" SelectionMode="BitSelectionMode.Single"
                     AriaLabelledBy="boms-title" WrapCellText="true" Resizable="true">
            <EmptyTemplate><p role="status" class="read-empty">@Text["ReadEmpty"]</p></EmptyTemplate>
            <Columns>
                <BitDataGridColumn TItem="BomSummary" Title="@Text["ReadCode"]">
                    <Template Context="row"><bdi dir="ltr">@row.Code</bdi></Template>
                </BitDataGridColumn>
                <BitDataGridColumn TItem="BomSummary" Title="@Text["ReadName"]">
                    <Template Context="row">@row.Name</Template>
                </BitDataGridColumn>
                <BitDataGridColumn TItem="BomSummary" Title="@Text["BomPrimaryItemLabel"]">
                    <Template Context="row"><bdi dir="ltr">@row.PrimaryOutputItemCode</bdi> — @row.PrimaryOutputItemName</Template>
                </BitDataGridColumn>
                <BitDataGridColumn TItem="BomSummary" Title="@Text["BomVersionCountColumn"]">
                    <Template Context="row"><bdi dir="ltr">@row.VersionCount</bdi></Template>
                </BitDataGridColumn>
                <BitDataGridColumn TItem="BomSummary" Title="@Text["ReadStatus"]">
                    <Template Context="row">
                        <span class="read-badge @(row.IsActive ? "active" : "inactive")">@(row.IsActive ? Text["ReadActive"] : Text["ReadInactiveStatus"])</span>
                    </Template>
                </BitDataGridColumn>
                <BitDataGridColumn TItem="BomSummary" Title="@Text["ReadActions"]">
                    <Template Context="row">
                        <div class="read-row-actions">
                            <BitTooltip Text="@Text["BomVersionsAction"]" ShowOnFocus="true">
                                <BitButton Variant="BitVariant.Outline" Size="BitSize.Small" Class="read-detail-action"
                                           Icon="@VersionsIcon" IconOnly="true" aria-label="@Text["BomVersionsAction"]"
                                           OnClick="() => OnOpenDetails.InvokeAsync(row.Id)" />
                            </BitTooltip>
                            @if (CanManage)
                            {
                                <BitTooltip Text="@Text["ReadEdit"]" ShowOnFocus="true">
                                    <BitButton Variant="BitVariant.Outline" Size="BitSize.Small" Class="read-detail-action"
                                               Icon="@EditIcon" IconOnly="true" aria-label="@Text["ReadEdit"]"
                                               OnClick="() => OnOpenEdit.InvokeAsync(row.Id)" />
                                </BitTooltip>
                            }
                        </div>
                    </Template>
                </BitDataGridColumn>
            </Columns>
        </BitDataGrid>
    </div>
</div>

@code {
    private BitDataGrid<BomSummary>? grid;

    [Parameter, EditorRequired] public Func<BitDataGridReadRequest, Task<BitDataGridReadResult<BomSummary>>> OnRead { get; set; } = default!;
    [Parameter, EditorRequired] public int[] PageSizeOptions { get; set; } = [];
    [Parameter, EditorRequired] public BitDataGridStrings GridStrings { get; set; } = default!;
    [Parameter] public bool CanManage { get; set; }
    [Parameter] public BitIconInfo? VersionsIcon { get; set; }
    [Parameter] public BitIconInfo? EditIcon { get; set; }
    [Parameter] public EventCallback<long> OnOpenDetails { get; set; }
    [Parameter] public EventCallback<long> OnOpenEdit { get; set; }

    public async Task RefreshFromFirstPageAsync()
    {
        if (grid is null) return;
        if (grid.CurrentPage <= 1) await grid.RefreshAsync();
        else await grid.GoToPageAsync(1);
    }
}
