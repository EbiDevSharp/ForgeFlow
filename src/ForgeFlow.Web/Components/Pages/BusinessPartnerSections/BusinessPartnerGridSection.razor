@using ForgeFlow.Application.BusinessPartners
@using ForgeFlow.Domain.BusinessPartners
@inject IStringLocalizer<SharedResources> Text

<div class="read-grid-card bp-grid-card">
    <div class="read-grid">
        <BitDataGrid @ref="grid" TItem="BusinessPartnerSummary" OnRead="OnReadPartners" Pageable="true" PageSize="25"
                     Resizable="true" WrapCellText="true"
                     PageSizeOptions="@PageSizeOptions" Strings="@GridStrings" AriaLabel="@Text["BusinessPartners"]">
            <Columns>
                <BitDataGridColumn TItem="BusinessPartnerSummary" Title="@Text["ReadCode"]" Width="140px">
                    <Template Context="p"><bdi dir="ltr">@p.Code</bdi></Template>
                </BitDataGridColumn>
                <BitDataGridColumn TItem="BusinessPartnerSummary" Title="@Text["ReadName"]" MinWidth="240">
                    <Template Context="p">
                        <div class="bp-name-cell">
                            <div class="bp-person-avatar @(p.PersonType == PersonType.Legal ? "bp-person-avatar--legal" : "bp-person-avatar--natural")"
                                 title="@(p.PersonType == PersonType.Legal ? Text["BpPersonLegalTooltip"] : Text["BpPersonNaturalTooltip"])">
                                @if (p.PersonType == PersonType.Legal)
                                {
                                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                        <rect x="4" y="2" width="16" height="20" rx="2" ry="2"></rect>
                                        <path d="M9 22v-4h6v4"></path>
                                        <path d="M8 6h.01"></path>
                                        <path d="M16 6h.01"></path>
                                        <path d="M8 10h.01"></path>
                                        <path d="M16 10h.01"></path>
                                        <path d="M8 14h.01"></path>
                                        <path d="M16 14h.01"></path>
                                    </svg>
                                }
                                else
                                {
                                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                        <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path>
                                        <circle cx="12" cy="7" r="4"></circle>
                                    </svg>
                                }
                            </div>
                            <div class="bp-name-details">
                                <span class="bp-name-title" title="@p.Name">@p.Name</span>
                                <span class="bp-adaptive-id">
                                    @if (p.PersonType == PersonType.Legal)
                                    {
                                        <span class="bp-adaptive-label">@Text["BpAdaptiveLegal"]:</span>
                                        <bdi dir="ltr">@(string.IsNullOrWhiteSpace(p.NationalLegalId) ? "—" : p.NationalLegalId)</bdi>
                                    }
                                    else
                                    {
                                        <span class="bp-adaptive-label">@Text["BpAdaptiveNatural"]:</span>
                                        <bdi dir="ltr">@(string.IsNullOrWhiteSpace(p.NationalCode) ? "—" : p.NationalCode)</bdi>
                                    }
                                </span>
                            </div>
                        </div>
                    </Template>
                </BitDataGridColumn>
                <BitDataGridColumn TItem="BusinessPartnerSummary" Title="@Text["BpRolesLabel"]" MinWidth="150">
                    <Template Context="p">
                        <div class="bp-roles-wrap">
                            @foreach (var rId in p.RoleIds)
                            {
                                <span class="bp-role-badge @GetRoleBadgeClass(rId)">@RoleName(rId)</span>
                            }
                        </div>
                    </Template>
                </BitDataGridColumn>
                <BitDataGridColumn TItem="BusinessPartnerSummary" Title="@Text["BpContactInfo"]" Width="180px">
                    <Template Context="p">
                        <div class="bp-contact-cell">
                            <span class="bp-contact-phone"><bdi dir="ltr">@(string.IsNullOrWhiteSpace(p.Mobile) ? (string.IsNullOrWhiteSpace(p.Phone) ? "—" : p.Phone) : p.Mobile)</bdi></span>
                            @if (!string.IsNullOrWhiteSpace(p.Email))
                            {
                                <span class="bp-contact-email" title="@p.Email"><bdi dir="ltr">@p.Email</bdi></span>
                            }
                        </div>
                    </Template>
                </BitDataGridColumn>
                <BitDataGridColumn TItem="BusinessPartnerSummary" Title="@Text["ReadStatus"]" Width="100px">
                    <Template Context="p">
                        <span class="read-badge @(p.IsActive ? "active" : "inactive")">
                            @(p.IsActive ? Text["ReadActive"] : Text["ReadInactiveStatus"])
                        </span>
                    </Template>
                </BitDataGridColumn>
                <BitDataGridColumn TItem="BusinessPartnerSummary" Title="@Text["ReadActions"]" Width="140px">
                    <Template Context="p">
                        <div class="bp-actions-cell">
                            <button type="button" class="bp-action-btn" title="@Text["ReadDetails"]" aria-label="@Text["ReadDetails"]" @onclick="() => OnOpenDetail.InvokeAsync(p)">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path>
                                    <circle cx="12" cy="12" r="3"></circle>
                                </svg>
                            </button>
                            @if (ScopeCanManage)
                            {
                                <button type="button" class="bp-action-btn" title="@Text["ReadEdit"]" aria-label="@Text["ReadEdit"]" @onclick="() => OnOpenEdit.InvokeAsync(p)">
                                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                        <path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"></path>
                                        <path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"></path>
                                    </svg>
                                </button>
                                var toggleLabel = Text[p.IsActive ? "WriteDeactivate" : "WriteActivate"];
                                <button type="button" class="bp-action-btn @(p.IsActive ? "bp-action-btn--deactivate" : "bp-action-btn--activate")"
                                        title="@toggleLabel" aria-label="@toggleLabel" @onclick="() => OnOpenToggleConfirm.InvokeAsync(p)">
                                    @if (p.IsActive)
                                    {
                                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                            <circle cx="12" cy="12" r="10"></circle>
                                            <line x1="4.93" y1="4.93" x2="19.07" y2="19.07"></line>
                                        </svg>
                                    }
                                    else
                                    {
                                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                            <path d="M18.36 6.64a9 9 0 1 1-12.73 0"></path>
                                            <line x1="12" y1="2" x2="12" y2="12"></line>
                                        </svg>
                                    }
                                </button>
                            }
                        </div>
                    </Template>
                </BitDataGridColumn>
            </Columns>
        </BitDataGrid>
    </div>
</div>

@code {
    private BitDataGrid<BusinessPartnerSummary>? grid;

    [Parameter] public Func<BitDataGridReadRequest, Task<BitDataGridReadResult<BusinessPartnerSummary>>>? OnReadPartners { get; set; }
    [Parameter] public int[] PageSizeOptions { get; set; } = [10, 25, 50, 100];
    [Parameter] public BitDataGridStrings? GridStrings { get; set; }
    [Parameter] public Func<int, string> GetRoleBadgeClass { get; set; } = _ => string.Empty;
    [Parameter] public Func<int, string> RoleName { get; set; } = _ => string.Empty;
    [Parameter] public bool ScopeCanManage { get; set; }
    [Parameter] public EventCallback<BusinessPartnerSummary> OnOpenDetail { get; set; }
    [Parameter] public EventCallback<BusinessPartnerSummary> OnOpenEdit { get; set; }
    [Parameter] public EventCallback<BusinessPartnerSummary> OnOpenToggleConfirm { get; set; }

    public Task RefreshAsync()
        => grid is not null ? grid.RefreshAsync() : Task.CompletedTask;
}
