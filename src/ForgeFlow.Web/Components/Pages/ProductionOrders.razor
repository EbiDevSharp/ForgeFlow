@page "/production-orders"
@page "/organizations/{OrganizationId:long}/production-orders"
@using ForgeFlow.Application.Boms
@using ForgeFlow.Application.Inventory
@using ForgeFlow.Application.Items
@using ForgeFlow.Application.Organizations
@using ForgeFlow.Application.ProductionOrders
@using ForgeFlow.Application.Routings
@using ForgeFlow.Application.Units
@using ForgeFlow.Domain.Boms
@using ForgeFlow.Domain.Inventory
@using ForgeFlow.Domain.ProductionOrders
@using ForgeFlow.Domain.Routings
@using ForgeFlow.Web.Roles
@implements IDisposable
@inject ProductionOrderUseCases OrderService
@inject RoutingUseCases RoutingService
@inject BomUseCases BomService
@inject ItemUseCases ItemService
@inject UnitUseCases UnitService
@inject InventoryUseCases InvService
@inject DocumentSequenceUseCases SeqService
@inject StockReservationUseCases ResService
@inject ForgeFlow.Web.Organizations.ReadScopes Scopes
@inject ITrustedActorAccessor Actors
@inject IOrganizationPermissionEvaluator Permissions
@inject CulturePolicy Culture
@inject DisplayFormatter Format
@inject NavigationManager Navigation
@inject IStringLocalizer<SharedResources> Text
<PageTitle>@Text["ProductionOrders"] - @Text["AppTitle"]</PageTitle>
<section class="organization-reader" aria-labelledby="po-title">
    <div class="read-page-head">
        <div>
            <h1 id="po-title">@Text["ProductionOrders"]</h1>
            <p class="write-hint">@Text["ProductionOrdersCaption"]</p>
        </div>
        @if (!initialLoading && pageError is null && available.Count > 0 && scopeCanManage)
        {
            <div class="read-head-actions">
                <BitButton Size="BitSize.Small" IconName="Add" Class="read-create-btn" OnClick="OpenCreateModalAsync">
                    @Text["PoCreateButton"]
                </BitButton>
            </div>
        }
    </div>
    @if (pageNotice is not null)
    {
        <p role="status" class="read-page-notice write-saved">@pageNotice</p>
    }
    @if (initialLoading)
    {
        <p role="status" aria-live="polite">@Text["ReadLoading"]</p>
    }
    else if (pageError is not null)
    {
        <div class="read-state" role="alert">
            <p>@Text[pageError]</p>
            <BitButton Variant="BitVariant.Outline" Size="BitSize.Small" OnClick="ReloadScopeAsync">@Text["WriteReload"]</BitButton>
        </div>
    }
    else if (available.Count == 0)
    {
        <p role="status" class="read-empty">@Text["ReadDenied"]</p>
    }
    else
    {
        <div class="read-toolbar-card">
            @if (available.Count > 1)
            {
                <div class="read-field">
                    <label for="po-scope">@Text["ReadScope"]</label>
                    <select id="po-scope" aria-label="@Text["ReadScope"]" value="@scopeIndex" @onchange="ChangeScopeAsync">
                        @for (var i = 0; i < available.Count; i++)
                        {
                            <option value="@i">@ScopeLabel(available[i])</option>
                        }
                    </select>
                </div>
            }
            @if (CurrentScope is OrganizationScope.Organization && authorizedSites.Count > 1)
            {
                <div class="read-field">
                    <label for="po-site-filter">@Text["PoSiteColumn"]</label>
                    <select id="po-site-filter" value="@siteFilter" @onchange="ChangeSiteFilterAsync">
                        <option value="0">@Text["PoAllSitesOption"]</option>
                        @foreach (var s in authorizedSites)
                        {
                            <option value="@s.Id">@s.Code — @s.Name</option>
                        }
                    </select>
                </div>
            }
            <div class="read-field">
                <label for="po-status-filter">@Text["PoStatusColumn"]</label>
                <select id="po-status-filter" value="@statusFilter" @onchange="ChangeStatusFilterAsync">
                    <option value="">@Text["PoAllStatusesOption"]</option>
                    @foreach (var st in Enum.GetValues<ProductionOrderStatus>())
                    {
                        <option value="@((byte)st)">@StatusLabel(st)</option>
                    }
                </select>
            </div>
            <div class="read-field">
                <label for="po-search">@Text["ReadSearch"]</label>
                <input id="po-search" type="search" value="@search" @oninput="OnSearchInput" maxlength="64" placeholder="@Text["ReadSearch"]" />
            </div>
        </div>
@using ForgeFlow.Web.Components.Pages.ProductionOrderSections
        <ProductionOrderGridSection @ref="gridSection"
                                    CurrentScope="@CurrentScope"
                                    SiteFilter="@siteFilter"
                                    StatusFilter="@statusFilter"
                                    AppliedSearch="@appliedSearch"
                                    PageSizeOptions="@PageSizeOptions"
                                    GridStrings="@GridStrings"
                                    StatusLabel="@StatusLabel"
                                    StatusBadgeClass="@StatusBadgeClass"
                                    OnOpenWorkbench="OpenWorkbenchAsync"
                                    OnPageError="err => { pageError = err; StateHasChanged(); }" />
    }
    <ProductionOrderCreateDialog
        @bind-IsOpen="createOpen"
        @bind-IsOpen:after="OnCreateOpenChanged"
        DialogClasses="@DialogClasses"
        CurrentScope="@CurrentScope"
        CreateError="@createError"
        MoAllowOverride="@moAllowOverride"
        @bind-NewOrderNumber="newOrderNumber"
        AuthorizedSites="@authorizedSites"
        NewSiteId="@newSiteId"
        OnNewSiteChanged="OnNewSiteChangedAsync"
        NewItemId="@newItemId"
        OnNewItemChanged="OnNewItemChangedAsync"
        ManufacturableItems="@manufacturableItems"
        @bind-NewRoutingId="newRoutingId"
        NewItemRoutings="@newItemRoutings"
        @bind-NewQuantity="newQuantity"
        @bind-NewUnitId="newUnitId"
        ActiveUnits="@activeUnits"
        @bind-NewStartDateOffset="NewStartDateOffset"
        @bind-NewDueDateOffset="NewDueDateOffset"
        PickerDateFormat="@PickerDateFormat"
        TodayIcon="@TodayIcon"
        CalendarIcon="@CalendarIcon"
        NextNavIcon="@NextNavIcon"
        PrevNavIcon="@PrevNavIcon"
        NextYearIcon="@NextYearIcon"
        PrevYearIcon="@PrevYearIcon"
        CloseIcon="@CloseIcon"
        PlusIcon="@PlusIcon"
        @bind-NewNotes="newNotes"
        ActiveDimensions="@activeDimensions"
        NewContextPairs="@newContextPairs"
        OnAddContextRow="() => AddContextRow(newContextPairs)"
        OnRemoveContextRow="row => newContextPairs.Remove(row)"
        ModalBusy="@modalBusy"
        OnCreateOrder="CreateOrderAsync" />
    <ProductionOrderWorkbenchModal @ref="workbenchModal"
                                 @bind-IsOpen="workbenchOpen"
                                 @bind-IsOpen:after="OnWorkbenchOpenChanged"
                                 DialogClasses="@DialogClasses"
                                 CurrentScope="@CurrentScope"
                                 ScopeCanManage="@scopeCanManage"
                                 CanManageInventory="@canManageInventory"
                                 CanExecuteOperations="@canExecuteOperations"
                                 @bind-ModalBusy="modalBusy"
                                 ActiveUnits="@activeUnits"
                                 ActiveDimensions="@activeDimensions"
                                 PickerDateFormat="@PickerDateFormat"
                                 TodayIcon="@TodayIcon"
                                 CalendarIcon="@CalendarIcon"
                                 NextNavIcon="@NextNavIcon"
                                 PrevNavIcon="@PrevNavIcon"
                                 NextYearIcon="@NextYearIcon"
                                 PrevYearIcon="@PrevYearIcon"
                                 CloseIcon="@CloseIcon"
                                 PlusIcon="@PlusIcon"
                                 StatusLabel="@StatusLabel"
                                 StatusBadgeClass="@StatusBadgeClass"
                                 BuildContextDictionary="@BuildContextDictionary"
                                 OnAddContextRow="AddContextRow"
                                 OnOpenReserveModal="OpenReserveModal"
                                 OnOpenCoaModal="args => OpenCoaModal(args.ItemId, args.LotCode)"
                                 OnRefreshGrid="RefreshGridCurrentPageAsync" />
    <ProductionOrderReserveDialog
        @bind-IsOpen="reserveModalOpen"
        @bind-IsOpen:after="OnReserveModalOpenChanged"
        DialogClasses="@DialogClasses"
        ReserveError="@reserveError"
        ReserveItemLabel="@reserveItemLabel"
        @bind-ReserveQuantity="reserveQuantity"
        @bind-ReserveUnitId="reserveUnitId"
        ActiveUnits="@activeUnits"
        @bind-ReserveWarehouseId="reserveWarehouseId"
        ActiveWarehouses="@activeWarehouses"
        SiteIdFilter="@(workbenchModal?.CurrentSummary?.SiteId)"
        @bind-ReserveLotCode="reserveLotCode"
        @bind-ReserveNotes="reserveNotes"
        ModalBusy="@modalBusy"
        OnSubmitReserve="SubmitReserveAsync" />
    @if (CurrentScope is not null)
    {
        <LotCertificateDialog @bind-IsOpen="coaOpen" Scope="@CurrentScope" OrganizationId="@ScopeOrganizationId(CurrentScope)"
                              ItemId="@coaItemId" LotCode="@coaLotCode" />
    }
</section>

@code {
    [Parameter] public long? OrganizationId { get; set; }

    private static readonly int[] PageSizeOptions = [10, 25, 50, 100];
    private static readonly BitDialogClassStyles DialogClasses = new()
    {
        Container = "read-dialog",
        Header = "read-dialog-header",
        Body = "read-dialog-body",
        CloseButton = "read-dialog-close",
        Overlay = "read-dialog-overlay"
    };

    private static readonly BitIconInfo CalendarIcon = BitIconInfo.Css("ff-icon ff-icon--calendar");
    private static readonly BitIconInfo TodayIcon = BitIconInfo.Css("ff-icon ff-icon--today");
    private static readonly BitIconInfo NextNavIcon = BitIconInfo.Css("ff-icon ff-icon--chevron-next");
    private static readonly BitIconInfo PrevNavIcon = BitIconInfo.Css("ff-icon ff-icon--chevron-prev");
    private static readonly BitIconInfo NextYearIcon = BitIconInfo.Css("ff-icon ff-icon--chevrons-next");
    private static readonly BitIconInfo PrevYearIcon = BitIconInfo.Css("ff-icon ff-icon--chevrons-prev");
    private static readonly BitIconInfo CloseIcon = BitIconInfo.Css("ff-icon ff-icon--close");
    private static readonly BitIconInfo PlusIcon = BitIconInfo.Css("ff-icon ff-icon--plus");
    private string PickerDateFormat => Culture.Language == CulturePolicy.Persian ? "yyyy/MM/dd" : "yyyy-MM-dd";

    private ProductionOrderGridSection? gridSection;
    private ProductionOrderWorkbenchModal? workbenchModal;
    private bool initialLoading = true;
    private string? pageError;
    private string? pageNotice;
    private List<OrganizationScope> available = [];
    private IReadOnlyDictionary<OrganizationScope, ForgeFlow.Web.Organizations.ScopeDisplayInfo> scopeLabels =
        new Dictionary<OrganizationScope, ForgeFlow.Web.Organizations.ScopeDisplayInfo>();
    private int scopeIndex;
    private bool scopeCanManage;
    private bool canManageInventory;
    private bool canExecuteOperations;
    private IReadOnlyList<RoutingSummary> newItemRoutings = [];
    private long newRoutingId;

    private IReadOnlyList<ProductionOrderSiteInfo> authorizedSites = [];
    private IReadOnlyList<ItemSummary> manufacturableItems = [];
    private IReadOnlyList<UnitSummary> activeUnits = [];
    private IReadOnlyList<ContextDimensionSummary> activeDimensions = [];
    private IReadOnlyList<WarehouseSummary> activeWarehouses = [];

    private bool reserveModalOpen;
    private long? reserveInputId;
    private long reserveItemId;
    private string reserveItemLabel = string.Empty;
    private decimal reserveQuantity = 1m;
    private long reserveUnitId;
    private long reserveWarehouseId;
    private string? reserveLotCode;
    private string? reserveNotes;
    private string? reserveError;

    private bool coaOpen;
    private long coaItemId;
    private string coaLotCode = string.Empty;

    private void OpenCoaModal(long itemId, string lotCode)
    {
        coaItemId = itemId;
        coaLotCode = lotCode;
        coaOpen = true;
    }

    private long siteFilter;
    private string statusFilter = string.Empty;
    private string? search;
    private string? appliedSearch;

    private bool createOpen;
    private bool modalBusy;
    private string? createError;
    private long newSiteId;
    private string newOrderNumber = string.Empty;
    private bool moAllowOverride;
    private long newItemId;
    private decimal newQuantity = 1m;
    private long newUnitId;
    private DateOnly newStartDate = DateOnly.FromDateTime(DateTime.UtcNow.Date);
    private DateOnly newDueDate = DateOnly.FromDateTime(DateTime.UtcNow.Date.AddDays(1));
    private string? newNotes;
    private readonly List<ContextPairRow> newContextPairs = [];

    private bool workbenchOpen;

    public sealed class ContextPairRow
    {
        public string DimensionCode { get; set; } = string.Empty;
        public string Value { get; set; } = string.Empty;
    }

    private DateTimeOffset? NewStartDateOffset
    {
        get => DatePickerHelper.ToDateTimeOffset(newStartDate);
        set
        {
            newStartDate = DatePickerHelper.FromDateTimeOffset(value) ?? newStartDate;
            if (newStartDate != default && newDueDate != default && newStartDate > newDueDate)
                newDueDate = newStartDate;
        }
    }

    private DateTimeOffset? NewDueDateOffset
    {
        get => DatePickerHelper.ToDateTimeOffset(newDueDate);
        set
        {
            newDueDate = DatePickerHelper.FromDateTimeOffset(value) ?? newDueDate;
            if (newStartDate != default && newDueDate != default && newDueDate < newStartDate)
                newStartDate = newDueDate;
        }
    }

    private OrganizationScope? CurrentScope =>
        scopeIndex >= 0 && scopeIndex < available.Count ? available[scopeIndex] : null;

    private static long ScopeOrganizationId(OrganizationScope scope) => scope switch
    {
        OrganizationScope.Organization o => o.OrganizationId,
        OrganizationScope.Site s => s.OrganizationId,
        _ => 0
    };

    private BitDataGridStrings GridStrings => new()
    {
        GridLabel = Text["ProductionOrders"],
        EmptyText = Text["ReadEmpty"],
        NoMatchesText = Text["ReadEmpty"],
        LoadingText = Text["ReadLoading"],
        PagerRangeFormat = Text["GridPagerRange"],
        PagerPageFormat = Text["GridPagerPage"],
        PerPageFormat = Text["GridPerPage"],
        RowsPerPageLabel = Text["GridRowsPerPage"],
        FirstPageLabel = Text["GridFirstPage"],
        PreviousPageLabel = Text["GridPreviousPage"],
        NextPageLabel = Text["GridNextPage"],
        LastPageLabel = Text["GridLastPage"],
        AnnouncementPage = Text["GridPagerPage"]
    };

    private CancellationTokenSource? _loadCts;
    private readonly DebouncedSearchController _searchController = new(300);

    public void Dispose()
    {
        _searchController.Dispose();
        _loadCts?.Cancel();
        _loadCts?.Dispose();
        _loadCts = null;
        workbenchModal?.ResetState();
        newContextPairs.Clear();
        newItemRoutings = [];
        authorizedSites = [];
        manufacturableItems = [];
        activeUnits = [];
        activeDimensions = [];
        activeWarehouses = [];
    }

    private void OnCreateOpenChanged()
    {
        if (!createOpen)
        {
            newContextPairs.Clear();
            createError = null;
            newNotes = string.Empty;
        }
    }

    private void OnWorkbenchOpenChanged()
    {
        if (!workbenchOpen)
            workbenchModal?.ResetState();
    }

    private void OnReserveModalOpenChanged()
    {
        if (!reserveModalOpen)
        {
            reserveError = null;
            reserveLotCode = null;
            reserveNotes = null;
        }
    }

    protected override async Task OnParametersSetAsync() => await ReloadScopeAsync();

    private async Task ReloadScopeAsync()
    {
        _loadCts?.Cancel();
        _loadCts?.Dispose();
        var cts = new CancellationTokenSource();
        _loadCts = cts;
        var ct = cts.Token;

        initialLoading = true;
        pageError = null;
        pageNotice = null;
        try
        {
            var loaded = await Scopes.LoadProductionOrderScopesAsync();
            if (ct.IsCancellationRequested) return;
            available = OrganizationId is long orgId
                ? loaded.Where(s => ScopeOrganizationId(s) == orgId).ToList()
                : loaded.ToList();
            scopeLabels = await Scopes.LoadDisplayInfoAsync(available);
            if (available.Count == 0 && OrganizationId is long fallbackOrgId)
                available = [new OrganizationScope.Organization(fallbackOrgId)];
            scopeIndex = 0;
            await RefreshScopeStateAsync(ct);
        }
        catch (OperationCanceledException)
        {
        }
        catch
        {
            pageError = "ReadError";
        }
        finally
        {
            if (ReferenceEquals(_loadCts, cts))
                initialLoading = false;
        }
    }

    private async Task RefreshScopeStateAsync(CancellationToken ct = default)
    {
        scopeCanManage = false;
        canManageInventory = false;
        authorizedSites = [];
        manufacturableItems = [];
        activeUnits = [];
        activeDimensions = [];
        activeWarehouses = [];
        siteFilter = 0;

        var scope = CurrentScope;
        if (scope is null || ct.IsCancellationRequested) return;

        var actor = await Actors.ResolveAsync(ct);
        var orgId = ScopeOrganizationId(scope);

        Task<PermissionDecision>? manageTask = actor is not null
            ? Permissions.EvaluateAsync(actor, scope, ProductionOrderPermissions.ProductionOrdersManage, ct).AsTask()
            : null;
        Task<PermissionDecision>? invTask = actor is not null
            ? Permissions.EvaluateAsync(actor, scope, InventoryPermissions.InventoryManage, ct).AsTask()
            : null;
        Task<PermissionDecision>? opTask = actor is not null
            ? Permissions.EvaluateAsync(actor, scope, RoutingPermissions.OperationsExecute, ct).AsTask()
            : null;

        var sitesTask = OrderService.ListAuthorizedSites(scope, orgId, ct);
        var itemsTask = ItemService.ListItems(scope, orgId, new ItemListQuery(CanBeManufactured: true, IncludeInactive: false, Page: 1, PageSize: 100), ct);
        var unitsTask = UnitService.ListUnits(scope, orgId, new UnitListQuery(IncludeInactive: false, Page: 1, PageSize: 100), ct);
        var dimsTask = BomService.ListContextDimensions(scope, orgId, new ContextDimensionListQuery(IncludeInactive: false, Page: 1, PageSize: 100), ct);
        var whTask = InvService.ListWarehouses(scope, orgId, new WarehouseListQuery(IncludeInactive: false, Page: 1, PageSize: 100), ct);

        var tasks = new List<Task> { sitesTask, itemsTask, unitsTask, dimsTask, whTask };
        if (manageTask is not null) tasks.Add(manageTask);
        if (invTask is not null) tasks.Add(invTask);
        if (opTask is not null) tasks.Add(opTask);

        await Task.WhenAll(tasks);
        if (ct.IsCancellationRequested) return;

        if (manageTask is not null) scopeCanManage = (await manageTask).IsAllowed;
        if (invTask is not null) canManageInventory = (await invTask).IsAllowed;
        if (opTask is not null) canExecuteOperations = (await opTask).IsAllowed;

        var sitesRes = await sitesTask;
        if (sitesRes.Succeeded)
            authorizedSites = sitesRes.Value!;

        if (scope is OrganizationScope.Site siteScope)
            siteFilter = siteScope.SiteId;

        var itemsRes = await itemsTask;
        if (itemsRes.Succeeded)
            manufacturableItems = itemsRes.Value!.Items;

        var unitsRes = await unitsTask;
        if (unitsRes.Succeeded)
            activeUnits = unitsRes.Value!.Items;

        var dimsRes = await dimsTask;
        if (dimsRes.Succeeded)
            activeDimensions = dimsRes.Value!.Items;

        var whRes = await whTask;
        if (whRes.Succeeded)
            activeWarehouses = whRes.Value!.Items;
    }

    private string ScopeLabel(OrganizationScope scope) => scope switch
    {
        OrganizationScope.Organization o when scopeLabels.TryGetValue(scope, out var info) && info.OrgCode is not null
            => $"{info.OrgCode} — {info.OrgName}",
        OrganizationScope.Organization o => Text["ReadOrganizationScope", o.OrganizationId],
        OrganizationScope.Site s when scopeLabels.TryGetValue(scope, out var info) && info.SiteCode is not null
            => $"{info.OrgCode} / {info.SiteCode} — {info.SiteName}",
        OrganizationScope.Site s => Text["ReadSiteScope", s.OrganizationId, s.SiteId],
        _ => string.Empty
    };

    private async Task ChangeScopeAsync(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), NumberStyles.Integer, CultureInfo.InvariantCulture, out var idx))
            scopeIndex = idx;
        pageError = null;
        pageNotice = null;
        await RefreshScopeStateAsync();
        await ReloadGridFromFirstPageAsync();
    }

    private async Task OnSearchInput(ChangeEventArgs e)
    {
        await _searchController.OnInputDebouncedAsync(
            e,
            val => search = val,
            async _ =>
            {
                appliedSearch = string.IsNullOrWhiteSpace(search) ? null : search.Trim();
                await ReloadGridFromFirstPageAsync();
                await InvokeAsync(StateHasChanged);
            });
    }

    private async Task ChangeSiteFilterAsync(ChangeEventArgs e)
    {
        siteFilter = long.TryParse(e.Value?.ToString(), NumberStyles.Integer, CultureInfo.InvariantCulture, out var id) ? id : 0;
        await _searchController.RunImmediateAsync(async _ =>
        {
            await ReloadGridFromFirstPageAsync();
            await InvokeAsync(StateHasChanged);
        });
    }

    private async Task ChangeStatusFilterAsync(ChangeEventArgs e)
    {
        statusFilter = e.Value?.ToString() ?? string.Empty;
        await _searchController.RunImmediateAsync(async _ =>
        {
            await ReloadGridFromFirstPageAsync();
            await InvokeAsync(StateHasChanged);
        });
    }

    private async Task ApplySearchAsync()
    {
        await _searchController.RunImmediateAsync(async _ =>
        {
            appliedSearch = string.IsNullOrWhiteSpace(search) ? null : search.Trim();
            await ReloadGridFromFirstPageAsync();
            await InvokeAsync(StateHasChanged);
        });
    }

    private Task ReloadGridFromFirstPageAsync()
        => gridSection?.ReloadFromFirstPageAsync() ?? Task.CompletedTask;

    private async Task OpenCreateModalAsync()
    {
        createError = null;
        var prevRes = CurrentScope is not null
            ? await SeqService.GetPreview(CurrentScope, ScopeOrganizationId(CurrentScope), ForgeFlow.Domain.Organizations.DocumentSequenceType.ProductionOrder)
            : null;
        moAllowOverride = prevRes is { Succeeded: true } && prevRes.Value!.AllowManualOverride;
        newOrderNumber = prevRes is { Succeeded: true } ? prevRes.Value!.NextPreview : string.Empty;
        newSiteId = CurrentScope is OrganizationScope.Site siteScope
            ? siteScope.SiteId
            : authorizedSites.FirstOrDefault()?.Id ?? 0;
        newItemId = 0;
        newUnitId = activeUnits.FirstOrDefault()?.Id ?? 0;
        newQuantity = 1m;
        var today = DateOnly.FromDateTime(DateTime.UtcNow.Date);
        newStartDate = today;
        newDueDate = today.AddDays(1);
        newRoutingId = 0;
        newItemRoutings = [];
        newNotes = null;
        newContextPairs.Clear();
        createOpen = true;
    }

    private async Task OnNewSiteChangedAsync(ChangeEventArgs e)
    {
        if (long.TryParse(e.Value?.ToString(), NumberStyles.Integer, CultureInfo.InvariantCulture, out var id))
        {
            newSiteId = id;
            await LoadNewItemRoutingsAsync();
        }
    }

    private async Task OnNewItemChangedAsync(ChangeEventArgs e)
    {
        if (long.TryParse(e.Value?.ToString(), NumberStyles.Integer, CultureInfo.InvariantCulture, out var id))
        {
            newItemId = id;
            var item = manufacturableItems.FirstOrDefault(i => i.Id == id);
            if (item is not null) newUnitId = item.BaseUnitId;
            await LoadNewItemRoutingsAsync();
        }
    }

    private async Task LoadNewItemRoutingsAsync()
    {
        newRoutingId = 0;
        newItemRoutings = [];
        var scope = CurrentScope;
        if (scope is null || newSiteId <= 0 || newItemId <= 0) return;
        var res = await RoutingService.ListActiveRoutingsForItem(scope, ScopeOrganizationId(scope), newSiteId, newItemId);
        if (res.Succeeded)
        {
            newItemRoutings = res.Value!;
            var def = newItemRoutings.FirstOrDefault(r => r.IsDefault);
            if (def is not null) newRoutingId = def.Id;
        }
    }

    private void AddContextRow(List<ContextPairRow> rows)
    {
        var used = rows.Select(r => r.DimensionCode).ToHashSet(StringComparer.Ordinal);
        var next = activeDimensions.FirstOrDefault(d => !used.Contains(d.Code)) ?? activeDimensions.FirstOrDefault();
        if (next is not null)
            rows.Add(new ContextPairRow { DimensionCode = next.Code, Value = string.Empty });
    }

    private static IReadOnlyDictionary<string, string>? BuildContextDictionary(List<ContextPairRow> rows)
    {
        var dict = new Dictionary<string, string>(StringComparer.Ordinal);
        foreach (var row in rows)
        {
            if (!string.IsNullOrWhiteSpace(row.DimensionCode) && !string.IsNullOrWhiteSpace(row.Value))
                dict[row.DimensionCode.Trim().ToUpperInvariant()] = row.Value.Trim();
        }
        return dict.Count == 0 ? null : dict;
    }

    private async Task CreateOrderAsync()
    {
        var scope = CurrentScope;
        if (scope is null) return;
        modalBusy = true;
        createError = null;
        try
        {
            var orgId = ScopeOrganizationId(scope);
            var req = new CreateProductionOrderRequest(
                orgId,
                newSiteId,
                moAllowOverride ? newOrderNumber : null,
                newItemId,
                newQuantity,
                newUnitId > 0 ? newUnitId : null,
                newStartDate,
                newDueDate,
                BuildContextDictionary(newContextPairs),
                newNotes,
                newRoutingId > 0 ? newRoutingId : null);
            var res = await OrderService.CreateDraftOrder(scope, req);
            if (!res.Succeeded)
            {
                createError = RolePermissionLocalization.FailureKey(res.Error!.Code);
                return;
            }
            createOpen = false;
            pageNotice = Text["PoCreatedNotice"];
            await ReloadGridFromFirstPageAsync();
            if (workbenchModal is not null)
                await workbenchModal.LoadOrderAsync(res.Value!);
            workbenchOpen = true;
        }
        finally
        {
            modalBusy = false;
        }
    }

    private async Task OpenWorkbenchAsync(long orderId)
    {
        var scope = CurrentScope;
        if (scope is null) return;
        var res = await OrderService.GetOrder(scope, ScopeOrganizationId(scope), orderId);
        if (!res.Succeeded)
        {
            pageError = RolePermissionLocalization.FailureKey(res.Error!.Code);
            return;
        }
        if (workbenchModal is not null)
            await workbenchModal.LoadOrderAsync(res.Value!);
        workbenchOpen = true;
    }

    private Task RefreshGridCurrentPageAsync()
        => gridSection?.RefreshCurrentPageAsync() ?? Task.CompletedTask;

    private string StatusLabel(ProductionOrderStatus status) => status switch
    {
        ProductionOrderStatus.Draft => Text["PoStatusDraft"],
        ProductionOrderStatus.Released => Text["PoStatusReleased"],
        ProductionOrderStatus.InProgress => Text["PoStatusInProgress"],
        ProductionOrderStatus.Completed => Text["PoStatusCompleted"],
        ProductionOrderStatus.Cancelled => Text["PoStatusCancelled"],
        _ => status.ToString()
    };

    private static string StatusBadgeClass(ProductionOrderStatus status) => status switch
    {
        ProductionOrderStatus.Draft => "po-status-draft",
        ProductionOrderStatus.Released => "po-status-released",
        ProductionOrderStatus.InProgress => "po-status-inprogress",
        ProductionOrderStatus.Completed => "po-status-completed",
        ProductionOrderStatus.Cancelled => "po-status-cancelled",
        _ => "po-status-draft"
    };

    private void OpenReserveModal(ProductionOrderInputSummary inp)
    {
        reserveError = null;
        reserveInputId = inp.Id;
        reserveItemId = inp.ItemId;
        reserveItemLabel = $"{inp.ItemCode} — {inp.ItemName}";
        reserveQuantity = inp.GrossQuantity > 0m ? inp.GrossQuantity : 1m;
        reserveUnitId = inp.UnitId > 0 ? inp.UnitId : (activeUnits.FirstOrDefault()?.Id ?? 0);
        reserveWarehouseId = 0;
        reserveLotCode = null;
        reserveNotes = null;
        reserveModalOpen = true;
    }

    private async Task SubmitReserveAsync()
    {
        var scope = CurrentScope;
        var s = workbenchModal?.CurrentSummary;
        if (scope is null || s is null) return;
        modalBusy = true;
        reserveError = null;
        try
        {
            var res = await ResService.ReserveStock(scope, new ReserveStockRequest(
                s.OrganizationId,
                s.Id,
                reserveInputId,
                reserveItemId,
                reserveQuantity,
                reserveUnitId > 0 ? reserveUnitId : null,
                reserveWarehouseId > 0 ? reserveWarehouseId : null,
                string.IsNullOrWhiteSpace(reserveLotCode) ? null : reserveLotCode.Trim(),
                reserveNotes));
            if (!res.Succeeded)
            {
                reserveError = RolePermissionLocalization.FailureKey(res.Error!.Code);
                return;
            }
            reserveModalOpen = false;
            if (workbenchModal is not null)
            {
                workbenchModal.SetReserveSavedNotice();
                await workbenchModal.ReloadReservationsAsync();
            }
        }
        finally { modalBusy = false; }
    }
}
