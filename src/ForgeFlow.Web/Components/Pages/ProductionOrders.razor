    private async Task RunOperationMutationAsync(Func<OrganizationScope, Task<OrganizationResult<ProductionOrderOperationSummary>>> call)
    {
        var scope = CurrentScope;
        if (scope is null || selectedOrder is null) return;
        modalBusy = true;
        workbenchError = null;
        workbenchSaved = null;
        try
        {
            var res = await call(scope);
            if (!res.Succeeded)
            {
                workbenchError = RolePermissionLocalization.FailureKey(res.Error!.Code);
                return;
            }
            var reloaded = await OrderService.GetOrder(scope, selectedOrder.Summary.OrganizationId, selectedOrder.Summary.Id);
            if (reloaded.Succeeded)
            {
                PopulateWorkbench(reloaded.Value!);
                workbenchSaved = "PoOpSavedNotice";
            }
        }
        finally { modalBusy = false; }
    }

