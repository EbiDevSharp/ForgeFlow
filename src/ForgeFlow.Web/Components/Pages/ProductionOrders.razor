    private void AddContextRow(List<ContextPairRow> rows)
    {
        var used = rows.Select(r => r.DimensionCode).ToHashSet(StringComparer.Ordinal);
        var next = activeDimensions.FirstOrDefault(d => !used.Contains(d.Code)) ?? activeDimensions.FirstOrDefault();
        if (next is not null)
            rows.Add(new ContextPairRow { DimensionCode = next.Code, Value = string.Empty });
    }

    private static IReadOnlyDictionary<string, string>? BuildContextDictionary(List<ContextPairRow> rows)
    {
        var dict = new Dictionary<string, string>(StringComparer.Ordinal);
        foreach (var row in rows)
        {
            if (!string.IsNullOrWhiteSpace(row.DimensionCode) && !string.IsNullOrWhiteSpace(row.Value))
                dict[row.DimensionCode.Trim().ToUpperInvariant()] = row.Value.Trim();
        }
        return dict.Count == 0 ? null : dict;
    }

