        opActualRun = op.ActualRunMinutes > 0m ? op.ActualRunMinutes : op.PlannedRunMinutes;
        opCompletedQty = op.CompletedQuantity > 0m ? op.CompletedQuantity : (selectedOrder?.Summary.RequestedQuantity ?? 0m);
