@page "/sales"
@page "/organizations/{OrganizationId:long}/sales"
@using ForgeFlow.Application.Inventory
@using ForgeFlow.Application.Items
@using ForgeFlow.Application.Organizations
@using ForgeFlow.Application.Sales
@using ForgeFlow.Application.Units
@using ForgeFlow.Domain.Inventory
@using ForgeFlow.Domain.Sales
@inject SalesUseCases SalesService
@inject StockReservationUseCases ReservationService
@inject OrganizationUseCases OrgService
@inject InventoryUseCases InvService
@inject ItemUseCases ItemService
@inject UnitUseCases UnitService
@inject DocumentSequenceUseCases SeqService
@inject ForgeFlow.Web.Organizations.ReadScopes Scopes
@inject ITrustedActorAccessor Actors
@inject IOrganizationPermissionEvaluator Permissions
@inject CulturePolicy Culture
@inject DisplayFormatter Format
@inject IStringLocalizer<SharedResources> Text

<PageTitle>@Text["SalesDispatch"] - @Text["AppTitle"]</PageTitle>

<section class="organization-reader" aria-labelledby="sales-page-title">
    <div class="read-page-head">
        <div>
            <h1 id="sales-page-title">@Text["SalesDispatch"]</h1>
            <p class="write-hint">@Text["SalesDispatchCaption"]</p>
        </div>
        @if (!initialLoading && pageError is null && available.Count > 0)
        {
            <div class="read-head-actions">
                @if (activeTab == TabCustomers && scopeCanManageCustomers)
                {
                    <BitButton Size="BitSize.Small" IconName="Add" Class="read-create-btn" OnClick="OpenCreateCustomerModal">
                        @Text["SalesCustomerCreateButton"]
                    </BitButton>
                }
                else if (activeTab == TabOrders && scopeCanManageOrders)
                {
                    <BitButton Size="BitSize.Small" IconName="Add" Class="read-create-btn" OnClick="OpenCreateOrderModalAsync">
                        @Text["SalesOrderCreateButton"]
                    </BitButton>
                }
            </div>
        }
    </div>

    @if (pageNotice is not null)
    {
        <p role="status" class="read-page-notice write-saved">@pageNotice</p>
    }

    @if (initialLoading)
    {
        <p role="status" aria-live="polite">@Text["ReadLoading"]</p>
    }
    else if (pageError is not null)
    {
        <div class="read-state" role="alert">
            <p>@Text[pageError]</p>
            <BitButton Variant="BitVariant.Outline" Size="BitSize.Small" OnClick="ReloadScopeAsync">@Text["WriteReload"]</BitButton>
        </div>
    }
    else if (available.Count == 0)
    {
        <p role="status" class="read-empty">@Text["ReadDenied"]</p>
    }
    else
    {
        <div class="read-tab-bar" role="tablist" aria-label="@Text["SalesDispatch"]">
            <button type="button" role="tab" aria-selected="@(activeTab == TabOrders)"
                    class="read-tab-btn @(activeTab == TabOrders ? "active" : string.Empty)"
                    @onclick="() => SwitchTabAsync(TabOrders)">@Text["SalesTabOrders"]</button>
            <button type="button" role="tab" aria-selected="@(activeTab == TabDispatches)"
                    class="read-tab-btn @(activeTab == TabDispatches ? "active" : string.Empty)"
                    @onclick="() => SwitchTabAsync(TabDispatches)">@Text["SalesTabDispatches"]</button>
            <button type="button" role="tab" aria-selected="@(activeTab == TabCustomers)"
                    class="read-tab-btn @(activeTab == TabCustomers ? "active" : string.Empty)"
                    @onclick="() => SwitchTabAsync(TabCustomers)">@Text["SalesTabCustomers"]</button>
        </div>

        <div class="read-toolbar-card">
            @if (available.Count > 1)
            {
                <div class="read-field">
                    <label for="sales-scope">@Text["ReadScope"]</label>
                    <select id="sales-scope" aria-label="@Text["ReadScope"]" value="@scopeIndex" @onchange="ChangeScopeAsync">
                        @for (var i = 0; i < available.Count; i++)
                        {
                            <option value="@i">@ScopeLabel(available[i])</option>
                        }
                    </select>
                </div>
            }

            @if (activeTab != TabCustomers && CurrentScope is OrganizationScope.Organization && authorizedSites.Count > 1)
            {
                <div class="read-field">
                    <label for="sales-site-filter">@Text["PoSiteColumn"]</label>
                    <select id="sales-site-filter" value="@siteFilter" @onchange="ChangeSiteFilterAsync">
                        <option value="0">@Text["PoAllSitesOption"]</option>
                        @foreach (var s in authorizedSites)
                        {
                            <option value="@s.Id">@s.Code — @s.Name</option>
                        }
                    </select>
                </div>
            }

            @if (activeTab == TabCustomers)
            {
                <label class="read-inactive">
                    <input type="checkbox" checked="@includeInactiveCustomers" @onchange="ToggleInactiveCustomersAsync" />
                    <span>@Text["ReadInactive"]</span>
                </label>
            }
            else if (activeTab == TabOrders)
            {
                <div class="read-field">
                    <label for="sales-order-status">@Text["PoStatusColumn"]</label>
                    <select id="sales-order-status" value="@orderStatusFilter" @onchange="ChangeOrderStatusFilterAsync">
                        <option value="">@Text["PoAllStatusesOption"]</option>
                        <option value="1">@Text["SalesOrderStatusDraft"]</option>
                        <option value="2">@Text["SalesOrderStatusApproved"]</option>
                        <option value="3">@Text["SalesOrderStatusPartiallyDispatched"]</option>
                        <option value="4">@Text["SalesOrderStatusDispatched"]</option>
                        <option value="6">@Text["SalesOrderStatusClosed"]</option>
                        <option value="5">@Text["SalesOrderStatusCancelled"]</option>
                    </select>
                </div>
            }

            <div class="read-field">
                <label for="sales-search">@Text["ReadSearch"]</label>
                <input id="sales-search" type="search" @bind="search" @bind:after="ApplySearchAsync" maxlength="64" placeholder="@Text["ReadSearch"]" />
            </div>
        </div>

        @if (activeTab == TabCustomers)
        {
            <div class="read-grid-card">
                <div class="read-grid">
                    <BitDataGrid @ref="customerGrid" TItem="CustomerSummary" OnRead="ReadCustomersAsync" Pageable="true" PageSize="25"
                                 Resizable="true" WrapCellText="true"
                                 PageSizeOptions="@PageSizeOptions" Strings="@GridStrings" AriaLabel="@Text["SalesTabCustomers"]">
                        <Columns>
                            <BitDataGridColumn TItem="CustomerSummary" Title="@Text["ReadCode"]" Width="120px">
                                <Template Context="c"><bdi dir="ltr">@c.Code</bdi></Template>
                            </BitDataGridColumn>
                            <BitDataGridColumn TItem="CustomerSummary" Title="@Text["ReadName"]" MinWidth="160">
                                <Template Context="c">@c.Name</Template>
                            </BitDataGridColumn>
                            <BitDataGridColumn TItem="CustomerSummary" Title="@Text["SupContactLabel"]" Width="140px">
                                <Template Context="c">@(c.ContactName ?? "—")</Template>
                            </BitDataGridColumn>
                            <BitDataGridColumn TItem="CustomerSummary" Title="@Text["ProfilePhoneLabel"]" Width="130px">
                                <Template Context="c"><bdi dir="ltr">@(c.Phone ?? "—")</bdi></Template>
                            </BitDataGridColumn>
                            <BitDataGridColumn TItem="CustomerSummary" Title="@Text["SalesCustomerTaxCode"]" Width="120px">
                                <Template Context="c"><bdi dir="ltr">@(c.TaxCode ?? "—")</bdi></Template>
                            </BitDataGridColumn>
                            <BitDataGridColumn TItem="CustomerSummary" Title="@Text["PoStatusColumn"]" Width="100px">
                                <Template Context="c">
                                    <span class="write-status-badge @(c.IsActive ? "is-active" : "is-inactive")">
                                        @(c.IsActive ? Text["ReadActive"] : Text["ReadInactiveStatus"])
                                    </span>
                                </Template>
                            </BitDataGridColumn>
                            <BitDataGridColumn TItem="CustomerSummary" Title="@Text["ReadActions"]" Width="150px">
                                <Template Context="c">
                                    @if (scopeCanManageCustomers)
                                    {
                                        <div class="read-row-actions">
                                            <BitButton Variant="BitVariant.Text" Size="BitSize.Small" OnClick="() => OpenEditCustomerModal(c)">@Text["ReadEdit"]</BitButton>
                                            <BitButton Variant="BitVariant.Text" Size="BitSize.Small" OnClick="() => ToggleCustomerActiveAsync(c)">
                                                @(c.IsActive ? Text["WriteDeactivate"] : Text["WriteActivate"])
                                            </BitButton>
                                        </div>
                                    }
                                    else
                                    {
                                        <span>—</span>
                                    }
                                </Template>
                            </BitDataGridColumn>
                        </Columns>
                    </BitDataGrid>
                </div>
            </div>
        }
        else if (activeTab == TabOrders)
        {
            <div class="read-grid-card">
                <div class="read-grid">
                    <BitDataGrid @ref="orderGrid" TItem="SalesOrderSummary" OnRead="ReadOrdersAsync" Pageable="true" PageSize="25"
                                 Resizable="true" WrapCellText="true"
                                 PageSizeOptions="@PageSizeOptions" Strings="@GridStrings" AriaLabel="@Text["SalesTabOrders"]">
                        <Columns>
                            <BitDataGridColumn TItem="SalesOrderSummary" Title="@Text["SalesOrderNumber"]" Width="120px">
                                <Template Context="o"><bdi dir="ltr">@o.OrderNumber</bdi></Template>
                            </BitDataGridColumn>
                            <BitDataGridColumn TItem="SalesOrderSummary" Title="@Text["SalesCustomerColumn"]" MinWidth="150">
                                <Template Context="o"><bdi dir="ltr">@o.CustomerCode</bdi> — @o.CustomerName</Template>
                            </BitDataGridColumn>
                            <BitDataGridColumn TItem="SalesOrderSummary" Title="@Text["PoSiteColumn"]" Width="120px">
                                <Template Context="o"><bdi dir="ltr">@o.SiteCode</bdi></Template>
                            </BitDataGridColumn>
                            <BitDataGridColumn TItem="SalesOrderSummary" Title="@Text["ProcOrderDateLabel"]" Width="104px">
                                <Template Context="o"><bdi dir="ltr">@Format.Date(o.OrderDate)</bdi></Template>
                            </BitDataGridColumn>
                            <BitDataGridColumn TItem="SalesOrderSummary" Title="@Text["SalesRequestedDate"]" Width="104px">
                                <Template Context="o">
                                    @if (o.RequestedDeliveryDate is DateOnly rd)
                                    {
                                        <bdi dir="ltr">@Format.Date(rd)</bdi>
                                    }
                                    else
                                    {
                                        <span>—</span>
                                    }
                                </Template>
                            </BitDataGridColumn>
                            <BitDataGridColumn TItem="SalesOrderSummary" Title="@Text["PoStatusColumn"]" Width="130px">
                                <Template Context="o">
                                    <span class="write-status-badge @OrderStatusCss(o.Status)">@OrderStatusLabel(o.Status)</span>
                                </Template>
                            </BitDataGridColumn>
                            <BitDataGridColumn TItem="SalesOrderSummary" Title="@Text["ReadActions"]" Width="210px">
                                <Template Context="o">
                                    <div class="read-row-actions">
                                        <BitButton Variant="BitVariant.Text" Size="BitSize.Small" OnClick="() => OpenOrderDetailModalAsync(o.Id)">@Text["ReadDetails"]</BitButton>
                                        @if (scopeCanDispatch && o.Status is SalesOrderStatus.Approved or SalesOrderStatus.PartiallyDispatched)
                                        {
                                            <BitButton Variant="BitVariant.Text" Size="BitSize.Small" OnClick="() => OpenPostDispatchModalAsync(o.Id)">@Text["SalesDispatchButton"]</BitButton>
                                        }
                                    </div>
                                </Template>
                            </BitDataGridColumn>
                        </Columns>
                    </BitDataGrid>
                </div>
            </div>
        }
        else if (activeTab == TabDispatches)
        {
            <div class="read-grid-card">
                <div class="read-grid">
                    <BitDataGrid @ref="dispatchGrid" TItem="DeliveryOrderSummary" OnRead="ReadDispatchesAsync" Pageable="true" PageSize="25"
                                 Resizable="true" WrapCellText="true"
                                 PageSizeOptions="@PageSizeOptions" Strings="@GridStrings" AriaLabel="@Text["SalesTabDispatches"]">
                        <Columns>
                            <BitDataGridColumn TItem="DeliveryOrderSummary" Title="@Text["SalesDispatchNumber"]" Width="125px">
                                <Template Context="d"><bdi dir="ltr">@d.DispatchNumber</bdi></Template>
                            </BitDataGridColumn>
                            <BitDataGridColumn TItem="DeliveryOrderSummary" Title="@Text["SalesOrderNumber"]" Width="120px">
                                <Template Context="d"><bdi dir="ltr">@d.SalesOrderNumber</bdi></Template>
                            </BitDataGridColumn>
                            <BitDataGridColumn TItem="DeliveryOrderSummary" Title="@Text["SalesCustomerColumn"]" MinWidth="140">
                                <Template Context="d"><bdi dir="ltr">@d.CustomerCode</bdi> — @d.CustomerName</Template>
                            </BitDataGridColumn>
                            <BitDataGridColumn TItem="DeliveryOrderSummary" Title="@Text["InvWarehouseLabel"]" Width="115px">
                                <Template Context="d"><bdi dir="ltr">@d.WarehouseCode</bdi></Template>
                            </BitDataGridColumn>
                            <BitDataGridColumn TItem="DeliveryOrderSummary" Title="@Text["SalesDispatchDate"]" Width="104px">
                                <Template Context="d"><bdi dir="ltr">@Format.Date(d.DispatchDate)</bdi></Template>
                            </BitDataGridColumn>
                            <BitDataGridColumn TItem="DeliveryOrderSummary" Title="@Text["PoStatusColumn"]" Width="105px">
                                <Template Context="d">
                                    <span class="write-status-badge @(d.Status == DeliveryOrderStatus.Posted ? "is-active" : "is-inactive")">
                                        @(d.Status == DeliveryOrderStatus.Posted ? Text["SalesDispatchPosted"] : Text["SalesDispatchReversed"])
                                    </span>
                                </Template>
                            </BitDataGridColumn>
                            <BitDataGridColumn TItem="DeliveryOrderSummary" Title="@Text["ReadActions"]" Width="160px">
                                <Template Context="d">
                                    <div class="read-row-actions">
                                        <BitButton Variant="BitVariant.Text" Size="BitSize.Small" OnClick="() => OpenDispatchDetailModalAsync(d.Id)">@Text["ReadDetails"]</BitButton>
                                        @if (scopeCanDispatch && d.Status == DeliveryOrderStatus.Posted)
                                        {
                                            <BitButton Variant="BitVariant.Text" Size="BitSize.Small" OnClick="() => OpenReverseDispatchModal(d)">@Text["SalesReverseButton"]</BitButton>
                                        }
                                    </div>
                                </Template>
                            </BitDataGridColumn>
                        </Columns>
                    </BitDataGrid>
                </div>
            </div>
        }
    }
</section>

@* Customer Modal *@
<ForgeFormDialog Width="620px" @bind-IsOpen="customerModalOpen"
                 Title="@(editingCustomerId.HasValue ? Text["SalesCustomerEditTitle"] : Text["SalesCustomerCreateButton"])"
                 CloseTitle="@Text["ReadClose"]">
    <ChildContent>
        @if (customerModalError is not null)
        {
            <p role="alert" class="write-error">@customerModalError</p>
        }
        <div class="write-modal-grid">
        <div class="write-field">
            <label for="cust-code">@Text["ReadCode"]</label>
            <input id="cust-code" type="text" @bind="custCode" maxlength="32" disabled="@editingCustomerId.HasValue" dir="ltr" />
        </div>
        <div class="write-field">
            <label for="cust-name">@Text["ReadName"]</label>
            <input id="cust-name" type="text" @bind="custName" maxlength="150" />
        </div>
        <div class="write-field">
            <label for="cust-contact">@Text["SupContactLabel"]</label>
            <input id="cust-contact" type="text" @bind="custContact" maxlength="120" />
        </div>
        <div class="write-field">
            <label for="cust-phone">@Text["ProfilePhoneLabel"]</label>
            <input id="cust-phone" type="text" @bind="custPhone" maxlength="32" dir="ltr" />
        </div>
        <div class="write-field">
            <label for="cust-email">@Text["ProfileEmailLabel"]</label>
            <input id="cust-email" type="email" @bind="custEmail" maxlength="200" dir="ltr" />
        </div>
        <div class="write-field">
            <label for="cust-tax">@Text["SalesCustomerTaxCode"]</label>
            <input id="cust-tax" type="text" @bind="custTaxCode" maxlength="40" dir="ltr" />
        </div>
        <div class="write-field write-field-span">
            <label for="cust-addr">@Text["SalesShippingAddress"]</label>
            <input id="cust-addr" type="text" @bind="custAddress" maxlength="500" />
        </div>
        <div class="write-field write-field-span">
            <label for="cust-notes">@Text["PoNotesLabel"]</label>
            <input id="cust-notes" type="text" @bind="custNotes" maxlength="1000" />
        </div>
        </div>
    </ChildContent>
    <FooterActions>
        <BitButton Variant="BitVariant.Outline" Size="BitSize.Small" OnClick="() => customerModalOpen = false">@Text["WriteCancel"]</BitButton>
        <BitButton Size="BitSize.Small" IsEnabled="!customerSaving" OnClick="SaveCustomerAsync">@(customerSaving ? Text["WriteSaving"] : Text["WriteSave"])</BitButton>
    </FooterActions>
</ForgeFormDialog>

@* Create/Edit Sales Order Modal *@
<ForgeFormDialog Width="1020px" @bind-IsOpen="orderModalOpen"
                 Title="@(editingOrderId.HasValue ? Text["SalesOrderEditTitle"] : Text["SalesOrderCreateButton"])"
                 Subtitle="@Text["SalesOrderModalSubtitle"]"
                 CloseTitle="@Text["ReadClose"]">
    <ChildContent>
        @if (orderModalError is not null)
        {
            <p role="alert" class="write-error">@orderModalError</p>
        }

        <div class="proc-po-section-head">
            <span class="proc-po-section-bar" aria-hidden="true"></span>
            <h3>@Text["ProcGeneralInfoSection"]</h3>
        </div>

        <div class="proc-po-general-grid">
            <div class="proc-po-field">
                <label for="so-num">@Text["SalesOrderNumber"]</label>
                <input id="so-num" type="text" class="@((editingOrderId.HasValue || !editOrderAllowOverride) ? "proc-input-readonly" : string.Empty)" @bind="editOrderNumber" maxlength="32" readonly="@(editingOrderId.HasValue || !editOrderAllowOverride)" dir="ltr" />
            </div>
            <div class="proc-po-field">
                <label for="so-cust">@Text["SalesCustomerColumn"] <span class="proc-req-star" aria-hidden="true">*</span></label>
                <select id="so-cust" @bind="editOrderCustomerId">
                    <option value="0">@Text["SalesSelectCustomerPlaceholder"]</option>
                    @foreach (var c in activeCustomers)
                    {
                        <option value="@c.Id">@c.Code — @c.Name</option>
                    }
                </select>
            </div>
            <div class="proc-po-field">
                <label for="so-site">@Text["PoSiteColumn"]</label>
                <select id="so-site" value="@editOrderSiteId" @onchange="ChangeEditOrderSiteAsync" disabled="@(editingOrderId.HasValue || CurrentScope is OrganizationScope.Site)">
                    @foreach (var s in authorizedSites)
                    {
                        <option value="@s.Id">@s.Code — @s.Name</option>
                    }
                </select>
            </div>

            <div class="proc-po-field">
                <label>@Text["ProcOrderDateLabel"]</label>
                <BitDatePicker @bind-Value="editOrderDateOffset" Class="bom-dtp proc-dtp" Culture="@Culture.PickerCulture" DateFormat="@PickerDateFormat"
                               Placeholder="@Text["ProcSelectDatePlaceholder"]"
                               ShowTimePicker="false" AllowTextInput="false" AutoClose="true" ShowGoToToday="true"
                               GoToTodayTitle="@Text["BomDateToday"]" GoToTodayIcon="@TodayIcon" Icon="@CalendarIcon"
                               NextMonthNavIcon="@NextNavIcon" PrevMonthNavIcon="@PrevNavIcon"
                               NextYearNavIcon="@NextYearIcon" PrevYearNavIcon="@PrevYearIcon" ClearButtonIcon="@CloseIcon" />
            </div>
            <div class="proc-po-field">
                <label>@Text["SalesRequestedDate"]</label>
                <BitDatePicker @bind-Value="editRequestedDateOffset" Class="bom-dtp proc-dtp" Culture="@Culture.PickerCulture" DateFormat="@PickerDateFormat"
                               Placeholder="@Text["ProcSelectDatePlaceholder"]"
                               ShowTimePicker="false" AllowTextInput="false" AutoClose="true" ShowGoToToday="true"
                               GoToTodayTitle="@Text["BomDateToday"]" GoToTodayIcon="@TodayIcon" Icon="@CalendarIcon"
                               NextMonthNavIcon="@NextNavIcon" PrevMonthNavIcon="@PrevNavIcon"
                               NextYearNavIcon="@NextYearIcon" PrevYearNavIcon="@PrevYearIcon" ClearButtonIcon="@CloseIcon" />
            </div>
            <div class="proc-po-field">
                <label for="so-cur">@Text["ProcCurrencyLabel"]</label>
                <select id="so-cur" @bind="editOrderCurrency">
                    @foreach (var cur in activeCurrencies)
                    {
                        <option value="@cur.Code">@cur.Code — @cur.Name (@cur.Symbol)</option>
                    }
                    @if (!string.IsNullOrEmpty(editOrderCurrency) && activeCurrencies.All(c => c.Code != editOrderCurrency))
                    {
                        <option value="@editOrderCurrency">@editOrderCurrency</option>
                    }
                </select>
            </div>

            <div class="proc-po-field">
                <label for="so-wh">@Text["SalesSourceWarehouse"]</label>
                <select id="so-wh" value="@editOrderWarehouseId" @onchange="ChangeEditOrderWarehouseAsync">
                    <option value="0">@Text["InvAllWarehousesOption"]</option>
                    @foreach (var w in siteWarehouses)
                    {
                        <option value="@w.Id">@w.Code — @w.Name</option>
                    }
                </select>
            </div>
            <div class="proc-po-field proc-po-notes-span">
                <label for="so-addr">@Text["SalesShippingAddress"]</label>
                <input id="so-addr" type="text" @bind="editOrderAddress" maxlength="500" />
            </div>

            <div class="proc-po-field" style="grid-column:1 / -1">
                <label for="so-notes">@Text["PoNotesLabel"]</label>
                <input id="so-notes" type="text" @bind="editOrderNotes" maxlength="1000" placeholder="@Text["ProcNotesOptionalPlaceholder"]" />
            </div>
        </div>

        <div class="proc-po-section-head proc-po-section-head--split">
            <div class="proc-po-section-title">
                <span class="proc-po-section-bar" aria-hidden="true"></span>
                <h3>@Text["ProcLinesSection"]</h3>
            </div>
            <BitButton Variant="BitVariant.Outline" Size="BitSize.Small" Icon="@PlusIcon" Class="proc-po-add-line-btn" OnClick="AddOrderLine">
                @Text["ProcAddLineBtn"]
            </BitButton>
        </div>

        <p class="write-hint" style="margin:0">@Text["SalesInventoryInfoHint"]</p>

        <div class="proc-lines-card">
            <div class="proc-lines-table">
                <div class="proc-lines-grid proc-lines-head">
                    <span>@Text["PoItemColumn"]</span>
                    <span>@Text["ProcOrderedCol"]</span>
                    <span>@Text["BomLineUnitColumn"]</span>
                    <span>@Text["ProcUnitPriceLabel"]</span>
                    <span>@Text["ProcLineAmountLabel"]</span>
                    <span>@Text["PoNotesLabel"]</span>
                    <span aria-hidden="true"></span>
                </div>
                @for (var idx = 0; idx < editLines.Count; idx++)
                {
                    var i = idx;
                    var line = editLines[i];
                    var stockInfo = line.ItemId > 0 && itemStockSummary.TryGetValue(line.ItemId, out var st) ? st : null;
                    <div class="proc-lines-grid proc-lines-row sales-lines-row">
                        <div style="display:flex;flex-direction:column;min-width:0">
                            <select aria-label="@Text["PoItemColumn"]" value="@line.ItemId" @onchange="e => OnOrderLineItemChanged(i, e)">
                                <option value="0">@Text["ProcSelectItemPlaceholder"]</option>
                                @foreach (var it in sellableItems)
                                {
                                    <option value="@it.Id">@it.Code — @it.Name</option>
                                }
                            </select>
                            @if (line.ItemId > 0 && stockInfo is not null)
                            {
                                var isLow = stockInfo.Available <= 0m || (line.UnitId == stockInfo.BaseUnitId && line.Quantity > stockInfo.Available);
                                <span class="sales-stock-pill @(isLow ? "is-low" : "is-ok")">
                                    @(stockInfo.Available > 0m
                                        ? Text["SalesStockAvailableBadge", Format.Number(stockInfo.Available), stockInfo.BaseUnitSymbol]
                                        : Text["SalesStockZeroBadge", stockInfo.BaseUnitSymbol])
                                </span>
                            }
                        </div>
                        <input type="number" step="0.000001" min="0.000001" aria-label="@Text["ProcOrderedCol"]" @bind="line.Quantity" @bind:event="oninput" dir="ltr" />
                        <select aria-label="@Text["BomLineUnitColumn"]" @bind="line.UnitId">
                            @foreach (var u in activeUnits)
                            {
                                <option value="@u.Id">@u.Code (@u.Symbol)</option>
                            }
                        </select>
                        <input type="number" step="0.0001" min="0" aria-label="@Text["ProcUnitPriceLabel"]" placeholder="0" @bind="line.UnitPrice" @bind:event="oninput" dir="ltr" />
                        <div class="proc-line-amount" dir="ltr">
                            @(line.UnitPrice.HasValue && line.Quantity > 0m ? Format.Number(line.Quantity * line.UnitPrice.Value) : "—")
                        </div>
                        <input type="text" maxlength="300" aria-label="@Text["PoNotesLabel"]" placeholder="@Text["PoNotesLabel"]" @bind="line.Notes" />
                        <button type="button" class="proc-line-del-btn" aria-label="@Text["BomRemoveRowBtn"]" title="@Text["BomRemoveRowBtn"]"
                                disabled="@(editLines.Count <= 1)" @onclick="() => RemoveOrderLine(i)">
                            <span class="ff-icon ff-icon--trash" aria-hidden="true"></span>
                        </button>
                    </div>
                }
            </div>
        </div>
    </ChildContent>
    <FooterActions>
        <BitButton Class="proc-po-primary-btn" IsEnabled="@(!orderSaving)" OnClick="SaveOrderAsync">@(orderSaving ? Text["WriteSaving"] : Text["WriteSave"])</BitButton>
        <BitButton Variant="BitVariant.Outline" Class="proc-po-cancel-btn" OnClick="() => orderModalOpen = false">@Text["WriteCancel"]</BitButton>
    </FooterActions>
    <FooterEnd>
        <div class="proc-po-footer-total">
