        {
            var orderDate = DateOnly.FromDateTime((editOrderDateOffset ?? DateTimeOffset.Now).DateTime);
            DateOnly? reqDate = editRequestedDateOffset is DateTimeOffset dto ? DateOnly.FromDateTime(dto.DateTime) : null;
            var lineRequests = editLines.Select(l => new SalesOrderLineRequest(l.ItemId, l.Quantity, l.UnitId, l.UnitPrice, l.Notes)).ToArray();

            var res = editingOrderId.HasValue
                ? await SalesService.UpdateSalesOrder(CurrentScope, CurrentOrgId, editingOrderId.Value,
                    new UpdateSalesOrderRequest(editOrderCustomerId, orderDate, reqDate, editOrderWarehouseId > 0 ? editOrderWarehouseId : null, editOrderCurrency, editOrderAddress, editOrderNotes, lineRequests),
                    editingOrderVersion)
                : await SalesService.CreateSalesOrder(CurrentScope,
                    new CreateSalesOrderRequest(CurrentOrgId, editOrderSiteId, editOrderCustomerId, editOrderAllowOverride ? editOrderNumber : null, orderDate, reqDate, editOrderWarehouseId > 0 ? editOrderWarehouseId : null, editOrderCurrency, editOrderAddress, editOrderNotes, lineRequests));

            if (!res.Succeeded)
            {
                orderModalError = MapError(res.Error!.Code);
                return;
            }
            orderModalOpen = false;
            pageNotice = Text["WriteSaved"];
            await RefreshCurrentGridAsync();
        }
        finally { orderSaving = false; }
    }

