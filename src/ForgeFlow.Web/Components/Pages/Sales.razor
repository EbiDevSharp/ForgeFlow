    private async Task LoadOrderModalLookupsAsync(long siteId)
    {
        if (CurrentScope is null) return;
        var custRes = await SalesService.ListCustomers(CurrentScope, CurrentOrgId, new CustomerListQuery(IncludeInactive: false, PageSize: 100));
        activeCustomers = custRes.Succeeded ? custRes.Value!.Items.ToList() : [];

        var whRes = await InvService.ListWarehouses(CurrentScope, CurrentOrgId, new WarehouseListQuery(SiteId: siteId > 0 ? siteId : null, IncludeInactive: false, PageSize: 100));
        siteWarehouses = whRes.Succeeded ? whRes.Value!.Items.ToList() : [];

        var itemRes = await ItemService.ListItems(CurrentScope, CurrentOrgId, new ItemListQuery(IncludeInactive: false, PageSize: 100));
        sellableItems = itemRes.Succeeded ? itemRes.Value!.Items.Where(i => i.CanBeSold).ToList() : [];

        var unitRes = await UnitService.ListUnits(CurrentScope, CurrentOrgId, new UnitListQuery(IncludeInactive: false, PageSize: 100));
        activeUnits = unitRes.Succeeded ? unitRes.Value!.Items.ToList() : [];

        var curRes = await UnitService.ListCurrencies(CurrentScope, CurrentOrgId, new CurrencyListQuery(IncludeInactive: false, PageSize: 100));
        activeCurrencies = curRes.Succeeded ? curRes.Value!.Items.ToList() : [];

        await LoadOrderStockSummaryAsync(siteId, editOrderWarehouseId);
    }

    private async Task LoadOrderStockSummaryAsync(long siteId, long warehouseId)
    {
        itemStockSummary = [];
        if (CurrentScope is null || siteId <= 0) return;
        try
        {
            var balRes = await InvService.ListBalances(CurrentScope, CurrentOrgId,
                new InventoryBalanceListQuery(SiteId: siteId, WarehouseId: warehouseId > 0 ? warehouseId : null, IncludeZeroBalances: false, Page: 1, PageSize: 100));
            if (!balRes.Succeeded) return;

            var dict = new Dictionary<long, ItemStockSnapshot>();
            foreach (var b in balRes.Value!.Items)
            {
                if (dict.TryGetValue(b.ItemId, out var cur))
                    dict[b.ItemId] = cur with { Available = cur.Available + b.AvailableBaseQuantity };
                else
                    dict[b.ItemId] = new ItemStockSnapshot(b.BaseUnitId, b.BaseUnitSymbol, b.AvailableBaseQuantity);
            }
            foreach (var it in sellableItems)
            {
                if (!dict.ContainsKey(it.Id))
                    dict[it.Id] = new ItemStockSnapshot(it.BaseUnitId, it.BaseUnitSymbol, 0m);
            }
            itemStockSummary = dict;
        }
        catch { }
    }

