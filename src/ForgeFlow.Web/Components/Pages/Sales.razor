@* Sales Order Detail + Reservations Modal *@
<BitDialog Width="920px" MaxWidth="calc(100vw - 24px)" Classes="@DialogClasses" @bind-IsOpen="orderDetailOpen"
           Title="@(detailOrder?.Summary.OrderNumber ?? Text["SalesTabOrders"])" ShowCloseButton="true">
    @if (detailOrder is not null)
    {
        var s = detailOrder.Summary;
        <div class="proc-detail-wrap">
            @if (detailError is not null)
            {
                <p role="alert" class="write-modal-err">@detailError</p>
            }
            <table class="ff-table">
                <tbody>
                    <tr>
                        <th>@Text["SalesCustomerColumn"]</th><td><bdi dir="ltr">@s.CustomerCode</bdi> — @s.CustomerName</td>
                        <th>@Text["PoStatusColumn"]</th><td>@OrderStatusLabel(s.Status)</td>
                    </tr>
                    <tr>
                        <th>@Text["ProcOrderDateLabel"]</th><td dir="ltr">@Format.Date(s.OrderDate)</td>
                        <th>@Text["SalesRequestedDate"]</th><td dir="ltr">@(s.RequestedDeliveryDate is DateOnly rd ? Format.Date(rd) : "—")</td>
                    </tr>
                    <tr>
                        <th>@Text["SalesShippingAddress"]</th><td colspan="3">@(s.ShippingAddressSnapshot ?? "—")</td>
                    </tr>
                </tbody>
            </table>

            <h4>@Text["ProcLinesSection"]</h4>
            <table class="ff-table">
                <thead>
                    <tr>
                        <th>#</th>
                        <th>@Text["PoItemColumn"]</th>
                        <th>@Text["ProcOrderedCol"]</th>
                        <th>@Text["SalesDispatchedQty"]</th>
                        <th>@Text["SalesRemainingQty"]</th>
                        <th>@Text["ReadActions"]</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var l in detailOrder.Lines)
                    {
                        <tr>
                            <td dir="ltr">@l.LineNumber</td>
                            <td><bdi dir="ltr">@l.ItemCode</bdi> — @l.ItemName</td>
                            <td dir="ltr">@Format.Number(l.OrderedBaseQuantity) @l.BaseUnitSymbolSnapshot</td>
                            <td dir="ltr">@Format.Number(l.DispatchedBaseQuantity) @l.BaseUnitSymbolSnapshot</td>
                            <td dir="ltr">@Format.Number(l.RemainingBaseQuantity) @l.BaseUnitSymbolSnapshot</td>
                            <td>
                                @if (scopeCanManageOrders && l.RemainingBaseQuantity > 0m && s.Status is SalesOrderStatus.Approved or SalesOrderStatus.PartiallyDispatched)
                                {
                                    <BitButton Variant="BitVariant.Outline" Size="BitSize.Small" OnClick="() => OpenReserveModalAsync(l)">@Text["SalesReserveStockButton"]</BitButton>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>

            @if (orderReservations.Count > 0)
            {
                <h4>@Text["SalesReservationsTitle"]</h4>
                <table class="ff-table">
                    <thead>
                        <tr>
                            <th>@Text["InvWarehouseLabel"]</th>
                            <th>@Text["PoItemColumn"]</th>
                            <th>@Text["InvLotCodeLabel"]</th>
                            <th>@Text["ProcOrderedCol"]</th>
                            <th>@Text["PoStatusColumn"]</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var r in orderReservations)
                        {
                            <tr>
                                <td><bdi dir="ltr">@r.WarehouseCode</bdi></td>
                                <td><bdi dir="ltr">@r.ItemCode</bdi></td>
                                <td dir="ltr">@(string.IsNullOrEmpty(r.LotCode) ? "—" : r.LotCode)</td>
                                <td dir="ltr">@Format.Number(r.RemainingReservedBaseQuantity) / @Format.Number(r.ReservedBaseQuantity) @r.BaseUnitSymbol</td>
                                <td>@r.Status</td>
                                <td>
                                    @if (scopeCanManageOrders && (r.Status is ReservationStatus.Active or ReservationStatus.PartiallyConsumed))
                                    {
                                        <BitButton Variant="BitVariant.Text" Size="BitSize.Small" OnClick="() => ReleaseOrderReservationAsync(r)">@Text["SalesReleaseReservation"]</BitButton>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            }

            <div class="proc-detail-actions">
                @if (scopeCanManageOrders && s.Status == SalesOrderStatus.Draft)
                {
                    <BitButton Variant="BitVariant.Outline" Size="BitSize.Small" OnClick="() => OpenEditOrderFromDetailAsync(detailOrder)">@Text["ReadEdit"]</BitButton>
                    <BitButton Size="BitSize.Small" OnClick="ApproveDetailOrderAsync">@Text["ProcApproveBtn"]</BitButton>
                }
                @if (scopeCanDispatch && s.Status is SalesOrderStatus.Approved or SalesOrderStatus.PartiallyDispatched)
                {
                    <BitButton Size="BitSize.Small" OnClick="() => OpenPostDispatchModalAsync(s.Id)">@Text["SalesDispatchButton"]</BitButton>
                }
                @if (scopeCanManageOrders && s.Status is SalesOrderStatus.PartiallyDispatched or SalesOrderStatus.Dispatched)
                {
                    <BitButton Variant="BitVariant.Outline" Size="BitSize.Small" OnClick="CloseDetailOrderAsync">@Text["ProcShortCloseBtn"]</BitButton>
                }
                @if (scopeCanManageOrders && s.Status is SalesOrderStatus.Draft or SalesOrderStatus.Approved)
                {
                    <BitButton Variant="BitVariant.Outline" Size="BitSize.Small" OnClick="OpenCancelOrderModal">@Text["ProcCancelBtn"]</BitButton>
                }
            </div>
        </div>
    }
</BitDialog>

