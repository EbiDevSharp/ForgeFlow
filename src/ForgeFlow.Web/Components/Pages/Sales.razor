    private string OrderStatusLabel(SalesOrderStatus status) => status switch
    {
        SalesOrderStatus.Draft => Text["SalesOrderStatusDraft"],
        SalesOrderStatus.Approved => Text["SalesOrderStatusApproved"],
        SalesOrderStatus.PartiallyDispatched => Text["SalesOrderStatusPartiallyDispatched"],
        SalesOrderStatus.Dispatched => Text["SalesOrderStatusDispatched"],
        SalesOrderStatus.Cancelled => Text["SalesOrderStatusCancelled"],
        SalesOrderStatus.Closed => Text["SalesOrderStatusClosed"],
        _ => status.ToString()
    };

    private static string OrderStatusCss(SalesOrderStatus status) => status switch
    {
        SalesOrderStatus.Approved or SalesOrderStatus.Dispatched => "is-active",
        SalesOrderStatus.Cancelled => "is-inactive",
        _ => string.Empty
    };

    private string MapError(string code)
    {
        var key = "Err_" + code.Replace(".", string.Empty, StringComparison.Ordinal);
        var val = Text[key];
        return val.ResourceNotFound ? code : val.Value;
    }

    private sealed record ItemStockSnapshot(long BaseUnitId, string BaseUnitSymbol, decimal Available);

