    private async Task OpenPostDispatchModalAsync(long salesOrderId)
    {
        if (CurrentScope is null) return;
        orderDetailOpen = false;
        var ordRes = await SalesService.GetSalesOrder(CurrentScope, CurrentOrgId, salesOrderId);
        if (!ordRes.Succeeded) return;
        var order = ordRes.Value!;
        dispatchOrderId = salesOrderId;

        var whRes = await InvService.ListWarehouses(CurrentScope, CurrentOrgId, new WarehouseListQuery(SiteId: order.Summary.SiteId, IncludeInactive: false, PageSize: 100));
        siteWarehouses = whRes.Succeeded ? whRes.Value!.Items.ToList() : [];
        dispWarehouseId = order.Summary.SourceWarehouseId ?? (siteWarehouses.FirstOrDefault()?.Id ?? 0);
        var dispPrev = await SeqService.GetPreview(CurrentScope, CurrentOrgId, ForgeFlow.Domain.Organizations.DocumentSequenceType.DeliveryOrder);
        dispAllowOverride = dispPrev.Succeeded && dispPrev.Value!.AllowManualOverride;
        dispNumber = dispPrev.Succeeded ? dispPrev.Value!.NextPreview : string.Empty;
        dispDateOffset = DateTimeOffset.Now;
        dispCarrier = null;
        dispTracking = null;
        dispNotes = null;
        dispLines = order.Lines.Where(l => l.RemainingBaseQuantity > 0m).Select(l => new DispatchLineEdit
        {
            SalesOrderLineId = l.Id,
            ItemId = l.ItemId,
            ItemCode = l.ItemCode,
            ItemName = l.ItemName,
            RemainingBaseQuantity = l.RemainingBaseQuantity,
            UnitId = l.BaseUnitIdSnapshot,
            UnitSymbol = l.BaseUnitSymbolSnapshot,
            Quantity = l.RemainingBaseQuantity
        }).ToList();

        if (dispWarehouseId > 0)
        {
            var lotsRes = await SalesService.ListDispatchableLots(CurrentScope, CurrentOrgId, salesOrderId, dispWarehouseId);
            dispatchableLots = lotsRes.Succeeded ? lotsRes.Value! : [];
        }
        else dispatchableLots = [];

        dispatchModalError = null;
        dispatchModalOpen = true;
    }

