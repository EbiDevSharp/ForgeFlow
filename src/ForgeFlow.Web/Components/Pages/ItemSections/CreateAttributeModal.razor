@using System.Globalization
@using ForgeFlow.Application.Items
@using ForgeFlow.Application.Organizations
@using ForgeFlow.Application.Units
@using ForgeFlow.Domain.Items
@using ForgeFlow.Web.Roles
@inject ItemUseCases ItemService
@inject IStringLocalizer<SharedResources> Text

<BitDialog Width="580px" MaxWidth="calc(100vw - 24px)" Classes="@DialogClasses" @bind-IsOpen="isOpen"
           Title="@Text["AttributeCreateButton"]" AriaLabel="@Text["AttributeCreateButton"]"
           CloseButtonTitle="@Text["ReadClose"]" ShowOkButton="false" ShowCancelButton="false" ShowCloseButton="true"
           AutoFocus="true" TrapFocus="true" RestoreFocus="true" CloseOnEscape="true">
    <Body>
        <div class="audit-modal-body">
            <form class="write-panel" @onsubmit:preventDefault>
                <div class="read-field">
                    <label for="create-attr-code">@Text["ReadCode"]</label>
                    <input id="create-attr-code" @bind="code" @bind:event="oninput" maxlength="32" disabled="@saving" />
                </div>
                <div class="read-field">
                    <label for="create-attr-name">@Text["ReadName"]</label>
                    <input id="create-attr-name" @bind="name" @bind:event="oninput" maxlength="200" disabled="@saving" />
                </div>
                <div class="read-field">
                    <label for="create-attr-type">@Text["AttributeDataTypeLabel"]</label>
                    <select id="create-attr-type" @bind="dataType" disabled="@saving">
                        @foreach (var dt in AllDataTypes) { <option value="@dt">@Text[DataTypeResourceKey(dt)]</option> }
                    </select>
                </div>
                @if (dataType == AttributeDataType.Decimal)
                {
                    <div class="read-field">
                        <label for="create-attr-unit">@Text["UnitsTab"]</label>
                        <select id="create-attr-unit" @bind="unitIdText" disabled="@saving">
                            <option value="">—</option>
                            @foreach (var u in ActiveUnits) { <option value="@u.Id">@u.Code — @u.Name (@u.Symbol)</option> }
                        </select>
                    </div>
                }
                <label class="perm-check"><input type="checkbox" @bind="isRequired" disabled="@saving" /><span>@Text["AttributeRequiredLabel"]</span></label>
                <div class="write-actions">
                    <BitButton Size="BitSize.Small" IsEnabled="@(!saving && !string.IsNullOrWhiteSpace(code) && !string.IsNullOrWhiteSpace(name))"
                               OnClick="SubmitAsync">@Text["CreateSubmit"]</BitButton>
                </div>
                @if (error is not null) { <p role="alert" class="write-error">@Text[error]</p> }
            </form>
        </div>
    </Body>
</BitDialog>

@code {
    private static readonly AttributeDataType[] AllDataTypes = Enum.GetValues<AttributeDataType>();

    private bool isOpen, isRequired, saving;
    private string code = string.Empty, name = string.Empty, unitIdText = string.Empty;
    private AttributeDataType dataType = AttributeDataType.Text;
    private string? error;

    [Parameter, EditorRequired] public BitDialogClassStyles DialogClasses { get; set; } = default!;
    [Parameter] public OrganizationScope? CurrentScope { get; set; }
    [Parameter] public long CurrentOrgId { get; set; }
    [Parameter] public IReadOnlyList<UnitSummary> ActiveUnits { get; set; } = [];
    [Parameter, EditorRequired] public Func<AttributeDataType, string> DataTypeResourceKey { get; set; } = default!;
    [Parameter] public EventCallback OnCreated { get; set; }

    public void Open()
    {
        code = string.Empty;
        name = string.Empty;
        unitIdText = string.Empty;
        dataType = AttributeDataType.Text;
        isRequired = false;
        error = null;
        isOpen = true;
        StateHasChanged();
    }

    private async Task SubmitAsync()
    {
        if (CurrentScope is null || CurrentOrgId <= 0 || saving) return;
        long? unitId = dataType == AttributeDataType.Decimal && long.TryParse(unitIdText, NumberStyles.Integer, CultureInfo.InvariantCulture, out var uid) && uid > 0 ? uid : null;
        saving = true;
        error = null;
        try
        {
            var res = await ItemService.CreateAttributeDefinition(CurrentScope, new CreateAttributeDefinitionRequest(
                CurrentOrgId, code, name, dataType, unitId, isRequired));
            if (!res.Succeeded) { error = RolePermissionLocalization.FailureKey(res.Error!.Code); return; }
            isOpen = false;
            await OnCreated.InvokeAsync();
        }
        finally { saving = false; }
    }
}
