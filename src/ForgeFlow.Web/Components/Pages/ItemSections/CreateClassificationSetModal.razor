@using ForgeFlow.Application.Items
@using ForgeFlow.Application.Organizations
@using ForgeFlow.Web.Roles
@inject ItemUseCases ItemService
@inject IStringLocalizer<SharedResources> Text

<BitDialog Width="580px" MaxWidth="calc(100vw - 24px)" Classes="@DialogClasses" @bind-IsOpen="isOpen"
           Title="@Text["ClassificationSetCreateButton"]" AriaLabel="@Text["ClassificationSetCreateButton"]"
           CloseButtonTitle="@Text["ReadClose"]" ShowOkButton="false" ShowCancelButton="false" ShowCloseButton="true"
           AutoFocus="true" TrapFocus="true" RestoreFocus="true" CloseOnEscape="true">
    <Body>
        <div class="audit-modal-body">
            <form class="write-panel" @onsubmit:preventDefault>
                <div class="read-field">
                    <label for="create-set-code">@Text["ReadCode"]</label>
                    <input id="create-set-code" @bind="code" @bind:event="oninput" maxlength="32" disabled="@saving" />
                </div>
                <div class="read-field">
                    <label for="create-set-name">@Text["ReadName"]</label>
                    <input id="create-set-name" @bind="name" @bind:event="oninput" maxlength="200" disabled="@saving" />
                </div>
                <label class="perm-check"><input type="checkbox" @bind="allowMultiple" disabled="@saving" /><span>@Text["ClassificationSetAllowMultiple"]</span></label>
                <div class="write-actions">
                    <BitButton Size="BitSize.Small" IsEnabled="@(!saving && !string.IsNullOrWhiteSpace(code) && !string.IsNullOrWhiteSpace(name))"
                               OnClick="SubmitAsync">@Text["CreateSubmit"]</BitButton>
                </div>
                @if (error is not null) { <p role="alert" class="write-error">@Text[error]</p> }
            </form>
        </div>
    </Body>
</BitDialog>

@code {
    private bool isOpen, allowMultiple, saving;
    private string code = string.Empty, name = string.Empty;
    private string? error;

    [Parameter, EditorRequired] public BitDialogClassStyles DialogClasses { get; set; } = default!;
    [Parameter] public OrganizationScope? CurrentScope { get; set; }
    [Parameter] public long CurrentOrgId { get; set; }
    [Parameter] public EventCallback OnCreated { get; set; }

    public void Open()
    {
        code = string.Empty;
        name = string.Empty;
        allowMultiple = false;
        error = null;
        isOpen = true;
        StateHasChanged();
    }

    private async Task SubmitAsync()
    {
        if (CurrentScope is null || CurrentOrgId <= 0 || saving) return;
        saving = true;
        error = null;
        try
        {
            var res = await ItemService.CreateClassificationSet(CurrentScope, new CreateClassificationSetRequest(
                CurrentOrgId, code, name, false, allowMultiple));
            if (!res.Succeeded) { error = RolePermissionLocalization.FailureKey(res.Error!.Code); return; }
            isOpen = false;
            await OnCreated.InvokeAsync();
        }
        finally { saving = false; }
    }
}
