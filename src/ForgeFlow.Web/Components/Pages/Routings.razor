    private string StatusLabel(RoutingStatus st) => st switch
    {
        RoutingStatus.Draft => Text["RtStatusDraft"],
        RoutingStatus.Active => Text["RtStatusActive"],
        RoutingStatus.Obsolete => Text["RtStatusObsolete"],
        _ => st.ToString()
    };

    private static string StatusBadgeClass(RoutingStatus st) => st switch
    {
        RoutingStatus.Draft => "inactive",
        RoutingStatus.Active => "active",
        _ => "inactive"
    };

    private string ScopeLabel(OrganizationScope scope) => scope switch
    {
        OrganizationScope.Organization o when scopeLabels.TryGetValue(scope, out var info) && info.OrgCode is not null
            => $"{info.OrgCode} — {info.OrgName}",
        OrganizationScope.Organization o => Text["ReadOrganizationScope", o.OrganizationId],
        OrganizationScope.Site s when scopeLabels.TryGetValue(scope, out var info) && info.SiteCode is not null
            => $"{info.OrgCode} / {info.SiteCode} — {info.SiteName}",
        OrganizationScope.Site s => Text["ReadSiteScope", s.OrganizationId, s.SiteId],
        _ => string.Empty
    };
}
