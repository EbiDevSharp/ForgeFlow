@using System.Globalization
@using ForgeFlow.Application.Organizations
@using ForgeFlow.Application.Units
@using ForgeFlow.Domain.Units
@inject UnitUseCases UnitService
@inject IStringLocalizer<SharedResources> Text

@if (ActiveTab == TabUnits)
{
    <div class="read-grid-card">
        <div class="read-grid">
            <BitDataGrid @ref="unitsGrid" TItem="UnitSummary" OnRead="ReadUnitsGridAsync" Pageable="true" PageSize="25"
                         PageSizeOptions="@PageSizeOptions" Strings="@GridStrings" SelectionMode="BitSelectionMode.Single"
                         AriaLabelledBy="units-title" WrapCellText="true" Resizable="true">
                <EmptyTemplate><p role="status" class="read-empty">@Text["ReadEmpty"]</p></EmptyTemplate>
                <Columns>
                    <BitDataGridColumn TItem="UnitSummary" Title="@Text["ReadCode"]">
                        <Template Context="row"><bdi dir="ltr">@row.Code</bdi></Template>
                    </BitDataGridColumn>
                    <BitDataGridColumn TItem="UnitSummary" Title="@Text["ReadName"]">
                        <Template Context="row">@row.Name</Template>
                    </BitDataGridColumn>
                    <BitDataGridColumn TItem="UnitSummary" Title="@Text["UnitSymbolLabel"]">
                        <Template Context="row"><bdi dir="ltr">@row.Symbol</bdi></Template>
                    </BitDataGridColumn>
                    <BitDataGridColumn TItem="UnitSummary" Title="@Text["UnitDimensionLabel"]">
                        <Template Context="row">
                            <span class="read-badge role">@Text[DimensionResourceKey(row.Dimension)]</span>
                        </Template>
                    </BitDataGridColumn>
                    <BitDataGridColumn TItem="UnitSummary" Title="@Text["UnitPrecisionLabel"]">
                        <Template Context="row"><bdi dir="ltr">@row.PrecisionScale</bdi></Template>
                    </BitDataGridColumn>
                    <BitDataGridColumn TItem="UnitSummary" Title="@Text["ReadStatus"]">
                        <Template Context="row">
                            <span class="read-badge @(row.IsActive ? "active" : "inactive")">
                                @Text[row.IsActive ? "ReadActive" : "ReadInactiveStatus"]
                            </span>
                        </Template>
                    </BitDataGridColumn>
                    <BitDataGridColumn TItem="UnitSummary" Title="@Text["ReadActions"]">
                        <Template Context="row">
                            <div class="read-row-actions">
                                <BitTooltip Text="@Text["ReadDetails"]" ShowOnFocus="true">
                                    <BitButton Variant="BitVariant.Outline" Size="BitSize.Small" Class="read-detail-action"
                                               IconName="View" IconOnly="true" aria-label="@Text["ReadDetails"]"
                                               OnClick="() => OnOpenUnitModal.InvokeAsync((row.Id, false))" />
                                </BitTooltip>
                                @if (ScopeCanManage)
                                {
                                    <BitTooltip Text="@Text["ReadEdit"]" ShowOnFocus="true">
                                        <BitButton Variant="BitVariant.Outline" Size="BitSize.Small" Class="read-detail-action"
                                                   Icon="@EditIcon" IconOnly="true" aria-label="@Text["ReadEdit"]"
                                                   OnClick="() => OnOpenUnitModal.InvokeAsync((row.Id, true))" />
                                    </BitTooltip>
                                }
                            </div>
                        </Template>
                    </BitDataGridColumn>
                </Columns>
            </BitDataGrid>
        </div>
    </div>
}
else if (ActiveTab == TabConversions)
{
    <div class="read-grid-card">
        <div class="read-grid">
            <BitDataGrid @ref="conversionsGrid" TItem="UnitConversionSummary" OnRead="ReadConversionsGridAsync" Pageable="true" PageSize="25"
                         PageSizeOptions="@PageSizeOptions" Strings="@GridStrings" SelectionMode="BitSelectionMode.Single"
                         AriaLabelledBy="units-title" WrapCellText="true" Resizable="true">
                <EmptyTemplate><p role="status" class="read-empty">@Text["ReadEmpty"]</p></EmptyTemplate>
                <Columns>
                    <BitDataGridColumn TItem="UnitConversionSummary" Title="@Text["UnitConversionFromLabel"]">
                        <Template Context="row">
                            <bdi dir="ltr">@row.FromUnitCode</bdi> — @row.FromUnitName (<bdi dir="ltr">@row.FromUnitSymbol</bdi>)
                        </Template>
                    </BitDataGridColumn>
                    <BitDataGridColumn TItem="UnitConversionSummary" Title="@Text["UnitConversionToLabel"]">
                        <Template Context="row">
                            <bdi dir="ltr">@row.ToUnitCode</bdi> — @row.ToUnitName (<bdi dir="ltr">@row.ToUnitSymbol</bdi>)
                        </Template>
                    </BitDataGridColumn>
                    <BitDataGridColumn TItem="UnitConversionSummary" Title="@Text["UnitConversionFactorLabel"]">
                        <Template Context="row">
                            <bdi dir="ltr">@FormatConversionFormula(row)</bdi>
                        </Template>
                    </BitDataGridColumn>
                    <BitDataGridColumn TItem="UnitConversionSummary" Title="@Text["ReadStatus"]">
                        <Template Context="row">
                            <span class="read-badge @(row.IsActive ? "active" : "inactive")">
                                @Text[row.IsActive ? "ReadActive" : "ReadInactiveStatus"]
                            </span>
                        </Template>
                    </BitDataGridColumn>
                    <BitDataGridColumn TItem="UnitConversionSummary" Title="@Text["ReadActions"]">
                        <Template Context="row">
                            <div class="read-row-actions">
                                <BitTooltip Text="@Text["ReadDetails"]" ShowOnFocus="true">
                                    <BitButton Variant="BitVariant.Outline" Size="BitSize.Small" Class="read-detail-action"
                                               IconName="View" IconOnly="true" aria-label="@Text["ReadDetails"]"
                                               OnClick="() => OnOpenConversionModal.InvokeAsync((row.Id, false))" />
                                </BitTooltip>
                                @if (ScopeCanManage)
                                {
                                    <BitTooltip Text="@Text["ReadEdit"]" ShowOnFocus="true">
                                        <BitButton Variant="BitVariant.Outline" Size="BitSize.Small" Class="read-detail-action"
                                                   Icon="@EditIcon" IconOnly="true" aria-label="@Text["ReadEdit"]"
                                                   OnClick="() => OnOpenConversionModal.InvokeAsync((row.Id, true))" />
                                    </BitTooltip>
                                }
                            </div>
                        </Template>
                    </BitDataGridColumn>
                </Columns>
            </BitDataGrid>
        </div>
    </div>
}
else
{
    <div class="read-grid-card">
        <div class="read-grid">
            <BitDataGrid @ref="currenciesGrid" TItem="CurrencySummary" OnRead="ReadCurrenciesGridAsync" Pageable="true" PageSize="25"
                         PageSizeOptions="@PageSizeOptions" Strings="@GridStrings" SelectionMode="BitSelectionMode.Single"
                         AriaLabelledBy="units-title" WrapCellText="true" Resizable="true">
                <EmptyTemplate><p role="status" class="read-empty">@Text["ReadEmpty"]</p></EmptyTemplate>
                <Columns>
                    <BitDataGridColumn TItem="CurrencySummary" Title="@Text["ReadCode"]">
                        <Template Context="row"><bdi dir="ltr">@row.Code</bdi></Template>
                    </BitDataGridColumn>
                    <BitDataGridColumn TItem="CurrencySummary" Title="@Text["ReadName"]">
                        <Template Context="row">@row.Name</Template>
                    </BitDataGridColumn>
                    <BitDataGridColumn TItem="CurrencySummary" Title="@Text["UnitSymbolLabel"]">
                        <Template Context="row"><bdi dir="ltr">@row.Symbol</bdi></Template>
                    </BitDataGridColumn>
                    <BitDataGridColumn TItem="CurrencySummary" Title="@Text["UnitPrecisionLabel"]">
                        <Template Context="row"><bdi dir="ltr">@row.PrecisionScale</bdi></Template>
                    </BitDataGridColumn>
                    <BitDataGridColumn TItem="CurrencySummary" Title="@Text["ReadStatus"]">
                        <Template Context="row">
                            <span class="read-badge @(row.IsActive ? "active" : "inactive")">
                                @Text[row.IsActive ? "ReadActive" : "ReadInactiveStatus"]
                            </span>
                        </Template>
                    </BitDataGridColumn>
                    <BitDataGridColumn TItem="CurrencySummary" Title="@Text["ReadActions"]">
                        <Template Context="row">
                            <div class="read-row-actions">
                                <BitTooltip Text="@Text["ReadDetails"]" ShowOnFocus="true">
                                    <BitButton Variant="BitVariant.Outline" Size="BitSize.Small" Class="read-detail-action"
                                               IconName="View" IconOnly="true" aria-label="@Text["ReadDetails"]"
                                               OnClick="() => OnOpenCurrencyModal.InvokeAsync((row.Id, false))" />
                                </BitTooltip>
                                @if (ScopeCanManage)
                                {
                                    <BitTooltip Text="@Text["ReadEdit"]" ShowOnFocus="true">
                                        <BitButton Variant="BitVariant.Outline" Size="BitSize.Small" Class="read-detail-action"
                                                   Icon="@EditIcon" IconOnly="true" aria-label="@Text["ReadEdit"]"
                                                   OnClick="() => OnOpenCurrencyModal.InvokeAsync((row.Id, true))" />
                                    </BitTooltip>
                                }
                            </div>
                        </Template>
                    </BitDataGridColumn>
                </Columns>
            </BitDataGrid>
        </div>
    </div>
}

@code {
    private const byte TabUnits = 0;
    private const byte TabConversions = 1;

    private BitDataGrid<UnitSummary>? unitsGrid;
    private BitDataGrid<UnitConversionSummary>? conversionsGrid;
    private BitDataGrid<CurrencySummary>? currenciesGrid;

    [Parameter] public byte ActiveTab { get; set; }
    [Parameter] public OrganizationScope? CurrentScope { get; set; }
    [Parameter] public long CurrentOrgId { get; set; }
    [Parameter] public string DimensionFilter { get; set; } = string.Empty;
    [Parameter] public string ConversionUnitFilter { get; set; } = string.Empty;
    [Parameter] public string Search { get; set; } = string.Empty;
    [Parameter] public bool IncludeInactive { get; set; }
    [Parameter] public bool ScopeCanManage { get; set; }
    [Parameter] public int[] PageSizeOptions { get; set; } = [];
    [Parameter] public BitDataGridStrings GridStrings { get; set; } = new();
    [Parameter] public BitIconInfo EditIcon { get; set; } = default!;
    [Parameter] public Func<UnitDimension, string> DimensionResourceKey { get; set; } = _ => string.Empty;
    [Parameter] public Func<UnitConversionSummary, string> FormatConversionFormula { get; set; } = _ => string.Empty;
    [Parameter] public EventCallback<(long Id, bool Edit)> OnOpenUnitModal { get; set; }
    [Parameter] public EventCallback<(long Id, bool Edit)> OnOpenConversionModal { get; set; }
    [Parameter] public EventCallback<(long Id, bool Edit)> OnOpenCurrencyModal { get; set; }

    public Task RefreshActiveGridAsync() => ActiveTab switch
    {
        TabUnits => ReloadUnitsFromFirstPageAsync(),
        TabConversions => ReloadConversionsFromFirstPageAsync(),
        _ => ReloadCurrenciesFromFirstPageAsync()
    };

    private async Task ReloadCurrenciesFromFirstPageAsync()
    {
        if (currenciesGrid is null) return;
        if (currenciesGrid.CurrentPage <= 1) await currenciesGrid.RefreshAsync();
        else await currenciesGrid.GoToPageAsync(1);
    }

    private async Task ReloadUnitsFromFirstPageAsync()
    {
        if (unitsGrid is null) return;
        if (unitsGrid.CurrentPage <= 1) await unitsGrid.RefreshAsync();
        else await unitsGrid.GoToPageAsync(1);
    }

    private async Task ReloadConversionsFromFirstPageAsync()
    {
        if (conversionsGrid is null) return;
        if (conversionsGrid.CurrentPage <= 1) await conversionsGrid.RefreshAsync();
        else await conversionsGrid.GoToPageAsync(1);
    }

    private async Task<BitDataGridReadResult<UnitSummary>> ReadUnitsGridAsync(BitDataGridReadRequest req)
    {
        if (CurrentScope is null || CurrentOrgId <= 0)
            return new([], 0);

        UnitDimension? dim = byte.TryParse(DimensionFilter, NumberStyles.Integer, CultureInfo.InvariantCulture, out var d)
            && Enum.IsDefined(typeof(UnitDimension), d)
            ? (UnitDimension)d
            : null;

        var pageSize = Math.Clamp(req.Take ?? 25, 1, 100);
        var page = (req.Skip / pageSize) + 1;
        var res = await UnitService.ListUnits(CurrentScope, CurrentOrgId, new UnitListQuery(Search, dim, IncludeInactive, page, pageSize), req.CancellationToken);
        if (!res.Succeeded || res.Value is null)
            return new([], 0);

        return new(res.Value.Items.ToList(), res.Value.Total);
    }

    private async Task<BitDataGridReadResult<UnitConversionSummary>> ReadConversionsGridAsync(BitDataGridReadRequest req)
    {
        if (CurrentScope is null || CurrentOrgId <= 0)
            return new([], 0);

        long? unitId = long.TryParse(ConversionUnitFilter, NumberStyles.Integer, CultureInfo.InvariantCulture, out var uid) && uid > 0 ? uid : null;
        var pageSize = Math.Clamp(req.Take ?? 25, 1, 100);
        var page = (req.Skip / pageSize) + 1;
        var res = await UnitService.ListConversions(CurrentScope, CurrentOrgId, new UnitConversionListQuery(unitId, Search, IncludeInactive, page, pageSize), req.CancellationToken);
        if (!res.Succeeded || res.Value is null)
            return new([], 0);

        return new(res.Value.Items.ToList(), res.Value.Total);
    }

    private async Task<BitDataGridReadResult<CurrencySummary>> ReadCurrenciesGridAsync(BitDataGridReadRequest req)
    {
        if (CurrentScope is null || CurrentOrgId <= 0)
            return new([], 0);

        var pageSize = Math.Clamp(req.Take ?? 25, 1, 100);
        var page = (req.Skip / pageSize) + 1;
        var res = await UnitService.ListCurrencies(CurrentScope, CurrentOrgId, new CurrencyListQuery(Search, IncludeInactive, page, pageSize), req.CancellationToken);
        if (!res.Succeeded || res.Value is null)
            return new([], 0);

        return new(res.Value.Items.ToList(), res.Value.Total);
    }
}
