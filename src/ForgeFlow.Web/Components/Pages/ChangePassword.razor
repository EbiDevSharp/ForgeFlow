@page "/account/change-password"
@inject IStringLocalizer<SharedResources> Text

<PageTitle>@Text["ChangePasswordTitle"]</PageTitle>
<section class="change-password-card" aria-labelledby="change-password-title">
    <h1 id="change-password-title">@Text["ChangePasswordTitle"]</h1>
    <form id="auth-change-password-form" action="/account/change-password-submit" method="post"
          class="write-panel" data-auth-change-password
          data-required-message="@Text["LoginRequired"]"
          data-mismatch-message="@Text["ChangePasswordMismatch"]"
          data-unavailable-message="@Text["LoginUnavailable"]" novalidate>
        <input type="hidden" name="__RequestVerificationToken" value="" />
        <BitTextField Name="currentPassword" Type="BitInputType.Password" Label="@Text["CurrentPasswordLabel"]"
                      Classes="@FieldClasses"
                      CanRevealPassword="true" RevealPasswordAriaLabel="@Text["PasswordVisibilityToggle"]"
                      InputHtmlAttributes="@CurrentAttributes" />
        <BitTextField Name="newPassword" Type="BitInputType.Password" Label="@Text["NewPasswordLabel"]"
                      Classes="@FieldClasses"
                      CanRevealPassword="true" RevealPasswordAriaLabel="@Text["PasswordVisibilityToggle"]"
                      InputHtmlAttributes="@NewAttributes" />
        <span class="write-hint">@Text["UserPasswordHint"]</span>
        <BitTextField Name="confirmPassword" Type="BitInputType.Password" Label="@Text["ConfirmPasswordLabel"]"
                      Classes="@FieldClasses"
                      CanRevealPassword="true" RevealPasswordAriaLabel="@Text["PasswordVisibilityToggle"]"
                      InputHtmlAttributes="@ConfirmAttributes" />
        <div id="change-pwd-error" class="auth-error" role="alert" hidden>
            <span data-auth-error-message></span>
        </div>
        <p id="change-pwd-success" class="read-page-notice write-saved" role="status" hidden></p>
        <div class="write-actions">
            <BitButton ButtonType="BitButtonType.Submit" Size="BitSize.Small" data-auth-submit="true">
                @Text["ChangePasswordSubmit"]
            </BitButton>
        </div>
    </form>
</section>

@code {
    private static readonly BitTextFieldClassStyles FieldClasses = new()
    {
        Root = "write-field",
        Label = "write-field-label",
        InputWrapper = "write-field-wrapper",
        FieldGroup = "write-field-group",
        Input = "write-field-input",
        RevealPassword = "write-field-reveal"
    };

    private static readonly Dictionary<string, object> CurrentAttributes = new()
    {
        ["id"] = "change-current-password",
        ["autocomplete"] = "current-password",
        ["maxlength"] = "128",
        ["aria-required"] = "true"
    };

    private static readonly Dictionary<string, object> NewAttributes = new()
    {
        ["id"] = "change-new-password",
        ["autocomplete"] = "new-password",
        ["maxlength"] = "128",
        ["aria-required"] = "true"
    };

    private static readonly Dictionary<string, object> ConfirmAttributes = new()
    {
        ["id"] = "change-confirm-password",
        ["autocomplete"] = "new-password",
        ["maxlength"] = "128",
        ["aria-required"] = "true"
    };
}
