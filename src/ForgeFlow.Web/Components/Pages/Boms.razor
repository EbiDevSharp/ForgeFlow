    private void AddSimulatorContextPair()
    {
        if (activeDimensions.Count == 0) return;
        simContextPairs.Add(new SimContextPair { DimensionCode = activeDimensions[0].Code, Value = string.Empty });
    }

    private Dictionary<string, string>? BuildSimulatorContext()
    {
        if (simContextPairs.Count == 0) return null;
        var dict = new Dictionary<string, string>(StringComparer.OrdinalIgnoreCase);
        foreach (var pair in simContextPairs)
        {
            if (!string.IsNullOrWhiteSpace(pair.DimensionCode) && !string.IsNullOrWhiteSpace(pair.Value))
                dict[pair.DimensionCode] = pair.Value.Trim();
        }
        return dict.Count == 0 ? null : dict;
    }

    private async Task RunResolveAsync()
    {
        if (CurrentScope is null || simItemId <= 0) return;
        simRunning = true;
        simError = null;
        simExplosion = null;
        try
        {
            var res = await BomService.ResolveBom(CurrentScope,
                new ResolveBomRequest(CurrentOrgId, simItemId, simDate, BuildSimulatorContext()));
            if (!res.Succeeded)
            {
                simResolution = null;
                simError = RolePermissionLocalization.FailureKey(res.Error!.Code);
                return;
            }
            simResolution = res.Value;
        }
        finally { simRunning = false; }
    }

    private async Task RunExplodeAsync()
    {
        if (CurrentScope is null || simItemId <= 0) return;
        if (!TryParsePositiveDecimal(simQtyText, out var qty))
        {
            simError = "BomErrorQuantityInvalid";
            return;
        }
        simRunning = true;
        simError = null;
        try
        {
            long? unitId = simUnitId > 0 ? simUnitId : null;
            var res = await BomService.ExplodeBom(CurrentScope,
                new ExplodeBomRequest(CurrentOrgId, simItemId, simDate, qty, unitId, BuildSimulatorContext()));
            if (!res.Succeeded)
            {
                simExplosion = null;
                simError = RolePermissionLocalization.FailureKey(res.Error!.Code);
                return;
            }
            simExplosion = res.Value;
            var resolveRes = await BomService.ResolveBom(CurrentScope,
                new ResolveBomRequest(CurrentOrgId, simItemId, simDate, BuildSimulatorContext()));
            simResolution = resolveRes.Succeeded ? resolveRes.Value : null;
        }
        finally { simRunning = false; }
    }

    private static bool TryParsePositiveDecimal(string raw, out decimal value) =>
        decimal.TryParse(raw?.Trim(), NumberStyles.Number, CultureInfo.InvariantCulture, out value) && value > 0m;

    private string ScopeLabel(OrganizationScope scope) => scope switch
    {
        OrganizationScope.Organization o when scopeLabels.TryGetValue(scope, out var info) && info.OrgCode is not null
            => $"{info.OrgCode} — {info.OrgName}",
        OrganizationScope.Organization o => Text["ReadOrganizationScope", o.OrganizationId],
        OrganizationScope.Site s when scopeLabels.TryGetValue(scope, out var info) && info.SiteCode is not null
            => $"{info.OrgCode} / {info.SiteCode} — {info.SiteName}",
        OrganizationScope.Site s => Text["ReadSiteScope", s.OrganizationId, s.SiteId],
        _ => string.Empty
    };

