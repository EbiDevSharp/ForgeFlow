    private async Task<BitDataGridReadResult<UnitSummary>> ReadUnitsGridAsync(BitDataGridReadRequest req)
    {
        if (CurrentScope is null || CurrentOrgId <= 0)
            return new([], 0);

        UnitDimension? dim = byte.TryParse(dimensionFilter, NumberStyles.Integer, CultureInfo.InvariantCulture, out var d)
            && Enum.IsDefined(typeof(UnitDimension), d)
            ? (UnitDimension)d
            : null;

        var pageSize = Math.Clamp(req.Take ?? 25, 1, 100);
        var page = (req.Skip / pageSize) + 1;
        var res = await UnitService.ListUnits(CurrentScope, CurrentOrgId, new UnitListQuery(search, dim, includeInactive, page, pageSize), req.CancellationToken);
        if (!res.Succeeded || res.Value is null)
            return new([], 0);

        return new(res.Value.Items.ToList(), res.Value.Total);
    }

    private async Task<BitDataGridReadResult<UnitConversionSummary>> ReadConversionsGridAsync(BitDataGridReadRequest req)
    {
        if (CurrentScope is null || CurrentOrgId <= 0)
            return new([], 0);

        long? unitId = long.TryParse(conversionUnitFilter, NumberStyles.Integer, CultureInfo.InvariantCulture, out var uid) && uid > 0 ? uid : null;
        var pageSize = Math.Clamp(req.Take ?? 25, 1, 100);
        var page = (req.Skip / pageSize) + 1;
        var res = await UnitService.ListConversions(CurrentScope, CurrentOrgId, new UnitConversionListQuery(unitId, search, includeInactive, page, pageSize), req.CancellationToken);
        if (!res.Succeeded || res.Value is null)
            return new([], 0);

        return new(res.Value.Items.ToList(), res.Value.Total);
    }

    private async Task<BitDataGridReadResult<CurrencySummary>> ReadCurrenciesGridAsync(BitDataGridReadRequest req)
    {
        if (CurrentScope is null || CurrentOrgId <= 0)
            return new([], 0);

        var pageSize = Math.Clamp(req.Take ?? 25, 1, 100);
        var page = (req.Skip / pageSize) + 1;
        var res = await UnitService.ListCurrencies(CurrentScope, CurrentOrgId, new CurrencyListQuery(search, includeInactive, page, pageSize), req.CancellationToken);
        if (!res.Succeeded || res.Value is null)
            return new([], 0);

        return new(res.Value.Items.ToList(), res.Value.Total);
    }

