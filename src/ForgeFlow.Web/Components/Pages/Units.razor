@page "/units"
@page "/organizations/{OrganizationId:long}/units"
@using System.Globalization
@using ForgeFlow.Application.Organizations
@using ForgeFlow.Application.Units
@using ForgeFlow.Domain.Units
@using ForgeFlow.Web.Roles
@inject UnitUseCases UnitService
@inject ForgeFlow.Web.Organizations.ReadScopes Scopes
@inject ITrustedActorAccessor Actors
@inject IOrganizationPermissionEvaluator Permissions
@inject IStringLocalizer<SharedResources> Text

<PageTitle>@Text["Units"] - @Text["AppTitle"]</PageTitle>

<section class="organization-reader" aria-labelledby="units-title">
    <div class="read-page-head">
        <div>
            <h1 id="units-title">@Text["Units"]</h1>
            <p class="write-hint">@Text["UnitsCaption"]</p>
        </div>
        @if (!initialLoading && pageError is null && available.Count > 0)
        {
            <div class="read-head-actions">
                <BitButton Variant="BitVariant.Outline" Size="BitSize.Small" Class="read-create-btn"
                           OnClick="OpenConverter">@Text["UnitConverterButton"]</BitButton>
                @if (scopeCanManage)
                {
                    <BitButton Variant="BitVariant.Outline" Size="BitSize.Small" Class="read-create-btn"
                               IsEnabled="@(!seeding)" OnClick="SeedStandardUnitsAsync">@Text["UnitsSeedButton"]</BitButton>
                    <BitButton Size="BitSize.Small" IconName="Add" Class="read-create-btn"
                               OnClick="OpenActiveCreate">
                        @Text[activeTab == TabUnits ? "UnitCreateButton" : activeTab == TabConversions ? "UnitConversionCreateButton" : "CurrencyCreateButton"]
                    </BitButton>
                }
            </div>
        }
    </div>

    @if (pageNotice is not null)
    {
        <p role="status" class="read-page-notice write-saved">@pageNotice</p>
    }

    @if (initialLoading)
    {
        <p role="status" aria-live="polite">@Text["ReadLoading"]</p>
    }
    else if (pageError is not null)
    {
        <div class="read-state" role="alert">
            <p>@Text[pageError]</p>
            <BitButton Variant="BitVariant.Outline" Size="BitSize.Small" OnClick="ReloadScopeAsync">@Text["WriteReload"]</BitButton>
        </div>
    }
    else
    {
        <div class="read-tab-bar" role="tablist" aria-label="@Text["Units"]">
            <button type="button" role="tab" aria-selected="@(activeTab == TabUnits)"
                    class="read-tab-btn @(activeTab == TabUnits ? "active" : string.Empty)"
                    @onclick="() => SwitchTabAsync(TabUnits)">@Text["UnitsTab"]</button>
            <button type="button" role="tab" aria-selected="@(activeTab == TabConversions)"
                    class="read-tab-btn @(activeTab == TabConversions ? "active" : string.Empty)"
                    @onclick="() => SwitchTabAsync(TabConversions)">@Text["UnitConversionsTab"]</button>
            <button type="button" role="tab" aria-selected="@(activeTab == TabCurrencies)"
                    class="read-tab-btn @(activeTab == TabCurrencies ? "active" : string.Empty)"
                    @onclick="() => SwitchTabAsync(TabCurrencies)">@Text["UnitCurrenciesTab"]</button>
        </div>

        <div class="read-toolbar-card">
            @if (available.Count > 1)
            {
                <div class="read-field">
                    <label for="units-scope">@Text["ReadScope"]</label>
                    <select id="units-scope" aria-label="@Text["ReadScope"]" value="@scopeIndex" @onchange="ChangeScopeAsync">
                        @for (var i = 0; i < available.Count; i++)
                        {
                            <option value="@i">@ScopeLabel(available[i])</option>
                        }
                    </select>
                </div>
            }

            @if (activeTab == TabUnits)
            {
                <div class="read-field">
                    <label for="units-dimension">@Text["UnitDimensionLabel"]</label>
                    <select id="units-dimension" aria-label="@Text["UnitDimensionLabel"]" value="@dimensionFilter" @onchange="ChangeDimensionAsync">
                        <option value="">@Text["UnitDimensionAll"]</option>
                        @foreach (var dim in AllDimensions)
                        {
                            <option value="@((byte)dim)">@Text[DimensionResourceKey(dim)]</option>
                        }
                    </select>
                </div>
            }
            else if (activeTab == TabConversions)
            {
                <div class="read-field">
                    <label for="conv-unit-filter">@Text["UnitsTab"]</label>
                    <select id="conv-unit-filter" aria-label="@Text["UnitsTab"]" value="@conversionUnitFilter" @onchange="ChangeConversionUnitFilterAsync">
                        <option value="">@Text["UnitFilterAll"]</option>
                        @foreach (var u in activeUnits)
                        {
                            <option value="@u.Id">@FormatUnitOption(u)</option>
                        }
                    </select>
                </div>
            }

            <div class="read-field">
                <label for="units-search">@Text["ReadSearch"]</label>
                <input id="units-search" type="search" @bind="search" @bind:after="ApplySearchAsync"
                       maxlength="100" placeholder="@Text["UnitSearchPlaceholder"]" />
            </div>

            <label class="read-inactive">
                <input type="checkbox" @bind="includeInactive" @bind:after="ApplySearchAsync" /> @Text["ReadInactive"]
            </label>
        </div>

        @if (activeTab == TabUnits)
        {
            <div class="read-grid-card">
                <div class="read-grid">
                    <BitDataGrid @ref="unitsGrid" TItem="UnitSummary" OnRead="ReadUnitsGridAsync" Pageable="true" PageSize="25"
                                 PageSizeOptions="@PageSizeOptions" Strings="@GridStrings" SelectionMode="BitSelectionMode.Single"
                                 AriaLabelledBy="units-title" WrapCellText="true" Resizable="true">
                        <EmptyTemplate><p role="status" class="read-empty">@Text["ReadEmpty"]</p></EmptyTemplate>
                        <Columns>
                            <BitDataGridColumn TItem="UnitSummary" Title="@Text["ReadCode"]">
                                <Template Context="row"><bdi dir="ltr">@row.Code</bdi></Template>
                            </BitDataGridColumn>
                            <BitDataGridColumn TItem="UnitSummary" Title="@Text["ReadName"]">
                                <Template Context="row">@row.Name</Template>
                            </BitDataGridColumn>
                            <BitDataGridColumn TItem="UnitSummary" Title="@Text["UnitSymbolLabel"]">
                                <Template Context="row"><bdi dir="ltr">@row.Symbol</bdi></Template>
                            </BitDataGridColumn>
                            <BitDataGridColumn TItem="UnitSummary" Title="@Text["UnitDimensionLabel"]">
                                <Template Context="row">
                                    <span class="read-badge role">@Text[DimensionResourceKey(row.Dimension)]</span>
                                </Template>
                            </BitDataGridColumn>
                            <BitDataGridColumn TItem="UnitSummary" Title="@Text["UnitPrecisionLabel"]">
                                <Template Context="row"><bdi dir="ltr">@row.PrecisionScale</bdi></Template>
                            </BitDataGridColumn>
                            <BitDataGridColumn TItem="UnitSummary" Title="@Text["ReadStatus"]">
                                <Template Context="row">
                                    <span class="read-badge @(row.IsActive ? "active" : "inactive")">
                                        @Text[row.IsActive ? "ReadActive" : "ReadInactiveStatus"]
                                    </span>
                                </Template>
                            </BitDataGridColumn>
                            <BitDataGridColumn TItem="UnitSummary" Title="@Text["ReadActions"]">
                                <Template Context="row">
                                    <div class="read-row-actions">
                                        <BitTooltip Text="@Text["ReadDetails"]" ShowOnFocus="true">
                                            <BitButton Variant="BitVariant.Outline" Size="BitSize.Small" Class="read-detail-action"
                                                       IconName="View" IconOnly="true" aria-label="@Text["ReadDetails"]"
                                                       OnClick="() => OpenUnitModal(row.Id, edit: false)" />
                                        </BitTooltip>
                                        @if (scopeCanManage)
                                        {
                                            <BitTooltip Text="@Text["ReadEdit"]" ShowOnFocus="true">
                                                <BitButton Variant="BitVariant.Outline" Size="BitSize.Small" Class="read-detail-action"
                                                           Icon="@EditIcon" IconOnly="true" aria-label="@Text["ReadEdit"]"
                                                           OnClick="() => OpenUnitModal(row.Id, edit: true)" />
                                            </BitTooltip>
                                        }
                                    </div>
                                </Template>
                            </BitDataGridColumn>
                        </Columns>
                    </BitDataGrid>
                </div>
            </div>
        }
        else if (activeTab == TabConversions)
        {
            <div class="read-grid-card">
                <div class="read-grid">
                    <BitDataGrid @ref="conversionsGrid" TItem="UnitConversionSummary" OnRead="ReadConversionsGridAsync" Pageable="true" PageSize="25"
                                 PageSizeOptions="@PageSizeOptions" Strings="@GridStrings" SelectionMode="BitSelectionMode.Single"
                                 AriaLabelledBy="units-title" WrapCellText="true" Resizable="true">
                        <EmptyTemplate><p role="status" class="read-empty">@Text["ReadEmpty"]</p></EmptyTemplate>
                        <Columns>
                            <BitDataGridColumn TItem="UnitConversionSummary" Title="@Text["UnitConversionFromLabel"]">
                                <Template Context="row">
                                    <bdi dir="ltr">@row.FromUnitCode</bdi> — @row.FromUnitName (<bdi dir="ltr">@row.FromUnitSymbol</bdi>)
                                </Template>
                            </BitDataGridColumn>
                            <BitDataGridColumn TItem="UnitConversionSummary" Title="@Text["UnitConversionToLabel"]">
                                <Template Context="row">
                                    <bdi dir="ltr">@row.ToUnitCode</bdi> — @row.ToUnitName (<bdi dir="ltr">@row.ToUnitSymbol</bdi>)
                                </Template>
                            </BitDataGridColumn>
                            <BitDataGridColumn TItem="UnitConversionSummary" Title="@Text["UnitConversionFactorLabel"]">
                                <Template Context="row">
                                    <bdi dir="ltr">@FormatConversionFormula(row)</bdi>
                                </Template>
                            </BitDataGridColumn>
                            <BitDataGridColumn TItem="UnitConversionSummary" Title="@Text["ReadStatus"]">
                                <Template Context="row">
                                    <span class="read-badge @(row.IsActive ? "active" : "inactive")">
                                        @Text[row.IsActive ? "ReadActive" : "ReadInactiveStatus"]
                                    </span>
                                </Template>
                            </BitDataGridColumn>
                            <BitDataGridColumn TItem="UnitConversionSummary" Title="@Text["ReadActions"]">
                                <Template Context="row">
                                    <div class="read-row-actions">
                                        <BitTooltip Text="@Text["ReadDetails"]" ShowOnFocus="true">
                                            <BitButton Variant="BitVariant.Outline" Size="BitSize.Small" Class="read-detail-action"
                                                       IconName="View" IconOnly="true" aria-label="@Text["ReadDetails"]"
                                                       OnClick="() => OpenConversionModal(row.Id, edit: false)" />
                                        </BitTooltip>
                                        @if (scopeCanManage)
                                        {
                                            <BitTooltip Text="@Text["ReadEdit"]" ShowOnFocus="true">
                                                <BitButton Variant="BitVariant.Outline" Size="BitSize.Small" Class="read-detail-action"
                                                           Icon="@EditIcon" IconOnly="true" aria-label="@Text["ReadEdit"]"
                                                           OnClick="() => OpenConversionModal(row.Id, edit: true)" />
                                            </BitTooltip>
                                        }
                                    </div>
                                </Template>
                            </BitDataGridColumn>
                        </Columns>
                    </BitDataGrid>
                </div>
            </div>
        }
        else
        {
            <div class="read-grid-card">
                <div class="read-grid">
                    <BitDataGrid @ref="currenciesGrid" TItem="CurrencySummary" OnRead="ReadCurrenciesGridAsync" Pageable="true" PageSize="25"
                                 PageSizeOptions="@PageSizeOptions" Strings="@GridStrings" SelectionMode="BitSelectionMode.Single"
                                 AriaLabelledBy="units-title" WrapCellText="true" Resizable="true">
                        <EmptyTemplate><p role="status" class="read-empty">@Text["ReadEmpty"]</p></EmptyTemplate>
                        <Columns>
                            <BitDataGridColumn TItem="CurrencySummary" Title="@Text["ReadCode"]">
                                <Template Context="row"><bdi dir="ltr">@row.Code</bdi></Template>
                            </BitDataGridColumn>
                            <BitDataGridColumn TItem="CurrencySummary" Title="@Text["ReadName"]">
                                <Template Context="row">@row.Name</Template>
                            </BitDataGridColumn>
                            <BitDataGridColumn TItem="CurrencySummary" Title="@Text["UnitSymbolLabel"]">
                                <Template Context="row"><bdi dir="ltr">@row.Symbol</bdi></Template>
                            </BitDataGridColumn>
                            <BitDataGridColumn TItem="CurrencySummary" Title="@Text["UnitPrecisionLabel"]">
                                <Template Context="row"><bdi dir="ltr">@row.PrecisionScale</bdi></Template>
                            </BitDataGridColumn>
                            <BitDataGridColumn TItem="CurrencySummary" Title="@Text["ReadStatus"]">
                                <Template Context="row">
                                    <span class="read-badge @(row.IsActive ? "active" : "inactive")">
                                        @Text[row.IsActive ? "ReadActive" : "ReadInactiveStatus"]
                                    </span>
                                </Template>
                            </BitDataGridColumn>
                            <BitDataGridColumn TItem="CurrencySummary" Title="@Text["ReadActions"]">
                                <Template Context="row">
                                    <div class="read-row-actions">
                                        <BitTooltip Text="@Text["ReadDetails"]" ShowOnFocus="true">
                                            <BitButton Variant="BitVariant.Outline" Size="BitSize.Small" Class="read-detail-action"
                                                       IconName="View" IconOnly="true" aria-label="@Text["ReadDetails"]"
                                                       OnClick="() => OpenCurrencyModal(row.Id, edit: false)" />
                                        </BitTooltip>
                                        @if (scopeCanManage)
                                        {
                                            <BitTooltip Text="@Text["ReadEdit"]" ShowOnFocus="true">
                                                <BitButton Variant="BitVariant.Outline" Size="BitSize.Small" Class="read-detail-action"
                                                           Icon="@EditIcon" IconOnly="true" aria-label="@Text["ReadEdit"]"
                                                           OnClick="() => OpenCurrencyModal(row.Id, edit: true)" />
                                            </BitTooltip>
                                        }
                                    </div>
                                </Template>
                            </BitDataGridColumn>
                        </Columns>
                    </BitDataGrid>
                </div>
            </div>
        }
    }
</section>

<BitDialog Width="580px" MaxWidth="calc(100vw - 24px)" Classes="@DialogClasses" @bind-IsOpen="unitModalOpen"
           OnDismissing="OnUnitModalDismissing"
           Title="@Text[unitEditMode ? "UnitEditTitle" : "UnitDetailTitle"]"
           AriaLabel="@Text[unitEditMode ? "UnitEditTitle" : "UnitDetailTitle"]"
           CloseButtonTitle="@Text["ReadClose"]" ShowOkButton="false" ShowCancelButton="false" ShowCloseButton="true"
           AutoFocus="true" TrapFocus="true" RestoreFocus="true" CloseOnEscape="true">
    <Body>
        @if (selectedUnit is not null)
        {
            <div class="audit-modal-body">
                @if (!unitEditMode)
                {
                    <div class="audit-modal-title-row">
                        <strong class="audit-modal-code" dir="ltr">@selectedUnit.Code</strong>
                        <span class="read-badge @(selectedUnit.IsActive ? "active" : "inactive")">
                            @Text[selectedUnit.IsActive ? "ReadActive" : "ReadInactiveStatus"]
                        </span>
                    </div>
                    <div class="audit-meta-card">
                        <div class="audit-meta-row">
                            <span class="audit-meta-label">@Text["ReadName"]</span>
                            <span class="audit-meta-val">@selectedUnit.Name</span>
                        </div>
                        <div class="audit-meta-row">
                            <span class="audit-meta-label">@Text["UnitSymbolLabel"]</span>
                            <bdi class="audit-meta-val" dir="ltr">@selectedUnit.Symbol</bdi>
                        </div>
                        <div class="audit-meta-row">
                            <span class="audit-meta-label">@Text["UnitDimensionLabel"]</span>
                            <span class="audit-meta-val">@Text[DimensionResourceKey(selectedUnit.Dimension)]</span>
                        </div>
                        <div class="audit-meta-row">
                            <span class="audit-meta-label">@Text["UnitPrecisionLabel"]</span>
                            <bdi class="audit-meta-val" dir="ltr">@selectedUnit.PrecisionScale</bdi>
                        </div>
                    </div>
                }
                else
                {
                    <form class="write-panel" @onsubmit:preventDefault>
                        <div class="write-meta">
                            <span class="write-code" dir="ltr">@selectedUnit.Code</span>
                            <span class="read-badge @(selectedUnit.IsActive ? "active" : "inactive")">
                                @Text[selectedUnit.IsActive ? "ReadActive" : "ReadInactiveStatus"]
                            </span>
                        </div>
                        <div class="read-field">
                            <label for="edit-unit-name">@Text["ReadName"]</label>
                            <input id="edit-unit-name" @bind="editUnitName" @bind:event="oninput" maxlength="200"
                                   disabled="@(!selectedUnit.IsActive || unitSaving)" />
                        </div>
                        <div class="read-field">
                            <label for="edit-unit-symbol">@Text["UnitSymbolLabel"]</label>
                            <input id="edit-unit-symbol" @bind="editUnitSymbol" @bind:event="oninput" maxlength="32"
                                   disabled="@(!selectedUnit.IsActive || unitSaving)" />
                        </div>
                        <div class="read-field">
                            <label for="edit-unit-precision">@Text["UnitPrecisionLabel"]</label>
                            <select id="edit-unit-precision" @bind="editUnitPrecision" disabled="@(!selectedUnit.IsActive || unitSaving)">
                                @for (byte p = 0; p <= 6; p++)
                                {
                                    <option value="@p">@p</option>
                                }
                            </select>
                        </div>

                        @if (unitDiscardConfirm)
                        {
                            <div class="write-confirm" role="alertdialog" aria-labelledby="unit-discard-text">
                                <p id="unit-discard-text">@Text["WriteDiscardConfirm"]</p>
                                <div class="write-actions">
                                    <BitButton Size="BitSize.Small" OnClick="ConfirmUnitDiscard">@Text["WriteDiscard"]</BitButton>
                                    <BitButton Variant="BitVariant.Outline" Size="BitSize.Small" OnClick="() => unitDiscardConfirm = false">@Text["WriteKeepEditing"]</BitButton>
                                </div>
                            </div>
                        }

                        @if (!unitDiscardConfirm && unitConfirmToggle is null)
                        {
                            <div class="write-actions">
                                @if (selectedUnit.IsActive)
                                {
                                    <BitButton Size="BitSize.Small" IsEnabled="@(!unitSaving && UnitEditDirty)" OnClick="SubmitUnitUpdateAsync">@Text["WriteSave"]</BitButton>
                                    <BitButton Variant="BitVariant.Outline" Size="BitSize.Small" IsEnabled="@(!unitSaving)" OnClick="() => unitConfirmToggle = false">@Text["WriteDeactivate"]</BitButton>
                                }
                                else
                                {
                                    <BitButton Variant="BitVariant.Outline" Size="BitSize.Small" IsEnabled="@(!unitSaving)" OnClick="() => unitConfirmToggle = true">@Text["WriteActivate"]</BitButton>
                                }
                            </div>
                        }

                        @if (unitConfirmToggle is bool targetActive)
                        {
                            <div class="write-confirm" role="alertdialog" aria-labelledby="unit-toggle-text">
                                <p id="unit-toggle-text">@Text[targetActive ? "WriteConfirmActivate" : "WriteConfirmDeactivate", selectedUnit.Name]</p>
                                <div class="write-actions">
                                    <BitButton Size="BitSize.Small" IsEnabled="@(!unitSaving)" OnClick="ExecuteUnitToggleAsync">@Text["WriteConfirm"]</BitButton>
                                    <BitButton Variant="BitVariant.Outline" Size="BitSize.Small" IsEnabled="@(!unitSaving)" OnClick="() => unitConfirmToggle = null">@Text["WriteCancel"]</BitButton>
                                </div>
                            </div>
                        }

                        @if (unitSaving) { <p role="status">@Text["WriteSaving"]</p> }
                        @if (unitSaved) { <p role="status" class="write-saved">@Text["WriteSaved"]</p> }
                        @if (unitError is not null)
                        {
                            <p role="alert" class="write-error">@Text[unitError]</p>
                            @if (unitError is "WriteConflict" or "WriteOutcomeUnknown")
                            {
                                <div class="write-actions">
                                    <BitButton Variant="BitVariant.Outline" Size="BitSize.Small" OnClick="ReloadSelectedUnitAsync">@Text["WriteReload"]</BitButton>
                                </div>
                            }
                        }
                    </form>
                }
            </div>
        }
    </Body>
</BitDialog>

<BitDialog Width="580px" MaxWidth="calc(100vw - 24px)" Classes="@DialogClasses" @bind-IsOpen="createUnitOpen"
           OnDismissing="OnCreateUnitDismissing"
           Title="@Text["UnitCreateTitle"]" AriaLabel="@Text["UnitCreateTitle"]"
           CloseButtonTitle="@Text["ReadClose"]" ShowOkButton="false" ShowCancelButton="false" ShowCloseButton="true"
           AutoFocus="true" TrapFocus="true" RestoreFocus="true" CloseOnEscape="true">
    <Body>
        <div class="audit-modal-body">
            <form class="write-panel" @onsubmit:preventDefault>
                <div class="read-field">
                    <label for="create-unit-code">@Text["ReadCode"]</label>
                    <input id="create-unit-code" @bind="createUnitCode" @bind:event="oninput" maxlength="32"
                           disabled="@unitSaving" aria-describedby="create-unit-code-hint" />
                    <span id="create-unit-code-hint" class="write-hint">@Text["CreateCodeHint"]</span>
                </div>
                <div class="read-field">
                    <label for="create-unit-name">@Text["ReadName"]</label>
                    <input id="create-unit-name" @bind="createUnitName" @bind:event="oninput" maxlength="200" disabled="@unitSaving" />
                </div>
                <div class="read-field">
                    <label for="create-unit-symbol">@Text["UnitSymbolLabel"]</label>
                    <input id="create-unit-symbol" @bind="createUnitSymbol" @bind:event="oninput" maxlength="32" disabled="@unitSaving" />
                </div>
                <div class="read-field">
                    <label for="create-unit-dimension">@Text["UnitDimensionLabel"]</label>
                    <select id="create-unit-dimension" @bind="createUnitDimension" disabled="@unitSaving">
                        @foreach (var dim in AllDimensions)
                        {
                            <option value="@dim">@Text[DimensionResourceKey(dim)]</option>
                        }
                    </select>
                </div>
                <div class="read-field">
                    <label for="create-unit-precision">@Text["UnitPrecisionLabel"]</label>
                    <select id="create-unit-precision" @bind="createUnitPrecision" disabled="@unitSaving">
                        @for (byte p = 0; p <= 6; p++)
                        {
                            <option value="@p">@p</option>
                        }
                    </select>
                </div>

                @if (createUnitDiscardConfirm)
                {
                    <div class="write-confirm" role="alertdialog" aria-labelledby="create-unit-discard-text">
                        <p id="create-unit-discard-text">@Text["WriteDiscardConfirm"]</p>
                        <div class="write-actions">
                            <BitButton Size="BitSize.Small" OnClick="ConfirmCreateUnitDiscard">@Text["WriteDiscard"]</BitButton>
                            <BitButton Variant="BitVariant.Outline" Size="BitSize.Small" OnClick="() => createUnitDiscardConfirm = false">@Text["WriteKeepEditing"]</BitButton>
                        </div>
                    </div>
                }
                else
                {
                    <div class="write-actions">
                        <BitButton Size="BitSize.Small" IsEnabled="@(!unitSaving && !string.IsNullOrWhiteSpace(createUnitCode) && !string.IsNullOrWhiteSpace(createUnitName) && !string.IsNullOrWhiteSpace(createUnitSymbol))"
                                   OnClick="SubmitCreateUnitAsync">@Text["CreateSubmit"]</BitButton>
                    </div>
                }

                @if (unitSaving) { <p role="status">@Text["WriteSaving"]</p> }
                @if (unitError is not null) { <p role="alert" class="write-error">@Text[unitError]</p> }
            </form>
        </div>
    </Body>
</BitDialog>

<BitDialog Width="580px" MaxWidth="calc(100vw - 24px)" Classes="@DialogClasses" @bind-IsOpen="conversionModalOpen"
           OnDismissing="OnConversionModalDismissing"
           Title="@Text[conversionEditMode ? "UnitConversionEditTitle" : "UnitConversionDetailTitle"]"
           AriaLabel="@Text[conversionEditMode ? "UnitConversionEditTitle" : "UnitConversionDetailTitle"]"
           CloseButtonTitle="@Text["ReadClose"]" ShowOkButton="false" ShowCancelButton="false" ShowCloseButton="true"
           AutoFocus="true" TrapFocus="true" RestoreFocus="true" CloseOnEscape="true">
    <Body>
        @if (selectedConversion is not null)
        {
            <div class="audit-modal-body">
                @if (!conversionEditMode)
                {
                    <div class="audit-modal-title-row">
                        <strong class="audit-modal-code" dir="ltr">@FormatConversionFormula(selectedConversion)</strong>
                        <span class="read-badge @(selectedConversion.IsActive ? "active" : "inactive")">
                            @Text[selectedConversion.IsActive ? "ReadActive" : "ReadInactiveStatus"]
                        </span>
                    </div>
                    <div class="audit-meta-card">
                        <div class="audit-meta-row">
                            <span class="audit-meta-label">@Text["UnitConversionFromLabel"]</span>
                            <span class="audit-meta-val">@selectedConversion.FromUnitCode — @selectedConversion.FromUnitName</span>
                        </div>
                        <div class="audit-meta-row">
                            <span class="audit-meta-label">@Text["UnitConversionToLabel"]</span>
                            <span class="audit-meta-val">@selectedConversion.ToUnitCode — @selectedConversion.ToUnitName</span>
                        </div>
                        <div class="audit-meta-row">
                            <span class="audit-meta-label">@Text["UnitConversionFactorLabel"]</span>
                            <bdi class="audit-meta-val" dir="ltr">@selectedConversion.Factor.ToString("0.######", CultureInfo.InvariantCulture)</bdi>
                        </div>
                    </div>
                }
                else
                {
                    <form class="write-panel" @onsubmit:preventDefault>
                        <div class="write-meta">
                            <span class="write-code" dir="ltr">@selectedConversion.FromUnitCode → @selectedConversion.ToUnitCode</span>
                            <span class="read-badge @(selectedConversion.IsActive ? "active" : "inactive")">
                                @Text[selectedConversion.IsActive ? "ReadActive" : "ReadInactiveStatus"]
                            </span>
                        </div>
                        <div class="read-field">
                            <label for="edit-conv-factor">@Text["UnitConversionFactorLabel"]</label>
                            <input id="edit-conv-factor" type="number" step="0.000001" min="0.000001"
                                   @bind="editConversionFactorText" @bind:event="oninput"
