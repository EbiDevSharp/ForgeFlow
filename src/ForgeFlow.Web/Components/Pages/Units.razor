@page "/units"
@page "/organizations/{OrganizationId:long}/units"
@using System.Globalization
@using ForgeFlow.Application.Organizations
@using ForgeFlow.Application.Units
@using ForgeFlow.Domain.Units
@using ForgeFlow.Web.Roles
@inject UnitUseCases UnitService
@inject ForgeFlow.Web.Organizations.ReadScopes Scopes
@inject ITrustedActorAccessor Actors
@inject IOrganizationPermissionEvaluator Permissions
@inject IStringLocalizer<SharedResources> Text

<PageTitle>@Text["Units"] - @Text["AppTitle"]</PageTitle>

<section class="organization-reader" aria-labelledby="units-title">
    <div class="read-page-head">
        <div>
            <h1 id="units-title">@Text["Units"]</h1>
            <p class="write-hint">@Text["UnitsCaption"]</p>
        </div>
        @if (!initialLoading && pageError is null && available.Count > 0)
        {
            <div class="read-head-actions">
                <BitButton Variant="BitVariant.Outline" Size="BitSize.Small" Class="read-create-btn"
                           OnClick="OpenConverter">@Text["UnitConverterButton"]</BitButton>
                @if (scopeCanManage)
                {
                    <BitButton Variant="BitVariant.Outline" Size="BitSize.Small" Class="read-create-btn"
                               IsEnabled="@(!seeding)" OnClick="SeedStandardUnitsAsync">@Text["UnitsSeedButton"]</BitButton>
                    <BitButton Size="BitSize.Small" IconName="Add" Class="read-create-btn"
                               OnClick="OpenActiveCreate">
                        @Text[activeTab == TabUnits ? "UnitCreateButton" : activeTab == TabConversions ? "UnitConversionCreateButton" : "CurrencyCreateButton"]
                    </BitButton>
                }
            </div>
        }
    </div>

    @if (pageNotice is not null)
    {
        <p role="status" class="read-page-notice write-saved">@pageNotice</p>
    }

    @if (initialLoading)
    {
        <p role="status" aria-live="polite">@Text["ReadLoading"]</p>
    }
    else if (pageError is not null)
    {
        <div class="read-state" role="alert">
            <p>@Text[pageError]</p>
            <BitButton Variant="BitVariant.Outline" Size="BitSize.Small" OnClick="ReloadScopeAsync">@Text["WriteReload"]</BitButton>
        </div>
    }
    else
    {
        <div class="read-tab-bar" role="tablist" aria-label="@Text["Units"]">
            <button type="button" role="tab" aria-selected="@(activeTab == TabUnits)"
                    class="read-tab-btn @(activeTab == TabUnits ? "active" : string.Empty)"
                    @onclick="() => SwitchTabAsync(TabUnits)">@Text["UnitsTab"]</button>
            <button type="button" role="tab" aria-selected="@(activeTab == TabConversions)"
                    class="read-tab-btn @(activeTab == TabConversions ? "active" : string.Empty)"
                    @onclick="() => SwitchTabAsync(TabConversions)">@Text["UnitConversionsTab"]</button>
            <button type="button" role="tab" aria-selected="@(activeTab == TabCurrencies)"
                    class="read-tab-btn @(activeTab == TabCurrencies ? "active" : string.Empty)"
                    @onclick="() => SwitchTabAsync(TabCurrencies)">@Text["UnitCurrenciesTab"]</button>
        </div>

        <div class="read-toolbar-card">
            @if (available.Count > 1)
            {
                <div class="read-field">
                    <label for="units-scope">@Text["ReadScope"]</label>
                    <select id="units-scope" aria-label="@Text["ReadScope"]" value="@scopeIndex" @onchange="ChangeScopeAsync">
                        @for (var i = 0; i < available.Count; i++)
                        {
                            <option value="@i">@ScopeLabel(available[i])</option>
                        }
                    </select>
                </div>
            }

            @if (activeTab == TabUnits)
            {
                <div class="read-field">
                    <label for="units-dimension">@Text["UnitDimensionLabel"]</label>
                    <select id="units-dimension" aria-label="@Text["UnitDimensionLabel"]" value="@dimensionFilter" @onchange="ChangeDimensionAsync">
                        <option value="">@Text["UnitDimensionAll"]</option>
                        @foreach (var dim in AllDimensions)
                        {
                            <option value="@((byte)dim)">@Text[DimensionResourceKey(dim)]</option>
                        }
                    </select>
                </div>
            }
            else if (activeTab == TabConversions)
            {
                <div class="read-field">
                    <label for="conv-unit-filter">@Text["UnitsTab"]</label>
                    <select id="conv-unit-filter" aria-label="@Text["UnitsTab"]" value="@conversionUnitFilter" @onchange="ChangeConversionUnitFilterAsync">
                        <option value="">@Text["UnitFilterAll"]</option>
                        @foreach (var u in activeUnits)
                        {
                            <option value="@u.Id">@FormatUnitOption(u)</option>
                        }
                    </select>
                </div>
            }

            <div class="read-field">
                <label for="units-search">@Text["ReadSearch"]</label>
                <input id="units-search" type="search" @bind="search" @bind:after="ApplySearchAsync"
                       maxlength="100" placeholder="@Text["UnitSearchPlaceholder"]" />
            </div>

            <label class="read-inactive">
                <input type="checkbox" @bind="includeInactive" @bind:after="ApplySearchAsync" /> @Text["ReadInactive"]
            </label>
        </div>

        <UnitGridsSection @ref="gridsSection"
                          ActiveTab="@activeTab"
                          CurrentScope="@CurrentScope"
                          CurrentOrgId="@CurrentOrgId"
                          DimensionFilter="@dimensionFilter"
                          ConversionUnitFilter="@conversionUnitFilter"
                          Search="@search"
                          IncludeInactive="@includeInactive"
                          ScopeCanManage="@scopeCanManage"
                          PageSizeOptions="@PageSizeOptions"
                          GridStrings="@GridStrings"
                          EditIcon="@EditIcon"
                          DimensionResourceKey="@DimensionResourceKey"
                          FormatConversionFormula="@FormatConversionFormula"
                          OnOpenUnitModal="args => unitModals?.OpenModalAsync(args.Id, args.Edit) ?? Task.CompletedTask"
                          OnOpenConversionModal="args => conversionModals?.OpenModalAsync(args.Id, args.Edit) ?? Task.CompletedTask"
                          OnOpenCurrencyModal="args => OpenCurrencyModal(args.Id, args.Edit)" />
    }
</section>

<UnitModals @ref="unitModals"
            DialogClasses="@DialogClasses"
            CurrentScope="@CurrentScope"
            CurrentOrgId="@CurrentOrgId"
            ScopeCanManage="@scopeCanManage"
            AllDimensions="@AllDimensions"
            DimensionResourceKey="@DimensionResourceKey"
            OnPageNotice="n => pageNotice = n"
            OnPageError="e => pageError = e"
            OnChanged="OnUnitsChangedAsync" />

<UnitConversionModals @ref="conversionModals"
                      DialogClasses="@DialogClasses"
                      CurrentScope="@CurrentScope"
                      CurrentOrgId="@CurrentOrgId"
                      ScopeCanManage="@scopeCanManage"
                      ActiveUnits="@activeUnits"
                      FormatUnitOption="@FormatUnitOption"
                      FormatConversionFormula="@FormatConversionFormula"
                      OnPageNotice="n => pageNotice = n"
                      OnPageError="e => pageError = e"
                      OnChanged="RefreshActiveGridAsync" />

<CurrencyEditModal
    DialogClasses="@DialogClasses"
    @bind-CurrencyModalOpen="currencyModalOpen"
    OnCurrencyModalDismissing="OnCurrencyModalDismissing"
    CurrencyEditMode="@currencyEditMode"
    SelectedCurrency="@selectedCurrency"
    @bind-EditCurrencyName="editCurrencyName"
    @bind-EditCurrencySymbol="editCurrencySymbol"
    @bind-EditCurrencyPrecision="editCurrencyPrecision"
    CurrencySaving="@currencySaving"
    CurrencySaved="@currencySaved"
    CurrencyEditDirty="@CurrencyEditDirty"
    CurrencyError="@currencyError"
    @bind-CurrencyDiscardConfirm="currencyDiscardConfirm"
    OnConfirmCurrencyDiscard="ConfirmCurrencyDiscard"
    @bind-CurrencyConfirmToggle="currencyConfirmToggle"
    OnSubmitCurrencyUpdate="SubmitCurrencyUpdateAsync"
    OnExecuteCurrencyToggle="ExecuteCurrencyToggleAsync"
    OnReloadSelectedCurrency="ReloadSelectedCurrencyAsync" />

@using ForgeFlow.Web.Components.Pages.UnitSections
<UnitCreateCurrencyAndConverterDialogs
    DialogClasses="@DialogClasses"
    @bind-CreateCurrencyOpen="createCurrencyOpen"
    OnCreateCurrencyDismissing="OnCreateCurrencyDismissing"
    @bind-CreateCurrencyCode="createCurrencyCode"
    @bind-CreateCurrencyName="createCurrencyName"
    @bind-CreateCurrencySymbol="createCurrencySymbol"
    @bind-CreateCurrencyPrecision="createCurrencyPrecision"
    @bind-CreateCurrencyDiscardConfirm="createCurrencyDiscardConfirm"
    OnConfirmCreateCurrencyDiscard="ConfirmCreateCurrencyDiscard"
    OnSubmitCreateCurrency="SubmitCreateCurrencyAsync"
    CurrencySaving="@currencySaving"
    CurrencyError="@currencyError"
    @bind-ConverterOpen="converterOpen"
    @bind-CalcQuantityText="calcQuantityText"
    @bind-CalcFromUnitId="calcFromUnitId"
    @bind-CalcToUnitId="calcToUnitId"
    ActiveUnits="@activeUnits"
    FormatUnitOption="@FormatUnitOption"
    Calculating="@calculating"
    OnCalculateConversion="CalculateConversionAsync"
    CalcError="@calcError"
    CalcResult="@calcResult"
    FormattedEquation="@(calcResult is not null ? FormatCalculatedEquation() : string.Empty)" />

@code {
    [Parameter] public long? OrganizationId { get; set; }

    private const byte TabUnits = 0;
    private const byte TabConversions = 1;
    private const byte TabCurrencies = 2;
    private static readonly int[] PageSizeOptions = [10, 25, 50, 100];
    private static readonly UnitDimension[] AllDimensions = Enum.GetValues<UnitDimension>();
    private static readonly BitIconInfo EditIcon = BitIconInfo.Css("ff-icon ff-icon--edit");
    private static readonly BitDialogClassStyles DialogClasses = new()
    {
        Container = "read-dialog",
        Header = "read-dialog-header",
        Body = "read-dialog-body",
        CloseButton = "read-dialog-close",
        Overlay = "read-dialog-overlay"
    };

    private UnitGridsSection? gridsSection;
    private UnitModals? unitModals;
    private UnitConversionModals? conversionModals;
    private IReadOnlyList<OrganizationScope> available = [];
    private IReadOnlyDictionary<OrganizationScope, ForgeFlow.Web.Organizations.ScopeDisplayInfo> scopeLabels =
        new Dictionary<OrganizationScope, ForgeFlow.Web.Organizations.ScopeDisplayInfo>();
    private List<UnitSummary> activeUnits = [];
    private int scopeIndex;
    private byte activeTab = TabUnits;
    private bool scopeCanManage;
    private bool initialLoading = true;
    private bool seeding;
    private string? pageError;
    private string? pageNotice;

    private string dimensionFilter = string.Empty;
    private string conversionUnitFilter = string.Empty;
    private string search = string.Empty;
    private bool includeInactive;

    private bool currencyModalOpen;
    private bool currencyEditMode;
    private bool currencySaving;
    private bool currencySaved;
    private bool currencyDiscardConfirm;
    private bool? currencyConfirmToggle;
    private string? currencyError;
    private CurrencySummary? selectedCurrency;
    private string editCurrencyName = string.Empty;
    private string editCurrencySymbol = string.Empty;
    private byte editCurrencyPrecision;

    private bool createCurrencyOpen;
    private bool createCurrencyDiscardConfirm;
    private string createCurrencyCode = string.Empty;
    private string createCurrencyName = string.Empty;
    private string createCurrencySymbol = string.Empty;
    private byte createCurrencyPrecision = 2;

    private bool converterOpen;
    private bool calculating;
    private long calcFromUnitId;
    private long calcToUnitId;
    private string calcQuantityText = "1";
    private UnitConversionPreviewResult? calcResult;
    private string? calcError;

    private OrganizationScope? CurrentScope => scopeIndex >= 0 && scopeIndex < available.Count ? available[scopeIndex] : null;
    private long CurrentOrgId => CurrentScope switch
    {
        OrganizationScope.Organization o => o.OrganizationId,
        OrganizationScope.Site s => s.OrganizationId,
        _ => 0
    };

    private BitDataGridStrings GridStrings => new()
    {
        GridLabel = Text["Units"],
        EmptyText = Text["ReadEmpty"],
        NoMatchesText = Text["ReadEmpty"],
        LoadingText = Text["ReadLoading"],
        PagerRangeFormat = Text["GridPagerRange"],
        PagerPageFormat = Text["GridPagerPage"],
        PerPageFormat = Text["GridPerPage"],
        RowsPerPageLabel = Text["GridRowsPerPage"],
        FirstPageLabel = Text["GridFirstPage"],
        PreviousPageLabel = Text["GridPreviousPage"],
        NextPageLabel = Text["GridNextPage"],
        LastPageLabel = Text["GridLastPage"],
        AnnouncementPage = Text["GridPagerPage"]
    };

    private bool CurrencyEditDirty => selectedCurrency is not null && selectedCurrency.IsActive
        && (editCurrencyName.Trim() != selectedCurrency.Name
            || editCurrencySymbol.Trim() != selectedCurrency.Symbol
            || editCurrencyPrecision != selectedCurrency.PrecisionScale);

    protected override async Task OnParametersSetAsync() => await LoadAllAsync();

    private async Task LoadAllAsync()
    {
        initialLoading = true;
        pageError = null;
        pageNotice = null;
        try
        {
            available = await Scopes.LoadUnitScopesAsync();
            scopeLabels = await Scopes.LoadDisplayInfoAsync(available);
        }
        catch when (OrganizationId is long requestedOrgId)
        {
            available = [new OrganizationScope.Organization(requestedOrgId)];
        }
        catch
        {
            pageError = "ReadError";
            initialLoading = false;
            return;
        }

        if (available.Count == 0)
        {
            if (OrganizationId is long requestedOrgId)
            {
                available = [new OrganizationScope.Organization(requestedOrgId)];
                scopeIndex = 0;
            }
            else
            {
                pageError = "ReadDenied";
                initialLoading = false;
                return;
            }
        }
        else if (OrganizationId is long orgId)
        {
            var matchIdx = -1;
            for (var i = 0; i < available.Count; i++)
            {
                var scopeOrg = available[i] switch
                {
                    OrganizationScope.Organization o => o.OrganizationId,
                    OrganizationScope.Site s => s.OrganizationId,
                    _ => 0
                };
                if (scopeOrg == orgId)
                {
                    matchIdx = i;
                    break;
                }
            }
            if (matchIdx >= 0) scopeIndex = matchIdx;
            else
            {
                available = [new OrganizationScope.Organization(orgId)];
                scopeIndex = 0;
            }
        }
        else
        {
            scopeIndex = Math.Clamp(scopeIndex, 0, available.Count - 1);
        }

        await RefreshScopePermissionsAndUnitsAsync();
        initialLoading = false;
    }

    private async Task RefreshScopePermissionsAndUnitsAsync()
    {
        scopeCanManage = false;
        activeUnits = [];
        if (CurrentScope is null || CurrentOrgId <= 0) return;

        var actor = await Actors.ResolveAsync(default);
        if (actor is not null && CurrentScope is OrganizationScope.Organization orgScope)
            scopeCanManage = (await Permissions.EvaluateAsync(actor, orgScope, UnitPermissions.UnitsManage, default)).IsAllowed;

        var probe = await UnitService.ListUnits(CurrentScope, CurrentOrgId, new UnitListQuery(null, null, false, 1, 1));
        if (!probe.Succeeded)
        {
            pageError = RolePermissionLocalization.FailureKey(probe.Error!.Code);
            return;
        }

        var activeRes = await UnitService.ListActiveUnits(CurrentScope, CurrentOrgId);
        if (activeRes.Succeeded && activeRes.Value is not null)
        {
            activeUnits = activeRes.Value.ToList();
            if (activeUnits.Count >= 2)
            {
                if (calcFromUnitId == 0 || activeUnits.All(u => u.Id != calcFromUnitId)) calcFromUnitId = activeUnits[0].Id;
                if (calcToUnitId == 0 || activeUnits.All(u => u.Id != calcToUnitId)) calcToUnitId = activeUnits[1].Id;
            }
            else if (activeUnits.Count == 1)
            {
                calcFromUnitId = calcToUnitId = activeUnits[0].Id;
            }
        }
    }

    private async Task ReloadScopeAsync() => await LoadAllAsync();

    private async Task ChangeScopeAsync(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), NumberStyles.Integer, CultureInfo.InvariantCulture, out var idx) && idx >= 0 && idx < available.Count)
        {
            scopeIndex = idx;
            pageError = null;
            pageNotice = null;
            await RefreshScopePermissionsAndUnitsAsync();
            await RefreshActiveGridAsync();
        }
    }

    private async Task SwitchTabAsync(byte tab)
    {
        if (activeTab == tab) return;
        activeTab = tab;
        pageNotice = null;
        await RefreshActiveGridAsync();
    }

    private async Task ChangeDimensionAsync(ChangeEventArgs e)
    {
        dimensionFilter = e.Value?.ToString() ?? string.Empty;
        await RefreshActiveGridAsync();
    }

    private async Task ChangeConversionUnitFilterAsync(ChangeEventArgs e)
    {
        conversionUnitFilter = e.Value?.ToString() ?? string.Empty;
        await RefreshActiveGridAsync();
    }

    private Task ApplySearchAsync() => RefreshActiveGridAsync();

    private Task RefreshActiveGridAsync() => gridsSection?.RefreshActiveGridAsync() ?? Task.CompletedTask;

    private async Task OnUnitsChangedAsync()
    {
        await RefreshScopePermissionsAndUnitsAsync();
        await RefreshActiveGridAsync();
    }

    private void OpenActiveCreate()
    {
        if (activeTab == TabUnits) unitModals?.OpenCreate();
        else if (activeTab == TabConversions) conversionModals?.OpenCreate();
        else OpenCreateCurrency();
    }

    private void OpenCreateCurrency()
    {
        createCurrencyCode = string.Empty;
        createCurrencyName = string.Empty;
        createCurrencySymbol = string.Empty;
        createCurrencyPrecision = 2;
        currencyError = null;
        createCurrencyDiscardConfirm = false;
        createCurrencyOpen = true;
    }

    private async Task OpenCurrencyModal(long id, bool edit)
    {
        if (CurrentScope is null || CurrentOrgId <= 0) return;
        currencySaving = false;
        currencySaved = false;
        currencyDiscardConfirm = false;
        currencyConfirmToggle = null;
        currencyError = null;

        var res = await UnitService.GetCurrency(CurrentScope, CurrentOrgId, id);
        if (!res.Succeeded || res.Value is null)
        {
            pageNotice = null;
            pageError = res.Succeeded ? "ReadNotFound" : RolePermissionLocalization.FailureKey(res.Error!.Code);
            return;
        }

        ApplySelectedCurrency(res.Value);
        currencyEditMode = edit && scopeCanManage;
        currencyModalOpen = true;
    }

    private void ApplySelectedCurrency(CurrencySummary cur)
    {
        selectedCurrency = cur;
        editCurrencyName = cur.Name;
        editCurrencySymbol = cur.Symbol;
        editCurrencyPrecision = cur.PrecisionScale;
    }

    private async Task SubmitCreateCurrencyAsync()
    {
        if (CurrentScope is null || CurrentOrgId <= 0 || currencySaving) return;
        currencySaving = true;
        currencyError = null;
        try
        {
            var res = await UnitService.CreateCurrency(CurrentScope, new CreateCurrencyRequest(
                CurrentOrgId, createCurrencyCode, createCurrencyName, createCurrencySymbol, createCurrencyPrecision));
            if (!res.Succeeded || res.Value is null)
            {
                currencyError = RolePermissionLocalization.FailureKey(res.Error!.Code);
                return;
            }
            createCurrencyOpen = false;
            pageNotice = Text["WriteSaved"];
            await RefreshActiveGridAsync();
        }
        finally
        {
            currencySaving = false;
        }
    }

    private async Task SubmitCurrencyUpdateAsync()
    {
        if (CurrentScope is null || selectedCurrency is null || currencySaving) return;
        currencySaving = true;
        currencySaved = false;
        currencyError = null;
        try
        {
            var res = await UnitService.UpdateCurrency(CurrentScope, new UpdateCurrencyRequest(
                selectedCurrency.OrganizationId, selectedCurrency.Id, editCurrencyName, editCurrencySymbol, editCurrencyPrecision, selectedCurrency.RowVersion));
            if (!res.Succeeded || res.Value is null)
            {
                currencyError = RolePermissionLocalization.FailureKey(res.Error!.Code);
                return;
            }
            ApplySelectedCurrency(res.Value);
            currencySaved = true;
            await RefreshActiveGridAsync();
        }
        finally
        {
            currencySaving = false;
        }
    }

    private async Task ExecuteCurrencyToggleAsync()
    {
        if (CurrentScope is null || selectedCurrency is null || currencyConfirmToggle is not bool target || currencySaving) return;
        currencySaving = true;
        currencySaved = false;
        currencyError = null;
        try
        {
            var res = await UnitService.SetCurrencyActive(CurrentScope, new SetCurrencyActiveRequest(
                selectedCurrency.OrganizationId, selectedCurrency.Id, target, selectedCurrency.RowVersion));
            if (!res.Succeeded || res.Value is null)
            {
                currencyConfirmToggle = null;
                currencyError = RolePermissionLocalization.FailureKey(res.Error!.Code);
                return;
            }
            ApplySelectedCurrency(res.Value);
            currencyConfirmToggle = null;
            currencySaved = true;
            await RefreshActiveGridAsync();
        }
        finally
        {
            currencySaving = false;
        }
    }

    private async Task ReloadSelectedCurrencyAsync()
    {
        if (CurrentScope is null || selectedCurrency is null) return;
        await OpenCurrencyModal(selectedCurrency.Id, currencyEditMode);
    }

    private void OnCurrencyModalDismissing(BitDialogDismissArgs args)
    {
        if (!currencyEditMode || !CurrencyEditDirty || currencySaving) return;
        args.Cancel = true;
        currencyDiscardConfirm = true;
    }

    private void ConfirmCurrencyDiscard()
    {
        currencyDiscardConfirm = false;
        currencyModalOpen = false;
    }

    private void OnCreateCurrencyDismissing(BitDialogDismissArgs args)
    {
        if (currencySaving) return;
        if (string.IsNullOrWhiteSpace(createCurrencyCode) && string.IsNullOrWhiteSpace(createCurrencyName) && string.IsNullOrWhiteSpace(createCurrencySymbol))
            return;
        args.Cancel = true;
        createCurrencyDiscardConfirm = true;
    }

    private void ConfirmCreateCurrencyDiscard()
    {
        createCurrencyDiscardConfirm = false;
        createCurrencyOpen = false;
    }

    private void OpenConverter()
    {
        calcError = null;
        calcResult = null;
        if (activeUnits.Count >= 2 && calcFromUnitId == calcToUnitId)
        {
            calcFromUnitId = activeUnits[0].Id;
            calcToUnitId = activeUnits[1].Id;
        }
        converterOpen = true;
    }

    private async Task SeedStandardUnitsAsync()
    {
        if (CurrentScope is null || CurrentOrgId <= 0 || seeding || !scopeCanManage) return;
        seeding = true;
        pageNotice = null;
        pageError = null;
        try
        {
            var res = await UnitService.SeedStandardUnits(CurrentScope, CurrentOrgId);
            if (!res.Succeeded || res.Value is null)
            {
                pageError = RolePermissionLocalization.FailureKey(res.Error!.Code);
                return;
            }
            pageNotice = Text["UnitsSeededNotice", res.Value.UnitsCreated, res.Value.ConversionsCreated];
            await RefreshScopePermissionsAndUnitsAsync();
            await RefreshActiveGridAsync();
        }
        finally
        {
            seeding = false;
        }
    }

    private async Task CalculateConversionAsync()
    {
        if (CurrentScope is null || CurrentOrgId <= 0 || calculating) return;
        calcError = null;
        calcResult = null;
        if (!TryParseFactor(calcQuantityText, out var qty))
        {
            calcError = RolePermissionLocalization.FailureKey(UnitErrors.ConversionQuantityInvalid);
            return;
        }
        calculating = true;
        try
        {
            var res = await UnitService.PreviewConversion(CurrentScope, new ConvertQuantityRequest(
                CurrentOrgId, calcFromUnitId, calcToUnitId, qty));
            if (!res.Succeeded || res.Value is null)
            {
                calcError = RolePermissionLocalization.FailureKey(res.Error!.Code);
                return;
            }
            calcResult = res.Value;
        }
        finally
        {
            calculating = false;
        }
    }

    private string FormatCalculatedEquation()
    {
        if (calcResult is null) return string.Empty;
        var fromSym = activeUnits.FirstOrDefault(u => u.Id == calcResult.FromUnitId)?.Symbol ?? "#";
        var toSym = activeUnits.FirstOrDefault(u => u.Id == calcResult.ToUnitId)?.Symbol ?? "#";
        return $"{calcResult.InputQuantity.ToString("0.######", CultureInfo.InvariantCulture)} {fromSym} = {calcResult.ConvertedQuantity.ToString("0.######", CultureInfo.InvariantCulture)} {toSym}";
    }

    private static string FormatConversionFormula(UnitConversionSummary row)
        => $"1 {row.FromUnitSymbol} = {row.Factor.ToString("0.######", CultureInfo.InvariantCulture)} {row.ToUnitSymbol}";

    private static string FormatUnitOption(UnitSummary u) => $"{u.Code} — {u.Name} ({u.Symbol})";

    private static bool TryParseFactor(string? raw, out decimal value)
        => decimal.TryParse(raw?.Trim(), NumberStyles.Number, CultureInfo.InvariantCulture, out value) && value > 0m;

    private static string DimensionResourceKey(UnitDimension dimension) => dimension switch
    {
        UnitDimension.Mass => "UnitDimensionMass",
        UnitDimension.Volume => "UnitDimensionVolume",
        UnitDimension.Length => "UnitDimensionLength",
        UnitDimension.Area => "UnitDimensionArea",
        UnitDimension.Count => "UnitDimensionCount",
        UnitDimension.Time => "UnitDimensionTime",
        _ => "UnitDimensionMass"
    };

    private string ScopeLabel(OrganizationScope scope) => scope switch
    {
        OrganizationScope.Organization o when scopeLabels.TryGetValue(scope, out var info) && info.OrgCode is not null
            => $"{info.OrgCode} — {info.OrgName}",
        OrganizationScope.Organization o => Text["ReadOrganizationScope", o.OrganizationId],
        OrganizationScope.Site s when scopeLabels.TryGetValue(scope, out var info) && info.SiteCode is not null
            => $"{info.OrgCode} / {info.SiteCode} — {info.SiteName}",
        OrganizationScope.Site s => Text["ReadSiteScope", s.OrganizationId, s.SiteId],
        _ => string.Empty
    };
}
