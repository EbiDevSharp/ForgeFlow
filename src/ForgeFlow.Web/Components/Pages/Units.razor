    private string? TryFormatDraftFormula()
    {
        var from = activeUnits.FirstOrDefault(u => u.Id == createFromUnitId);
        var to = activeUnits.FirstOrDefault(u => u.Id == createToUnitId);
        if (from is null || to is null || !TryParseFactor(createConversionFactorText, out var factor)) return null;
        return $"1 {from.Symbol} = {factor.ToString("0.######", CultureInfo.InvariantCulture)} {to.Symbol}";
    }

    private string FormatCalculatedEquation()
    {
        if (calcResult is null) return string.Empty;
        var fromSym = activeUnits.FirstOrDefault(u => u.Id == calcResult.FromUnitId)?.Symbol ?? "#";
        var toSym = activeUnits.FirstOrDefault(u => u.Id == calcResult.ToUnitId)?.Symbol ?? "#";
        return $"{calcResult.InputQuantity.ToString("0.######", CultureInfo.InvariantCulture)} {fromSym} = {calcResult.ConvertedQuantity.ToString("0.######", CultureInfo.InvariantCulture)} {toSym}";
    }

    private static string FormatConversionFormula(UnitConversionSummary row)
        => $"1 {row.FromUnitSymbol} = {row.Factor.ToString("0.######", CultureInfo.InvariantCulture)} {row.ToUnitSymbol}";

    private static string FormatUnitOption(UnitSummary u) => $"{u.Code} — {u.Name} ({u.Symbol})";

    private static bool TryParseFactor(string? raw, out decimal value)
        => decimal.TryParse(raw?.Trim(), NumberStyles.Number, CultureInfo.InvariantCulture, out value) && value > 0m;

    private static string DimensionResourceKey(UnitDimension dimension) => dimension switch
    {
        UnitDimension.Mass => "UnitDimensionMass",
        UnitDimension.Volume => "UnitDimensionVolume",
        UnitDimension.Length => "UnitDimensionLength",
        UnitDimension.Area => "UnitDimensionArea",
        UnitDimension.Count => "UnitDimensionCount",
        UnitDimension.Time => "UnitDimensionTime",
        _ => "UnitDimensionMass"
    };

    private string ScopeLabel(OrganizationScope scope) => scope switch
    {
        OrganizationScope.Organization o when scopeLabels.TryGetValue(scope, out var info) && info.OrgCode is not null
            => $"{info.OrgCode} — {info.OrgName}",
        OrganizationScope.Organization o => Text["ReadOrganizationScope", o.OrganizationId],
        OrganizationScope.Site s when scopeLabels.TryGetValue(scope, out var info) && info.SiteCode is not null
            => $"{info.OrgCode} / {info.SiteCode} — {info.SiteName}",
        OrganizationScope.Site s => Text["ReadSiteScope", s.OrganizationId, s.SiteId],
        _ => string.Empty
    };
