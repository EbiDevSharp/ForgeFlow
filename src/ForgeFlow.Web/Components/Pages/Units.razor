@code {
    [Parameter] public long? OrganizationId { get; set; }

    private const byte TabUnits = 0;
    private const byte TabConversions = 1;
    private const byte TabCurrencies = 2;
    private static readonly int[] PageSizeOptions = [10, 25, 50, 100];
    private static readonly UnitDimension[] AllDimensions = Enum.GetValues<UnitDimension>();
    private static readonly BitIconInfo EditIcon = BitIconInfo.Css("ff-icon ff-icon--edit");
    private static readonly BitDialogClassStyles DialogClasses = new()
    {
        Container = "read-dialog",
        Header = "read-dialog-header",
        Body = "read-dialog-body",
        CloseButton = "read-dialog-close",
        Overlay = "read-dialog-overlay"
    };

    private BitDataGrid<UnitSummary>? unitsGrid;
    private BitDataGrid<UnitConversionSummary>? conversionsGrid;
    private BitDataGrid<CurrencySummary>? currenciesGrid;
    private IReadOnlyList<OrganizationScope> available = [];
    private IReadOnlyDictionary<OrganizationScope, ForgeFlow.Web.Organizations.ScopeDisplayInfo> scopeLabels =
        new Dictionary<OrganizationScope, ForgeFlow.Web.Organizations.ScopeDisplayInfo>();
    private List<UnitSummary> activeUnits = [];
    private int scopeIndex;
    private byte activeTab = TabUnits;
    private bool scopeCanManage;
    private bool initialLoading = true;
    private bool seeding;
    private string? pageError;
    private string? pageNotice;

    private string dimensionFilter = string.Empty;
    private string conversionUnitFilter = string.Empty;
    private string search = string.Empty;
    private bool includeInactive;

    private bool unitModalOpen;
    private bool unitEditMode;
    private bool unitSaving;
    private bool unitSaved;
    private bool unitDiscardConfirm;
    private bool? unitConfirmToggle;
    private string? unitError;
    private UnitSummary? selectedUnit;
    private string editUnitName = string.Empty;
    private string editUnitSymbol = string.Empty;
    private byte editUnitPrecision;

    private bool createUnitOpen;
    private bool createUnitDiscardConfirm;
    private string createUnitCode = string.Empty;
    private string createUnitName = string.Empty;
    private string createUnitSymbol = string.Empty;
    private UnitDimension createUnitDimension = UnitDimension.Mass;
    private byte createUnitPrecision = 3;

    private bool conversionModalOpen;
    private bool conversionEditMode;
    private bool conversionSaving;
    private bool conversionSaved;
    private bool conversionDiscardConfirm;
    private bool? conversionConfirmToggle;
    private string? conversionError;
    private UnitConversionSummary? selectedConversion;
    private string editConversionFactorText = string.Empty;

    private bool createConversionOpen;
    private bool createConversionDiscardConfirm;
    private long createFromUnitId;
    private long createToUnitId;
    private string createConversionFactorText = "1";

    private bool currencyModalOpen;
    private bool currencyEditMode;
    private bool currencySaving;
    private bool currencySaved;
    private bool currencyDiscardConfirm;
    private bool? currencyConfirmToggle;
    private string? currencyError;
    private CurrencySummary? selectedCurrency;
    private string editCurrencyName = string.Empty;
    private string editCurrencySymbol = string.Empty;
    private byte editCurrencyPrecision;

    private bool createCurrencyOpen;
    private bool createCurrencyDiscardConfirm;
    private string createCurrencyCode = string.Empty;
    private string createCurrencyName = string.Empty;
    private string createCurrencySymbol = string.Empty;
    private byte createCurrencyPrecision = 2;

    private bool converterOpen;
    private bool calculating;
    private long calcFromUnitId;
    private long calcToUnitId;
    private string calcQuantityText = "1";
    private UnitConversionPreviewResult? calcResult;
    private string? calcError;

    private OrganizationScope? CurrentScope => scopeIndex >= 0 && scopeIndex < available.Count ? available[scopeIndex] : null;
    private long CurrentOrgId => CurrentScope switch
    {
        OrganizationScope.Organization o => o.OrganizationId,
        OrganizationScope.Site s => s.OrganizationId,
        _ => 0
    };

    private BitDataGridStrings GridStrings => new()
    {
        GridLabel = Text["Units"],
        EmptyText = Text["ReadEmpty"],
        NoMatchesText = Text["ReadEmpty"],
        LoadingText = Text["ReadLoading"],
        PagerRangeFormat = Text["GridPagerRange"],
        PagerPageFormat = Text["GridPagerPage"],
        PerPageFormat = Text["GridPerPage"],
        RowsPerPageLabel = Text["GridRowsPerPage"],
        FirstPageLabel = Text["GridFirstPage"],
        PreviousPageLabel = Text["GridPreviousPage"],
        NextPageLabel = Text["GridNextPage"],
        LastPageLabel = Text["GridLastPage"],
        AnnouncementPage = Text["GridPagerPage"]
    };

    private bool UnitEditDirty => selectedUnit is not null && selectedUnit.IsActive
        && (editUnitName.Trim() != selectedUnit.Name
            || editUnitSymbol.Trim() != selectedUnit.Symbol
            || editUnitPrecision != selectedUnit.PrecisionScale);

    private bool ConversionEditDirty => selectedConversion is not null && selectedConversion.IsActive
        && TryParseFactor(editConversionFactorText, out var parsed)
        && parsed != selectedConversion.Factor;

    private bool CurrencyEditDirty => selectedCurrency is not null && selectedCurrency.IsActive
        && (editCurrencyName.Trim() != selectedCurrency.Name
            || editCurrencySymbol.Trim() != selectedCurrency.Symbol
            || editCurrencyPrecision != selectedCurrency.PrecisionScale);

    protected override async Task OnParametersSetAsync() => await LoadAllAsync();

    private async Task LoadAllAsync()
    {
        initialLoading = true;
        pageError = null;
        pageNotice = null;
        try
        {
            available = await Scopes.LoadUnitScopesAsync();
            scopeLabels = await Scopes.LoadDisplayInfoAsync(available);
        }
        catch when (OrganizationId is long requestedOrgId)
        {
            available = [new OrganizationScope.Organization(requestedOrgId)];
        }
        catch
        {
            pageError = "ReadError";
            initialLoading = false;
            return;
        }

        if (available.Count == 0)
        {
            if (OrganizationId is long requestedOrgId)
            {
                available = [new OrganizationScope.Organization(requestedOrgId)];
                scopeIndex = 0;
            }
            else
            {
                pageError = "ReadDenied";
                initialLoading = false;
                return;
            }
        }
        else if (OrganizationId is long orgId)
        {
            var matchIdx = -1;
            for (var i = 0; i < available.Count; i++)
            {
                var scopeOrg = available[i] switch
                {
                    OrganizationScope.Organization o => o.OrganizationId,
                    OrganizationScope.Site s => s.OrganizationId,
                    _ => 0
                };
                if (scopeOrg == orgId)
                {
                    matchIdx = i;
                    break;
                }
            }
            if (matchIdx >= 0) scopeIndex = matchIdx;
            else
            {
                available = [new OrganizationScope.Organization(orgId)];
                scopeIndex = 0;
            }
        }
        else
        {
            scopeIndex = Math.Clamp(scopeIndex, 0, available.Count - 1);
        }

        await RefreshScopePermissionsAndUnitsAsync();
        initialLoading = false;
    }

    private async Task RefreshScopePermissionsAndUnitsAsync()
    {
        scopeCanManage = false;
        activeUnits = [];
        if (CurrentScope is null || CurrentOrgId <= 0) return;

        var actor = await Actors.ResolveAsync(default);
        if (actor is not null && CurrentScope is OrganizationScope.Organization orgScope)
            scopeCanManage = (await Permissions.EvaluateAsync(actor, orgScope, UnitPermissions.UnitsManage, default)).IsAllowed;

        var probe = await UnitService.ListUnits(CurrentScope, CurrentOrgId, new UnitListQuery(null, null, false, 1, 1));
        if (!probe.Succeeded)
        {
            pageError = RolePermissionLocalization.FailureKey(probe.Error!.Code);
            return;
        }

        var activeRes = await UnitService.ListActiveUnits(CurrentScope, CurrentOrgId);
        if (activeRes.Succeeded && activeRes.Value is not null)
        {
            activeUnits = activeRes.Value.ToList();
            if (activeUnits.Count >= 2)
            {
                if (createFromUnitId == 0 || activeUnits.All(u => u.Id != createFromUnitId)) createFromUnitId = activeUnits[0].Id;
                if (createToUnitId == 0 || activeUnits.All(u => u.Id != createToUnitId)) createToUnitId = activeUnits[1].Id;
                if (calcFromUnitId == 0 || activeUnits.All(u => u.Id != calcFromUnitId)) calcFromUnitId = activeUnits[0].Id;
                if (calcToUnitId == 0 || activeUnits.All(u => u.Id != calcToUnitId)) calcToUnitId = activeUnits[1].Id;
            }
            else if (activeUnits.Count == 1)
            {
                createFromUnitId = createToUnitId = calcFromUnitId = calcToUnitId = activeUnits[0].Id;
            }
        }
    }

    private async Task ReloadScopeAsync() => await LoadAllAsync();

    private async Task ChangeScopeAsync(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), NumberStyles.Integer, CultureInfo.InvariantCulture, out var idx) && idx >= 0 && idx < available.Count)
        {
            scopeIndex = idx;
            pageError = null;
            pageNotice = null;
