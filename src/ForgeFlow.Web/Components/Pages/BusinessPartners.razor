    private async Task OpenEditModal(BusinessPartnerSummary p)
    {
        modalError = null;
        var detailRes = await BpService.Get(CurrentScope, CurrentOrgId, p.Id);
        if (!detailRes.Succeeded || detailRes.Value is null)
        {
            pageNotice = Text["ReadError"];
            return;
        }

        var d = detailRes.Value;
        editingPartnerId = d.Id;
        editingRowVersion = d.RowVersion;
        formCode = d.Code;
        formPersonType = d.PersonType;
        roleSupplier = d.Roles.Any(r => r.Id == 1);
        roleCustomer = d.Roles.Any(r => r.Id == 2);
        roleContractor = d.Roles.Any(r => r.Id == 3);
        formFirstName = d.FirstName ?? string.Empty;
        formLastName = d.LastName ?? string.Empty;
        formCompanyName = d.CompanyName ?? (d.PersonType == PersonType.Legal ? d.Name : string.Empty);
        formNationalCode = d.NationalCode ?? string.Empty;
        formNationalLegalId = d.NationalLegalId ?? string.Empty;
        formEconomicCode = d.EconomicCode ?? string.Empty;
        formMobile = d.Mobile ?? string.Empty;
        formPhone = d.Phone ?? string.Empty;
        formEmail = d.Email ?? string.Empty;
        formWebsite = d.Website ?? string.Empty;
        formCountry = string.IsNullOrWhiteSpace(d.Country) ? "ایران" : d.Country;
        formProvince = d.Province ?? string.Empty;
        formCity = d.City ?? string.Empty;
        formAddress = d.Address ?? string.Empty;

        cities.Clear();
        selectedProvinceId = null;
        if (!string.IsNullOrWhiteSpace(formProvince))
        {
            var match = provinces.FirstOrDefault(prov => prov.Name == formProvince);
            if (match is not null)
            {
                selectedProvinceId = match.Id;
                cities = (await BpService.ListCities(match.Id)).ToList();
            }
        }

        formModalOpen = true;
    }

    private async Task SavePartnerAsync()
    {
        var roleIds = new List<int>();
        if (roleSupplier) roleIds.Add(1);
        if (roleCustomer) roleIds.Add(2);
        if (roleContractor) roleIds.Add(3);

        if (roleIds.Count == 0)
        {
            modalError = Text["BpRoleRequired"];
            return;
        }

        // Validate names
        string resolvedName;
        if (formPersonType == PersonType.Natural)
        {
            formFirstName = formFirstName?.Trim() ?? string.Empty;
            formLastName = formLastName?.Trim() ?? string.Empty;
            if (string.IsNullOrWhiteSpace(formFirstName) || string.IsNullOrWhiteSpace(formLastName))
            {
                modalError = Text["BpFirstLastNameRequired"];
                return;
            }
            resolvedName = $"{formFirstName} {formLastName}".Trim();
        }
        else
        {
            formCompanyName = formCompanyName?.Trim() ?? string.Empty;
            if (string.IsNullOrWhiteSpace(formCompanyName))
            {
                modalError = Text["BpCompanyNameRequired"];
                return;
            }
            resolvedName = formCompanyName;
        }

        // Validate formats
        var normNatCode = BusinessPartnerText.NormalizeDigits(formNationalCode);
        if (formPersonType == PersonType.Natural && !string.IsNullOrWhiteSpace(normNatCode))
        {
            if (normNatCode.Length != 10 || !normNatCode.All(char.IsDigit))
            {
                modalError = Text["BpNationalCodeLengthError"];
                return;
            }
        }

        var normNatLegalId = BusinessPartnerText.NormalizeDigits(formNationalLegalId);
        if (formPersonType == PersonType.Legal && !string.IsNullOrWhiteSpace(normNatLegalId))
        {
            if (!normNatLegalId.All(char.IsDigit))
            {
                modalError = Text["BpNationalLegalIdFormatError"];
                return;
            }
        }

        var normEcon = BusinessPartnerText.NormalizeDigits(formEconomicCode);
        if (!string.IsNullOrWhiteSpace(normEcon) && !normEcon.All(char.IsDigit))
        {
            modalError = Text["BpEconomicCodeFormatError"];
            return;
        }

        var normMobile = BusinessPartnerText.NormalizeDigits(formMobile);
        if (!string.IsNullOrWhiteSpace(normMobile))
        {
            if (normMobile.Length != 11 || !normMobile.StartsWith("09", StringComparison.Ordinal) || !normMobile.All(char.IsDigit))
            {
                modalError = Text["BpMobileFormatError"];
                return;
            }
        }

        var normPhone = BusinessPartnerText.NormalizeDigits(formPhone);
        if (!string.IsNullOrWhiteSpace(normPhone))
        {
            if (!normPhone.StartsWith("0", StringComparison.Ordinal) || !normPhone.All(char.IsDigit))
            {
                modalError = Text["BpPhoneFormatError"];
                return;
            }
        }

        saving = true;
        modalError = null;
        try
        {
            if (editingPartnerId.HasValue)
            {
                var updateReq = new UpdateBusinessPartnerRequest(
                    formPersonType,
                    resolvedName,
                    string.IsNullOrWhiteSpace(formFirstName) ? null : formFirstName.Trim(),
                    string.IsNullOrWhiteSpace(formLastName) ? null : formLastName.Trim(),
                    string.IsNullOrWhiteSpace(normNatCode) ? null : normNatCode,
                    formPersonType == PersonType.Legal ? formCompanyName : null,
                    formPersonType == PersonType.Legal ? (string.IsNullOrWhiteSpace(normNatLegalId) ? null : normNatLegalId) : null,
                    string.IsNullOrWhiteSpace(normEcon) ? null : normEcon,
                    string.IsNullOrWhiteSpace(normMobile) ? null : normMobile,
                    string.IsNullOrWhiteSpace(normPhone) ? null : normPhone,
                    string.IsNullOrWhiteSpace(formEmail) ? null : formEmail.Trim(),
                    string.IsNullOrWhiteSpace(formWebsite) ? null : formWebsite.Trim(),
                    string.IsNullOrWhiteSpace(formCountry) ? null : formCountry.Trim(),
                    string.IsNullOrWhiteSpace(formProvince) ? null : formProvince.Trim(),
                    string.IsNullOrWhiteSpace(formCity) ? null : formCity.Trim(),
                    string.IsNullOrWhiteSpace(formAddress) ? null : formAddress.Trim(),
                    null,
                    null,
                    roleIds);

                var res = await BpService.Update(CurrentScope, CurrentOrgId, editingPartnerId.Value, editingRowVersion, updateReq);
                if (!res.Succeeded)
                {
                    modalError = MapError(res.Error!.Code);
                    return;
                }
            }
            else
            {
                var createReq = new CreateBusinessPartnerRequest(
                    CurrentOrgId,
                    null, // auto allocate
                    formPersonType,
                    resolvedName,
                    string.IsNullOrWhiteSpace(formFirstName) ? null : formFirstName.Trim(),
                    string.IsNullOrWhiteSpace(formLastName) ? null : formLastName.Trim(),
                    string.IsNullOrWhiteSpace(normNatCode) ? null : normNatCode,
                    formPersonType == PersonType.Legal ? formCompanyName : null,
                    formPersonType == PersonType.Legal ? (string.IsNullOrWhiteSpace(normNatLegalId) ? null : normNatLegalId) : null,
                    string.IsNullOrWhiteSpace(normEcon) ? null : normEcon,
                    string.IsNullOrWhiteSpace(normMobile) ? null : normMobile,
                    string.IsNullOrWhiteSpace(normPhone) ? null : normPhone,
                    string.IsNullOrWhiteSpace(formEmail) ? null : formEmail.Trim(),
                    string.IsNullOrWhiteSpace(formWebsite) ? null : formWebsite.Trim(),
                    string.IsNullOrWhiteSpace(formCountry) ? null : formCountry.Trim(),
                    string.IsNullOrWhiteSpace(formProvince) ? null : formProvince.Trim(),
                    string.IsNullOrWhiteSpace(formCity) ? null : formCity.Trim(),
                    string.IsNullOrWhiteSpace(formAddress) ? null : formAddress.Trim(),
                    null,
                    null,
                    roleIds);

                var res = await BpService.Create(CurrentScope, createReq);
                if (!res.Succeeded)
                {
                    modalError = MapError(res.Error!.Code);
                    return;
                }
            }

            formModalOpen = false;
            pageNotice = Text["WriteSaved"];
            await RefreshGridAsync();
        }
        finally
        {
            saving = false;
        }
    }

    private async Task OpenDetailModal(BusinessPartnerSummary p)
    {
        var res = await BpService.Get(CurrentScope, CurrentOrgId, p.Id);
        if (res.Succeeded)
        {
            detailItem = res.Value;
            detailModalOpen = true;
        }
    }

    private void OpenToggleActiveConfirm(BusinessPartnerSummary p)
    {
        targetId = p.Id;
        targetName = p.Name;
        targetVersion = p.RowVersion;
        targetIsActive = p.IsActive;
        confirmToggleOpen = true;
    }

    private async Task ExecuteToggleActiveAsync()
    {
        toggling = true;
        try
        {
            var res = await BpService.SetActive(CurrentScope, CurrentOrgId, targetId, targetVersion, !targetIsActive);
            if (res.Succeeded)
            {
                confirmToggleOpen = false;
                pageNotice = Text["WriteSaved"];
                await RefreshGridAsync();
            }
        }
        finally
        {
            toggling = false;
        }
    }

    private string RoleName(int id) => id switch
    {
        1 => Text["BpRoleSupplier"],
        2 => Text["BpRoleCustomer"],
        3 => Text["BpRoleContractor"],
        _ => id.ToString()
    };

    private static string GetRoleBadgeClass(int roleId) => roleId switch
    {
        1 => "bp-role-badge--supplier",
        2 => "bp-role-badge--customer",
        3 => "bp-role-badge--contractor",
        _ => string.Empty
    };

    private static string FilterDigitsOnly(string? val, int maxLen)
    {
        if (string.IsNullOrEmpty(val)) return string.Empty;
        var norm = BusinessPartnerText.NormalizeDigits(val);
        var sb = new System.Text.StringBuilder();
        foreach (var ch in norm)
        {
            if (char.IsDigit(ch))
            {
                sb.Append(ch);
                if (sb.Length == maxLen) break;
            }
        }
        return sb.ToString();
    }

    private string ScopeLabel(OrganizationScope scope) => scope switch
    {
        OrganizationScope.Organization o => Text["ReadOrganizationScope", o.OrganizationId],
        OrganizationScope.Site s => Text["ReadSiteScope", s.OrganizationId, s.SiteId],
        _ => string.Empty
    };

    private string MapError(string code) => Text[RolePermissionLocalization.FailureKey(code)];
