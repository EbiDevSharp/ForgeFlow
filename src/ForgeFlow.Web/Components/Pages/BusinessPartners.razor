    private void OpenToggleActiveConfirm(BusinessPartnerSummary p)
    {
        targetId = p.Id;
        targetName = p.Name;
        targetVersion = p.RowVersion;
        targetIsActive = p.IsActive;
        confirmToggleOpen = true;
    }

    private async Task ExecuteToggleActiveAsync()
    {
        toggling = true;
        try
        {
            var res = await BpService.SetActive(CurrentScope, CurrentOrgId, targetId, targetVersion, !targetIsActive);
            if (res.Succeeded)
            {
                confirmToggleOpen = false;
                pageNotice = Text["WriteSaved"];
                await RefreshGridAsync();
            }
        }
        finally
        {
            toggling = false;
        }
    }

    private string RoleName(int id) => id switch
    {
        1 => Text["BpRoleSupplier"],
        2 => Text["BpRoleCustomer"],
        3 => Text["BpRoleContractor"],
        _ => id.ToString()
    };

    private string ScopeLabel(OrganizationScope scope) => scope switch
    {
        OrganizationScope.Organization o => Text["ReadOrganizationScope", o.OrganizationId],
        OrganizationScope.Site s => Text["ReadSiteScope", s.OrganizationId, s.SiteId],
        _ => string.Empty
    };

    private string MapError(string code) => code switch
    {
        BusinessPartnerErrors.DuplicateCode => Text["CreateCodeDuplicate"],
        BusinessPartnerErrors.CodeInvalid => Text["CreateCodeInvalid"],
        BusinessPartnerErrors.NameInvalid => Text["WriteNameInvalid"],
        BusinessPartnerErrors.Conflict => Text["WriteConflict"],
        BusinessPartnerErrors.RoleRequired => Text["BpRoleRequired"],
        _ => Text["WriteUnavailable"]
    };
