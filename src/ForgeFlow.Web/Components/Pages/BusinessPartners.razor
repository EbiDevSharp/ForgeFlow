    private async Task OpenEditModal(BusinessPartnerSummary p)
    {
        modalError = null;
        var detailRes = await BpService.Get(CurrentScope, CurrentOrgId, p.Id);
        if (!detailRes.Succeeded || detailRes.Value is null)
        {
            pageNotice = Text["ReadError"];
            return;
        }

        var d = detailRes.Value;
        editingPartnerId = d.Id;
        editingRowVersion = d.RowVersion;
        formCode = d.Code;
        formPersonType = d.PersonType;
        roleSupplier = d.Roles.Any(r => r.Id == 1);
        roleCustomer = d.Roles.Any(r => r.Id == 2);
        roleContractor = d.Roles.Any(r => r.Id == 3);
        formName = d.Name;
        formCompanyName = d.CompanyName ?? string.Empty;
        formNationalCode = d.NationalCode ?? string.Empty;
        formNationalLegalId = d.NationalLegalId ?? string.Empty;
        formEconomicCode = d.EconomicCode ?? string.Empty;
        formMobile = d.Mobile ?? string.Empty;
        formPhone = d.Phone ?? string.Empty;
        formEmail = d.Email ?? string.Empty;
        formWebsite = d.Website ?? string.Empty;
        formCountry = d.Country ?? string.Empty;
        formProvince = d.Province ?? string.Empty;
        formCity = d.City ?? string.Empty;
        formAddress = d.Address ?? string.Empty;
        formModalOpen = true;
    }

    private async Task SavePartnerAsync()
    {
        var roleIds = new List<int>();
        if (roleSupplier) roleIds.Add(1);
        if (roleCustomer) roleIds.Add(2);
        if (roleContractor) roleIds.Add(3);

        if (roleIds.Count == 0)
        {
            modalError = Text["BpRoleRequired"];
            return;
        }

        saving = true;
        modalError = null;
        try
        {
            if (editingPartnerId.HasValue)
            {
                var updateReq = new UpdateBusinessPartnerRequest(
                    formPersonType,
                    formPersonType == PersonType.Legal ? (string.IsNullOrWhiteSpace(formCompanyName) ? formName : formCompanyName) : formName,
                    null,
                    null,
                    formNationalCode,
                    formCompanyName,
                    formNationalLegalId,
                    formEconomicCode,
                    formMobile,
                    formPhone,
                    formEmail,
                    formWebsite,
                    formCountry,
                    formProvince,
                    formCity,
                    formAddress,
                    null,
                    null,
                    roleIds);

                var res = await BpService.Update(CurrentScope, CurrentOrgId, editingPartnerId.Value, editingRowVersion, updateReq);
                if (!res.Succeeded)
                {
                    modalError = MapError(res.Error!.Code);
                    return;
                }
            }
            else
            {
                var createReq = new CreateBusinessPartnerRequest(
                    CurrentOrgId,
                    null, // auto allocate
                    formPersonType,
                    formPersonType == PersonType.Legal ? (string.IsNullOrWhiteSpace(formCompanyName) ? formName : formCompanyName) : formName,
                    null,
                    null,
                    formNationalCode,
                    formCompanyName,
                    formNationalLegalId,
                    formEconomicCode,
                    formMobile,
                    formPhone,
                    formEmail,
                    formWebsite,
                    formCountry,
                    formProvince,
                    formCity,
                    formAddress,
                    null,
                    null,
                    roleIds);

                var res = await BpService.Create(CurrentScope, createReq);
                if (!res.Succeeded)
                {
                    modalError = MapError(res.Error!.Code);
                    return;
                }
            }

            formModalOpen = false;
            pageNotice = Text["WriteSaved"];
            await RefreshGridAsync();
        }
        finally
        {
            saving = false;
        }
    }

