@page "/business-partners"
@page "/organizations/{OrganizationId:long}/business-partners"
@using ForgeFlow.Application.BusinessPartners
@using ForgeFlow.Application.Organizations
@using ForgeFlow.Domain.BusinessPartners
@using ForgeFlow.Domain.Organizations
@implements IDisposable
@inject BusinessPartnerUseCases BpService
@inject DocumentSequenceUseCases SeqService
@inject ForgeFlow.Web.Organizations.ReadScopes Scopes
@inject ITrustedActorAccessor Actors
@inject IOrganizationPermissionEvaluator Permissions
@inject CulturePolicy Culture
@inject DisplayFormatter Format
@inject IStringLocalizer<SharedResources> Text

<PageTitle>@Text["BusinessPartners"] - @Text["AppTitle"]</PageTitle>

<section class="organization-reader" aria-labelledby="bp-title">
    <div class="read-page-head">
        <div>
            <h1 id="bp-title">@Text["BusinessPartners"]</h1>
            <p class="write-hint">@Text["BusinessPartnersCaption"]</p>
        </div>
        @if (!initialLoading && pageError is null && available.Count > 0 && scopeCanManage)
        {
            <div class="read-head-actions">
                <BitButton Size="BitSize.Small" IconName="Add" Class="read-create-btn" OnClick="OpenCreateModal">
                    @Text["BpCreateButton"]
                </BitButton>
            </div>
        }
    </div>

    @if (pageNotice is not null)
    {
        <p role="status" class="read-page-notice write-saved">@pageNotice</p>
    }

    @if (initialLoading)
    {
        <p role="status" aria-live="polite">@Text["ReadLoading"]</p>
    }
    else if (pageError is not null)
    {
        <div class="read-state" role="alert">
            <p>@Text[pageError]</p>
            <BitButton Variant="BitVariant.Outline" Size="BitSize.Small" OnClick="ReloadScopeAsync">@Text["WriteReload"]</BitButton>
        </div>
    }
    else if (available.Count == 0)
    {
        <p role="status" class="read-empty">@Text["ReadDenied"]</p>
    }
    else
    {
        <div class="read-toolbar-card">
            @if (available.Count > 1)
            {
                <div class="read-field">
                    <label for="bp-scope">@Text["ReadScope"]</label>
                    <select id="bp-scope" aria-label="@Text["ReadScope"]" value="@scopeIndex" @onchange="ChangeScopeAsync">
                        @for (var i = 0; i < available.Count; i++)
                        {
                            <option value="@i">@ScopeLabel(available[i])</option>
                        }
                    </select>
                </div>
            }

            <div class="read-field">
                <label for="bp-search">@Text["ReadSearch"]</label>
                <input id="bp-search" type="search" value="@search" @oninput="OnSearchInput" maxlength="64" placeholder="@Text["BpSearchPlaceholder"]" />
            </div>

            <div class="read-field">
                <label for="bp-role-filter">@Text["BpFilterRole"]</label>
                <select id="bp-role-filter" aria-label="@Text["BpFilterRole"]" value="@roleFilter" @onchange="ChangeRoleFilterAsync">
                    <option value="0">@Text["BpAllRoles"]</option>
                    <option value="1">@Text["BpRoleSupplier"]</option>
                    <option value="2">@Text["BpRoleCustomer"]</option>
                    <option value="3">@Text["BpRoleContractor"]</option>
                </select>
            </div>

            <div class="read-field">
                <label for="bp-pt-filter">@Text["BpPersonType"]</label>
                <select id="bp-pt-filter" aria-label="@Text["BpPersonType"]" value="@personTypeFilter" @onchange="ChangePersonTypeFilterAsync">
                    <option value="0">@Text["BpAllPersonTypes"]</option>
                    <option value="1">@Text["BpPersonLegal"]</option>
                    <option value="2">@Text["BpPersonNatural"]</option>
                </select>
            </div>

            <label class="read-inactive">
                <input type="checkbox" checked="@includeInactive" @onchange="ToggleInactiveAsync" />
                <span>@Text["ReadInactive"]</span>
            </label>
        </div>

        <BusinessPartnerGridSection @ref="gridSection"
            OnReadPartners="@ReadPartnersAsync"
            PageSizeOptions="@PageSizeOptions"
            GridStrings="@GridStrings"
            GetRoleBadgeClass="@GetRoleBadgeClass"
            RoleName="@RoleName"
            ScopeCanManage="@scopeCanManage"
            OnOpenDetail="OpenDetailModal"
            OnOpenEdit="OpenEditModal"
            OnOpenToggleConfirm="OpenToggleActiveConfirm" />
    }

    <BusinessPartnerFormModal
        FormDialogClasses="@FormDialogClasses"
        @bind-IsOpen="formModalOpen"
        IsEditing="@editingPartnerId.HasValue"
        ModalError="@modalError"
        @bind-RoleSupplier="roleSupplier"
        @bind-RoleCustomer="roleCustomer"
        @bind-RoleContractor="roleContractor"
        FormPersonType="@formPersonType"
        OnPersonTypeChanged="OnPersonTypeChanged"
        FormCode="@formCode"
        @bind-FormNationalLegalId="formNationalLegalId"
        @bind-FormNationalCode="formNationalCode"
        @bind-FormEconomicCode="formEconomicCode"
        @bind-FormCompanyName="formCompanyName"
        @bind-FormFirstName="formFirstName"
        @bind-FormLastName="formLastName"
        @bind-FormMobile="formMobile"
        @bind-FormPhone="formPhone"
        @bind-FormEmail="formEmail"
        @bind-FormWebsite="formWebsite"
        @bind-FormCountry="formCountry"
        FormProvince="@formProvince"
        OnProvinceChanged="OnProvinceChangedAsync"
        @bind-FormCity="formCity"
        @bind-FormAddress="formAddress"
        Provinces="@provinces"
        Cities="@cities"
        FilterDigitsOnly="@FilterDigitsOnly"
        Saving="@saving"
        OnSave="SavePartnerAsync" />

@using ForgeFlow.Web.Components.Pages.BusinessPartnerSections
    <BusinessPartnerDetailAndToggleModals
        DetailDialogClasses="@DetailDialogClasses"
        @bind-DetailModalOpen="detailModalOpen"
        DetailItem="@detailItem"
        GetRoleBadgeClass="@GetRoleBadgeClass"
        RoleName="@RoleName"
        ResolveCountry="@ResolveCountry"
        @bind-ConfirmToggleOpen="confirmToggleOpen"
        TargetIsActive="@targetIsActive"
        TargetName="@targetName"
        Toggling="@toggling"
        OnExecuteToggleActive="ExecuteToggleActiveAsync" />
</section>

@code {
    [Parameter] public long? OrganizationId { get; set; }

    private BusinessPartnerGridSection? gridSection;
    private List<OrganizationScope> available = [];
    private int scopeIndex;
    private bool scopeCanManage;
    private bool initialLoading = true;
    private string? pageError;
    private string? pageNotice;
    private string search = string.Empty;
    private bool includeInactive;
    private readonly DebouncedSearchController _searchController = new(300);

    public void Dispose() => _searchController.Dispose();
    private int roleFilter;
    private int personTypeFilter;

    // Form modal state
    private bool formModalOpen;
    private bool saving;
    private string? modalError;
    private long? editingPartnerId;
    private string? editingRowVersion;
    private string formCode = string.Empty;
    private PersonType formPersonType = PersonType.Legal;
    private bool roleSupplier = true;
    private bool roleCustomer;
    private bool roleContractor;
    private string formFirstName = string.Empty;
    private string formLastName = string.Empty;
    private string formCompanyName = string.Empty;
    private string formNationalCode = string.Empty;
    private string formNationalLegalId = string.Empty;
    private string formEconomicCode = string.Empty;
    private string formMobile = string.Empty;
    private string formPhone = string.Empty;
    private string formEmail = string.Empty;
    private string formWebsite = string.Empty;
    private string formCountry = "IR";
    private string formProvince = string.Empty;
    private string formCity = string.Empty;
    private string formAddress = string.Empty;

    // Location reference data
    private List<IranProvinceDto> provinces = [];
    private List<IranCityDto> cities = [];
    private int? selectedProvinceId;

    // Detail modal state
    private bool detailModalOpen;
    private BusinessPartnerDetail? detailItem;

    // Toggle active state
    private bool confirmToggleOpen;
    private bool toggling;
    private long targetId;
    private string targetName = string.Empty;
    private string? targetVersion;
    private bool targetIsActive;

    private static readonly int[] PageSizeOptions = [10, 25, 50, 100];

    private BitDataGridStrings GridStrings => new()
    {
        GridLabel = Text["BusinessPartners"],
        EmptyText = Text["ReadEmpty"],
        NoMatchesText = Text["ReadEmpty"],
        LoadingText = Text["ReadLoading"],
        PagerRangeFormat = Text["GridPagerRange"],
        PagerPageFormat = Text["GridPagerPage"],
        PerPageFormat = Text["GridPerPage"],
        RowsPerPageLabel = Text["GridRowsPerPage"],
        FirstPageLabel = Text["GridFirstPage"],
        PreviousPageLabel = Text["GridPreviousPage"],
        NextPageLabel = Text["GridNextPage"],
        LastPageLabel = Text["GridLastPage"],
        AnnouncementPage = Text["GridPagerPage"]
    };

    private static readonly BitDialogClassStyles FormDialogClasses = new()
    {
        Container = "bp-modal-dialog",
        Header = "bp-modal-dialog-hidden-hdr",
        Body = "bp-modal-shell",
        CloseButton = "read-dialog-close",
        Overlay = "read-dialog-overlay"
    };

    private static readonly BitDialogClassStyles DetailDialogClasses = new()
    {
        Container = "read-dialog",
        Header = "read-dialog-header",
        Body = "read-dialog-body",
        CloseButton = "read-dialog-close",
        Overlay = "read-dialog-overlay"
    };

    private const string DeactivateIcon = "<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'><circle cx='12' cy='12' r='10'></circle><line x1='4.93' y1='4.93' x2='19.07' y2='19.07'></line></svg>";
    private const string ActivateIcon = "<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'><circle cx='12' cy='12' r='10'></circle><polyline points='12 6 12 12 16 14'></polyline></svg>";

    private OrganizationScope? CurrentScope => available.Count > scopeIndex ? available[scopeIndex] : null;
    private long CurrentOrgId => CurrentScope switch
    {
        OrganizationScope.Organization o => o.OrganizationId,
        OrganizationScope.Site s => s.OrganizationId,
        _ => 0
    };

    protected override async Task OnInitializedAsync()
    {
        var scopesTask = LoadScopesAsync();
        var provincesTask = BpService.ListProvinces();
        await Task.WhenAll(scopesTask, provincesTask);
        provinces = (await provincesTask).ToList();
    }

    protected override async Task OnParametersSetAsync()
    {
        if (OrganizationId.HasValue && available.Count > 0)
        {
            var match = available.FindIndex(s => s is OrganizationScope.Organization o && o.OrganizationId == OrganizationId.Value);
            if (match >= 0 && match != scopeIndex)
            {
                scopeIndex = match;
                await EvaluateManagePermissionAsync();
                await RefreshGridAsync();
            }
        }
    }

    private async Task LoadScopesAsync()
    {
        initialLoading = true;
        pageError = null;
        try
        {
            var loaded = await Scopes.LoadBusinessPartnerScopesAsync();
            available = loaded.ToList();
            if (OrganizationId.HasValue && available.Count > 0)
            {
                var match = available.FindIndex(s => s is OrganizationScope.Organization o && o.OrganizationId == OrganizationId.Value);
                if (match >= 0) scopeIndex = match;
            }
            await EvaluateManagePermissionAsync();
        }
        catch (Exception)
        {
            pageError = "ReadError";
        }
        finally
        {
            initialLoading = false;
        }
    }

    private async Task EvaluateManagePermissionAsync()
    {
        var scope = CurrentScope;
        if (scope is null) { scopeCanManage = false; return; }
        var actor = await Actors.ResolveAsync(default);
        if (actor is null) { scopeCanManage = false; return; }
        scopeCanManage = (await Permissions.EvaluateAsync(actor, scope, BusinessPartnerPermissions.Manage, default)).IsAllowed;
    }

    private async Task ChangeScopeAsync(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out var idx) && idx >= 0 && idx < available.Count)
        {
            scopeIndex = idx;
            await EvaluateManagePermissionAsync();
            await RefreshGridAsync();
        }
    }

    private async Task OnSearchInput(ChangeEventArgs e)
    {
        await _searchController.OnInputDebouncedAsync(
            e,
            val => search = val,
            async _ =>
            {
                await RefreshGridAsync();
                await InvokeAsync(StateHasChanged);
            });
    }

    private async Task ChangeRoleFilterAsync(ChangeEventArgs e)
    {
        roleFilter = int.TryParse(e.Value?.ToString(), out var r) ? r : 0;
        await _searchController.RunImmediateAsync(async _ =>
        {
            await RefreshGridAsync();
            await InvokeAsync(StateHasChanged);
        });
    }

    private async Task ChangePersonTypeFilterAsync(ChangeEventArgs e)
    {
        personTypeFilter = int.TryParse(e.Value?.ToString(), out var pt) ? pt : 0;
        await _searchController.RunImmediateAsync(async _ =>
        {
            await RefreshGridAsync();
            await InvokeAsync(StateHasChanged);
        });
    }

    private async Task ToggleInactiveAsync(ChangeEventArgs e)
    {
        includeInactive = e.Value is bool b && b;
        await _searchController.RunImmediateAsync(async _ =>
        {
            await RefreshGridAsync();
            await InvokeAsync(StateHasChanged);
        });
    }

    private async Task ApplySearchAsync()
    {
        await _searchController.RunImmediateAsync(async _ =>
        {
            await RefreshGridAsync();
            await InvokeAsync(StateHasChanged);
        });
    }

    private async Task ReloadScopeAsync() => await LoadScopesAsync();

    private Task RefreshGridAsync() => gridSection?.RefreshAsync() ?? Task.CompletedTask;

    private async Task<BitDataGridReadResult<BusinessPartnerSummary>> ReadPartnersAsync(BitDataGridReadRequest req)
    {
        var scope = CurrentScope;
        if (scope is null) return new([], 0);
        var size = Math.Clamp(req.Take ?? 25, 1, 100);
        var page = (req.Skip / size) + 1;

        PersonType? pType = personTypeFilter switch
        {
            1 => PersonType.Legal,
            2 => PersonType.Natural,
            _ => null
        };

        var res = await BpService.List(
            scope,
            CurrentOrgId,
            new BusinessPartnerListQuery(search, roleFilter > 0 ? roleFilter : null, includeInactive, page, size, pType),
            req.CancellationToken);

        if (!res.Succeeded)
            return new([], 0);

        return new(res.Value!.Items.ToList(), res.Value.Total);
    }

    private void OnPersonTypeChanged(PersonType type)
    {
        formPersonType = type;
    }

    private async Task OnProvinceChangedAsync(ChangeEventArgs e)
    {
        formProvince = e.Value?.ToString() ?? string.Empty;
        formCity = string.Empty;
        cities.Clear();
        if (!string.IsNullOrWhiteSpace(formProvince))
        {
            var match = provinces.FirstOrDefault(p => p.Name == formProvince);
            if (match is not null)
            {
                selectedProvinceId = match.Id;
                cities = (await BpService.ListCities(match.Id)).ToList();
            }
        }
        else
        {
            selectedProvinceId = null;
        }
    }

    private async Task OpenCreateModal()
    {
        editingPartnerId = null;
        editingRowVersion = null;
        formPersonType = PersonType.Legal;
        roleSupplier = true;
        roleCustomer = false;
        roleContractor = false;
        formFirstName = string.Empty;
        formLastName = string.Empty;
        formCompanyName = string.Empty;
        formNationalCode = string.Empty;
        formNationalLegalId = string.Empty;
        formEconomicCode = string.Empty;
        formMobile = string.Empty;
        formPhone = string.Empty;
        formEmail = string.Empty;
        formWebsite = string.Empty;
        formCountry = "IR";
        formProvince = string.Empty;
        formCity = string.Empty;
        formAddress = string.Empty;
        cities.Clear();
        selectedProvinceId = null;
        modalError = null;

        var prevRes = CurrentScope is not null
            ? await SeqService.GetPreview(CurrentScope, CurrentOrgId, DocumentSequenceType.BusinessPartner)
            : null;
        formCode = prevRes is { Succeeded: true } ? prevRes.Value!.NextPreview : string.Empty;

        formModalOpen = true;
    }

    private async Task OpenEditModal(BusinessPartnerSummary p)
    {
        modalError = null;
        var detailRes = await BpService.Get(CurrentScope, CurrentOrgId, p.Id);
        if (!detailRes.Succeeded || detailRes.Value is null)
        {
            pageNotice = Text["ReadError"];
            return;
        }

        var d = detailRes.Value;
        editingPartnerId = d.Id;
        editingRowVersion = d.RowVersion;
        formCode = d.Code;
        formPersonType = d.PersonType;
        roleSupplier = d.Roles.Any(r => r.Id == 1);
        roleCustomer = d.Roles.Any(r => r.Id == 2);
        roleContractor = d.Roles.Any(r => r.Id == 3);
        formFirstName = d.FirstName ?? string.Empty;
        formLastName = d.LastName ?? string.Empty;
        formCompanyName = d.CompanyName ?? (d.PersonType == PersonType.Legal ? d.Name : string.Empty);
        formNationalCode = d.NationalCode ?? string.Empty;
        formNationalLegalId = d.NationalLegalId ?? string.Empty;
        formEconomicCode = d.EconomicCode ?? string.Empty;
        formMobile = d.Mobile ?? string.Empty;
        formPhone = d.Phone ?? string.Empty;
        formEmail = d.Email ?? string.Empty;
        formWebsite = d.Website ?? string.Empty;
        formCountry = string.IsNullOrWhiteSpace(d.Country) || d.Country == "ایران" ? "IR" : d.Country;
        formProvince = d.Province ?? string.Empty;
        formCity = d.City ?? string.Empty;
        formAddress = d.Address ?? string.Empty;

        cities.Clear();
        selectedProvinceId = null;
        if (!string.IsNullOrWhiteSpace(formProvince))
        {
            var match = provinces.FirstOrDefault(prov => prov.Name == formProvince);
            if (match is not null)
            {
                selectedProvinceId = match.Id;
                cities = (await BpService.ListCities(match.Id)).ToList();
            }
        }

        formModalOpen = true;
    }

    private async Task SavePartnerAsync()
    {
        var roleIds = new List<int>();
        if (roleSupplier) roleIds.Add(1);
        if (roleCustomer) roleIds.Add(2);
        if (roleContractor) roleIds.Add(3);

        if (roleIds.Count == 0)
        {
            modalError = Text["BpRoleRequired"];
            return;
        }

        // Validate names
        string resolvedName;
        if (formPersonType == PersonType.Natural)
        {
            formFirstName = formFirstName?.Trim() ?? string.Empty;
            formLastName = formLastName?.Trim() ?? string.Empty;
            if (string.IsNullOrWhiteSpace(formFirstName) || string.IsNullOrWhiteSpace(formLastName))
            {
                modalError = Text["BpFirstLastNameRequired"];
                return;
            }
            resolvedName = $"{formFirstName} {formLastName}".Trim();
        }
        else
        {
            formCompanyName = formCompanyName?.Trim() ?? string.Empty;
            if (string.IsNullOrWhiteSpace(formCompanyName))
            {
                modalError = Text["BpCompanyNameRequired"];
                return;
            }
            resolvedName = formCompanyName;
        }

        // Validate formats
        var normNatCode = BusinessPartnerText.NormalizeDigits(formNationalCode);
        if (formPersonType == PersonType.Natural && !string.IsNullOrWhiteSpace(normNatCode))
        {
            if (normNatCode.Length != 10 || !normNatCode.All(char.IsDigit))
            {
                modalError = Text["BpNationalCodeLengthError"];
                return;
            }
        }

        var normNatLegalId = BusinessPartnerText.NormalizeDigits(formNationalLegalId);
        if (formPersonType == PersonType.Legal && !string.IsNullOrWhiteSpace(normNatLegalId))
        {
            if (!normNatLegalId.All(char.IsDigit))
            {
                modalError = Text["BpNationalLegalIdFormatError"];
                return;
            }
        }

        var normEcon = BusinessPartnerText.NormalizeDigits(formEconomicCode);
        if (!string.IsNullOrWhiteSpace(normEcon) && !normEcon.All(char.IsDigit))
        {
            modalError = Text["BpEconomicCodeFormatError"];
            return;
        }

        var normMobile = BusinessPartnerText.NormalizeDigits(formMobile);
        if (!string.IsNullOrWhiteSpace(normMobile))
        {
            if (normMobile.Length != 11 || !normMobile.StartsWith("09", StringComparison.Ordinal) || !normMobile.All(char.IsDigit))
            {
                modalError = Text["BpMobileFormatError"];
                return;
            }
        }

        var normPhone = BusinessPartnerText.NormalizeDigits(formPhone);
        if (!string.IsNullOrWhiteSpace(normPhone))
        {
            if (!normPhone.StartsWith("0", StringComparison.Ordinal) || !normPhone.All(char.IsDigit))
            {
                modalError = Text["BpPhoneFormatError"];
                return;
            }
        }

        saving = true;
        modalError = null;
        try
        {
            if (editingPartnerId.HasValue)
            {
                var updateReq = new UpdateBusinessPartnerRequest(
                    formPersonType,
                    resolvedName,
                    string.IsNullOrWhiteSpace(formFirstName) ? null : formFirstName.Trim(),
                    string.IsNullOrWhiteSpace(formLastName) ? null : formLastName.Trim(),
                    string.IsNullOrWhiteSpace(normNatCode) ? null : normNatCode,
                    formPersonType == PersonType.Legal ? formCompanyName : null,
                    formPersonType == PersonType.Legal ? (string.IsNullOrWhiteSpace(normNatLegalId) ? null : normNatLegalId) : null,
                    string.IsNullOrWhiteSpace(normEcon) ? null : normEcon,
                    string.IsNullOrWhiteSpace(normMobile) ? null : normMobile,
                    string.IsNullOrWhiteSpace(normPhone) ? null : normPhone,
                    string.IsNullOrWhiteSpace(formEmail) ? null : formEmail.Trim(),
                    string.IsNullOrWhiteSpace(formWebsite) ? null : formWebsite.Trim(),
                    string.IsNullOrWhiteSpace(formCountry) ? null : formCountry.Trim(),
                    string.IsNullOrWhiteSpace(formProvince) ? null : formProvince.Trim(),
                    string.IsNullOrWhiteSpace(formCity) ? null : formCity.Trim(),
                    string.IsNullOrWhiteSpace(formAddress) ? null : formAddress.Trim(),
                    null,
                    null,
                    roleIds);

                var res = await BpService.Update(CurrentScope, CurrentOrgId, editingPartnerId.Value, editingRowVersion, updateReq);
                if (!res.Succeeded)
                {
                    modalError = MapError(res.Error!.Code);
                    return;
                }
            }
            else
            {
                var createReq = new CreateBusinessPartnerRequest(
                    CurrentOrgId,
                    null, // auto allocate
                    formPersonType,
                    resolvedName,
                    string.IsNullOrWhiteSpace(formFirstName) ? null : formFirstName.Trim(),
                    string.IsNullOrWhiteSpace(formLastName) ? null : formLastName.Trim(),
                    string.IsNullOrWhiteSpace(normNatCode) ? null : normNatCode,
                    formPersonType == PersonType.Legal ? formCompanyName : null,
                    formPersonType == PersonType.Legal ? (string.IsNullOrWhiteSpace(normNatLegalId) ? null : normNatLegalId) : null,
                    string.IsNullOrWhiteSpace(normEcon) ? null : normEcon,
                    string.IsNullOrWhiteSpace(normMobile) ? null : normMobile,
                    string.IsNullOrWhiteSpace(normPhone) ? null : normPhone,
                    string.IsNullOrWhiteSpace(formEmail) ? null : formEmail.Trim(),
                    string.IsNullOrWhiteSpace(formWebsite) ? null : formWebsite.Trim(),
                    string.IsNullOrWhiteSpace(formCountry) ? null : formCountry.Trim(),
                    string.IsNullOrWhiteSpace(formProvince) ? null : formProvince.Trim(),
                    string.IsNullOrWhiteSpace(formCity) ? null : formCity.Trim(),
                    string.IsNullOrWhiteSpace(formAddress) ? null : formAddress.Trim(),
                    null,
                    null,
                    roleIds);

                var res = await BpService.Create(CurrentScope, createReq);
                if (!res.Succeeded)
                {
                    modalError = MapError(res.Error!.Code);
                    return;
                }
            }

            formModalOpen = false;
            pageNotice = Text["WriteSaved"];
            await RefreshGridAsync();
        }
        finally
        {
            saving = false;
        }
    }

    private async Task OpenDetailModal(BusinessPartnerSummary p)
    {
        var res = await BpService.Get(CurrentScope, CurrentOrgId, p.Id);
        if (res.Succeeded)
        {
            detailItem = res.Value;
            detailModalOpen = true;
        }
    }

    private void OpenToggleActiveConfirm(BusinessPartnerSummary p)
    {
        targetId = p.Id;
        targetName = p.Name;
        targetVersion = p.RowVersion;
        targetIsActive = p.IsActive;
        confirmToggleOpen = true;
    }

    private async Task ExecuteToggleActiveAsync()
    {
        toggling = true;
        try
        {
            var res = await BpService.SetActive(CurrentScope, CurrentOrgId, targetId, targetVersion, !targetIsActive);
            if (res.Succeeded)
            {
                confirmToggleOpen = false;
                pageNotice = Text["WriteSaved"];
                await RefreshGridAsync();
            }
        }
        finally
        {
            toggling = false;
        }
    }

    private string RoleName(int id) => id switch
    {
        1 => Text["BpRoleSupplier"],
        2 => Text["BpRoleCustomer"],
        3 => Text["BpRoleContractor"],
        _ => id.ToString()
    };

    private static string GetRoleBadgeClass(int roleId) => roleId switch
    {
        1 => "bp-role-badge--supplier",
        2 => "bp-role-badge--customer",
        3 => "bp-role-badge--contractor",
        _ => string.Empty
    };

    private static string FilterDigitsOnly(string? val, int maxLen)
    {
        if (string.IsNullOrEmpty(val)) return string.Empty;
        var norm = BusinessPartnerText.NormalizeDigits(val);
        var sb = new System.Text.StringBuilder();
        foreach (var ch in norm)
        {
            if (char.IsDigit(ch))
            {
                sb.Append(ch);
                if (sb.Length == maxLen) break;
            }
        }
        return sb.ToString();
    }

    private string ScopeLabel(OrganizationScope scope) => scope switch
    {
        OrganizationScope.Organization o => Text["ReadOrganizationScope", o.OrganizationId],
        OrganizationScope.Site s => Text["ReadSiteScope", s.OrganizationId, s.SiteId],
        _ => string.Empty
    };

    private string ResolveCountry(string? country) => country is "IR" or "ایران" ? Text["Country_IR"] : (country ?? string.Empty);

    private string MapError(string code) => Text[RolePermissionLocalization.FailureKey(code)];
}
